{
  "name": "@deepseek-ai/dsh-target-protection",
  "version": "0.2.1-rc.3",
  "description": "Persistent target rules and mandatory execution admission",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Water-Run/deepseek-harness-uncensored.git",
    "directory": "packages/guard/target-protection"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./http": {
      "types": "./lib/types/http.d.ts",
      "default": "./lib/types/http.js"
    },
    "./package.json": "./package.json",
    "./ssh": {
      "types": "./lib/types/ssh.d.ts",
      "default": "./lib/types/ssh.js"
    },
    "./rea": {
      "types": "./lib/types/rea.d.ts",
      "default": "./lib/types/rea.js"
    },
    "./mcp": {
      "types": "./lib/types/mcp.d.ts",
      "default": "./lib/types/mcp.js"
    },
    "./country": {
      "types": "./lib/types/country-provider.d.ts",
      "default": "./lib/types/country-provider.js"
    },
    "./fs": {
      "types": "./lib/types/fs.d.ts",
      "default": "./lib/types/fs.js"
    },
    "./subprocess": {
      "types": "./lib/types/subprocess.d.ts",
      "default": "./lib/types/subprocess.js"
    },
    "./security-proxy": {
      "types": "./lib/types/security-proxy.d.ts",
      "default": "./lib/types/security-proxy.js"
    }
  },
  "files": [
    "lib/index.js",
    "assets",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "ipaddr.js": "2.5.0",
    "re2js": "2.9.0",
    "zod": "4.4.3",
    "dns-packet": "5.6.1",
    "mmdb-lib": "3.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "workspace:*",
    "@deepseek-ai/dsh-rea": "workspace:*",
    "@deepseek-ai/dsh-ssh": "workspace:*",
    "@deepseek-ai/dsh-security-proxy-local": "workspace:*",
    "@deepseek-ai/dsh-fs": "workspace:*",
    "@deepseek-ai/dsh-fs-sandbox": "workspace:*",
    "@deepseek-ai/dsh-sandbox": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/dsh-subprocess-local": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-timeout": "workspace:*",
    "@deepseek-ai/dsh-web": "workspace:*",
    "@deepseek-ai/dsh-web-fetch-http": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-mcp-client": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-mcp-resources": "workspace:*",
    "@modelcontextprotocol/client": "2.2.0",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-rea": "workspace:*",
    "@deepseek-ai/dsh-ssh": "workspace:*",
    "@deepseek-ai/dsh-fs-ssh": "workspace:*",
    "@deepseek-ai/dsh-credentials-local": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-security-proxy": "workspace:*",
    "@deepseek-ai/dsh-security-proxy-local": "workspace:*",
    "@deepseek-ai/dsh-http-proxy": "workspace:*",
    "@deepseek-ai/dsh-fs-local": "workspace:*",
    "@deepseek-ai/dsh-sandbox-policy": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-fs": "workspace:*",
    "@deepseek-ai/dsh-fs-sandbox": "workspace:*",
    "@deepseek-ai/dsh-sandbox": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/dsh-subprocess-local": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-timeout": "workspace:*",
    "@deepseek-ai/dsh-web": "workspace:*",
    "@deepseek-ai/dsh-web-fetch-http": "workspace:*",
