/** Each checkout runs this fixture from its scripts directory with its own source and dependencies. */
import { mkdir, readFile, writeFile } from 'node:fs/promises'
import { join } from 'node:path'
import { expect, it } from 'vitest'
import { loadCordisYaml } from './cordis-yaml.ts'
import { resolveDshHome } from '@deepseek-ai/dsh-home-paths'
import { Context } from '@deepseek-ai/cordis'
import { mountAgentLoopTestDependencies, mountAgentLoopTestHarness } from '@deepseek-ai/dsh-agent-loop-testkit'
import { brandString, type Branded } from '@deepseek-ai/dsh-brand'
import { LocalFileSystem } from '@deepseek-ai/dsh-fs-local'
import { createAssistantMessage, createDeveloperMessage, createUserMessage, projectToolUpdates, ReasoningEffortId } from '@deepseek-ai/dsh-llm'
import SessionStore, { Session, type SessionEvent, type SessionId, type SessionLogOffset } from '@deepseek-ai/dsh-session'
import * as jsonl from '@deepseek-ai/dsh-session-persistence-jsonl'
import MemoryService from '@deepseek-ai/dsh-memory'
import Storage from '@deepseek-ai/dsh-storage'
import * as domains from '@deepseek-ai/dsh-storage-domain'
import * as jsonStorage from '@deepseek-ai/dsh-storage-json'
import WorkspaceRegistry from '@deepseek-ai/dsh-workspace'
import PermissionPresets from '@deepseek-ai/dsh-permission-presets'
import { liveConfig } from '../packages/settings/settings/tests/live-config.ts'
import { createSessionTestController } from '../packages/api/session-controller/tests/test-remote.ts'
import { MockAdapter, textResponse, toolCallResponse } from '../packages/core/agent-loop/tests/mock-adapter.ts'
import { writingMaterialsText } from '../packages/api/mode-dossiers/src/index.ts'
import { createStoryEntry, listStory, setStorySelection } from '../packages/api/mode-dossiers/src/story.ts'
import { DEFAULT_PREFERENCES, MICRO_CNY, SpendLedger } from '../packages/guard/spend-limit/src/ledger.ts'
import * as spending from '../packages/guard/spend-limit/src/index.ts'
import { DEFAULT_RATES } from '../packages/guard/spend-limit/src/pricing.ts'
import { sessionSpendUsage } from '../packages/guard/spend-limit/src/session-usage.ts'

import { createPluginProfile } from '../apps/desktop/src/project-manager.ts'

const phase = process.env.DSHU_VERIFY_PHASE
const directory = process.env.DSHU_VERIFY_DATA
if (!directory || !['write', 'read', 'reopen'].includes(phase ?? '')) throw new Error('Run with the released-data verifier')
if (process.env.DSHU_VERIFY_ELECTRON === '1') {
  const desktop = JSON.parse(await readFile(new URL('../apps/desktop/node_modules/electron/package.json', import.meta.url), 'utf8'))
  expect(process.versions.electron).toBe(desktop.version)
  console.log('Candidate reader runtime', process.versions.electron, process.versions.node, process.versions.modules)
}
const workspace = join(directory, 'workspace')
const money = join(directory, 'storages', 'spending.sqlite')
const historicalTime = 1_795_000_000_000
const style = 'story/style/voice.md'
const bible = 'story/bible/city.md'
const unused = 'story/style/unused.md'
const estimateUsage: (events: readonly SessionEvent[], rates: typeof DEFAULT_RATES,
  inherited: SessionLogOffset) => ReturnType<typeof sessionSpendUsage> = sessionSpendUsage

it('preserves a released writing workspace, rolling ledger and compressed v4 Session', async () => {
  await mkdir(workspace, { recursive: true })
  const ctx = new Context()
  const ledger = await SpendLedger.open(money, () => historicalTime)
  const id = brandString<SessionId>('released-writing')
  try {
    await ctx.plugin(LocalFileSystem, { cwd: workspace })
    await ctx.plugin(jsonl, { root: join(directory, 'sessions'), compression: 'zstd' })
    const signal = new AbortController().signal
    if (phase === 'write') {
      await createStoryEntry(ctx.fs, workspace, 'style', 'voice', 'Voice', '句子要短。', signal)
      await createStoryEntry(ctx.fs, workspace, 'bible', 'city', 'City', '城里只有一座钟楼。', signal)
      await createStoryEntry(ctx.fs, workspace, 'style', 'unused', 'Unused', 'UNSELECTED DRAFT', signal)
      await setStorySelection(ctx.fs, workspace, [bible, style], signal)
      ledger.configure({ ...DEFAULT_PREFERENCES, autoResume: true, enabledPeriods: ['5h', '7d'],
        limits: { ...DEFAULT_PREFERENCES.limits, '5h': 2, '7d': 3 } })
      const charge = ledger.reserve(MICRO_CNY)
      if (charge.kind !== 'reserved') throw new Error('Expected a reservation from the release writer')
      ledger.settle(charge.id, MICRO_CNY)
      ledger.reset('5h')
      ledger.blockSession(ledger.waitForSession(id, 2 * MICRO_CNY))

      const session = Session.create(id)
      const header = { ...session.header, cwd: workspace, agentPreset: 'writing' }
      const admission = await writingMaterialsText(ctx.fs, workspace, 'writing', 4096, signal)
      session.append('turn/start', { turn: 1 })
      session.append('user/message', createUserMessage({ source: { kind: 'mode-dossiers', form: 'instructions' },
        content: [{ type: 'text', text: admission }] }), { surfaceOp: 'append' })
      session.append('user/message', createUserMessage({ source: { kind: 'user' },
        content: [{ type: 'text', text: '写一段清晨的街景。' }] }), { surfaceOp: 'append' })
      const route = { provider: 'deepseek-official', model: 'deepseek-flash' }
      session.append('step/start', { turn: 1, step: 1 })
      session.append('request/header', { reason: 'initial', header: { config: route } })
      session.append('assistant/message', { turn: 1, step: 1,
        message: createAssistantMessage({ source: route, content: [{ type: 'text', text: '钟声响了。' }] }),
        usage: { inputTokens: 100, outputTokens: 20 }, stream: [],
      }, { surfaceOp: 'append' })
      session.append('step/end', { turn: 1, step: 1 })
      session.append('turn/end', { turn: 1, reason: { kind: 'completed' } })
      const handle = await ctx.sessionPersistence.create(header)
      try {
        await handle.append(session.snapshotEvents())
        await handle.flush()
      } finally { await handle.close() }
    }

    const registry = await listStory(ctx.fs, workspace, signal)
    const hasBible = phase !== 'reopen'
    expect(registry.selected).toEqual(hasBible ? [bible, style] : [style])
    expect(registry.entries.map(e => [e.path, e.selected, e.missing]).sort()).toEqual([
      [bible, hasBible, false], [unused, false, false], [style, true, false],
    ])
    const material = await writingMaterialsText(ctx.fs, workspace, 'writing', 4096, signal)
    expect(material).toContain('句子要短。')
    if (hasBible) {
      expect(material).toContain('城里只有一座钟楼。')
      expect(material.indexOf('城里只有一座钟楼。')).toBeLessThan(material.indexOf('句子要短。'))
    } else { expect(material).not.toContain('钟楼') }
    expect(material).not.toContain('UNSELECTED DRAFT')

    const state = ledger.snapshot()
    expect(state.preferences).toMatchObject({ enabledPeriods: ['5h', '7d'], autoResume: true, limits: { '5h': 2, '7d': 3 } })
    expect(state.windows.find(window => window.period === '5h')?.spent).toBe(0)
    expect(state.windows.find(window => window.period === '7d')?.spent).toBe(1)
    expect(state.pausedSessions).toMatchObject(phase === 'reopen' ? [] : [{ sessionId: id, state: 'blocked' }])
    const handle = await ctx.sessionPersistence.open(id, 'read')
    try {
      const { events } = await handle.read()
      const receipt = join(directory, 'released.json')
      const observed = { header: handle.header, events }
      if (phase === 'write') await writeFile(receipt, JSON.stringify(observed))
      else expect(observed).toEqual(JSON.parse(await readFile(receipt, 'utf8')))
      expect(handle.header).toMatchObject({ version: 4, cwd: workspace, agentPreset: 'writing' })
      const session = Session.create(id, events, handle.header, handle.inheritedEventCount)
      expect(session.deriveMessages().map(message => message.content)).toEqual([
        [{ type: 'text', text: expect.stringContaining('城里只有一座钟楼。') }], [{ type: 'text', text: '写一段清晨的街景。' }],
        [{ type: 'text', text: '钟声响了。' }],
      ])
      expect(estimateUsage(events, DEFAULT_RATES, handle.inheritedEventCount))
        .toMatchObject({ total: 0.00036, requests: 1, unpricedRequests: 0 })
    } finally { await handle.close() }
    if (phase === 'read') {
      const [claim] = ledger.claimBlockedSessions()
      if (!claim) throw new Error('Released pause was not available to the candidate')
      expect(claim.sessionId).toBe(id)
      expect(ledger.claimBlockedSessions()).toEqual([])
      ledger.completeClaim(claim.id)
      await setStorySelection(ctx.fs, workspace, [style], signal)
      const revised = await writingMaterialsText(ctx.fs, workspace, 'writing', 4096, signal)
      expect(revised).toContain('句子要短。')
      expect(revised).not.toContain('钟楼')
    }
  } finally {
    ledger.close()
    await ctx.fiber.dispose()
  }
}, 30_000)

it('reopens and continues a released conversation containing an unsent composer suggestion', async () => {
  const ctx = new Context()
  const id = brandString<SessionId>('released-composer')
  const config = { provider: 'deepseek-official', model: 'deepseek-flash' }
  const first = 'Save the word ORCHID.'
  const next = 'Use the word in a poem.'
  const userText = (text: string) => createUserMessage({ source: { kind: 'user' }, content: [{ type: 'text', text }] })
  try {
    await ctx.plugin(jsonl, { root: join(directory, 'sessions'), compression: 'zstd' })
    if (phase === 'write') {
      const session = Session.create(id)
      session.append('turn/start', { turn: 1 })
      session.append('user/message', userText(first), { surfaceOp: 'append' })
      session.append('turn/end', { turn: 1, reason: { kind: 'completed' } })
      const writerModule = '../packages/api/session-controller/src/prediction.ts'
      const { requestPrediction } = await import(writerModule)
      const suggestion = await requestPrediction({
        session, surface: 'main', revision: 3, draft: 'Write', context: 'Notebook', locale: 'en',
        ...config, signal: new AbortController().signal, maxTokens: 16, maxSuggestionBytes: 64,
        stream: async function* () {
          yield { type: 'text-delta', index: 0, text: ' a sentence' }
          yield { type: 'usage', usage: { inputTokens: 5, outputTokens: 2 } }
          yield { type: 'finish', reason: { kind: 'stop' } }
        },
      })
      expect(suggestion).toBe(' a sentence')
      const predictions = session.snapshotEvents().filter(event => event.type === 'input/prediction')
      expect(predictions).toMatchObject([
        { data: { phase: 'request', draft: 'Write', request: config } },
        { data: { phase: 'result', suggestion, usage: { inputTokens: 5, outputTokens: 2 } } },
      ])
      await writeFile(join(directory, 'predictions.json'), JSON.stringify(predictions))
      const handle = await ctx.sessionPersistence.create(session.header)
      try {
        await handle.append(session.snapshotEvents())
        await handle.flush()
      } finally { await handle.close() }
      return
    }
    const handle = await ctx.sessionPersistence.open(id, phase === 'read' ? 'write' : 'read')
    try {
      const { events } = await handle.read()
      const session = Session.fromRestore(id, events, handle.header, handle.inheritedEventCount, 'detached')
      expect(events.filter(event => event.type === 'input/prediction'))
        .toEqual(JSON.parse(await readFile(join(directory, 'predictions.json'), 'utf8')))
      if (phase === 'read') {
        expect(session.deriveMessages().map(message => message.content)).toEqual([[{ type: 'text', text: first }]])
        session.append('turn/start', { turn: 2 })
        session.append('user/message', userText(next), { surfaceOp: 'append' })
        session.append('turn/end', { turn: 2, reason: { kind: 'completed' } })
        await handle.append(session.snapshotEvents().slice(events.length))
        await handle.flush()
      }
      expect(session.deriveMessages().map(message => message.content)).toEqual(
        [first, next].map(text => [{ type: 'text', text }]),
      )
    } finally { await handle.close() }
  } finally { await ctx.fiber.dispose() }
})

async function mountConversationHost(runtime: Context, adapter: MockAdapter) {
  await mountAgentLoopTestDependencies(runtime)
  const harness = await mountAgentLoopTestHarness(runtime)
  runtime.provide('shell', {
    sandboxMode: 'workspace-write',
    resolve() { throw new Error('Unexpected shell use') },
    run() { throw new Error('Unexpected shell use') },
    start() { throw new Error('Unexpected shell use') },
  })
  runtime.provide('approval', { config: { policy: 'ask' } })
  const bundle = loadCordisYaml(await readFile(new URL('../packages/bundle/base/cordis.patch.yml', import.meta.url), 'utf8'))
  const rows = (bundle as { insert: { id: string; config?: Record<string, unknown> }[] }[])[0]?.insert
  const permission = rows?.find(row => row.id === 'permission')?.config
  if (!permission) throw new Error('The release bundle has no permission preset configuration')
  await liveConfig(runtime, PermissionPresets, permission)
  runtime.provide('workspaceRegistry', { list: () => [], archivedSessionIds: [] } as never)
  const model = { provider: 'mock', model: 'mock' }
  runtime.llm.registerAdapter(['mock'], adapter)
  const controller = await createSessionTestController(runtime, { defaultModelSelection: () => model, cwd: workspace })
  return { harness, controller, model }
}

it('reopens the released quick question with its own answer, permissions and recorded parent context', async () => {
  const store = new Context()
  const parentId = brandString<SessionId>('released-question-parent')
  const identity = join(directory, 'quick-question.json')
  const mainRequest = 'Write a scene at the CLOCKTOWER.'
  const mainAnswer = 'The market opened at dawn.'
  const question = 'Which part is ready?'
  const answer = 'The opening scene is ready.'
  try {
    await store.plugin(jsonl, { root: join(directory, 'sessions'), compression: 'zstd' })
    if (phase === 'write') {
      const runtime = new Context()
      try {
        const adapter = new MockAdapter([textResponse(mainAnswer), textResponse(answer)], {
          efforts: ['off', 'low', 'high'].map(id => ({ id: ReasoningEffortId(id), name: id })),
          defaultEffort: ReasoningEffortId('high'),
        })
        const { harness, controller, model } = await mountConversationHost(runtime, adapter)
        const parent = await harness.create(parentId, model, { cwd: workspace })
        const prompt = (text: string) => createUserMessage({ source: { kind: 'user' }, content: [{ type: 'text', text }] })
        parent.followup(prompt(mainRequest))
        await parent.whenIdle()
        const opened = await controller.aside({ sessionId: parent.id, kind: 'btw' })
        const child = runtime.agents.get(opened.sessionId)
        if (!child) throw new Error('The release did not publish the question')
        child.followup(prompt(question))
        await child.whenIdle()
        expect(child.session.snapshotEvents().findLast(event => event.type === 'turn/end')?.data.reason).toEqual({ kind: 'completed' })
        expect(adapter.requests).toHaveLength(2)
        expect(JSON.stringify(adapter.requests[1]?.messages)).toContain(mainAnswer)
        expect(runtime.permissionPresets.current(child.session)).toBe('read-only')
        for (const session of [parent.session, child.session]) {
          const handle = await store.sessionPersistence.create(session.header)
          try {
            await handle.append(session.snapshotEvents())
            await handle.flush()
          } finally { await handle.close() }
        }
        await writeFile(identity, JSON.stringify(child.id))
      } finally { await runtime.fiber.dispose() }
    }
    const childId = JSON.parse(await readFile(identity, 'utf8')) as SessionId
    for (const id of [parentId, childId]) {
      const handle = await store.sessionPersistence.open(id, 'read')
      try {
        const { events } = await handle.read()
        const restored = Session.create(id, events, handle.header, handle.inheritedEventCount)
        const human = restored.deriveMessages().filter(message => message.role === 'user' && message.source.kind === 'user')
        expect(human.map(message => message.content)).toEqual([[{ type: 'text', text: id === parentId ? mainRequest : question }]])
        expect(restored.deriveMessages().filter(message => message.role === 'assistant').at(-1)?.content)
          .toEqual([{ type: 'text', text: id === parentId ? mainAnswer : answer }])
        if (id === childId) {
          expect(handle.header.parentSession).toBe(parentId)
          expect(events.findLast(event => event.type === 'permission/preset')?.data.preset).toBe('read-only')
          const recorded = restored.deriveMessages().filter(message => message.role === 'user' && message.source.kind === 'runtime-context')
          expect(JSON.stringify(recorded)).toContain(mainAnswer)
        }
      } finally { await handle.close() }
    }
  } finally { await store.fiber.dispose() }
})

it('reads the released side answer on demand and reopens the recorded tool result without waking the side', async () => {
  const ctx = new Context()
  const receipt = join(directory, 'side-reader.json')
  const answer = 'The pattern is called Silver Birch.'
  try {
    await ctx.plugin(jsonl, { root: join(directory, 'sessions'), compression: 'zstd' })
    const adapter = new MockAdapter(phase === 'write' ? [textResponse('The book is ready.'), textResponse(answer)]
      : [toolCallResponse('read-pattern', 'read_side_context', {}), textResponse('Use Silver Birch.')])
    const { controller } = await mountConversationHost(ctx, adapter)
    if (phase === 'write') {
      const { sessionId: parent } = await controller.create({ cwd: workspace })
      const main = ctx.agents.get(parent)!
      main.followup(createUserMessage({ source: { kind: 'user' }, content: [{ type: 'text', text: 'Write the book.' }] }))
      await main.whenIdle()
      const declaration = adapter.requests[0]?.tools?.find(tool => tool.name === 'read_side_context')
      expect(declaration).toBeDefined()
      const opened = await controller.aside({ sessionId: parent, kind: 'side' })
      const side = ctx.agents.get(opened.sessionId)!
      side.followup(createUserMessage({ source: { kind: 'user' }, content: [{ type: 'text', text: 'Name the cover pattern.' }] }))
      await side.whenIdle()
      expect(await ctx.sessions.flush(main.session)).toBe(true)
      expect(await ctx.sessions.flush(side.session)).toBe(true)
      await writeFile(receipt, JSON.stringify({ parent, declaration }))
      return
    }
    const { parent, declaration } = JSON.parse(await readFile(receipt, 'utf8')) as { parent: SessionId; declaration: object }
    const [side] = (await ctx.sessionQuery.listSessions()).filter(entry => entry.header.parentSession === parent)
    if (!side) throw new Error('Released side discussion is missing')
    using before = await ctx.sessionQuery.observeSession(side.header.id)
    if (phase === 'read') {
      await controller.prompt({ sessionId: parent, requestId: brandString<Branded<'session-request-id'>>('read-saved-side'),
        mode: 'queue', content: [{ type: 'text', text: 'Read the side conversation for the pattern.' }] }, new AbortController().signal)
      const writer = ctx.agents.get(parent)!
      await writer.whenIdle()
      expect(adapter.requests).toHaveLength(2)
      expect(adapter.requests[0]?.tools?.find(tool => tool.name === 'read_side_context')).toEqual(declaration)
      expect(JSON.stringify(adapter.requests[0]?.messages)).not.toContain(answer)
      expect(JSON.stringify(adapter.requests[1]?.messages)).toContain(answer)
      expect(await ctx.sessions.flush(writer.session)).toBe(true)
    } else expect(adapter.requests).toHaveLength(0)
    using main = await ctx.sessionQuery.observeSession(parent)
    const reads = main.events.filter(event => event.type === 'tool/result')
    expect(reads).toHaveLength(1)
    expect(JSON.stringify(reads[0]?.data.message.content)).toContain(answer)
    expect(ctx.agents.get(side.header.id)).toBeUndefined()
    using after = await ctx.sessionQuery.observeSession(side.header.id)
    expect(after.events).toEqual(before.events)
  } finally { await ctx.fiber.dispose() }
}, 30_000)

it('continues a released side conversation with fresh completed parent context after a cold start', async () => {
  const ctx = new Context()
  const parentId = brandString<SessionId>('released-side-parent')
  const receipt = join(directory, 'side-conversation.json')
  const mainQuestion = 'Describe a public garden.'
  const mainAnswer = 'The garden has a fountain.'
  const firstQuestion = 'Suggest a name for the fountain.'
  const firstAnswer = 'The Silver Spring.'
  const mainUpdate = 'The opening date is now September 8.'
  const secondQuestion = 'What name did we choose, and when will the garden open?'
  const secondAnswer = 'The Silver Spring opens September 8.'
  const prompt = (text: string) => createUserMessage({ source: { kind: 'user' }, content: [{ type: 'text', text }] })
  try {
    await ctx.plugin(jsonl, { root: join(directory, 'sessions'), compression: 'zstd' })
    const adapter = new MockAdapter((phase === 'write' ? [mainAnswer, 'The retired discussion is complete.', firstAnswer, mainUpdate] : [secondAnswer]).map(textResponse))
    const { harness, controller, model } = await mountConversationHost(ctx, adapter)
    if (phase === 'write') {
      const main = await harness.create(parentId, model, { cwd: workspace })
      main.followup(prompt(mainQuestion))
      await main.whenIdle()
      const original = await controller.aside({ sessionId: parentId, kind: 'side' })
      const retired = ctx.agents.get(original.sessionId)
      if (!retired) throw new Error('The released Host did not create the initial side conversation')
      retired.followup(prompt('An earlier question in the retired discussion.'))
      await retired.whenIdle()
      const { sessionId } = await controller.resetAside({ sessionId: original.sessionId, cause: 'manual' })
      expect(sessionId).not.toBe(original.sessionId)
      const side = ctx.agents.get(sessionId)
      if (!side) throw new Error('The released Host did not open the side conversation')
      side.session.append('sandbox/mode', { mode: 'read-only' })
      side.session.append('approval/policy', { policy: 'never' })
      side.followup(prompt(firstQuestion))
      await side.whenIdle()
      main.followup(prompt('Record the opening date.'))
      await main.whenIdle()
      expect(adapter.requests).toHaveLength(4)
      expect(JSON.stringify(adapter.requests[1]?.messages)).toContain(mainAnswer)
      expect(JSON.stringify(adapter.requests[3]?.messages)).not.toContain(firstQuestion)
      expect(await ctx.sessions.flush(side.session)).toBe(true)
      expect(await ctx.sessions.flush(main.session)).toBe(true)
      await writeFile(receipt, JSON.stringify({ current: sessionId, retired: original.sessionId }))
      return
    }
    const { current: saved, retired } = JSON.parse(await readFile(receipt, 'utf8')) as { current: SessionId; retired: SessionId }
    const pausePath = join(directory, 'side-clear-budget.sqlite')
    const ledger = await SpendLedger.open(pausePath)
    try {
      ledger.configure({ ...DEFAULT_PREFERENCES, autoResume: false })
      if (phase === 'read') ledger.blockSession(ledger.waitForSession(parentId, MICRO_CNY))
      ledger.blockSession(ledger.waitForSession(saved, MICRO_CNY))
    } finally { ledger.close() }
    await ctx.plugin(spending, { path: pausePath }).await()
    const clearedReceipt = join(directory, 'side-cleared-by-candidate.json')
    const expectedCurrent = phase === 'reopen' ? JSON.parse(await readFile(clearedReceipt, 'utf8')) as SessionId : saved
    using existing = await ctx.sessionQuery.observeSession(saved)
    const lastSideTurn = existing.events.findLast(event => event.type === 'turn/end')
    expect(lastSideTurn?.seq).toBeDefined()
    expect(existing.projections?.values.sessionListMetadata?.side).toEqual({
      generation: 1, fromSeq: existing.inheritedEventCount, asked: true,
      result: { seq: lastSideTurn!.seq, interrupted: false },
    })
    const openings = await Promise.all([1, 2].map(() => controller.aside({ sessionId: parentId, kind: 'side' })))
    expect(openings.map(item => item.sessionId)).toEqual([expectedCurrent, expectedCurrent])
    if (phase === 'read') {
      const otherWriter = await ctx.sessionPersistence.open(saved, 'write')
      try {
        await expect(controller.resetAside({ sessionId: saved, cause: 'manual' })).rejects.toMatchObject({ code: 'session/writer-held' })
        expect(await controller.aside({ sessionId: parentId, kind: 'side' })).toEqual({ sessionId: saved })
      } finally { await otherWriter.close() }
    }
    using retiredLog = await ctx.sessionQuery.observeSession(retired)
    expect(JSON.stringify(retiredLog.events)).toContain('An earlier question in the retired discussion.')
    await expect(controller.prompt({
      sessionId: retired, requestId: brandString<Branded<'session-request-id'>>('retired-side'), mode: 'queue',
      content: [{ type: 'text', text: 'Do not append this to the retired discussion.' }],
    }, new AbortController().signal)).rejects.toMatchObject({ code: 'session/agent-busy', details: { reason: 'side-context-cleared' } })
    expect(ctx.agents.get(retired)).toBeUndefined()
    expect(adapter.requests).toHaveLength(0)
    if (phase === 'read') {
      const mainHandle = await ctx.sessionPersistence.open(parentId, 'write')
      try {
        const { events } = await mainHandle.read()
        const restored = Session.fromRestore(parentId, events, mainHandle.header, mainHandle.inheritedEventCount, 'detached')
        restored.append('turn/start', { turn: 3 })
        restored.append('user/message', prompt('UNFINISHED PRIVATE DRAFT'), { surfaceOp: 'append' })
        await mainHandle.append(restored.snapshotEvents().slice(events.length))
        await mainHandle.flush()
      } finally { await mainHandle.close() }
      const accepted = await controller.prompt({
        sessionId: saved, requestId: brandString<Branded<'session-request-id'>>('continue-side'), mode: 'queue',
        content: [{ type: 'text', text: secondQuestion }],
      }, new AbortController().signal)
      expect(accepted).toEqual({ accepted: true })
      const side = ctx.agents.get(saved)
      if (!side) throw new Error('Candidate did not resume the saved side conversation')
      await side.whenIdle()
      const outgoing = JSON.stringify(adapter.requests.at(-1)?.messages)
      for (const text of [firstQuestion, firstAnswer, mainUpdate, secondQuestion]) expect(outgoing).toContain(text)
      expect(outgoing).not.toContain('UNFINISHED PRIVATE DRAFT')
      expect(outgoing).not.toContain('An earlier question in the retired discussion.')
      expect(await ctx.sessions.flush(side.session)).toBe(true)
    }
    expect((await controller.resetAside({ sessionId: saved, cause: 'close' })).sessionId).toBe(expectedCurrent)
    const reset = await controller.resetAside({ sessionId: saved, cause: 'manual' })
    expect(reset.sessionId).not.toBe(saved)
    if (phase === 'read') await writeFile(clearedReceipt, JSON.stringify(reset.sessionId))
    else expect(reset.sessionId).toBe(expectedCurrent)
    using fresh = await ctx.sessionQuery.observeSession(reset.sessionId)
    expect(fresh.header.parentSession).toBe(parentId)
    expect(fresh.events.findLast(event => event.type === 'sandbox/mode')?.data.mode).toBe('read-only')
    expect(fresh.events.findLast(event => event.type === 'approval/policy')?.data.policy).toBe('never')
    expect(fresh.events.filter(event => event.type === 'user/message' && event.data.source.kind === 'user')).toEqual([])
    await expect.poll(async () => (await ctx.spendLimit.get()).pausedSessions.map(entry => entry.sessionId)).toEqual([parentId])
    await expect(controller.prompt({
      sessionId: saved, requestId: brandString<Branded<'session-request-id'>>('closed-candidate-tab'), mode: 'queue',
      content: [{ type: 'text', text: 'A late submission from a cleared tab.' }],
    }, new AbortController().signal)).rejects.toMatchObject({ code: 'session/agent-busy', details: { reason: 'side-context-cleared' } })
    if (phase === 'reopen') {
      const interrupted = brandString<SessionId>(retired + '-3')
      const partial = Session.create(interrupted)
      partial.append('approval/policy', { policy: 'ask' })
      const interruptedWriter = await ctx.sessionPersistence.create({ ...fresh.header, id: interrupted })
      try {
        await interruptedWriter.append(partial.snapshotEvents())
        await interruptedWriter.flush()
      } finally { await interruptedWriter.close() }
      const result = await controller.resolveAgent(interrupted)
      if ('error' in result) throw result.error
      expect(result.agent.model.current()).toMatchObject(model)
      using recovered = await ctx.sessionQuery.observeSession(interrupted)
      expect(recovered.events.findLast(event => event.type === 'sandbox/mode')?.data.mode).toBe('read-only')
      expect(recovered.events.findLast(event => event.type === 'approval/policy')?.data.policy).toBe('never')
      expect(recovered.events.some(event => event.type === 'user/message')).toBe(false)
    }
    for (const id of [parentId, saved]) {
      using observation = await ctx.sessionQuery.observeSession(id)
      const users = observation.events.filter(event => event.type === 'user/message' && event.data.source.kind === 'user')
      const transcript = JSON.stringify(users)
      if (id === saved) {
        expect(observation.header.parentSession).toBe(parentId)
        expect(transcript).toContain(firstQuestion)
        expect(transcript).toContain(secondQuestion)
        expect(JSON.stringify(observation.events.filter(event => event.type === 'assistant/message'))).toContain(secondAnswer)
      } else {
        expect(transcript).toContain(mainQuestion)
        expect(transcript).not.toContain(firstQuestion)
        expect(transcript).not.toContain(secondQuestion)
      }
    }
  } finally { await ctx.fiber.dispose() }
}, 30_000)

it('recovers a rejected MCP declaration from a released v4 log and reopens the same conversation', async () => {
  await mkdir(workspace, { recursive: true })
  const ctx = new Context()
  const id = brandString<SessionId>('released-notebook-recovery')
  const config = { provider: 'deepseek-account', model: 'deepseek-flash' }
  const clock = { name: 'clock', description: 'Read the date.', parameters: { type: 'object' } }
  const notes = { name: 'mcp__notes__lookup', description: 'Read a label.', parameters: {
    type: 'object', properties: { label: { type: 'string', pattern: '^[^\\uD800-\\uDFFF]*$' } },
  } }
  const userText = (text: string) => createUserMessage({ source: { kind: 'user' }, content: [{ type: 'text', text }] })
  try {
    await ctx.plugin(LocalFileSystem, { cwd: workspace })
    await ctx.plugin(jsonl, { root: join(directory, 'sessions'), compression: 'zstd' })
    if (phase === 'write') {
      const session = Session.create(id)
      session.append('turn/start', { turn: 1 })
      session.append('step/start', { turn: 1, step: 1 })
      session.append('user/message', userText('Remember the label ORCHID.'), { surfaceOp: 'append' })
      session.append('request/header', { reason: 'initial', header: { config, tools: [clock, notes] } })
      session.append('step/end', { turn: 1, step: 1 })
      session.append('turn/end', { turn: 1, reason: { kind: 'error', error: { code: 'INVALID_REQUEST', status: 400, message: 'Invalid schema for function ' + notes.name } } })
      const handle = await ctx.sessionPersistence.create(session.header)
      try { await handle.append(session.snapshotEvents()); await handle.flush() } finally { await handle.close() }
      return
    }
    const handle = await ctx.sessionPersistence.open(id, phase === 'read' ? 'write' : 'read')
    try {
      const { events } = await handle.read()
      const session = Session.fromRestore(id, events, handle.header, handle.inheritedEventCount, 'detached')
      if (phase === 'read') {
        session.append('turn/start', { turn: 2 })
        session.append('step/start', { turn: 2, step: 1 })
        session.append('user/message', userText('Continue without the notebook.'), { surfaceOp: 'append' })
        session.append('request/header', { reason: 'resume', header: { config, tools: [clock] } })
        session.append('developer/message', { turn: 2, step: 1, message: createDeveloperMessage({
          source: { kind: 'tool-registry' }, content: [{ type: 'tool-removal', toolName: notes.name }],
        }) }, { surfaceOp: 'append' })
        session.append('step/end', { turn: 2, step: 1 })
        session.append('turn/end', { turn: 2, reason: { kind: 'completed' } })
        await handle.append(session.snapshotEvents().slice(events.length))
        await handle.flush()
      }
      for (const mode of [undefined, 'addition-only', 'in-history'] as const) {
        const projected = projectToolUpdates(session.deriveMessages(), [clock], mode, session.toolHistory())
        expect(projected.tools).toEqual([clock])
        expect(projected.messages.map(message => message.content)).toEqual([
          [{ type: 'text', text: 'Remember the label ORCHID.' }], [{ type: 'text', text: 'Continue without the notebook.' }],
        ])
      }
    } finally { await handle.close() }
  } finally { await ctx.fiber.dispose() }
})

it('reopens the released workspace index with the same order, membership, pins and archive', async () => {
  const ctx = new Context()
  const home = resolveDshHome()
  expect(home).toBe(join(directory, 'user', '.dsh-uncensored'))
  const first = join(home, 'writing')
  const second = join(home, 'notes')
  const pinned = brandString<SessionId>('pinned-story')
  const archived = brandString<SessionId>('archived-story')
  const receipt = join(home, 'workspace-receipt.json')
  try {
    await ctx.plugin(Storage)
    await ctx.plugin(jsonStorage, { root: join(home, 'storages') })
    await ctx.plugin(domains, { backend: 'json' })
    await ctx.plugin(jsonl, { root: join(home, 'sessions'), compression: 'zstd' })
    if (phase === 'write') {
      await mkdir(first, { recursive: true })
      await mkdir(second, { recursive: true })
      for (const id of [pinned, archived]) {
        const session = Session.create(id)
        session.append('user/message', createUserMessage({ source: { kind: 'user' },
          content: [{ type: 'text', text: 'My writing notes' }] }), { surfaceOp: 'append' })
        const handle = await ctx.sessionPersistence.create({ ...session.header, cwd: first, agentPreset: 'writing' })
        try { await handle.append(session.snapshotEvents()) } finally { await handle.close() }
      }
    }
    await ctx.plugin(WorkspaceRegistry)
    const registry = ctx.workspaceRegistry
    const writing = await registry.resolveByPath(first)
    if (!writing) throw new Error('Workspace of released writing sessions is missing')
    if (phase === 'write') {
      const notes = await registry.create(second, 'Research notes')
      await registry.insertBefore(notes.id, writing.id)
      await writing.insertSessionBefore(archived, pinned)
      await registry.pinSession(pinned)
      await registry.archiveSession(archived)
    }
    const order = registry.list().map(row => ({ id: row.id, title: row.title, path: row.path, members: row.sessionIds }))
    if (phase === 'write') await writeFile(receipt, JSON.stringify(order))
    else expect(order).toEqual(JSON.parse(await readFile(receipt, 'utf8')))
    expect(order[0]?.title).toBe('Research notes')
    expect(writing.sessionIds).toEqual([archived, pinned])
    expect(registry.pinnedSessionIds).toEqual([pinned])
    expect(registry.archivedSessionIds).toEqual(phase === 'reopen' ? [] : [archived])
    if (phase === 'read') await registry.unarchiveSession(archived)
  } finally { await ctx.fiber.dispose() }
}, 30_000)

it('attributes only the new model work after reopening two generations of released forks', async () => {
  const ctx = new Context()
  const ids = ['original', 'child', 'grandchild'].map(value => brandString<SessionId>(value))
  const route = { provider: 'deepseek-official', model: 'deepseek-flash' }
  try {
    await ctx.plugin(SessionStore)
    await ctx.plugin(jsonl, { root: join(directory, 'sessions'), compression: 'zstd' })
    if (phase === 'write') {
      let parent: Session | undefined
      for (const [index, id] of ids.entries()) {
        const turn = index + 1
        const session: Session = parent ? ctx.sessions.fork(parent, undefined, id) : ctx.sessions.create(id)
        session.append('turn/start', { turn })
        session.append('step/start', { turn, step: 1 })
        if (!parent) session.append('request/header', { reason: 'initial', header: { config: route } })
        session.append('assistant/message', { turn, step: 1, stream: [],
          usage: { inputTokens: turn * 100, outputTokens: 20 },
          message: createAssistantMessage({ source: route, content: [{ type: 'text', text: String(id) }] }),
        }, { surfaceOp: 'append' })
        session.append('step/end', { turn, step: 1 })
        session.append('turn/end', { turn, reason: { kind: 'completed' } })
        const writer = await ctx.sessionPersistence.create(session.header, { inheritedEventCount: session.inheritedEventCount })
        try {
          await writer.append(session.snapshotEvents())
          await writer.flush()
        } finally { await writer.close() }
        parent = session
      }
    }
    let previous = 0
    for (const [index, id] of ids.entries()) {
      const handle = await ctx.sessionPersistence.open(id, 'read')
      try {
        const { events } = await handle.read()
        expect(handle.inheritedEventCount).toBe(previous)
        previous = events.length
        expect(events.filter(event => event.type === 'assistant/message')).toHaveLength(index + 1)
        if (phase !== 'write') {
          expect(estimateUsage(events, DEFAULT_RATES, handle.inheritedEventCount)).toMatchObject({
            requests: 1, unpricedRequests: 0, total: [0.00036, 0.00056, 0.00076][index],
          })
        }
      } finally { await handle.close() }
    }
  } finally { await ctx.fiber.dispose() }
}, 30_000)

it('replays the released memory context and prices its separate extraction call once', async () => {
  const ctx = new Context()
  const id = brandString<SessionId>('released-memory-fee')
  const memory = brandString<Branded<'MemoryId'>>('writing-preference')
  const preference = 'Use short sentences.'
  const question = 'Write a paragraph about the city.'
  const context = { kind: 'memory-context', form: 'snapshot', sections: [{ name: 'Memory', text: preference }],
    entries: [{ id: memory, version: 2 }] } as const
  try {
    await ctx.plugin(jsonl, { root: join(directory, 'sessions'), compression: 'zstd' })
    if (phase === 'write') {
      const log = Session.create(id)
      log.append('turn/start', { turn: 1 })
      log.append('user/message', createUserMessage({ source: context, content: [{ type: 'text', text: preference }] }), { surfaceOp: 'append' })
      log.append('user/message', createUserMessage({ source: { kind: 'user' }, content: [{ type: 'text', text: question }] }), { surfaceOp: 'append' })
      log.append('turn/end', { turn: 1, reason: { kind: 'completed' } })
      const request = { requestId: brandString<Branded<'MemoryExtractionId'>>('released-extraction'), turn: 1, throughSeq: 3 }
      log.append('memory/extraction', { ...request, phase: 'request', scope: { global: false, mode: 'writing' },
        provider: 'deepseek-official', model: 'deepseek-flash', maxTokens: 100,
        message: createUserMessage({ source: { kind: 'memory-extraction', form: 'instructions' },
          content: [{ type: 'text', text: 'Extract the writing preference.' }] }) })
      log.append('memory/extraction', { ...request, phase: 'result', outcome: 'completed', saved: [{ id: memory, version: 3 }],
        usage: { inputTokens: 100, outputTokens: 20 } })
      const writer = await ctx.sessionPersistence.create({ ...log.header, agentPreset: 'writing' })
      try { await writer.append(log.snapshotEvents()) } finally { await writer.close() }
    }
    const handle = await ctx.sessionPersistence.open(id, 'read')
    try {
      const { events } = await handle.read()
      expect(events.filter(event => event.type === 'memory/extraction').map(event => event.data.phase)).toEqual(['request', 'result'])
      const log = Session.create(id, events, handle.header, handle.inheritedEventCount)
      expect(log.deriveMessages().map(({ source, content }) => ({ source, content }))).toEqual([
        { source: context, content: [{ type: 'text', text: preference }] },
        { source: { kind: 'user' }, content: [{ type: 'text', text: question }] },
      ])
      expect(estimateUsage(events, DEFAULT_RATES, handle.inheritedEventCount)).toMatchObject({
        requests: 1, unpricedRequests: 0, total: 0.00036, points: [{ total: 0.00036 }],
      })
    } finally { await handle.close() }
  } finally { await ctx.fiber.dispose() }
}, 30_000)

it('opens the released memory collection, preserves disabled records and retains candidate edits after restart', async () => {
  const ctx = new Context()
  const topic = '雾港灯塔'
  const updated = '雾港灯塔使用蓝色灯光。'
  const scope = { global: false, workspace: 'workspace:harbour', mode: 'writing' } as const
  const source = { kind: 'user', confirmed: true } as const
  try {
    await ctx.plugin(Storage)
    await ctx.plugin(jsonStorage, { root: join(directory, 'storages') })
    await ctx.plugin(domains, { backend: 'json' })
    await ctx.plugin(MemoryService, {})
    if (phase === 'write') {
      await ctx.memory.create({ title: topic, content: '雾港灯塔使用白色灯光。', type: 'writing-setting', scope, source })
      const retired = await ctx.memory.create({ title: '旧地址', content: '雾港灯塔位于旧码头。', type: 'writing-setting', scope, source })
      await ctx.memory.setStatus(retired.record.id, 'disabled', retired.record.version)
      return
    }
    expect(ctx.memory.enabled).toBe(false)
    expect(ctx.memory.list()).toHaveLength(2)
    const [record] = ctx.memory.list({ status: 'enabled' })
    if (!record) throw new Error('Missing released memory')
    expect(record).toMatchObject({ title: topic, scope, source })
    expect(ctx.memory.list({ status: 'disabled' }).map(item => item.title)).toEqual(['旧地址'])
    const session = { sessionId: brandString<SessionId>('harbour-chapter'), workspaceKeys: [scope.workspace], mode: scope.mode, freshChild: false }
    expect(ctx.memory.retrieve({ query: topic, scope: session }).text).toContain(record.content)
    expect(ctx.memory.retrieve({ query: topic, scope: { ...session, mode: 'standard' } }).text).toBe('')
    if (phase === 'read') {
      expect(record.version).toBe(1)
      await ctx.memory.update(record.id, { content: updated }, record.version)
    } else {
      expect(record).toMatchObject({ version: 2, content: updated })
    }
  } finally { await ctx.fiber.dispose() }
}, 30_000)

const controller = '@deepseek-ai/dsh-api-workspace-controller'
const observer = 'dshu-profile-observer'

it.runIf(phase === 'write')('retains a desktop profile with an obsolete controller and an external plugin', async () => {
  const profile = join(resolveDshHome(), 'profiles', 'desktop')
  createPluginProfile(profile)
  const stale = join(profile, 'node_modules', controller)
  const external = join(profile, 'node_modules', observer)
  await mkdir(stale, { recursive: true })
  await mkdir(external, { recursive: true })
  await writeFile(join(stale, 'package.json'), JSON.stringify({ name: controller, version: '0.0.1', type: 'module', exports: './index.js' }))
  await writeFile(join(stale, 'index.js'), "throw new Error('Loaded the obsolete profile workspace controller')")
  await writeFile(join(external, 'package.json'), JSON.stringify({
    name: observer, version: '1.0.0', type: 'module', exports: './index.js', dsh: { bundle: { patch: './bundle.yml' } },
  }))
  await writeFile(join(external, 'bundle.yml'), '- insert:\n    - id: dshu-profile-observer\n      name: dshu-profile-observer\n      inject: [webServer, workspaceController]\n')
  await writeFile(join(external, 'index.js'), [
    "import { WorkspaceController } from '@deepseek-ai/dsh-api-workspace-controller'",
    'export function apply(ctx) {',
    "  ctx.effect(() => ctx.webServer.register({ kind: 'exact', path: '/profile-observer',",
    "    handler(_req, res) { res.end(ctx.workspaceController instanceof WorkspaceController ? 'ready' : 'mismatched controller') } }))",
    '}',
  ].join('\n'))
  const path = join(profile, 'package.json')
  const manifest = JSON.parse(await readFile(path, 'utf8'))
  manifest.dependencies = { ...manifest.dependencies, [controller]: '0.0.1', [observer]: '1.0.0' }
  manifest.dsh.profile.bundles.push(observer)
  await writeFile(path, JSON.stringify(manifest))
  await writeFile(join(profile, 'cordis.patch.yml'), '- id: webserver\n  config:\n    host: 127.0.0.1\n    port: 0\n')
})
