+      const reply = policyStatus(error) === 403 ? '403 Forbidden' : '502 Bad Gateway'
+      await new Promise<void>((resolve) => { socket.end(`HTTP/1.1 ${reply}\r\n\r\n`, () => { resolve() }) })
