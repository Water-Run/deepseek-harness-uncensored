+++ b/packages/mcp/rea/src/header-identification.ts
@@ -0,0 +1,107 @@
+/**
+ * Model-visible file identity from supplied header bytes. This operation has no filesystem or process access.
+ * @module
+ */
+import type { Context } from '@deepseek-ai/cordis'
+import { ToolArgsError, defineTool } from '@deepseek-ai/dsh-tools'
+import { readMachoHeaderPrefixFacts } from 'rea-agents/dist/domain/apple/machoContainer.js'
+import { machoArchitectureName } from 'rea-agents/dist/domain/apple/machoCpuIdentity.js'
+import { readElfFixedHeader } from 'rea-agents/dist/domain/elfFixedHeader.js'
+import { readPeCoffHeader } from 'rea-agents/dist/domain/peCoffHeader.js'
+import { decodePeMachine } from 'rea-agents/dist/domain/peMachine.js'
+import type {} from '@deepseek-ai/dsh-system-prompt'
+import type {} from './index.ts'
+
+function headerFromMessage(text: string): string {
+  const blocks: string[][] = []
+  let current: string[] | undefined
+  for (const line of text.split(/\r?\n/u)) {
+    const trimmed = line.trim()
+    if (/^[a-f\d \t]+$/iu.test(trimmed) || /^[a-f\d]+:\s/iu.test(trimmed) || (trimmed === '*' && current)) {
+      if (!current) { current = []; blocks.push(current) }
+      current.push(trimmed)
+    } else {
+      current = undefined
+    }
+  }
+  const [header] = blocks
+  if (!header || blocks.length !== 1) throw new ToolArgsError(['Paste one hex or xxd dump on its own lines in the current message.'])
+  if (!header.some(line => line.includes(':'))) return header.join(' ')
+
+  let hex = ''
+  for (const line of header) {
+    const [, offset = '', contents = ''] = /^([a-f\d]{8,16}): (.+)$/iu.exec(line) ?? []
+    if (Number.parseInt(offset, 16) !== hex.length / 2) {
+      throw new ToolArgsError(['Use consecutive xxd rows starting at offset zero.'])
+    }
+    const [column = ''] = contents.split(/ {2,}/u, 1)
+    const groups = column.split(' ')
+    if (!groups.every(group => /^(?:[a-f\d]{2}){1,2}$/iu.test(group))) {
+      throw new ToolArgsError(['Paste standard xxd output or use xxd -g 1.'])
+    }
+    hex += groups.join('')
+    if (hex.length > 8192) throw new ToolArgsError(['Supply up to 4096 hexadecimal bytes.'])
+  }
+  return hex
+}
+
+function identify(input: string) {
+  if (input.length > 12_288) throw new ToolArgsError(['Supply up to 4096 hexadecimal bytes.'])
+  const hex = input.replace(/\s/gu, '')
+  if (hex.length === 0 || hex.length > 8192 || hex.length % 2 || /[^a-f\d]/iu.test(hex)) {
+    throw new ToolArgsError(['Supply complete hexadecimal byte pairs, optionally separated by whitespace.'])
+  }
+  const bytes = Buffer.from(hex, 'hex')
+  if (hex.toLowerCase().startsWith('7f454c46')) {
+    const header = readElfFixedHeader(bytes)
+    if (!header.ok) throw new ToolArgsError([header.error])
+    return { format: 'ELF', machine: header.value.machine, architecture: header.value.architecture }
+  }
+  if (bytes[0] === 0x4d && bytes[1] === 0x5a) {
+    if (bytes.length < 64) throw new ToolArgsError(['The DOS header is incomplete.'])
+    const offset = bytes.readUInt32LE(60)
+    if (offset < 64 || offset + 4 > bytes.length) throw new ToolArgsError(['The prefix does not contain the PE signature.'])
+    if (bytes.readUInt32LE(offset) === 0x4550) {
+      const header = readPeCoffHeader(bytes.subarray(offset + 4))
+      if (!header.ok) throw new ToolArgsError([header.error.message])
+      const machine = decodePeMachine(header.value.machine)
+      return { format: 'PE', machine: header.value.machine, architecture: machine && !machine.nativeOsOverride ? machine.architecture : null }
+    }
+  }
+  const macho = readMachoHeaderPrefixFacts(bytes)
+  if (macho.format !== null) {
+    if (macho.identity === null) throw new ToolArgsError(['Supply the first 12 bytes of the Mach-O header to identify its CPU.'])
+    const { cpuType, cpuSubtype } = macho.identity
+    const name = machoArchitectureName(cpuType, cpuSubtype)
+    return { format: 'Mach-O', machine: cpuType, architecture: name.startsWith('cpu-') ? null : name }
+  }
+  return { format: null, machine: null, architecture: null }
+}
+
+/** Register REA's fixed-header reader in the first model request while the integration is enabled.
+ * @param ctx - Scope owning the tools and REA preference.
+ */
+export function registerHeaderIdentification(ctx: Context): void {
+  ctx.inject(['systemPrompt'], (scope) => {
+    scope.effect(() => scope.systemPrompt.section({
+      name: 'rea:file-identification',
+      order: scope.systemPrompt.getSectionOrder('TOOL_READ'),
+      text: ({ scope: agent }) => scope.rea.options.enabled && scope.tools.get('rea_identify_header', agent) !== undefined
+        ? 'Use rea_identify_header for format or CPU questions about a pasted executable header. Ask for its hex or xxd prefix if the message has no bytes.'
+        : '',
+    }))
+  })
+  ctx.effect(() => ctx.tools.register(defineTool({
+    name: 'rea_identify_header',
+    description: 'Identify the file format and declared CPU architecture of ELF, Windows PE, or single-architecture Mach-O from a hex prefix or standard xxd output in the current user message.',
+    parameters: {},
+    output: { schema: { type: 'json' }, render: (_args, value) => [{ type: 'text', text: JSON.stringify(value) }] },
+    execute(_args, { agent }) {
+      if (!ctx.rea.options.enabled) throw new ToolArgsError(['REA is disabled in settings.'])
+      const message = agent?.session.deriveMessages().findLast(item => item.role === 'user' && item.source.kind === 'user')
+      if (!message) throw new ToolArgsError(['A current user message with a hex dump is required.'])
+      const text = message.content.flatMap(part => part.type === 'text' ? [part.text] : []).join('\n\n')
+      return Promise.resolve(identify(headerFromMessage(text)))
+    },
+  }), { when: () => ctx.rea.options.enabled }))
+}
diff --git a/packages/mcp/rea/src/index.ts b/packages/mcp/rea/src/index.ts
new file mode 100644
index 00000000..bb86694e
--- /dev/null
+++ b/packages/mcp/rea/src/index.ts
@@ -0,0 +1,137 @@
+/** REA launch preferences and owned external connections. @module */
+import { Context, Service, type Volatile } from '@deepseek-ai/cordis'
+import z from '@deepseek-ai/schemastery'
+import type {} from '@deepseek-ai/cordis-plugin-loader'
+import { ReaConnection } from './connection.ts'
+import { resolveReaLaunch } from './launch.ts'
+import type { ReaOptions, ReaExecutionLease } from './types.ts'
+
+export type { ReaOptions, ReaProbe, ReaExecutionLease } from './types.ts'
+
+declare module '@deepseek-ai/cordis' {
+  interface Context { /** REA connection owner and persisted launch preferences. */ rea: ReaService }
+}
+
+/** Launch preferences; blank paths use the bundled REA and application runtime. */
+interface LiveOptions {
+  /** Permit Reverse conversations to start REA. */
+  enabled: Volatile<boolean>
+  /** Physical Node executable path. */
+  nodePath: Volatile<string>
+  /** Physical REA entry path. */
+  cliPath: Volatile<string>
+  /** Optional Ghidra installation directory. */
+  ghidraPath: Volatile<string>
+  /** Optional Java home directory. */
+  javaHome: Volatile<string>
+  /** Optional IDA MCP configuration path. */
+  idaConfig: Volatile<string>
+  /** Native analysis engine selection. */
+  provider: Volatile<ReaOptions['provider']>
+  /** MCP startup deadline in milliseconds. */
+  startupTimeoutMs: Volatile<number>
+  /** External call deadline in milliseconds. */
+  toolTimeoutMs: Volatile<number>
+  /** Maximum entries returned on one discovery page. */
+  catalogPageSize: Volatile<number>
+}
+type ServiceConfig = Partial<ReaOptions> | LiveOptions
+export const Config: z<Partial<ReaOptions>, LiveOptions> = z.object({
+  enabled: z.boolean().default(true).volatile(), nodePath: z.string().default('').volatile(), cliPath: z.string().default('').volatile(),
+  ghidraPath: z.string().default('').volatile(), javaHome: z.string().default('').volatile(), idaConfig: z.string().default('').volatile(),
+  provider: z.union(['auto', 'ghidra', 'ida', 'hopper', 'kuna']).default('auto').volatile(),
+  startupTimeoutMs: z.natural().min(1000).max(600000).default(60000).volatile(),
+  toolTimeoutMs: z.natural().min(1000).max(3600000).default(180000).volatile(),
+  catalogPageSize: z.natural().min(1).max(100).default(20).volatile(),
+})
+
+/** Root owner; changing configuration closes old connections before replacement. */
+export default class ReaService extends Service {
+  static Config = Config
+  private readonly config: LiveOptions
+  /** Loader entry that owns these preferences, absent in unconfigured test contexts. */
+  readonly namespace: string | undefined
+  private readonly connections = new Set<ReaConnection>()
+  private stopped = false
+  private reconfiguring: Promise<void> = Promise.resolve()
+
+  /** Current owner preferences, read from Loader-managed live fields. */
+  get options(): ReaOptions {
+    const config = this.config
+    return { enabled: config.enabled.get(), nodePath: config.nodePath.get(), cliPath: config.cliPath.get(),
+      ghidraPath: config.ghidraPath.get(), javaHome: config.javaHome.get(), idaConfig: config.idaConfig.get(),
+      provider: config.provider.get(), startupTimeoutMs: config.startupTimeoutMs.get(),
+      toolTimeoutMs: config.toolTimeoutMs.get(), catalogPageSize: config.catalogPageSize.get() }
+  }
+
+  /**
+   * @param ctx - Host root context with Loader ownership.
+   * @param config - Owner-selected executable paths and timeouts.
+   */
+  constructor(ctx: Context, config: ServiceConfig = {}) {
+    super(ctx, 'rea')
+    this.config = typeof config.enabled === 'object' ? config : Config(config)
+    this.namespace = ctx.fiber.entry?.options.id
+    let previous = JSON.stringify(this.options)
+    ctx.on('loader/volatile-update', () => {
+      const current = JSON.stringify(this.options)
+      if (current === previous) return
+      previous = current
+      this.reconfiguring = this.closeConnections()
+      void this.reconfiguring.catch((error: unknown) => { ctx.logger.error('REA configuration could not close old connections: %o', error) })
+    })
+    ctx.effect(() => async () => {
+      this.stopped = true
+      await this.reconfiguring
+      await this.closeConnections()
+    }, 'rea.connections')
+  }
+
+  private async closeConnections(): Promise<void> {
+    const owned = [...this.connections]
+    const results = await Promise.allSettled(owned.map(async (connection) => {
+      await connection.close(); this.connections.delete(connection)
+    }))
+    const errors: unknown[] = []
+    for (const result of results) if (result.status === 'rejected') errors.push(result.reason)
+    if (errors.length > 0) throw new AggregateError(errors, 'REA processes did not all close')
+  }
+
+  /** @returns An executor-owned lease, or no extra policy for the ordinary provider. */
+  protected acquireExecution(): ReaExecutionLease | undefined { return undefined }
+
+  /**
+   * Launch one connection, rolling back on cancellation or startup failure.
+   * @param cwd - Absolute workspace or temporary probe directory.
+   * @param signal - Cancellation of connection acquisition.
+   * @returns Connection and disposer; caller must release it with its own lifetime.
+   */
+  async connect(cwd: string, signal: AbortSignal): Promise<{ connection: ReaConnection; dispose: () => Promise<void> }> {
+    await this.reconfiguring
+    if (this.stopped) throw new Error('REA service is stopping')
+    if (!this.options.enabled) throw new Error('REA is disabled. Configure it in Reverse settings.')
+    signal.throwIfAborted()
+    const execution = this.acquireExecution()
+    let connection: ReaConnection
+    try { connection = new ReaConnection(resolveReaLaunch(this.options), cwd, execution, (error) => { this.ctx.logger.error('REA execution could not close: %o', error) }) }
+    catch (error) { execution?.release(); throw error }
+    this.connections.add(connection)
+    const dispose = async (): Promise<void> => { await connection.close(); this.connections.delete(connection) }
+    let cancellation: Promise<void> | undefined
+    const cancel = (): void => { cancellation = dispose(); void cancellation.catch(() => {}) }
+    signal.addEventListener('abort', cancel, { once: true })
+    try {
+      await connection.ready
+      signal.throwIfAborted()
+      this.assertRunning()
+      return { connection, dispose }
+    } catch (error) {
+      await (cancellation ?? dispose())
+      throw error
+    } finally { signal.removeEventListener('abort', cancel) }
+  }
+
+  private assertRunning(): void {
+    if (this.stopped) throw new Error('REA service is stopping')
+  }
+}
diff --git a/packages/mcp/rea/src/launch.ts b/packages/mcp/rea/src/launch.ts
