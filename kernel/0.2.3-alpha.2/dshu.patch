+  const ledger = await setup()
+  enable(ledger, false)
+  ledger.settle(reservation(ledger.reserve(4 * MICRO_CNY)), 4 * MICRO_CNY)
+  expect(ledger.reserve(2 * MICRO_CNY).kind).toBe('waiting')
+  expect(ledger.snapshot().paused).toBe(true)
+  ledger.configure({ ...ledger.snapshot().preferences, enabledPeriods: ['5h'] })
+  expect(ledger.reserve(2 * MICRO_CNY).kind).toBe('reserved')
+})
+
+it('keeps recovery manual when a dead reservation becomes an uncertain charge', async () => {
+  const directory = await mkdtemp(join(tmpdir(), 'dshu-spending-dead-charge-')); directories.push(directory)
+  const path = join(directory, 'budget.sqlite')
+  let now = 1000
+  const previous = await setup(path, () => now)
+  enable(previous, false)
+  reservation(previous.reserve(4 * MICRO_CNY))
+  const id = previous.waitForSession(SessionId('blocked-by-reservation'), 2 * MICRO_CNY)
+  previous.close()
+  const next = await setup(path, () => now)
+  expect(next.claimBlockedSessions()).toEqual([])
+  expect(next.snapshot().paused).toBe(true)
+  now += 900001
+  expect(next.claimBlockedSessions()).toEqual([])
+  next.resume()
+  expect(next.claimBlockedSessions()).toEqual([{ id, sessionId: 'blocked-by-reservation' }])
+})
+
+it('rejects a corrupt recovery record while opening without discarding it', async () => {
+  const directory = await mkdtemp(join(tmpdir(), 'dshu-spending-corrupt-pause-')); directories.push(directory)
+  const path = join(directory, 'budget.sqlite')
+  const previous = await setup(path)
+  previous.waitForSession(SessionId('corrupt-pause'), MICRO_CNY)
+  previous.close()
+  const db = new DatabaseSync(path)
+  try { db.prepare("UPDATE session_pauses SET ticket = ''").run() }
+  finally { db.close() }
+  await expect(SpendLedger.open(path)).rejects.toThrow()
+  const inspect = new DatabaseSync(path)
+  try { expect(inspect.prepare('SELECT ticket FROM session_pauses').get()?.ticket).toBe('') }
+  finally { inspect.close() }
+})
diff --git a/packages/guard/spend-limit/tests/process.spec.ts b/packages/guard/spend-limit/tests/process.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6cc45530a5d75bb83cd020154af502fd6a04690e
--- /dev/null
+++ b/packages/guard/spend-limit/tests/process.spec.ts
@@ -0,0 +1,38 @@
+import { expect, it } from 'vitest'
+import { fork } from 'node:child_process'
+import { once } from 'node:events'
+import { mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { SpendLedger, DEFAULT_PREFERENCES } from '../src/ledger.ts'
+
+it('atomically excludes competing reservations from independent processes', async () => {
+  const directory = await mkdtemp(join(tmpdir(), 'dshu-budget-process-'))
+  const path = join(directory, 'spending.sqlite')
+  const ledger = await SpendLedger.open(path)
+  const peers: { child: ReturnType<typeof fork>; closed: Promise<[number | null, NodeJS.Signals | null]> }[] = []
+  try {
+    ledger.configure({ ...DEFAULT_PREFERENCES, enabledPeriods: ['15m', '1h', '5h', '1d', '7d', '30d'], autoResume: true })
+    const started = [0, 1].map(() => {
+      const child = fork(fileURLToPath(new URL('./fixtures/process-ledger.ts', import.meta.url)), [path], {
+        execArgv: ['--import', 'tsx/esm'], env: { ...process.env, TSX_TSCONFIG_PATH: join(process.cwd(), 'tsconfig.base.json') }, stdio: ['ignore', 'ignore', 'inherit', 'ipc'],
+      })
+      const closed = new Promise<[number | null, NodeJS.Signals | null]>((resolve) => { child.once('exit', (code, signal) => { resolve([code, signal]) }) })
+      peers.push({ child, closed })
+      return once(child, 'message')
+    })
+    expect((await Promise.all(started)).map((reply): unknown => reply[0])).toEqual(['ready', 'ready'])
+    const admitted = peers.map(({ child }) => { const reply = once(child, 'message'); child.send('reserve'); return reply })
+    expect((await Promise.all(admitted)).map((reply): unknown => reply[0]).sort()).toEqual(['reserved', 'waiting'])
+    expect(ledger.snapshot().windows[0]?.reserved).toBe(4)
+    for (const { child } of peers) child.send('finish')
+    expect(await Promise.all(peers.map(peer => peer.closed))).toEqual([[0, null], [0, null]])
+    expect(ledger.snapshot().windows[0]?.reserved).toBe(0)
+  } finally {
+    for (const { child } of peers) if (child.exitCode === null && child.signalCode === null) child.kill()
+    await Promise.all(peers.map(peer => peer.closed))
+    ledger.close()
+    await rm(directory, { recursive: true, force: true })
+  }
+})
diff --git a/packages/guard/spend-limit/tests/recovery.spec.ts b/packages/guard/spend-limit/tests/recovery.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..01e4339d2ab1e380ebe3f692cdd88631b97444aa
--- /dev/null
+++ b/packages/guard/spend-limit/tests/recovery.spec.ts
@@ -0,0 +1,89 @@
+import { afterEach, expect, it, vi } from 'vitest'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import { SpendGate } from '../src/gate.ts'
+import { SpendLedger, MICRO_CNY } from '../src/ledger.ts'
+import type { SpendPauseClaim } from '../src/ledger.ts'
+import { SpendRecovery } from '../src/continuation.ts'
+import { DEFAULT_RATES } from '../src/pricing.ts'
+
+const owned: { recovery: SpendRecovery; gate: SpendGate }[] = []
+afterEach(async () => { for (const { recovery, gate } of owned.splice(0)) { await recovery.close(); await gate.close() } })
+
+async function fixture() {
+  const ledger = await SpendLedger.open(':memory:')
+  const gate = new SpendGate(ledger, DEFAULT_RATES, 50, () => true)
+  const report = vi.fn()
+  const recovery = new SpendRecovery(report)
+  owned.push({ recovery, gate })
+  const id = ledger.waitForSession(SessionId('paused'), MICRO_CNY)
+  ledger.blockSession(id)
+  return { ledger, gate, recovery, report, id }
+}
+
+it('leaves records durable without a provider, on unavailable sessions, and on reported failures', async () => {
+  const { ledger, gate, recovery, report, id } = await fixture()
+  await recovery.flush(gate)
+  expect(ledger.snapshot().pausedSessions).toHaveLength(1)
+  const handler = vi.fn(async () => 'unavailable' as const)
+  const remove = recovery.register(handler, () => true)
+  await recovery.flush(gate)
+  expect(handler).toHaveBeenCalledWith({ id, sessionId: 'paused' }, expect.any(AbortSignal))
+  expect(ledger.snapshot().pausedSessions).toHaveLength(1)
+  handler.mockRejectedValueOnce(new Error('restore failed'))
+  await recovery.flush(gate)
+  expect(report).toHaveBeenCalledWith(expect.objectContaining({ message: 'restore failed' }))
+  expect(ledger.snapshot().pausedSessions).toHaveLength(1)
+  await remove()
+  recovery.register(async () => 'missing', () => true)
+  await recovery.flush(gate)
+  expect(ledger.snapshot().pausedSessions).toEqual([])
+})
+
+it('serializes recovery and drains a cancelled provider before releasing the ledger', async () => {
+  const { ledger, gate, recovery } = await fixture()
+  const entered = Promise.withResolvers<undefined>(), released = Promise.withResolvers<undefined>()
+  const handler = vi.fn(async (_claim: SpendPauseClaim, signal: AbortSignal) => {
+    entered.resolve(undefined)
+    await released.promise
+    signal.throwIfAborted()
+    return 'missing' as const
+  })
+  const remove = recovery.register(handler, () => true)
+  const first = recovery.flush(gate)
+  let removing: Promise<void> | undefined
+  try {
+    await vi.waitFor(() => { expect(handler).toHaveBeenCalledOnce() })
+    await entered.promise
+    expect(recovery.flush(gate)).toBe(first)
+    let removed = false
+    removing = remove().then(() => { removed = true })
+    await Promise.resolve()
+    expect(removed).toBe(false)
+    expect(ledger.snapshot().pausedSessions).toHaveLength(1)
+  } finally { released.resolve(undefined); await removing; await first }
+  expect(handler).toHaveBeenCalledOnce()
+  expect(ledger.snapshot().pausedSessions).toHaveLength(1)
+  expect(ledger.claimBlockedSessions()).toHaveLength(1)
+})
+
+it('skips a withdrawn pause while another restoration in the same batch is pending', async () => {
+  const { ledger, gate, recovery } = await fixture()
+  const secondId = ledger.waitForSession(SessionId('other-paused'), MICRO_CNY)
+  ledger.blockSession(secondId)
+  const release = Promise.withResolvers<undefined>()
+  const handler = vi.fn(async (_claim: SpendPauseClaim) => {
+    await release.promise
+    return 'missing' as const
+  })
+  recovery.register(handler, () => true)
+  const running = recovery.flush(gate)
+  try {
+    await vi.waitFor(() => { expect(handler).toHaveBeenCalledOnce() })
+    const first = handler.mock.calls[0]![0].sessionId
+    ledger.clearSession(SessionId(first === 'paused' ? 'other-paused' : 'paused'))
+    release.resolve(undefined)
+    await running
+    expect(handler).toHaveBeenCalledOnce()
+    expect(ledger.snapshot().pausedSessions).toEqual([])
+  } finally { release.resolve(undefined); await running }
+})
diff --git a/packages/guard/spend-limit/tests/session-usage.spec.ts b/packages/guard/spend-limit/tests/session-usage.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..09c9bbdcf32a0825e5acd7faf541a31427c1817e
--- /dev/null
+++ b/packages/guard/spend-limit/tests/session-usage.spec.ts
@@ -0,0 +1,59 @@
+import { expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import SessionStore, { SessionLogOffset, SessionSeq } from '@deepseek-ai/dsh-session'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import { RetryId } from '@deepseek-ai/dsh-llm-retry'
+import { sessionSpendUsage } from '../src/session-usage.ts'
+import { DEFAULT_RATES } from '../src/pricing.ts'
+
+const header = (seq: number, model = 'deepseek-flash'): SessionEvent<'request/header'> => ({
+  seq: SessionSeq(seq), time: seq * 1000, type: 'request/header',
+  data: { reason: 'initial', header: { config: { provider: 'deepseek-official', model } } },
+})
+const attempt = (seq: number, step = 1, input = 100): SessionEvent<'assistant/attempt'> => ({
+  seq: SessionSeq(seq), time: seq * 1000, type: 'assistant/attempt',
+  data: { turn: 1, step, stream: [{ type: 'chunk', time: 0, chunk: { type: 'usage', usage: { inputTokens: input, outputTokens: 20 } } }] },
+})
+
+it('replaces a repeated usage settlement and counts a real retry separately', () => {
+  const events: SessionEvent[] = [header(0), attempt(1), attempt(2),
+    { seq: SessionSeq(3), time: 3000, type: 'llm/retry-started', data: { turn: 1, step: 1, retry: 1, retryId: RetryId('retry') } },
+    attempt(4),
+  ]
+  const result = sessionSpendUsage(events, DEFAULT_RATES, SessionLogOffset(0))
+  expect(result).toMatchObject({ total: 0.00072, requests: 2, unpricedRequests: 0 })
+  expect(result.points).toEqual([{ time: 2000, total: 0.00036 }, { time: 4000, total: 0.00072 }])
+})
+
+it('excludes inherited work and reports unknown routes without inventing fees', () => {
+  const events: SessionEvent[] = [header(0), attempt(1),
+    { seq: SessionSeq(2), time: 2000, type: 'session/end-seed', data: { inherited: true } },
+    header(3, 'unpriced-model'), attempt(4, 2), header(5), attempt(6, 3),
+  ]
+  expect(sessionSpendUsage(events, DEFAULT_RATES, SessionLogOffset(2))).toMatchObject({ total: 0.00036, requests: 2, unpricedRequests: 1 })
+})
+
+it('charges only the grandchild after two real forks and keeps the inherited route', async () => {
+  const ctx = new Context()
+  try {
+    await ctx.plugin(SessionStore)
+    const root = ctx.sessions.create()
+    root.append('request/header', header(0).data)
+    root.append('assistant/attempt', attempt(1).data)
+    const parent = ctx.sessions.fork(root)
+    parent.append('assistant/attempt', attempt(0, 2).data)
+    const child = ctx.sessions.fork(parent)
+    child.append('assistant/attempt', attempt(0, 3).data)
+    const usage = sessionSpendUsage(child.snapshotEvents(), DEFAULT_RATES, child.inheritedEventCount)
+    expect(usage).toMatchObject({ total: 0.00036, requests: 1, unpricedRequests: 0 })
+    expect(usage.points).toHaveLength(1)
+  } finally { await ctx.fiber.dispose() }
+})
+
+it('bounds curve payloads while preserving the exact total and end points', () => {
+  const events = [header(0), ...Array.from({ length: 1000 }, (_, index) => attempt(index + 1, index + 1))]
+  const result = sessionSpendUsage(events, DEFAULT_RATES, SessionLogOffset(0))
+  expect(result.total).toBe(0.36)
+  expect(result.points).toHaveLength(240)
+  expect(result.points.at(-1)).toEqual({ time: 1_000_000, total: 0.36 })
+})
