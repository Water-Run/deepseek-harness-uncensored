@@ -0,0 +1,53 @@
+/**
+ * Bundled component identity, resolved from the values the client build seals
+ * into the artifact. A component whose metadata is absent from the build is
+ * omitted rather than shown with a guessed version.
+ */
+export interface ReleaseComponent {
+  readonly name: string
+  readonly repository: string
+  readonly version: string
+  readonly commit: string
+  readonly time: string
+  readonly license: string
+}
+
+/**
+ * Read one component's identity from the sealed client environment.
+ * @param name - display name of the bundled component.
+ * @param build - repository URL, version, commit, commit time, and license fields.
+ * @returns the component identity, or undefined when the build omits it.
+ */
+function bundled(
+  name: string,
+  build: {
+    repository: string | undefined
+    version: string | undefined
+    commit: string | undefined
+    time: string | undefined
+    license: string | undefined
+  },
+): ReleaseComponent | undefined {
+  const { repository, version, commit, time, license } = build
+  if (repository === undefined || version === undefined || commit === undefined
+    || time === undefined || license === undefined) return undefined
+  return { name, repository, version, commit, time, license }
+}
+
+/** Components this build actually ships, in display order. */
+export const releaseComponents: readonly ReleaseComponent[] = [
+  bundled('dsh-purge Community', {
+    repository: process.env.DSH_CLIENT_PURGE_REPOSITORY,
+    version: process.env.DSH_CLIENT_PURGE_VERSION,
+    commit: process.env.DSH_CLIENT_PURGE_COMMIT,
+    time: process.env.DSH_CLIENT_PURGE_DATE,
+    license: process.env.DSH_CLIENT_PURGE_LICENSE,
+  }),
+  bundled('REA', {
+    repository: process.env.DSH_CLIENT_REA_REPOSITORY,
+    version: process.env.DSH_CLIENT_REA_VERSION,
+    commit: process.env.DSH_CLIENT_REA_COMMIT,
+    time: process.env.DSH_CLIENT_REA_DATE,
+    license: process.env.DSH_CLIENT_REA_LICENSE,
+  }),
+].filter((component): component is ReleaseComponent => component !== undefined)
