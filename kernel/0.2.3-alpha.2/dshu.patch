@@ -0,0 +1,46 @@
+/** A reopened Writing session retains its historical turn and accepts an explicit manual invocation. */
+import { readFile } from 'node:fs/promises'
+import { LlmAdapter, createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { GenerateOptions, StreamChunk } from '@deepseek-ai/dsh-llm'
+import { expect, it } from 'vitest'
+import { launchWebScaffold, parseSeedFixture, readPersistedEvents, realizeSeedFixture, renderSeedFixture, seedSession } from './scaffold.ts'
+
+class Writer extends LlmAdapter {
+  override async listModels(provider: string) { return [{ provider, id: 'writer', name: 'Writer' }] }
+  override async *stream(_request: GenerateOptions): AsyncIterable<StreamChunk> {
+    yield { type: 'block-start', index: 0, blockType: 'text' }
+    yield { type: 'block-end', index: 0, block: { type: 'text', text: 'Read the voice sample aloud.' } }
+    yield { type: 'finish', reason: { kind: 'stop' } }
+  }
+}
+
+it('reopens a Writing session and records its next manual invocation', async () => {
+  const scaffold = await launchWebScaffold()
+  try {
+    const { ctx } = scaffold
+    ctx.effect(() => ctx.llm.registerAdapter(['writing-test'], new Writer()), 'writing snapshot adapter')
+    const fixture = await readFile(new URL('../../../snapshots/web/writing-manual-reopen/session.v4.jsonl', import.meta.url), 'utf8')
+    const id = await seedSession(scaffold, fixture, 'writing-manual-reopen', 'writing')
+    const realized = realizeSeedFixture(scaffold, fixture, id)
+    const { headerLine, events } = parseSeedFixture(realized)
+    expect(renderSeedFixture(headerLine, await readPersistedEvents(scaffold, id))).toBe(realized)
+
+    await ctx.sessionController.selectModel({ sessionId: id, provider: 'writing-test', model: 'writer' })
+    const resolved = await ctx.sessionController.resolveAgent(id)
+    if ('error' in resolved) throw resolved.error
+    const { agent } = resolved
+    expect(ctx.agentPresets.composedPreset(agent.ctx)).toBe('writing')
+    agent.followup(createUserMessage({ content: [{ type: 'text', text: '/writing-style-reference\nContinue revising the voice.' }], source: { kind: 'user' } }))
+    await agent.whenIdle()
+    const log = await readPersistedEvents(scaffold, id)
+    expect(renderSeedFixture(headerLine, log.slice(0, events.length))).toBe(realized)
+    const invocations = log.flatMap(event => event.type === 'user/message' && event.data.source.kind === 'skill-invocation' ? [event.data] : [])
+    expect(invocations).toHaveLength(1)
+    const invocation = invocations[0]
+    expect(invocation?.source).toMatchObject({ kind: 'skill-invocation', name: 'writing-style-reference', form: 'instructions' })
+    expect(invocation?.content).toHaveLength(1)
+    const block = invocation?.content[0]
+    expect(block?.type === 'text' && block.text).toContain('references/style-card.md')
+    expect(log.at(-1)).toMatchObject({ type: 'turn/end', data: { turn: 2, reason: { kind: 'completed' } } })
+  } finally { await scaffold.close() }
+}, 90_000)
