@@ -0,0 +1,46 @@
+// @vitest-environment jsdom
+import { expect, it, vi } from 'vitest'
+import { SessionId } from '@deepseek-ai/dsh-session/types'
+import { AsideReads } from '../src/client/asides/read-status.ts'
+
+const parent = SessionId('print-workshop')
+const first = SessionId('session-side-' + 'a'.repeat(64))
+const second = SessionId(first + '-1')
+const key = 'dshu.aside.read.' + parent
+
+it('preserves released receipts and rejects delayed acknowledgements after a clear', () => {
+  const reads = new AsideReads()
+  localStorage.setItem(key, JSON.stringify({ child: first, seq: 99 }))
+  try {
+    const stream = reads.for(parent)
+    const changed = vi.fn()
+    const release = stream.subscribe(changed)
+    expect(stream.getSnapshot()).toEqual({ child: first, seq: 99 })
+    expect(stream.getSnapshot()).toBe(stream.getSnapshot())
+    reads.mark(parent, first, 4)
+    expect(changed).not.toHaveBeenCalled()
+    reads.mark(parent, second, 3)
+    reads.mark(parent, first, 120)
+    expect(changed).toHaveBeenCalledTimes(1)
+    expect(stream.getSnapshot()).toEqual({ child: second, seq: 3 })
+    release()
+    reads.mark(parent, second, 4)
+    expect(changed).toHaveBeenCalledTimes(1)
+    localStorage.setItem(key, 'malformed')
+    expect(stream.getSnapshot()).toBeNull()
+  } finally { localStorage.removeItem(key) }
+})
+
+it('remembers a visible result in the current window when storage is unavailable', () => {
+  const reads = new AsideReads()
+  const load = vi.spyOn(Storage.prototype, 'getItem').mockImplementation(() => { throw new Error('Storage unavailable') })
+  const save = vi.spyOn(Storage.prototype, 'setItem').mockImplementation(() => { throw new Error('Storage unavailable') })
+  try {
+    const stream = reads.for(parent)
+    expect(stream.getSnapshot()).toBeNull()
+    reads.mark(parent, first, 7)
+    expect(stream.getSnapshot()).toEqual({ child: first, seq: 7 })
+    reads.sync(new StorageEvent('storage', { key: null }))
+    expect(stream.getSnapshot()).toBeNull()
+  } finally { load.mockRestore(); save.mockRestore() }
+})
diff --git a/packages/client/ui-commands/tests/aside-reasoning.client.spec.tsx b/packages/client/ui-commands/tests/aside-reasoning.client.spec.tsx
