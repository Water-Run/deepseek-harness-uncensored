+/** Client entry points and subscriptions for a main conversation's persistent side discussion. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { SessionReference } from '@deepseek-ai/dsh-api-session-controller/client'
+import type { ResourceProvider } from '@deepseek-ai/dsh-client-resources/client'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import { remoteErrorOf, RemoteError } from '@deepseek-ai/dsh-typert-protocol'
+import { ASIDE_PREFIX, asideParent } from './address.ts'
+import { AsideGuideIcon, AsideIcon } from './AsideIcon.tsx'
+import { AsideReads } from './read-status.ts'
+import { SideConversation, SideLauncher, SidePanel, SideTitle } from './SidePanel.tsx'
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface ResourceProtocolMap {
+    /** Current child Session, or null while the panel switches to a replacement. */
+    aside: SessionReference | null
+  }
+  interface SlotMap {
+    /** Right-sidebar transcript and composer provided with the persistent child Session. */
+    'sidebar.aside.conversation': { kind: 'single'; scope: 'session' }
+  }
+}
+
+const tabType = '@deepseek-ai/dsh-client-ui-commands/aside'
+
+/** Register the sidebar tab, main header shortcut and slash command.
+ * @param ctx - Command plugin's Client context.
+ */
+export function registerSideConversations(ctx: Context): void {
+  ctx.inject(['slots', 'locale', 'sessions', 'commandUi', 'resources', 'sidebarRight', 'sidebarRightTabs', 'remote.session'], (scope) => {
+    const t = scope.locale.bind('command')
+    const reads = new AsideReads()
+    scope.effect(() => {
+      const sync = (event: StorageEvent) => { reads.sync(event) }
+      window.addEventListener('storage', sync)
+      return () => { window.removeEventListener('storage', sync) }
+    }, 'side conversation: synchronize read positions')
+    const bindings = new Map<SessionId, {
+      ready: Promise<SessionReference>
+      lifetime: AbortController
+      changed: AbortController
+      holders: number
+    }>()
+    const tabTargets = new Map<SessionId, Promise<SessionId>>()
+    const activeParents = new Map<SessionId, { parent: SessionId; reference: SessionReference }>()
+    const resets = new Map<SessionId, Promise<void>>()
+    const shutdown = new AbortController()
+    const currentSide = async (parent: SessionId): Promise<SessionId> => {
+      if (resets.has(parent)) await resets.get(parent)
+      shutdown.signal.throwIfAborted()
+      const result = await scope.remote.session.aside({ sessionId: parent, kind: 'side' })
+      if (!result.ok) throw result.error
+      return result.value.sessionId
+    }
+    const connect = async (parent: SessionId, target: Promise<SessionId>, signal: AbortSignal): Promise<SessionReference> => {
+      const id = await target
+      signal.throwIfAborted()
+      const reference = scope.sessions.retain(id, { source: 'aside', publishedByHost: true, facets: { conversation: true }, signal })
+      activeParents.set(id, { parent, reference })
+      signal.addEventListener('abort', () => {
+        if (activeParents.get(id)?.reference === reference) activeParents.delete(id)
+        reference.release()
+      }, { once: true })
+      await reference.ready
+      return reference
+    }
+    const acquire = (parent: SessionId, signal?: AbortSignal) => {
+      let binding = bindings.get(parent)
+      if (!binding) {
+        const lifetime = new AbortController()
+        const target = currentSide(parent)
+        tabTargets.set(parent, target)
+        binding = { ready: connect(parent, target, lifetime.signal), lifetime, changed: new AbortController(), holders: 0 }
+        bindings.set(parent, binding)
+      }
+      const current = binding
+      current.holders++
+      let held = true
+      const release = () => {
+        if (!held) return
+        held = false
+        signal?.removeEventListener('abort', release)
+        if (--current.holders === 0) {
+          if (bindings.get(parent) === current) bindings.delete(parent)
+          current.lifetime.abort()
+        }
+      }
+      signal?.addEventListener('abort', release, { once: true })
+      return { ready: current.ready, changed: current.changed.signal, [Symbol.dispose]: release }
+    }
+    scope.effect(() => () => {
+      shutdown.abort()
+      for (const binding of bindings.values()) binding.lifetime.abort()
+      bindings.clear()
+      tabTargets.clear()
+    }, 'side conversation: release Sessions')
+    const invalidate = (parent: SessionId) => {
+      const binding = bindings.get(parent)
+      bindings.delete(parent)
+      binding?.changed.abort()
+    }
+    scope.effect(() => scope.remote.$on('api-session/side-reset', invalidate), 'side conversation: new context')
+    const reset = (parent: SessionId, target: Promise<SessionId> | SessionId, cause: 'manual' | 'close') => {
+      const previous = resets.get(parent)
+      const previousBinding = bindings.get(parent)
+      const operation = (async () => {
+        await previous
+        const old = await target
+        shutdown.signal.throwIfAborted()
+        let current: SessionId
+        try {
+          const result = await scope.remote.session.resetAside({ sessionId: old, cause })
+          if (!result.ok) throw result.error
+          current = result.value.sessionId
+        } catch (error) {
+          if (cause === 'close' || shutdown.signal.aborted) throw error
+          const observed = await scope.remote.session.aside({ sessionId: parent, kind: 'side' })
+          if (!observed.ok || observed.value.sessionId === old) throw error
+          current = observed.value.sessionId
+        }
+        if (current !== old && bindings.get(parent) === previousBinding) invalidate(parent)
+      })().catch((_resetFailed: unknown) => {
+        if (shutdown.signal.aborted) return
+        const context = scope.sessions.scope(typeof target === 'string' ? target : parent) ?? scope.sessions.scope(parent)
+        if (context) context.get('conversation')?.input.for(context).notify('error', t(cause === 'close' ? 'aside.autoClearFailed' : 'aside.clearFailed'))
+        invalidate(parent)
+      })
+      resets.set(parent, operation)
+      if (cause === 'manual') invalidate(parent)
+      void operation.then(() => { if (resets.get(parent) === operation) resets.delete(parent) })
+    }
+    let previousTabs = scope.sidebarRight.openTabs.getSnapshot()
+    scope.effect(() => scope.sidebarRight.openTabs.subscribe(() => {
+      const current = scope.sidebarRight.openTabs.getSnapshot()
+      const open = new Set(current.filter(tab => tab.kind === 'aside').map(tab => tab.sessionId))
+      for (const tab of previousTabs) {
+        if (tab.kind !== 'aside' || open.has(tab.sessionId)) continue
+        const target = tabTargets.get(tab.sessionId)
+        tabTargets.delete(tab.sessionId)
+        if (target !== undefined) {
+          reset(tab.sessionId, target, 'close')
+          invalidate(tab.sessionId)
+        }
+      }
+      previousTabs = current
+    }), 'side conversation: actual tab closures')
+    const provider: ResourceProvider<'aside'> = {
+      protocol: 'aside',
+      async *open(address, { signal }) {
+        const parent = asideParent(address)
+        if (parent === undefined) {
+          yield { ok: false, error: new RemoteError('gateway/bad-request', t('aside.failed'), {}) }
+          return
+        }
+        let displayed: Disposable | undefined
+        try {
+          while (!signal.aborted) {
+            if (displayed) yield { ok: true, value: null }
+            const lease = acquire(parent, signal)
+            try {
+              const reference = await lease.ready
+              signal.throwIfAborted()
+              const wake = AbortSignal.any([signal, lease.changed])
+              if (wake.aborted) continue
+              const previous = displayed
+              displayed = lease
+              try { yield { ok: true, value: reference } }
+              finally { previous?.[Symbol.dispose]() }
+              await new Promise<void>((resolve) => {
+                if (wake.aborted) resolve()
+                else wake.addEventListener('abort', () => { resolve() }, { once: true })
+              })
+            } finally {
+              if (lease !== displayed) lease[Symbol.dispose]()
+            }
+          }
+        } catch (error) {
+          if (!signal.aborted) yield { ok: false, error: remoteErrorOf(error) ?? new RemoteError('gateway/internal', t('aside.failed'), {}) }
+        } finally { displayed?.[Symbol.dispose]() }
+      },
+    }
+    scope.effect(() => scope.resources.register(provider), 'side conversation: resource')
+    const open = () => { scope.sidebarRight.openTab('aside') }
+    scope.effect(() => scope.sidebarRightTabs.register({
+      id: tabType, kind: 'aside', priority: 'builtin', patterns: [`${ASIDE_PREFIX}**`],
+      title: () => t('aside.side'), canOpen: address => asideParent(address) !== undefined,
+      guide: [{ id: 'aside', order: 30, title: () => t('aside.side'), description: () => t('aside.sideDescription'), icon: AsideGuideIcon }],
+    }), 'side conversation: tab')
+    scope.slots.inject('conversation.session.header.utilities', () => scope.slots.register({
+      name: 'conversation.session.header.utilities', id: 'side-question', order: 100, locale: 'command', inject: (parent: SessionId) => ({ open, hooks: { asideRead: reads.for(parent) } }),
+    }, SideLauncher))
+    scope.slots.inject('sidebar.right.pane.tab', () => scope.slots.register({
+      name: 'sidebar.right.pane.tab', key: tabType, locale: 'command',
+      inject: (parent: SessionId) => ({
+        clear: (child: SessionId) => { reset(parent, child, 'manual') },
+        markRead: (child: SessionId, seq: number) => { reads.mark(parent, child, seq) },
+      }),
+      children: { 'sidebar.aside.conversation': { kind: 'single', scope: 'session' } },
+    }, SidePanel))
+    scope.slots.inject('sidebar.aside.conversation', () => scope.slots.register({ name: 'sidebar.aside.conversation', locale: 'command' }, SideConversation))
+    scope.slots.inject('sidebar.right.pane.tab.title', () => scope.slots.register({
+      name: 'sidebar.right.pane.tab.title', key: tabType, locale: 'command',
+      inject: (parent: SessionId) => ({ hooks: { asideRead: reads.for(parent) } }),
+    }, SideTitle))
+    scope.effect(() => scope.commandUi.register({
+      name: 'clear', label: () => t('aside.clear'), description: () => t('aside.clearDescription'), icon: AsideIcon,
+      available: session => activeParents.has(session.sessionId),
+      ui: { kind: 'action', run: (session) => {
+        const parent = activeParents.get(session.sessionId)?.parent
+        if (parent !== undefined) reset(parent, session.sessionId, 'manual')
+      } },
+    }), 'side conversation: /clear')
+    scope.effect(() => scope.commandUi.register({
+      name: 'side', label: () => t('aside.side'), description: () => t('aside.sideDescription'), icon: AsideIcon,
+      available: session => session.sessionId === scope.sidebarRight.mounted.getSnapshot(),
+      ui: { kind: 'input', attachments: true, runEmpty: open, hint: () => t('aside.placeholder'),
+        submit: async (session, question, attachments = []) => {
+          const images = attachments.filter(part => part.type === 'image')
+          if (images.length !== attachments.length) return { kind: 'error', text: t('aside.imageOnly') }
+          open()
+          using lease = acquire(session.sessionId)
+          try {
+            const side = await lease.ready
+            const content = question.trim() ? [...images, { type: 'text' as const, text: question }] : images
+            if (content.length === 0) return { kind: 'success' }
+            const result = await side.binding.session.prompt(content, 'queue')
+            if (!result.ok) throw result.error
+            return { kind: 'success' }
+          } catch (error) {
+            const failure = remoteErrorOf(error)
+            const unsupported = failure?.code === 'session/attachment-invalid' && failure.details.reason === 'MODEL_DOES_NOT_SUPPORT_IMAGES'
+            return { kind: 'error', text: t(unsupported ? 'aside.imageModelUnsupported' : 'aside.submitFailed') }
+          }
+        },
+      },
+    }), 'side conversation: /side')
+  })
+}
