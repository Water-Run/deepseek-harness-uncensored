+  const trigger = screen.getByRole('button', { name: 'Spending limits: 5h 98%' })
+  trigger.focus()
+  fireEvent.click(trigger)
+  await waitFor(() => { expect(document.activeElement).toBe(screen.getByRole('button', { name: 'Settings' })) })
