+  { name: 'multicast', subnets: [[[0xff00, 0, 0, 0, 0, 0, 0, 0], 8]] },
+  { name: 'loopback', subnets: [[[0, 0, 0, 0, 0, 0, 0, 1], 128]] },
+  { name: 'uniqueLocal', subnets: [[[0xfc00, 0, 0, 0, 0, 0, 0, 0], 7]] },
+  { name: 'ipv4Mapped', subnets: [[[0, 0, 0, 0, 0, 0xffff, 0, 0], 96]] },
