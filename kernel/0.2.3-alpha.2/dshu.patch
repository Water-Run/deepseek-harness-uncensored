+      let received = 0
+      socket.on('data', (chunk: Buffer) => { sent += chunk.byteLength })
+      remote.on('data', (chunk: Buffer) => { received += chunk.byteLength })
+      socket.write('HTTP/1.1 200 Connection Established\r\n\r\n')
+      if (head.byteLength > 0) remote.write(head)
+      socket.pipe(remote)
+      remote.pipe(socket)
