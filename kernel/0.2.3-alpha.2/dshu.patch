--- /dev/null
+++ b/apps/desktop/scripts/dshu-release-feed.mjs
@@ -0,0 +1,24 @@
+/** Select the fork's public release feed for production installers. */
+import { resolveDesktopAutoUpdateConfig } from '@deepseek-ai/dsh-desktop-publisher/desktop-auto-update-environment.mjs'
+
+/** Public GitHub repository for staged attachments and production installer configuration. */
+export const DSHU_RELEASE_REPOSITORY = 'Water-Run/deepseek-harness-uncensored'
+
+/**
+ * Choose the public GitHub feed for supported production installers or keep the configured test feed.
+ * @param {NodeJS.ProcessEnv} env - Validated packaging settings.
+ * @param {NodeJS.Platform} platform - Installer platform.
+ * @param {string} arch - Installer architecture.
+ * @returns {{ channel: 'stable' | 'nightly', publicUrl: string, environment: 'production' | 'test', github: boolean } | undefined}
+ * Feed settings for the packaged application, if the platform has one.
+ */
+export function resolvePackagedUpdate(env, platform, arch) {
+  const production = env.DSH_DESKTOP_AUTO_UPDATE_ENV?.trim() === 'production'
+  if (production && ((arch === 'arm64' && (platform === 'linux' || platform === 'darwin'))
+    || (arch === 'x64' && (platform === 'linux' || platform === 'win32')))) {
+    return { channel: 'stable', publicUrl: 'https://github.com/' + DSHU_RELEASE_REPOSITORY + '/releases/latest/download/',
+      environment: 'production', github: true }
+  }
+  if (platform === 'linux') return undefined
+  return { ...resolveDesktopAutoUpdateConfig(env, platform, arch), github: false }
+}
