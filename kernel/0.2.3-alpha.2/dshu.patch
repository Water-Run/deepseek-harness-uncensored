+      let failed = false
+      const finish = (): void => {
+        if (recorded) return
+        recorded = true
+        socket.destroy()
+        remote.destroy()
+        this.record({
+          at: started,
+          kind: 'tunnel',
+          origin: 'proxy',
+          sessionId: this.options.sessionId,
+          tool: this.options.tool(),
