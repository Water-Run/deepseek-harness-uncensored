@@ -0,0 +1,39 @@
+/** Model and permission settings copied when publishing or recovering a native side conversation. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { Agent, ModelSelection } from '@deepseek-ai/dsh-agent'
+import { ReasoningEffortId } from '@deepseek-ai/dsh-llm'
+import { setSandboxMode } from '@deepseek-ai/dsh-sandbox-policy'
+import type { SessionObservation } from '@deepseek-ai/dsh-session-query'
+import { setApprovalPolicy } from '@deepseek-ai/dsh-user-approval'
+
+/** Read a conversation's latest selected model and reasoning level.
+ * @param ctx - Host services for active and default selections.
+ * @param source - Conversation supplying the new context's settings.
+ * @returns Selection for the new Agent.
+ */
+export function inheritedModel(ctx: Context, source: SessionObservation): ModelSelection {
+  const route = ctx.agents.get(source.header.id)?.model.current() ?? source.projections?.values.modelSelection?.next
+    ?? source.events.findLast(event => event.type === 'request/header')?.data.header.config
+  return route === undefined ? ctx.agentDefaultModel.currentSelection() : {
+    provider: route.provider, model: route.model,
+    ...(route.reasoningEffort === undefined ? {} : { reasoningEffort: ReasoningEffortId(route.reasoningEffort) }),
+  }
+}
+
+/** Install the side's permission settings before recording its first model selection.
+ * @param ctx - Unpublished Agent scope with the deployment's permission presets.
+ * @param agent - Exact child being initialized.
+ * @param source - Main conversation or outgoing side generation.
+ */
+export function inheritSidePermissions(ctx: Context, agent: Agent, source: SessionObservation): void {
+  const preset = source.projections?.values.permissions?.currentValue
+  if (preset !== undefined && preset !== 'custom') {
+    const presets = ctx.get('permissionPresets')
+    if (!presets) throw new Error('The recorded permission preset is unavailable.')
+    presets.set(agent.session, preset)
+  }
+  const sandbox = source.events.findLast(event => event.type === 'sandbox/mode')
+  if (sandbox !== undefined) setSandboxMode(agent.session, sandbox.data.mode)
+  const approval = source.events.findLast(event => event.type === 'approval/policy')
+  if (approval !== undefined) setApprovalPolicy(agent.session, approval.data.policy)
+}
