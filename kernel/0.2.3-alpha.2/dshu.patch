@@ -0,0 +1,79 @@
+import type { Context } from '@deepseek-ai/cordis'
+import type {} from '@deepseek-ai/dsh-api-remotes/client'
+import type {} from '@deepseek-ai/dsh-client-ui-sidebar-right/client'
+import type {} from '@deepseek-ai/dsh-client-ui-settings/client'
+import { IconNewChatOutlineRegular } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import { InlineAsideController } from './controller.ts'
+import { InlineAsidePanel, QuickAnswer, type InlineAsideInjected } from './QuickAnswer.tsx'
+import { AsideReasoningRow } from './ReasoningSettings.tsx'
+import { AsideClearController } from './clear-settings.ts'
+import { AsideClearRow } from './ClearSettings.tsx'
+import { AsideReasoningController, type BtwReasoningEffort } from './reasoning-settings.ts'
+
+declare module '@deepseek-ai/dsh-api-session-controller/client' {
+  interface SessionReferenceSourceMap { aside: unknown }
+}
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface SlotMap {
+    /** Independent quick question displayed above the parent Session's composer. */
+    'conversation.input.aside': { kind: 'single'; scope: 'session' }
+  }
+}
+
+function registerAsideSettings(ctx: Context): void {
+  ctx.inject(['slots', 'locale', 'remote.settings'], (scope) => {
+    const reasoning = new AsideReasoningController(scope.remote.settings)
+    const clearing = new AsideClearController(scope.remote.settings)
+    scope.slots.inject('settings.general.item', () => scope.slots.register({
+      name: 'settings.general.item', id: 'side-clear-on-close', order: 41, locale: 'command',
+      inject: () => ({ load: () => clearing.load(), save: (value: boolean) => clearing.save(value) }),
+    }, AsideClearRow))
+    scope.slots.inject('settings.general.item', () => scope.slots.register({
+      name: 'settings.general.item', id: 'quick-question-reasoning', order: 40, locale: 'command',
+      inject: () => ({
+        load: () => reasoning.load(),
+        save: (value: BtwReasoningEffort) => reasoning.save(value),
+      }),
+    }, AsideReasoningRow))
+  })
+}
+
+/** Register the inline question command, result panel and reasoning preference.
+ * @param ctx - Command plugin's Client context.
+ */
+export function registerQuickQuestions(ctx: Context): void {
+  registerAsideSettings(ctx)
+  ctx.inject(['slots', 'locale', 'sessions', 'commandUi', 'sidebarRight', 'remote.session'], (scope) => {
+    const t = scope.locale.bind('command')
+    const inline = new InlineAsideController(async (parent) => {
+      const result = await scope.remote.session.aside({ sessionId: parent, kind: 'btw' })
+      if (!result.ok) throw result.error
+      const reference = scope.sessions.retain(result.value.sessionId, { source: 'aside', publishedByHost: true, facets: { conversation: true } })
+      try { await reference.ready; return reference }
+      catch (error) { reference.release(); throw error }
+    }, async (reference, question) => {
+      const result = await reference.binding.session.prompt([{ type: 'text', text: question }], 'queue')
+      if (!result.ok) throw result.error
+    })
+    scope.effect(() => () => inline.dispose(), 'quick question: release child sessions')
+    scope.slots.inject('conversation.input.dock', () => scope.slots.register({
+      name: 'conversation.input.dock', id: 'btw', order: -20, locale: 'command',
+      children: { 'conversation.input.aside': { kind: 'single', scope: 'session' } },
+      inject: (parent: SessionId): InlineAsideInjected => ({
+        hooks: { inlineAside: inline.state }, close: () => { inline.hide(parent) },
+      }),
+    }, InlineAsidePanel))
+    scope.slots.inject('conversation.input.aside', () => scope.slots.register({
+      name: 'conversation.input.aside',
+    }, QuickAnswer))
+    scope.effect(() => scope.commandUi.register({ name: 'btw',
+      label: () => t('aside.btw'), description: () => t('aside.btwDescription'), icon: IconNewChatOutlineRegular,
+      available: session => session.sessionId === scope.sidebarRight.mounted.getSnapshot(),
+      ui: { kind: 'input', hint: () => t('aside.btwHint'), submit: async (session, question) => {
+        if (!question.trim()) return { kind: 'error', text: t('aside.btwRequired') }
+        return await inline.ask(session.sessionId, question) ? { kind: 'success' } : { kind: 'error', text: t('aside.submitFailed') }
+      } },
+    }), 'quick question: /btw')
+  })
+}
diff --git a/packages/client/ui-commands/src/client/asides/read-status.ts b/packages/client/ui-commands/src/client/asides/read-status.ts
new file mode 100644
index 00000000..ddb06697
--- /dev/null
+++ b/packages/client/ui-commands/src/client/asides/read-status.ts
@@ -0,0 +1,132 @@
+/** Read position of the most recently viewed side result for each main conversation. */
+import type { ObservableSnapshot } from '@deepseek-ai/dsh-client-store'
+import type { SessionListMetadata } from '@deepseek-ai/dsh-api-session-controller/types'
+import type { SessionListState } from '@deepseek-ai/dsh-api-session-controller/client'
+import { SessionId } from '@deepseek-ai/dsh-session/types'
+
+const PREFIX = 'dshu.aside.read.'
+type Receipt = { readonly child: SessionId; readonly seq: number }
+
+function sideIdentityParts(id: SessionId): { base: string; generation: number } | undefined {
+  const match = /^(session-side-[0-9a-f]{64})(?:-([1-9][0-9]*))?$/u.exec(id)
+  const base = match?.[1]
+  if (!base) return undefined
+  const generation = Number(match[2] ?? 0)
+  return Number.isSafeInteger(generation) ? { base, generation } : undefined
+}
+
+function decode(raw: string | null): Receipt | null {
+  let value: unknown
+  try {
+    value = JSON.parse(raw ?? 'null')
+  } catch (_invalidReceipt) {
+    return null
+  }
+  if (value && typeof value === 'object' && 'child' in value && typeof value.child === 'string' && sideIdentityParts(SessionId(value.child)) !== undefined
+    && 'seq' in value && typeof value.seq === 'number' && Number.isSafeInteger(value.seq) && value.seq >= 0) {
+    return { child: SessionId(value.child), seq: value.seq }
+  }
+  return null
+}
+
+/** Browser-local read positions shared by a parent's sidebar and launcher. */
+export class AsideReads {
+  private readonly changes = new EventTarget()
+  private readonly unsaved = new Map<SessionId, string>()
+
+  private load(parent: SessionId): string | null {
+    const fallback = this.unsaved.get(parent)
+    if (fallback !== undefined) return fallback
+    try { return localStorage.getItem(PREFIX + parent) }
+    catch (_storageUnavailable) { return null }
+  }
+
+  /**
+   * Observe the last result read in this browser.
+   * @param parent - Main Session.
+   * @returns Its read position and a subscription scoped to the mounted view.
+   */
+  for(parent: SessionId): ObservableSnapshot<Receipt | null> {
+    let raw: string | null = null
+    let receipt: Receipt | null = null
+    return {
+      getSnapshot: () => {
+        const next = this.load(parent)
+        if (next !== raw) { raw = next; receipt = decode(next) }
+        return receipt
+      },
+      subscribe: (listener) => {
+        this.changes.addEventListener(PREFIX + parent, listener)
+        this.changes.addEventListener('clear', listener)
+        return () => {
+          this.changes.removeEventListener(PREFIX + parent, listener)
+          this.changes.removeEventListener('clear', listener)
+        }
+      },
+    }
+  }
+
+  /**
+   * Record a result once the visible panel has received it.
+   * @param parent - Main Session.
+   * @param child - Viewed side generation.
+   * @param seq - Sequence of the finished turn.
+   */
+  mark(parent: SessionId, child: SessionId, seq: number): void {
+    const previous = decode(this.load(parent))
+    if (previous) {
+      if (previous.child === child && previous.seq >= seq) return
+      // A delayed acknowledgement from a retired panel may arrive after another window read its successor.
+      const seen = sideIdentityParts(previous.child)
+      const incoming = sideIdentityParts(child)
+      if (seen && incoming && seen.base === incoming.base && seen.generation > incoming.generation) return
+    }
+    const receipt = JSON.stringify({ child, seq })
+    try {
+      localStorage.setItem(PREFIX + parent, receipt)
+      this.unsaved.delete(parent)
+    } catch (_storageUnavailable) { this.unsaved.set(parent, receipt) }
+    this.changes.dispatchEvent(new Event(PREFIX + parent))
+  }
+
+  /**
+   * Notify mounted views when another window updates a receipt.
+   * @param event - Browser storage change.
+   */
+  sync(event: StorageEvent): void {
+    if (event.key === null) {
+      this.unsaved.clear()
+      this.changes.dispatchEvent(new Event('clear'))
+    } else if (event.key.startsWith(PREFIX)) {
+      this.unsaved.delete(SessionId(event.key.slice(PREFIX.length)))
+      this.changes.dispatchEvent(new Event(event.key))
+    }
+  }
+}
+
+/**
+ * Read the side status from the newest available summary.
+ * @param list - Session summaries.
+ * @param child - Side identity.
+ * @returns The generation and latest finished turn, when available.
+ */
+export function sideMetadata(list: SessionListState, child: SessionId | undefined): SessionListMetadata['side'] {
+  if (child === undefined) return undefined
+  return (list.projectionsBySession[child]?.values.sessionListMetadata ?? list.byId[child]?.projectionValues?.sessionListMetadata)?.side
+}
+
+/**
+ * Select the current side discussion, including an empty successor.
+ * @param list - Session summaries.
+ * @param parent - Main Session.
+ * @returns The newest confirmed side identity.
+ */
+export function newestSide(list: SessionListState, parent: SessionId): SessionId | undefined {
+  let current: SessionId | undefined, generation = -1
+  for (const id of list.ids) {
+    if (list.byId[id]?.parentId !== parent) continue
+    const next = sideMetadata(list, id)?.generation ?? sideIdentityParts(id)?.generation
+    if (next !== undefined && next > generation) { current = id; generation = next }
+  }
+  return current
+}
diff --git a/packages/client/ui-commands/src/client/asides/reasoning-settings.ts b/packages/client/ui-commands/src/client/asides/reasoning-settings.ts
new file mode 100644
index 00000000..e950714a
--- /dev/null
+++ b/packages/client/ui-commands/src/client/asides/reasoning-settings.ts
@@ -0,0 +1,96 @@
+/**
+ * Quick-question reasoning preference. The level lives in the Host
+ * session-controller settings namespace as a live (volatile) field, so the
+ * same value that Settings shows is what the next /btw child is created with.
+ */
+
+import type {
+  SettingsDescribeValue, SettingsNamespaceView,
+} from '@deepseek-ai/dsh-settings/types'
+import type { RemoteResult } from '@deepseek-ai/dsh-typert-protocol'
+import type { JsonValue } from '@deepseek-ai/dsh-util-values'
+
+/** Levels the quick question may select; 'low' is the Host default. */
+export type BtwReasoningEffort = 'off' | 'low' | 'high' | 'max'
+
+/** Ordered levels offered by the settings row. */
+export const BTW_REASONING_EFFORTS: readonly BtwReasoningEffort[] = ['off', 'low', 'high', 'max']
+
+/** Settings field name inside the session-controller namespace. */
+const EFFORT_FIELD = 'btwReasoningEffort'
+
+/** The narrowed settings Remote surface this row consumes. */
+export interface SettingsRemoteFace {
+  describe(): Promise<RemoteResult<SettingsDescribeValue>>
+  update(ns: string, patch: Record<string, JsonValue>, expectedRevision?: number): Promise<RemoteResult<SettingsNamespaceView>>
+}
+
+/** Row state after a read or write. */
+export interface AsideReasoningSnapshot {
+  status: 'loading' | 'ready' | 'saving' | 'unavailable' | 'error'
+  value: BtwReasoningEffort
+  writable: boolean
+}
+
+/** Narrow an arbitrary JSON value to a plain object. */
+function isRecord(value: JsonValue | undefined): value is Record<string, JsonValue> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+/** Read a stored level, falling back to the Host default. */
+function effortOf(value: JsonValue | undefined): BtwReasoningEffort {
+  return typeof value === 'string' && (BTW_REASONING_EFFORTS as readonly string[]).includes(value)
+    ? value as BtwReasoningEffort
+    : 'low'
+}
+
+/** Reads and writes the live setting through the settings Remote namespace. */
+export class AsideReasoningController {
+  private namespace: string | undefined
+  private revision: number | undefined
+  private accepted: BtwReasoningEffort = 'low'
+
+  /** @param settings - the settings Remote namespace. */
+  constructor(private readonly settings: SettingsRemoteFace) {}
+
+  /**
+   * Locate the namespace that owns the field and read its current level.
+   * The namespace id is discovered from the field instead of assuming one
+   * profile entry name, so renamed entries keep the row working.
+   * @returns the row snapshot.
+   */
+  async load(): Promise<AsideReasoningSnapshot> {
+    const result = await this.settings.describe()
+    if (!result.ok) return { status: 'unavailable', value: 'low', writable: false }
+    const view = result.value.namespaces.find(entry => isRecord(entry.value) && Object.hasOwn(entry.value, EFFORT_FIELD))
+    if (view === undefined) return { status: 'unavailable', value: 'low', writable: false }
+    this.namespace = view.ns
+    this.revision = view.revision
+    this.accepted = effortOf((view.value as Record<string, JsonValue>)[EFFORT_FIELD])
+    return { status: 'ready', value: this.accepted, writable: result.value.writable }
+  }
+
+  /**
+   * Persist one level with revision fencing and project the accepted value back.
+   * @param value - selected level.
+   * @returns the row snapshot after the write.
+   */
+  async save(value: BtwReasoningEffort): Promise<AsideReasoningSnapshot> {
+    if (this.namespace === undefined) return { status: 'unavailable', value, writable: false }
+    const accepted = this.accepted
+    let response = await this.settings.update(this.namespace, { [EFFORT_FIELD]: value }, this.revision)
+    if (!response.ok && response.error.code === 'settings/conflict') {
+      const current = await this.load()
+      if (current.status !== 'ready' || !current.writable || current.value === value) return current
+      if (current.value === accepted) response = await this.settings.update(this.namespace, { [EFFORT_FIELD]: value }, this.revision)
+      else return { ...current, status: 'error' }
+    }
+    if (!response.ok) {
+      const current = await this.load()
+      return { status: 'error', value: this.accepted, writable: current.writable }
+    }
+    this.revision = response.value.revision
+    this.accepted = isRecord(response.value.value) ? effortOf(response.value.value[EFFORT_FIELD]) : value
+    return { status: 'ready', value: this.accepted, writable: true }
+  }
+}
