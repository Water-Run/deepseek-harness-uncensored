index 00000000..54ef3e2c
--- /dev/null
+++ b/apps/desktop/scripts/verify-linux-debian-archive.ts
@@ -0,0 +1,99 @@
+/** Check critical files in the Linux Debian package without installing it. */
+import { spawn } from 'node:child_process'
+import { open, type FileHandle } from 'node:fs/promises'
+import { resolve } from 'node:path'
+import type { Readable } from 'node:stream'
+import { pipeline } from 'node:stream/promises'
+import { getPath7za } from 'app-builder-lib/out/toolsets/7zip.js'
+import { compareLinuxArchiveFiles, LINUX_APPLICATION_DIRECTORY, readLinuxArchiveFiles } from './verify-linux-portable-archive.ts'
+
+const LABEL = 'Linux Debian package'
+const APPLICATION_PREFIX = `${LINUX_APPLICATION_DIRECTORY}/`
+const AR_MAGIC = Buffer.from('!<arch>\n')
+
+async function dataMember(file: FileHandle): Promise<{ start: number; end: number; xz: boolean }> {
+  const magic = Buffer.alloc(AR_MAGIC.length)
+  const identifying = await file.read(magic, 0, magic.length, 0)
+  if (identifying.bytesRead !== magic.length || !magic.equals(AR_MAGIC)) throw new Error(LABEL + ': invalid archive signature')
+  const { size } = await file.stat()
+  const header = Buffer.alloc(60)
+  let offset = magic.length
+  while (offset + header.length <= size) {
+    const read = await file.read(header, 0, header.length, offset)
+    const sizeField = header.toString('latin1', 48, 58).trim()
+    if (read.bytesRead !== header.length || header[58] !== 0x60 || header[59] !== 0x0a || !/^\d+$/u.test(sizeField)) {
+      throw new Error(LABEL + ': invalid member header')
+    }
+    const bytes = Number(sizeField)
+    const start = offset + header.length
+    if (bytes > size - start) throw new Error(LABEL + ': member exceeds the package size')
+    const name = header.toString('latin1', 0, 16).trim().replace(/\/$/u, '')
+    if (name === 'data.tar' || name === 'data.tar.gz' || name === 'data.tar.xz') {
+      if (bytes === 0) throw new Error(LABEL + ': empty data member')
+      return { start, end: start + bytes - 1, xz: name === 'data.tar.xz' }
+    }
+    offset = start + bytes + bytes % 2
+  }
+  throw new Error(LABEL + ': expected a tar, gzip or XZ data member')
+}
+
+async function readXzData(source: Readable, tool: string): ReturnType<typeof readLinuxArchiveFiles> {
+  const child = spawn(tool, ['x', '-txz', '-si', '-so', '-bd', '-bso0', '-bsp0', '-bse2'], { windowsHide: true })
+  let diagnostics = ''
+  child.stderr.on('data', (chunk: Buffer) => { diagnostics = (diagnostics + chunk.toString('utf8')).slice(-16384) })
+  const closed = new Promise<void>((resolveExit, reject) => {
+    child.once('error', reject)
+    child.once('close', (code, signal) => {
+      if (code === 0 && signal === null) resolveExit()
+      else reject(new Error(LABEL + ': XZ reader failed: ' + (diagnostics.trim() || String(code ?? signal))))
+    })
+  })
+  const work = [
+    readLinuxArchiveFiles(child.stdout, LABEL, APPLICATION_PREFIX),
+    closed,
+    pipeline(source, child.stdin),
+  ] as const
+  try {
+    const [files] = await Promise.all(work)
+    return files
+  } catch (error) {
+    child.kill()
+    await Promise.allSettled(work)
+    throw error
+  }
+}
+
+/**
+ * Read critical file fingerprints from the assembled application's Debian package.
+ * @param archive - Debian package produced by Desktop packaging.
+ * @returns Verified file fingerprints relative to the package's application directory.
+ */
+export async function readLinuxDebianFiles(archive: string): ReturnType<typeof readLinuxArchiveFiles> {
+  const file = await open(archive, 'r')
+  try {
+    const { start, end, xz } = await dataMember(file)
+    const tool = xz ? await getPath7za() : undefined
+    const source = file.createReadStream({ start, end, autoClose: false })
+    return await (tool === undefined
+      ? readLinuxArchiveFiles(source, LABEL, APPLICATION_PREFIX)
+      : readXzData(source, tool))
+  } finally { await file.close() }
+}
+
+/**
+ * Verify the Debian package's desktop executable, ASAR, CLI launcher and Host interpreter match the assembled application.
+ * @param archive - Final Debian package.
+ * @param application - Assembled application directory used by the packager.
+ * @returns Completion after the indexed files match.
+ */
+export async function verifyLinuxDebianArchive(archive: string, application: string): Promise<void> {
+  await compareLinuxArchiveFiles(await readLinuxDebianFiles(archive), application, LABEL)
+}
+
+if (process.argv[1] !== undefined && import.meta.filename === resolve(process.argv[1])) {
+  const [archive, application] = process.argv.slice(2)
+  if (archive === undefined || application === undefined || process.argv.length !== 4) {
+    throw new Error(LABEL + ': expected package filename and assembled application directory')
+  }
+  await verifyLinuxDebianArchive(resolve(archive), resolve(application))
+}
diff --git a/apps/desktop/scripts/verify-linux-portable-archive.ts b/apps/desktop/scripts/verify-linux-portable-archive.ts
new file mode 100644
index 00000000..60bf517b
--- /dev/null
+++ b/apps/desktop/scripts/verify-linux-portable-archive.ts
@@ -0,0 +1,108 @@
+/** Compare critical files in a final Linux portable archive with the assembled application. */
+import { createHash } from 'node:crypto'
+import { createReadStream } from 'node:fs'
+import { join, resolve } from 'node:path'
+import type { Readable } from 'node:stream'
+import { pipeline } from 'node:stream/promises'
+import { list } from 'tar'
+
+/** Application files every Linux package must carry, relative to the application directory. */
+export const LINUX_APPLICATION_FILES = [
+  'deepseek-harness-uncensored', 'resources/app.asar', 'resources/runtime/cli/bin/dsh-uncensored',
+  'resources/runtime/primary-runtime/dependencies/node/bin/node',
+] as const
+
+/** Install directory the packaged application occupies inside a Linux system package. */
+export const LINUX_APPLICATION_DIRECTORY = 'opt/DeepSeek Harness Uncensored'
+
+interface PortableFingerprint {
+  readonly path: string
+  readonly bytes: number
+  readonly sha256: string
+  readonly executable: boolean
+}
+
+/**
+ * Read the packaged desktop, ASAR, CLI and Host interpreter bytes and file modes from a Linux application payload.
+ * @param source - Tar or gzip stream owned by the verifier.
+ * @param label - Artifact description used in diagnostics.
+ * @param applicationPrefix - Required application directory followed by a slash, or undefined for one portable root.
+ * @returns Verified file fingerprints relative to the archive's application directory.
+ */
+export async function readLinuxArchiveFiles(
+  source: Readable, label: string, applicationPrefix?: string,
+): Promise<readonly PortableFingerprint[]> {
+  const expected = new Set<string>(LINUX_APPLICATION_FILES)
+  const records: { root: string; path: string; type: string; size: number; bytes: number; sha256: string; executable: boolean }[] = []
+  await pipeline(source, list({ strict: true, onReadEntry(entry) {
+    const name = entry.path.replace(/^\.\//u, '')
+    const prefix = applicationPrefix ?? name.slice(0, name.indexOf('/') + 1)
+    if (prefix === '' || !name.startsWith(prefix)) return
+    const path = name.slice(prefix.length)
+    if (!expected.has(path)) return
+    const root = prefix.slice(0, -1)
+    const hash = createHash('sha256')
+    const record = { root, path, type: entry.type, size: entry.size, bytes: 0, sha256: '', executable: ((entry.mode ?? 0) & 0o111) !== 0 }
+    records.push(record)
+    entry.on('data', (chunk) => { record.bytes += chunk.length; hash.update(chunk) })
+    entry.once('end', () => { record.sha256 = hash.digest('hex') })
+  } }))
+  if (records.length !== expected.size || new Set(records.map(record => record.path)).size !== expected.size) {
+    throw new Error(`${label}: required application files are missing or repeated`)
+  }
+  const root = records[0]!.root
+  if (root === '' || root === '.' || root === '..' || records.some(record => record.root !== root)) {
+    throw new Error(`${label}: expected one application directory`)
+  }
+  for (const record of records) {
+    if (record.type !== 'File' || record.bytes === 0 || record.bytes !== record.size || record.sha256 === '') {
+      throw new Error(`${label}: invalid file ${record.path}`)
+    }
+    if (record.path !== 'resources/app.asar' && !record.executable) {
+      throw new Error(`${label}: executable permission missing for ${record.path}`)
+    }
+  }
+  return records.map(({ path, bytes, sha256, executable }) => ({ path, bytes, sha256, executable }))
+}
+
+/**
+ * Read critical file fingerprints from a final Linux portable archive.
+ * @param archive - Final Linux portable archive.
+ * @returns Verified file fingerprints relative to the archive's application directory.
+ */
+export function readLinuxPortableFiles(archive: string): Promise<readonly PortableFingerprint[]> {
+  return readLinuxArchiveFiles(createReadStream(archive), 'Linux portable archive')
+}
+
+/**
+ * Compare archived file bytes with the assembled Linux application.
+ * @param files - Verified fingerprints from the archive reader.
+ * @param application - Assembled application directory used by the packager.
+ * @param label - Artifact description used in diagnostics.
+ * @returns Completion after all indexed files match.
+ */
+export async function compareLinuxArchiveFiles(files: readonly PortableFingerprint[], application: string, label: string): Promise<void> {
+  for (const entry of files) {
+    const hash = createHash('sha256')
+    for await (const chunk of createReadStream(join(application, ...entry.path.split('/')))) hash.update(chunk)
+    if (hash.digest('hex') !== entry.sha256) throw new Error(`${label}: assembled file differs for ${entry.path}`)
+  }
+}
+
+/**
+ * Check the portable archive against the assembled desktop, Host interpreter, CLI launcher and ASAR.
+ * @param archive - Final Linux portable archive.
+ * @param application - Assembled application directory used by the packager.
+ * @returns Completion after the critical files match.
+ */
+export async function verifyLinuxPortableArchive(archive: string, application: string): Promise<void> {
+  await compareLinuxArchiveFiles(await readLinuxPortableFiles(archive), application, 'Linux portable archive')
+}
+
+if (process.argv[1] !== undefined && import.meta.filename === resolve(process.argv[1])) {
+  const [archive, application] = process.argv.slice(2)
+  if (archive === undefined || application === undefined || process.argv.length !== 4) {
+    throw new Error('Linux portable archive: expected archive filename and assembled application directory')
+  }
+  await verifyLinuxPortableArchive(resolve(archive), resolve(application))
+}
diff --git a/apps/desktop/scripts/verify-linux-rpm-archive.ts b/apps/desktop/scripts/verify-linux-rpm-archive.ts
new file mode 100644
index 00000000..0c7f01e5
--- /dev/null
+++ b/apps/desktop/scripts/verify-linux-rpm-archive.ts
@@ -0,0 +1,219 @@
+/** Compare critical files in a Linux RPM package with the assembled application. */
+import { execFile, spawn } from 'node:child_process'
+import { createHash, type Hash } from 'node:crypto'
+import { resolve } from 'node:path'
+import type { Readable } from 'node:stream'
+import { promisify } from 'node:util'
+import {
+  compareLinuxArchiveFiles,
+  LINUX_APPLICATION_DIRECTORY,
+  LINUX_APPLICATION_FILES,
+} from './verify-linux-portable-archive.ts'
+
+const LABEL = 'Linux RPM package'
+const APPLICATION_PREFIX = `${LINUX_APPLICATION_DIRECTORY}/`
+const PACKAGE_NAME = 'deepseek-harness-uncensored'
+const NEWC_MAGIC = '070701'
+/** Fixed newc header: six magic bytes plus thirteen eight-character hexadecimal fields. */
+const NEWC_HEADER_BYTES = 110
+const NEWC_TRAILER = 'TRAILER!!!'
+const LINUX_PACKAGE_ARCHITECTURES = new Set(['x86_64', 'aarch64'])
+
+/** One application file read back from the RPM payload. */
+interface RpmPayloadFingerprint {
+  readonly path: string
+  readonly bytes: number
+  readonly sha256: string
+  readonly executable: boolean
+}
+
+/** Identity the RPM metadata declares for the package it describes. */
+export interface LinuxRpmIdentity {
+  readonly name: string
+  readonly version: string
+  readonly release: string
+  readonly arch: string
+}
+
+/** One payload entry being consumed; unwanted entries skip without hashing. */
+interface EntryState {
+  /** Application-relative path when the entry is required, undefined for a skipped entry. */
+  readonly path: string | undefined
+  readonly mode: number
+  readonly hash: Hash | undefined
+  remaining: number
+  padding: number
+  bytes: number
+}
+
+const run = promisify(execFile)
+
+/**
+ * Read the package identity from the RPM header without unpacking the payload.
+ * @param archive - RPM package produced by Desktop packaging.
+ * @returns Name, version, release and architecture the header declares.
+ */
+export async function queryLinuxRpmArchive(archive: string): Promise<LinuxRpmIdentity> {
+  let stdout: string
+  try {
+    ({ stdout } = await run('rpm', ['-qp', '--queryformat', '%{NAME}\n%{VERSION}\n%{RELEASE}\n%{ARCH}\n', archive],
+      { timeout: 60_000, windowsHide: true }))
+  } catch (error) {
+    const reason = error instanceof Error ? error.message : String(error)
+    throw new Error(`${LABEL}: packaging verifies RPM metadata with the host rpm command. ${reason}`)
+  }
+  const [name, version, release, arch] = stdout.trim().split('\n')
+  if (name === undefined || version === undefined || release === undefined || arch === undefined) {
+    throw new Error(`${LABEL}: the package header has no complete name, version, release and architecture`)
+  }
+  return { name, version, release, arch }
+}
+
+/**
+ * Open the uncompressed payload of an RPM package.
+ * @param archive - RPM package produced by Desktop packaging.
+ * @returns The payload stream; the caller consumes it to completion.
+ */
+function openRpmPayload(archive: string): Readable {
+  const child = spawn('rpm2cpio', [archive], { windowsHide: true })
+  const payload = child.stdout
+  if (payload === null) throw new Error(`${LABEL}: rpm2cpio produced no payload stream`)
+  child.once('error', (error: Error) => {
+    payload.destroy(new Error(`${LABEL}: packaging reads RPM payloads with rpm2cpio. ${error.message}`))
+  })
+  let diagnostics = ''
+  child.stderr.on('data', (chunk: Buffer) => { diagnostics = (diagnostics + chunk.toString('utf8')).slice(-4096) })
+  child.once('close', (code) => {
+    if (code === 0) return
+    const detail = diagnostics.trim()
+    payload.destroy(new Error(`${LABEL}: rpm2cpio exited with ${String(code)}${detail === '' ? '' : `: ${detail}`}`))
+  })
+  return payload
+}
+
+function entryFields(header: Buffer): number[] {
+  const values: number[] = []
+  for (let field = 0; field < 13; field += 1) {
+    const start = 6 + field * 8
+    const text = header.toString('latin1', start, start + 8)
+    if (!/^[0-9a-f]{8}$/iu.test(text)) throw new Error(`${LABEL}: invalid cpio entry field`)
+    values.push(Number.parseInt(text, 16))
+  }
+  return values
+}
+
+/**
+ * Read the indexed application files from an RPM cpio payload without extracting it.
+ * @param source - Newc payload stream.
+ * @returns Fingerprints of every required application file.
+ */
+export async function readLinuxRpmPayloadFiles(source: Readable): Promise<readonly RpmPayloadFingerprint[]> {
+  const wanted = new Map(LINUX_APPLICATION_FILES.map(path => [`./${APPLICATION_PREFIX}${path}`, path]))
+  const found = new Map<string, RpmPayloadFingerprint>()
+  let pending: Buffer = Buffer.alloc(0)
+  let entry: EntryState | undefined
+  let trailer = false
+  for await (const chunk of source as AsyncIterable<Buffer>) {
+    pending = pending.length === 0 ? chunk : Buffer.concat([pending, chunk])
+    for (;;) {
+      if (entry !== undefined) {
+        if (entry.remaining > 0) {
+          const take = Math.min(entry.remaining, pending.length)
+          if (take === 0) break
+          if (entry.hash !== undefined) entry.hash.update(pending.subarray(0, take))
+          entry.bytes += take
+          entry.remaining -= take
+          pending = pending.subarray(take)
+          if (entry.remaining > 0) break
+        }
+        if (entry.padding > 0) {
+          const skip = Math.min(entry.padding, pending.length)
+          entry.padding -= skip
+          pending = pending.subarray(skip)
+          if (entry.padding > 0) break
+        }
+        if (entry.path !== undefined && entry.hash !== undefined) {
+          found.set(entry.path, {
+            path: entry.path, bytes: entry.bytes, sha256: entry.hash.digest('hex'), executable: (entry.mode & 0o111) !== 0,
+          })
+        }
+        entry = undefined
+        continue
+      }
+      if (pending.length < NEWC_HEADER_BYTES) break
+      const header = pending.subarray(0, NEWC_HEADER_BYTES)
+      if (header.toString('latin1', 0, 6) !== NEWC_MAGIC) throw new Error(`${LABEL}: the payload is not a newc cpio archive`)
+      const fields = entryFields(header)
+      const mode = fields[1]!
+      const size = fields[6]!
+      const nameSize = fields[11]!
+      const nameEnd = NEWC_HEADER_BYTES + nameSize
+      const dataStart = nameEnd + (4 - (nameEnd % 4)) % 4
+      if (pending.length < dataStart) break
+      const name = pending.toString('utf8', NEWC_HEADER_BYTES, nameEnd).replace(/\0+$/u, '')
+      pending = pending.subarray(dataStart)
+      if (name === NEWC_TRAILER) {
+        trailer = true
+        break
+      }
+      const path = wanted.get(name)
+      entry = {
+        path, mode, hash: path === undefined ? undefined : createHash('sha256'),
+        remaining: size, padding: (4 - (size % 4)) % 4, bytes: 0,
+      }
+    }
+    if (trailer) break
+  }
+  if (!trailer) {
+    if (entry !== undefined) throw new Error(`${LABEL}: the payload ends inside ${entry.path ?? 'an entry'}`)
+    throw new Error(`${LABEL}: the payload has no cpio trailer`)
+  }
+  if (found.size !== LINUX_APPLICATION_FILES.length) {
+    const missing = LINUX_APPLICATION_FILES.filter(path => !found.has(path))
+    throw new Error(`${LABEL}: required application files are missing from the payload: ${missing.join(', ')}`)
+  }
+  for (const record of found.values()) {
+    if (record.bytes === 0) throw new Error(`${LABEL}: empty file ${record.path}`)
+    if (record.path !== 'resources/app.asar' && !record.executable) {
+      throw new Error(`${LABEL}: executable permission missing for ${record.path}`)
+    }
+  }
+  return [...found.values()]
+}
+
+/**
+ * Read critical file fingerprints from the assembled application's RPM package.
+ * @param archive - RPM package produced by Desktop packaging.
+ * @returns Verified file fingerprints relative to the package's application directory.
+ */
+export async function readLinuxRpmFiles(archive: string): Promise<readonly RpmPayloadFingerprint[]> {
+  const identity = await queryLinuxRpmArchive(archive)
+  if (identity.name !== PACKAGE_NAME) {
+    throw new Error(`${LABEL}: the package is named ${JSON.stringify(identity.name)} instead of ${PACKAGE_NAME}`)
+  }
+  if (!LINUX_PACKAGE_ARCHITECTURES.has(identity.arch)) {
+    throw new Error(`${LABEL}: unsupported package architecture ${JSON.stringify(identity.arch)}`)
+  }
+  const files = await readLinuxRpmPayloadFiles(openRpmPayload(archive))
+  if (files.length !== LINUX_APPLICATION_FILES.length) throw new Error(`${LABEL}: expected ${LINUX_APPLICATION_FILES.length} application files`)
+  return files
+}
+
+/**
+ * Verify the RPM package's desktop executable, ASAR, CLI launcher and Host interpreter match the assembled application.
+ * @param archive - Final RPM package.
+ * @param application - Assembled application directory used by the packager.
+ * @returns Completion after the indexed files match.
+ */
+export async function verifyLinuxRpmArchive(archive: string, application: string): Promise<void> {
+  const files = await readLinuxRpmFiles(archive)
+  await compareLinuxArchiveFiles(files, application, LABEL)
+}
+
+if (process.argv[1] !== undefined && import.meta.filename === resolve(process.argv[1])) {
+  const [archive, application] = process.argv.slice(2)
+  if (archive === undefined || application === undefined || process.argv.length !== 4) {
+    throw new Error(LABEL + ': expected package filename and assembled application directory')
+  }
+  await verifyLinuxRpmArchive(resolve(archive), resolve(application))
+}
