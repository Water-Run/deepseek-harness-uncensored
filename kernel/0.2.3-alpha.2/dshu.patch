+/**
+ * Parse a textual IPv4 or IPv6 address.
+ * @param input - address text, optionally bracketed for IPv6 as a URL carries it.
+ * @returns the parsed address, or `undefined` when the text is not an address.
+ */
+export function parseIp(input: string): IpAddress | undefined {
+  const text = stripIpv6Brackets(input)
+  const family = isIP(text)
+  if (family === 4) {
+    const octets = ipv4Octets(text)
+    return octets === undefined ? undefined : { kind: 'ipv4', octets }
+  }
+  if (family !== 6) return undefined
+  const parts = ipv6Parts(text)
+  return parts === undefined ? undefined : { kind: 'ipv6', parts }
+}
+
+/**
+ * Name the special range the address belongs to.
+ * @param address - a parsed address.
+ * @returns the range name, or `unicast` when no special range matches.
+ */
+export function addressRange(address: IpAddress): AddressRange {
+  return address.kind === 'ipv4'
+    ? matchRange(IPV4_RANGES, address.octets, 8)
+    : matchRange(IPV6_RANGES, address.parts, 16)
+}
+
+/**
+ * Whether the address is globally reachable unicast. An IPv4-mapped IPv6 address is classified by
+ * the IPv4 address it carries.
+ * @param address - a parsed address.
+ * @returns true only for a public unicast destination.
+ */
+export function isPublicAddress(address: IpAddress): boolean {
+  return addressRange(unwrapIpv4Mapped(address)) === 'unicast'
+}
+
+/**
+ * Replace an IPv4-mapped IPv6 address with the IPv4 address it carries.
+ * @param address - a parsed address.
+ * @returns the embedded IPv4 address for a mapped address, otherwise the input address.
+ */
+export function unwrapIpv4Mapped(address: IpAddress): IpAddress {
+  if (address.kind !== 'ipv6') return address
+  const ipv4 = mappedIpv4(address)
+  return ipv4 === undefined ? address : ipv4
+}
+
+/**
+ * The address as bytes in network order: four for IPv4, sixteen for IPv6.
+ * @param address - a parsed address.
+ * @returns the address bytes, most significant first.
+ */
+export function ipByteArray(address: IpAddress): readonly number[] {
+  if (address.kind === 'ipv4') return [...address.octets]
+  const bytes: number[] = []
+  for (const part of address.parts) bytes.push(part >> 8, part & 0xff)
+  return bytes
+}
+
+/**
+ * A canonical spelling that compares equal for every spelling of one address, including
+ * `::ffff:127.0.0.1` against `127.0.0.1`.
+ * @param input - textual IPv4 or IPv6 address.
+ * @returns the canonical form, or `undefined` when the text is not an address.
+ */
+export function canonicalIp(input: string): string | undefined {
+  const parsed = parseIp(input)
+  if (parsed === undefined) return undefined
+  const address = unwrapIpv4Mapped(parsed)
+  return address.kind === 'ipv4'
+    ? address.octets.join('.')
+    : address.parts.map(part => part.toString(16).padStart(4, '0')).join(':')
+}
+
+/** The IPv4 address an IPv4-mapped IPv6 address carries. */
+function mappedIpv4(address: Ipv6Address): Ipv4Address | undefined {
+  if (addressRange(address) !== 'ipv4Mapped') return undefined
+  const high = address.parts[6]
+  const low = address.parts[7]
+  if (high === undefined || low === undefined) return undefined
+  return { kind: 'ipv4', octets: [high >> 8 & 0xff, high & 0xff, low >> 8 & 0xff, low & 0xff] }
+}
+
+/** Whether one prefix contains the address, comparing at most `bits` bits. */
+function samePrefix(
+  parts: readonly number[],
+  prefix: readonly number[],
+  bits: number,
+  partBits: number,
+): boolean {
+  let remaining = bits
+  for (let index = 0; remaining > 0; index++) {
+    const used = Math.min(partBits, remaining)
+    const mask = ((1 << used) - 1) << (partBits - used)
+    if ((((parts[index] ?? 0) ^ (prefix[index] ?? 0)) & mask) !== 0) return false
+    remaining -= used
+  }
+  return true
+}
+
+/** First range whose prefixes contain the address. */
+function matchRange(
+  ranges: readonly SpecialRange[],
+  parts: readonly number[],
+  partBits: number,
+): AddressRange {
+  for (const range of ranges) {
+    for (const [prefix, bits] of range.subnets) {
+      if (samePrefix(parts, prefix, bits, partBits)) return range.name
+    }
+  }
+  return 'unicast'
+}
+
+/** Four decimal octets, no leading zeros. */
+function ipv4Octets(text: string): readonly number[] | undefined {
+  const groups = text.split('.')
+  if (groups.length !== 4) return undefined
+  const octets: number[] = []
+  for (const group of groups) {
+    if (!/^(?:0|[1-9]\d{0,2})$/.test(group)) return undefined
+    const value = Number(group)
+    if (value > 255) return undefined
+    octets.push(value)
+  }
+  return octets
+}
+
+/**
+ * Eight 16-bit groups, expanding `::` and an embedded dotted-quad tail. A zone identifier is
+ * dropped rather than treated as part of the address.
+ */
+function ipv6Parts(text: string): readonly number[] | undefined {
+  const zone = text.indexOf('%')
+  const address = zone === -1 ? text : text.slice(0, zone)
+  const halves = address.split('::')
+  const headText = halves[0] ?? ''
+  const tailText = halves[1]
+  if (halves.length > 2) return undefined
+  const head = headText === '' ? [] : headText.split(':')
+  const tail = tailText === undefined || tailText === '' ? [] : tailText.split(':')
+  const dottedTail = tail.at(-1)
+  const embedded = dottedTail === undefined ? undefined : ipv4Octets(dottedTail)
+  const groups = embedded === undefined ? tail : tail.slice(0, -1)
+  const omitted = 8 - (head.length + groups.length + (embedded === undefined ? 0 : 2))
+  // Without `::` every group must be spelled out; with it, at least one group is compressed.
+  if (omitted < 0 || (tailText === undefined && omitted !== 0)) return undefined
+
+  const parts: number[] = []
+  for (const group of [...head, ...Array<string>(omitted).fill('0'), ...groups]) {
+    if (!/^[0-9a-fA-F]{1,4}$/.test(group)) return undefined
+    parts.push(Number.parseInt(group, 16))
+  }
+  if (embedded !== undefined) {
+    const [first, second, third, fourth] = embedded
+    if (first === undefined || second === undefined || third === undefined || fourth === undefined) {
+      return undefined
+    }
+    parts.push((first << 8) | second, (third << 8) | fourth)
+  }
+  return parts.length === 8 ? parts : undefined
+}
+
+/**
+ * Drop the brackets a URL keeps around an IPv6 hostname; IP parsers read the bare literal.
+ * @param hostname - hostname as a URL carries it, bracketed for IPv6.
+ * @returns the hostname without brackets.
+ */
+export function stripIpv6Brackets(hostname: string): string {
+  return hostname.startsWith('[') && hostname.endsWith(']') ? hostname.slice(1, -1) : hostname
+}
