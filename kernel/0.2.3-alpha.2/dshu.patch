diff --git a/packages/client/ui-settings-account/src/client/SpendingView.tsx b/packages/client/ui-settings-account/src/client/SpendingView.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..86e8064fe880c2b9764e3692cd7f012e7a90d52a
--- /dev/null
+++ b/packages/client/ui-settings-account/src/client/SpendingView.tsx
@@ -0,0 +1,161 @@
+/** Independent spending windows over the shared durable ledger. */
+import { useEffect, useId, useRef, useState } from 'react'
+import type { ReactNode } from 'react'
+import { Button, Modal, StateDot, Switch, Toast } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { InjectFace, PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import type { SpendPeriod, SpendSnapshot, SpendWindow, SpendWindowUpdate } from '@deepseek-ai/dsh-spend-limit/types'
+import type { SpendingController } from './spending-controller.ts'
+import { LimitAmountInput } from './LimitAmountInput.tsx'
+import { LimitIcon } from './BudgetIcons.tsx'
+import css from './SpendingView.module.css'
+
+/** Store and independent mutations supplied by the account plugin. */
+export interface SpendingInjected {
+  hooks: { spending: SpendingController['state'] }
+  configureSpendingWindow(value: SpendWindowUpdate): Promise<boolean>
+  setSpendingAutoResume(value: boolean): Promise<boolean>
+  disableAllSpending(): Promise<boolean>
+  resetSpending(period?: SpendPeriod): Promise<boolean>
+  resumeSpending(): Promise<boolean>
+  refreshSpending(): void
+  dismissSpendingToast(id: number): void
+}
+type Common = InjectFace<SpendingInjected> & PropsLocale<'settings.spending'>
+const FEATURED: readonly SpendPeriod[] = ['5h', '7d']
+const money = (value: number): string => `¥${value > 0 && value < 0.01 ? value.toFixed(6).replace(/0+$/u, '') : value.toFixed(2)}`
+const invalidLimit = (value: string): boolean => value.trim() === '' || !Number.isFinite(Number(value)) || Number(value) < 0.000001 || Number(value) > 1_000_000
+function hasBlockedSessions(data: SpendSnapshot): boolean {
+  return data.paused || data.pausedSessions.some(session => session.state === 'blocked')
+}
+
+function WindowBar({ window, label, t, actions }: { window: SpendWindow; label: string; t: Common['t']; actions: ReactNode }) {
+  const spent = Math.min(100, window.spent / window.limit * 100)
+  const reserved = Math.min(100 - spent, window.reserved / window.limit * 100)
+  return <div className={css.window}>
+    <div className={css.heading}><span>{money(window.spent + window.reserved)} / {money(window.limit)}</span><span>{window.enabled ? `${Math.min(100, spent + reserved).toFixed(1)}%` : t('spending.offShort')}</span></div>
+    <div role="progressbar" aria-label={label} aria-valuemin={0} aria-valuemax={window.limit} aria-valuenow={Math.min(window.limit, window.spent + window.reserved)}
+      aria-valuetext={`${t('spending.spent')} ${money(window.spent)}, ${t('spending.reserved')} ${money(window.reserved)}, ${t('spending.remaining')} ${money(window.remaining)}`} className={css.track}>
+      <span className={css.spent} style={{ width: `${spent}%` }} /><span className={css.reserved} style={{ width: `${reserved}%` }} />
+    </div>
+    <div className={css.meterFooter}><div className={css.details}><span>{t('spending.spent')} {money(window.spent)}</span><span>{t('spending.reserved')} {money(window.reserved)}</span><span>{t('spending.remaining')} {money(window.remaining)}</span></div><div className={css.windowActions}>{actions}</div></div>
+    {window.uncertain > 0 && <p className={css.hint}>{t('spending.unknown')} {money(window.uncertain)}</p>}
+  </div>
+}
+
+/**
+ * @param props - Current windows, shared operation state and authenticated mutations.
+ * @returns Independent limits and continuation controls.
+ */
+export function SpendingSettings({ useSpending, configureSpendingWindow, setSpendingAutoResume, disableAllSpending, resetSpending, resumeSpending, refreshSpending, t }: PropsRuntime<'settings.section'> & Common) {
+  const state = useSpending(value => value)
+  const data = state.data
+  const [draft, setDraft] = useState<Partial<Record<SpendPeriod, string>>>({})
+  const [confirm, setConfirm] = useState<SpendPeriod | 'all' | null>(null)
+  const [othersOpen, setOthersOpen] = useState(false)
+  const initialized = useRef(false)
+  const id = useId()
+  useEffect(() => {
+    if (data === undefined || initialized.current) return
+    initialized.current = true
+    setOthersOpen(data.preferences.enabledPeriods.some(period => !FEATURED.includes(period)))
+  }, [data])
+  if (data === undefined) return <section className={css.settings} aria-busy={!state.failed}>{state.failed ? <><p role="alert">{t('spending.failed')}</p><Button onClick={refreshSpending}>{t('spending.retry')}</Button></> : <span className={css.spinner} role="status" aria-label={t('spending.loading')}><StateDot state="ongoing" size={20} /></span>}</section>
+  const blocked = hasBlockedSessions(data)
+  const active = data.preferences.enabledPeriods.length
+  const featured = data.windows.filter(window => FEATURED.includes(window.period))
+  const otherActive = data.windows.filter(window => window.enabled && !FEATURED.includes(window.period)).length
+  const save = (window: SpendWindow, enabled?: boolean): void => {
+    const submitted = draft[window.period]
+    const validDraft = submitted !== undefined && !invalidLimit(submitted)
+    void configureSpendingWindow({ period: window.period, ...(enabled === undefined ? {} : { enabled }),
+      ...(validDraft ? { limit: Number(submitted) } : {}),
+    }).then((ok) => {
+      if (!ok || !validDraft) return
+      setDraft((current) => {
+        if (current[window.period] !== submitted) return current
+        const { [window.period]: _saved, ...remaining } = current
+        return remaining
+      })
+    })
+  }
+  const row = (window: SpendWindow) => {
+    const label = t(`spending.${window.period}`)
+    const value = draft[window.period] ?? String(window.limit)
+    const invalid = invalidLimit(value)
+    const changed = draft[window.period] !== undefined && Number(value) !== window.limit
+    return <section className={css.card} key={window.period} data-enabled={window.enabled} role="group" aria-label={label}>
+      <div className={css.limitHeader}>
+        <div className={css.windowTitle}><Switch label={t('spending.windowEnabled', { period: label })} checked={window.enabled}
+          disabled={state.saving || (!window.enabled && invalid)} onChange={(enabled) => { save(window, enabled) }} /><h4>{label}</h4></div>
+        <LimitAmountInput id={`${id}-${window.period}`} value={value} label={t('spending.limit', { period: label })}
+          increase={t('spending.increase', { period: label })} decrease={t('spending.decrease', { period: label })} disabled={state.saving}
+          invalid={invalid} descriptionId={invalid ? `${id}-${window.period}-error` : undefined}
+          onChange={(text) => { setDraft(current => ({ ...current, [window.period]: text })) }} />
+      </div>
+      <WindowBar window={window} label={label} t={t} actions={<>
+        {changed && <Button size="sm" disabled={state.saving || invalid} onClick={() => { save(window) }}>{t('spending.save')}</Button>}
+        <Button size="sm" variant="ghost" disabled={state.saving} onClick={() => { setConfirm(window.period) }}>{t('spending.resetWindow')}</Button>
+      </>} />
+      {invalid && <p id={`${id}-${window.period}-error`} role="alert" className={css.error}>{t('spending.invalid')}</p>}
+    </section>
+  }
+  return <section className={css.settings}>
+    <header className={css.sectionHead}><h3>{t('spending.title')}</h3><span>{t('spending.enabledCount', { count: active })}</span></header>
+    <p className={css.hint}>{t('spending.summary')}</p>
+    {state.failed && <div role="alert" className={css.row}><span>{t('spending.failed')}</span><Button size="sm" onClick={refreshSpending}>{t('spending.retry')}</Button></div>}
+    <div className={css.row}><div><span>{t('spending.auto')}</span><p className={css.hint}>{t('spending.autoHint')}</p></div><Switch label={t('spending.auto')} checked={data.preferences.autoResume} disabled={state.saving} onChange={(enabled) => { void setSpendingAutoResume(enabled) }} /></div>
+    {(blocked || data.waiting > 0) && <div className={css.status} role="status"><span>{t(blocked ? 'spending.paused' : 'spending.waiting', { count: data.waiting })}</span>{blocked && <Button size="sm" disabled={state.saving} onClick={() => { void resumeSpending() }}>{t('spending.resume')}</Button>}</div>}
+    <div className={css.grid}>{featured.map(row)}</div>
+    <details className={css.otherWindows} open={othersOpen} onToggle={(event) => { setOthersOpen(event.currentTarget.open) }}>
+      <summary>{t(otherActive > 0 ? 'spending.otherEnabled' : 'spending.other', { count: otherActive })}</summary>
+      {othersOpen && <div className={css.grid}>{data.windows.filter(window => !FEATURED.includes(window.period)).map(row)}</div>}
+    </details>
+    <div className={css.actions}><Button variant="outline" disabled={state.saving || active === 0} onClick={() => { void disableAllSpending() }}>{t('spending.disableAll')}</Button><Button variant="outline" disabled={state.saving} onClick={() => { setConfirm('all') }}>{t('spending.resetAll')}</Button></div>
+    <details className={css.explanation}><summary>{t('spending.explanation')}</summary><p className={css.hint}>{t('spending.estimate')}</p><p className={css.hint}>{t('spending.coverage')}</p><p className={css.hint}>{t('spending.uncertain')}</p></details>
+    <Modal open={confirm !== null} onClose={() => { setConfirm(null) }} closeLabel={t('spending.cancel')}
+      title={confirm === null || confirm === 'all' ? t('spending.resetAllTitle') : t('spending.resetWindowTitle', { period: t(`spending.${confirm}`) })}
+      footer={<><Button variant="outline" disabled={state.saving} onClick={() => { setConfirm(null) }}>{t('spending.cancel')}</Button><Button disabled={state.saving} onClick={() => { if (confirm !== null) void resetSpending(confirm === 'all' ? undefined : confirm).then((ok) => { if (ok) setConfirm(null) }) }}>{t('spending.resetConfirm')}</Button></>}>
+      <p className={css.hint}>{t(confirm === 'all' ? 'spending.resetHint' : 'spending.resetWindowHint')}</p>
+    </Modal>
+  </section>
+}
+
+/** @param props - Root-owned operation feedback. @returns A notification that survives closing Settings. */
+export function SpendingToast({ useSpending, dismissSpendingToast, t }: PropsRuntime<'shell.overlay'> & Common) {
+  const toast = useSpending(value => value.toast)
+  return toast === null ? null : <Toast key={toast.id} text={t(toast.success ? 'spending.saved' : 'spending.saveFailed')} {...toast.success ? { tone: 'success' as const } : {}} onDone={() => { dismissSpendingToast(toast.id) }} />
+}
+
+/**
+ * @param props - Session-owned admission state and recovery actions.
+ * @returns A persistent banner while this conversation waits for budget.
+ */
+export function SpendingBanner({
+  sessionId, useSpending, resetSpending, resumeSpending, refreshSpending, openBudgetSettings, t,
+}: Pick<PropsRuntime<'conversation.input.dock'>, 'sessionId'> & Common & { openBudgetSettings?: () => void }) {
+  const state = useSpending(value => value)
+  const data = state.data
+  const pause = data?.pausedSessions.find(row => row.sessionId === sessionId)
+  if (pause === undefined || data === undefined) return null
+  // Requests waiting only on reservations can continue even with automatic recovery disabled.
+  const manual = pause.requiresManualResume === true || data.paused
+  const exceedsLimit = pause.exceedsLimit === true
+  const waitingForReservations = !manual && !exceedsLimit && pause.resumeAt === null && data.pending > 0
+  const message = state.failed ? t('spending.failed') : exceedsLimit ? t('spending.bannerOverLimit') : manual ? t('spending.bannerManual')
+    : waitingForReservations ? t('spending.bannerPending') : pause.resumeAt == null ? t('spending.bannerRechecking')
+      : pause.resumeAt <= data.updatedAt ? t('spending.bannerResuming')
+        : t('spending.bannerAutomatic', { time: new Date(pause.resumeAt).toLocaleString() })
+  return <section className={css.banner} role="status" aria-live="polite">
+    <span className={css.noticeIcon}><LimitIcon /></span>
+    <div className={css.noticeText}><span>{t('spending.bannerTitle')}</span><p>{message}</p></div>
+    {(!waitingForReservations || state.failed) && <div className={css.windowActions}>
+      {state.failed ? <Button size="sm" onClick={refreshSpending}>{t('spending.retry')}</Button>
+        : exceedsLimit ? openBudgetSettings !== undefined
+          && <Button size="sm" variant="outline" onClick={openBudgetSettings}>{t('spending.bannerOpenLimits')}</Button>
+          : <>
+            {manual && <Button size="sm" variant="ghost" disabled={state.saving} onClick={() => { void resumeSpending() }}>{t('spending.resume')}</Button>}
+            <Button size="sm" variant="outline" disabled={state.saving} onClick={() => { void resetSpending() }}>{t('spending.bannerReset')}</Button>
+          </>}
+    </div>}
+  </section>
+}
diff --git a/packages/client/ui-settings-account/src/client/balance-chart.ts b/packages/client/ui-settings-account/src/client/balance-chart.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7f20df664d87506b470aef548609b3554420d33d
--- /dev/null
+++ b/packages/client/ui-settings-account/src/client/balance-chart.ts
@@ -0,0 +1,252 @@
+/** Geometry for the local balance sample curve. Sampling and rates stay elsewhere. */
+
+/** One plotted observation. */
+export interface BalanceChartSample {
+  readonly time: number
+  readonly value: number
+  /** Original decimal amount retained for inspection; geometry uses value. */
+  readonly exactValue?: string
+}
+
+/** Drawable curve and original sample positions on its displayed time axis. */
+export interface BalanceChartGeometry {
+  readonly kind: 'empty' | 'single' | 'series'
+  readonly points: string
+  readonly positions: readonly number[]
+  /** Solid runs and vertical jumps when balance increases are drawn as discrete events. */
+  readonly path?: string
+  readonly increases?: string
+  /** Horizontal dashed connectors replacing compressed flat runs. */
+  readonly compressed?: string
+  /** Dashed connectors spanning intervals the samples do not cover. */
+  readonly gaps?: string
+  readonly dot?: { readonly x: number; readonly y: number }
+  /** Observed value bounds; the vertical axis labels them. */
+  readonly range?: { readonly low: number; readonly high: number }
+}
+
+/** Plot area: a left gutter carries the vertical axis labels. */
+const LEFT = 52
+const WIDTH = 252
+const TOP = 12
+const BOTTOM = 98
+const MAX_POINTS = 120
+const FLAT_THRESHOLD_MS = 30 * 60_000
+/** Sample intervals above this multiple of the usual cadence carry no observation. */
+const GAP_FACTOR = 3
+const MIN_GAP_MS = 5 * 60_000
+const DASH_PX = 5
+const GAP_PX = 4
+/** SVG dash pattern in CSS pixels for non-scaling balance connectors. */
+export const BALANCE_DASH_ARRAY = `${DASH_PX} ${GAP_PX}`
+
+interface FlatRun { start: number; end: number; duration: number }
+
+function atIndex<T>(items: readonly T[], index: number): T {
+  const value = items[index]
+  if (value === undefined) throw new RangeError(`Balance chart index ${index} is out of range`)
+  return value
+}
+
+function flatRuns(samples: readonly BalanceChartSample[]): FlatRun[] {
+  const runs: FlatRun[] = []
+  let start = 0
+  for (let end = 1; end <= samples.length; end += 1) {
+    const first = atIndex(samples, start)
+    if (samples[end]?.value === first.value) continue
+    const duration = atIndex(samples, end - 1).time - first.time
+    if (duration >= FLAT_THRESHOLD_MS) runs.push({ start, end: end - 1, duration })
+    start = end
+  }
+  return runs
+}
+
+/**
+ * Interval above which a connector means the samples do not cover it.
+ * The usual cadence comes from the lower quartile of positive intervals, so an
+ * outage elsewhere in the history cannot raise its own threshold.
+ * @param samples - Observations in time order.
+ * @returns Milliseconds above which consecutive observations count as separated.
+ */
+function gapThreshold(samples: readonly BalanceChartSample[]): number {
+  const intervals: number[] = []
+  for (let index = 1; index < samples.length; index += 1) {
+    const interval = atIndex(samples, index).time - atIndex(samples, index - 1).time
+    if (interval > 0) intervals.push(interval)
+  }
+  if (intervals.length === 0) return Number.POSITIVE_INFINITY
+  intervals.sort((left, right) => left - right)
+  return Math.max(MIN_GAP_MS, GAP_FACTOR * atIndex(intervals, Math.floor((intervals.length - 1) / 4)))
+}
+
+/**
+ * Count the observation gaps ending at or before each observation.
+ * @param samples - Observations in time order.
+ * @param threshold - Interval above which consecutive observations count as separated.
+ * @returns One running total per observation, so a drawn pair spans a gap when its totals differ.
+ */
+function gapEnds(samples: readonly BalanceChartSample[], threshold: number): number[] {
+  const counts = [0]
+  for (let index = 1; index < samples.length; index += 1) {
+    const interval = atIndex(samples, index).time - atIndex(samples, index - 1).time
+    counts.push(atIndex(counts, index - 1) + (interval > threshold ? 1 : 0))
+  }
+  return counts
+}
+
+function timeAxis(samples: readonly BalanceChartSample[], compress: boolean) {
+  const start = atIndex(samples, 0).time
+  const span = atIndex(samples, samples.length - 1).time - start
+  const candidates = compress ? flatRuns(samples) : []
+  const active = span - candidates.reduce((total, run) => total + run.duration, 0)
+  // Together the compressed runs occupy at most a fifth of the remaining axis.
+  const cap = active / (4 * Math.max(1, candidates.length))
+  const runs = active > 0 ? candidates.filter(run => run.duration > cap) : []
+  const displayed = span - runs.reduce((total, run) => total + run.duration - cap, 0)
+  let runIndex = 0
+  let removed = 0
+  const positions = samples.map((sample, index) => {
+    let run = runs[runIndex]
+    if (run !== undefined && index > run.end) {
+      removed += run.duration - cap
+      run = runs[++runIndex]
+    }
+    const offset = sample.time - start - removed
+    if (run !== undefined && index >= run.start) {
+      const elapsed = sample.time - atIndex(samples, run.start).time
+      return (offset - elapsed + elapsed / run.duration * cap) / displayed
+    }
+    return displayed === 0 ? index / Math.max(1, samples.length - 1) : offset / displayed
+  })
+  return { positions, runs }
+}
+
+/**
+ * Project samples into the fixed balance chart view box.
+ * @param samples - Observations for one currency, in time order.
+ * @param options - Draw discrete increases and, with `dashes`, mark shortened unchanged runs and unobserved intervals.
+ * @returns Empty, one dot, or a downsampled curve with positions for every original observation.
+ */
+export function balanceChart(
+  samples: readonly BalanceChartSample[],
+  options: { stepIncreases?: boolean; dashes?: boolean; plotWidth?: number; plotHeight?: number } = {},
+): BalanceChartGeometry {
+  const { stepIncreases = false, dashes = false, plotWidth = 264, plotHeight = 110 } = options
+  if (samples.length === 0) return { kind: 'empty', points: '', positions: [] }
+  const { positions, runs } = timeAxis(samples, dashes)
+  const kept = new Set(downsample(samples, MAX_POINTS))
+  if (stepIncreases) {
+    for (let index = 1; index < samples.length; index += 1) {
+      if (atIndex(samples, index).value <= atIndex(samples, index - 1).value) continue
+      kept.add(index - 1)
+      kept.add(index)
+    }
+  }
+  const compressedEnds = new Set<number>()
+  for (const run of runs) {
+    kept.add(run.start)
+    kept.add(run.end)
+    compressedEnds.add(run.end)
+    for (let index = run.start + 1; index < run.end; index += 1) kept.delete(index)
+  }
+  const picked = [...kept].sort((a, b) => a - b)
+  const values = picked.map(index => atIndex(samples, index).value)
+  const low = Math.min(...values)
+  const high = Math.max(...values)
+  const range = { low, high }
+  const coords = picked.map((index) => {
+    const sample = atIndex(samples, index)
+    const x = LEFT + atIndex(positions, index) * WIDTH
+    const y = high === low ? (TOP + BOTTOM) / 2 : BOTTOM - ((sample.value - low) * (BOTTOM - TOP)) / (high - low)
+    return { x, y, index }
+  })
+  const first = atIndex(coords, 0)
+  if (coords.length === 1) return { kind: 'single', points: '', dot: { x: first.x, y: first.y }, range, positions }
+  const points = coords.map(point => `${point.x},${point.y}`).join(' ')
+  const gaps = dashes ? gapEnds(samples, gapThreshold(samples)) : undefined
+  let path = `M${first.x},${first.y}`, increases = '', compressed = '', missing = ''
+  let previous = first
+  for (const current of coords.slice(1)) {
+    const flat = compressedEnds.has(current.index)
+    if (flat || (gaps !== undefined && atIndex(gaps, current.index) !== atIndex(gaps, previous.index))) {
+      const length = Math.hypot((current.x - previous.x) * plotWidth / 264, (current.y - previous.y) * plotHeight / 110)
+      if (length < 2 * DASH_PX + GAP_PX) path += ` L${current.x},${current.y}`
+      else {
+        path += ` M${current.x},${current.y}`
+        if (flat) compressed += `M${previous.x},${previous.y} H${current.x} `
+        else missing += `M${previous.x},${previous.y} L${current.x},${current.y} `
+      }
+    } else if (stepIncreases && current.y < previous.y) {
+      path += ` H${current.x} M${current.x},${current.y}`
+      increases += `M${current.x},${previous.y} V${current.y} `
+    } else path += ` L${current.x},${current.y}`
+    previous = current
+  }
+  const series = { kind: 'series' as const, points, range, positions }
+  if (!stepIncreases && runs.length === 0 && missing === '') return series
+  return { ...series, path, increases: increases.trimEnd(), compressed: compressed.trimEnd(), gaps: missing.trimEnd() }
+}
+
+function downsample(items: readonly BalanceChartSample[], max: number): number[] {
+  if (items.length <= max) return items.map((_sample, index) => index)
+  const last = items.length - 1
+  const picked = [0]
+  const buckets = Math.floor((max - 2) / 2)
+  for (let bucket = 0; bucket < buckets; bucket += 1) {
+    const start = 1 + Math.floor(bucket * (last - 1) / buckets)
+    const end = 1 + Math.floor((bucket + 1) * (last - 1) / buckets)
+    let low: { index: number; sample: BalanceChartSample } | undefined
+    let high: { index: number; sample: BalanceChartSample } | undefined
+    for (const [index, sample] of items.slice(start, end).entries()) {
+      if (low === undefined || sample.value < low.sample.value) low = { index, sample }
+      if (high === undefined || sample.value > high.sample.value) high = { index, sample }
+    }
+    if (low === undefined || high === undefined) continue
+    if (low.index === high.index) picked.push(start + low.index)
+    else picked.push(start + Math.min(low.index, high.index), start + Math.max(low.index, high.index))
+  }
+  picked.push(last)
+  return picked
+}
+
+/**
+ * Find the original observation nearest to a horizontal position in the plot.
+ * @param positions - Fractions along the displayed axis, one per original observation.
+ * @param fraction - Pointer position on that axis, clamped to its ends.
+ * @returns Original sample index, including observations omitted from the drawn polyline.
+ */
+export function nearestBalanceSample(positions: readonly number[], fraction: number): number {
+  if (positions.length === 0) return 0
+  const position = Math.max(0, Math.min(1, fraction))
+  let low = 0, high = positions.length - 1
+  while (low < high) {
+    const middle = Math.floor((low + high) / 2)
+    if (atIndex(positions, middle) < position) low = middle + 1
+    else high = middle
+  }
+  const previous = positions[low - 1]
+  return previous !== undefined && position - previous <= atIndex(positions, low) - position ? low - 1 : low
+}
+
+/**
+ * Keep an inspected observation across replacements of the chart history.
+ * @param samples - Current observations in ascending time order.
+ * @param observation - The previously selected time and amount.
+ * @returns Its current index or the closest retained time; zero if the observations are empty.
+ */
+export function retainedBalanceSample(samples: readonly BalanceChartSample[], observation: BalanceChartSample): number {
+  let low = 0, high = samples.length
+  while (low < high) {
+    const middle = Math.floor((low + high) / 2)
+    if (atIndex(samples, middle).time < observation.time) low = middle + 1
+    else high = middle
+  }
+  for (let index = low; index < samples.length; index += 1) {
+    const candidate = atIndex(samples, index)
+    if (candidate.time !== observation.time) break
+    if (candidate.value === observation.value && candidate.exactValue === observation.exactValue) return index
+  }
+  const previous = samples[low - 1], next = samples[low]
+  if (next === undefined) return Math.max(0, low - 1)
+  return previous !== undefined && observation.time - previous.time <= next.time - observation.time ? low - 1 : low
+}
