+/** Public calendar date and its ordered application version. */
+interface CalendarVersion {
+  readonly year: number
+  readonly month: number
+  readonly day: number
+  readonly sequence: number
+  readonly display: string
+  readonly runtime: string
+}
+
+/**
+ * @param value - Public calendar date or ordered application version.
+ * @returns Valid date fields and both spellings when the date exists.
+ */
