+/**
+ * The Remote surface of the security-mode egress proxy: settings, connection
+ * check, and the bounded traffic list/detail the settings panel renders.
+ *
+ * Mutations and captured exchanges require the application owner. Status reads
+ * report upstream password presence without returning the secret.
+ * @module @deepseek-ai/dsh-security-proxy-local/service
+ */
+
+import type { Context } from '@deepseek-ai/cordis'
+import { principalOf, Remote, RemoteError, TypertRemoteService } from '@deepseek-ai/dsh-typert-protocol'
+import type {
+  SecurityProxyCaptureStats,
+  SecurityProxyCaptureExport,
+  SecurityProxyExportQuery,
+  SecurityProxyFlowDetail,
+  SecurityProxyFlowQuery,
+  SecurityProxyFlowsResult,
+  SecurityProxySettingsPatch,
+  SecurityProxyState,
+  SecurityProxyTestResult,
+} from '@deepseek-ai/dsh-security-proxy/types'
+import type { SecurityProxyEgressLease } from '@deepseek-ai/dsh-security-proxy'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { WebFetchResult } from '@deepseek-ai/dsh-web'
+import type { SecurityProxyEngine } from './engine.ts'
+
+/**
+ * Host service consumed by tools in-process and by the settings panel over the
+ * Remote gateway. One instance serves the whole Host.
+ */
+export class SecurityProxyService extends TypertRemoteService {
+  /**
+   * @param ctx - owning context; the service registers as `ctx.securityProxy`.
+   * @param engine - the proxy runtime this service fronts.
+   */
+  constructor(ctx: Context, private readonly engine: SecurityProxyEngine) {
+    super(ctx, 'securityProxy', { namespace: 'securityProxy' })
+  }
+
+  /**
+   * Resolve whether one tool execution is routed through the proxy.
+   * @param agent - the executing Agent.
+   * @param tool - the model-facing tool name.
+   * @returns the route, or undefined when the session is not covered.
+   */
+  route(agent: Agent | undefined, tool: string): { sessionId: SessionId; preset: string; tool: string } | undefined {
+    return this.engine.route(agent, tool)
+  }
+
+  /**
+   * Environment for one child process in a covered session.
+   * @param agent - the executing Agent.
+   * @param tool - the model-facing tool name.
+   * @returns the overlay, or undefined when the session is not covered.
+   */
+  async environment(agent: Agent | undefined, tool: string): Promise<Readonly<Record<string, string>> | undefined> {
+    return await this.engine.environment(agent, tool)
+  }
+
+  /**
+   * Retain native forwarding and capture under the executing conversation.
+   * @param agent - Executing Agent; absence acquires nothing.
+   * @param tool - Traffic attribution.
+   * @param stop - Join delegated resources after cancellation.
+   * @param signal - Caller lifetime.
+   * @param admission - Optional cancellation during startup only; omitted for caller lifetime alone.
+   * @returns Covered execution lease, or undefined outside enabled Security mode.
+   */
+  async openEgress(
+    agent: Agent | undefined, tool: string, stop: () => Promise<void>, signal: AbortSignal, admission?: AbortSignal,
+  ): Promise<SecurityProxyEgressLease | undefined> {
+    return await this.engine.openEgress(agent, tool, stop, signal, admission)
+  }
+
+  /**
+   * Issue a sidebar-browser endpoint using the Host-resolved conversation and recorded mode.
+   * @param agent - Agent resolved by the ordinary Session resource loader.
+   * @returns A credential-free local endpoint, or undefined outside enabled Security mode.
+   */
+  @Remote
+  async browserEnvironment(agent: Agent): Promise<string | undefined> {
+    this.assertOwner('securityProxy/browserEnvironment')
+    const environment = await this.engine.environment(agent, 'sidebar_browser')
+    if (environment === undefined) return undefined
+    if (environment.HTTP_PROXY === undefined) throw new Error('Security proxy did not provide a browser endpoint')
+    return environment.HTTP_PROXY
+  }
+
+  /**
+   * Bind public certificate material to the owner-requested conversation and current listener.
+   * @param agent - Agent resolved by the ordinary Session resource loader.
+   * @param server - Exact loopback endpoint already issued for this browser.
+   * @returns Public PEM for an inspected listener, or null for an opaque listener.
+   */
+  @Remote
+  async browserTrust(agent: Agent, server: string): Promise<string | null> {
+    this.assertOwner('securityProxy/browserTrust')
+    const certificate = await this.engine.issuedCertificate(agent, 'sidebar_browser', server)
+    if (certificate === undefined) {
+      throw new RemoteError('security-proxy/browser-route-changed', 'The browser proxy route changed. Reopen the page to use the current route.', {})
+    }
+    return certificate
+  }
+
+  /**
+   * Retrieve one target through the proxy with full plaintext capture.
+   * @param agent - the executing Agent.
+   * @param url - the absolute HTTP(S) target.
+   * @param signal - caller cancellation.
+   * @returns the decoded response.
+   */
+  async fetchTarget(agent: Agent | undefined, url: string, signal: AbortSignal): Promise<WebFetchResult> {
+    return await this.engine.fetchTarget(agent, url, signal)
+  }
+
+  /**
+   * Read the whole settings and status surface.
+   * @returns current state.
+   */
+  @Remote
+  async get(): Promise<SecurityProxyState> {
+    return await this.engine.state()
+  }
+
+  /**
+   * Change settings; transport changes are re-verified before this resolves.
+   * @param patch - owner-edited fields.
+   * @returns state after the write.
+   */
+  @Remote
+  async configure(patch: SecurityProxySettingsPatch): Promise<SecurityProxyState> {
+    this.assertOwner('securityProxy/configure')
+    const before = await this.engine.state()
+    const after = await this.engine.configure(patch)
+    if ((['enabled', 'protocol', 'host', 'port', 'authEnabled', 'username'] as const)
+      .some(key => before.settings[key] !== after.settings[key])) this.transportChanged()
+    return after
+  }
+
+  /**
+   * Store or remove the upstream password.
+   * @param password - the new secret, or null to remove the record.
+   * @returns state after the write.
+   */
+  @Remote
+  async setPassword(password: string | null): Promise<SecurityProxyState> {
+    this.assertOwner('securityProxy/setPassword')
+    const state = await this.engine.setPassword(password)
+    this.transportChanged()
+    return state
+  }
+
+  /**
+   * Run one real proxy-path check.
+   * @returns the check outcome and the state after it.
+   */
+  @Remote
+  async test(): Promise<SecurityProxyTestResult> {
+    this.assertOwner('securityProxy/test')
+    return await this.engine.test()
+  }
+
+  /**
+   * List retained flows for the application owner, newest first.
+   * @param query - optional filters.
+   * @returns matching rows and the capture counters.
+   */
+  @Remote
+  async list(query: SecurityProxyFlowQuery): Promise<SecurityProxyFlowsResult> {
+    this.assertOwner('securityProxy/list')
+    const state = await this.engine.state()
+    return { flows: this.engine.list(query), capture: state.capture }
+  }
+
+  /**
+   * Read one flow's detail for the application owner.
+   * @param id - flow identity.
+   * @returns the detail, or null when pruned or unknown.
+   */
+  @Remote
+  async detail(id: string): Promise<SecurityProxyFlowDetail | null> {
+    this.assertOwner('securityProxy/detail')
+    return Promise.resolve(this.engine.detail(id))
+  }
+
+  /**
+   * Export all matching stored records for the application owner.
+   * @param query - Session, kind and text filters without pagination.
+   * @returns Complete stored snapshot; oversized exports fail without returning records.
+   */
+  @Remote
+  async exportCapture(query: SecurityProxyExportQuery): Promise<SecurityProxyCaptureExport> {
+    this.assertOwner('securityProxy/exportCapture')
+    const result = this.engine.exportCapture(query)
+    if (result.kind === 'too-large') {
+      throw new RemoteError('security-proxy/export-too-large', 'The capture export exceeds the configured byte budget.',
+        { maxBytes: result.maxBytes })
+    }
+    return Promise.resolve(result.data)
+  }
+
+  /**
+   * Drop every retained flow.
+   * @returns the capture counters after clearing.
+   */
+  @Remote
+  async clear(): Promise<SecurityProxyCaptureStats> {
+    this.assertOwner('securityProxy/clear')
+    this.engine.clear()
+    return (await this.engine.state()).capture
+  }
+
+  /**
+   * Pause or resume capture; forwarding continues either way.
+   * @param paused - whether new flows are refused.
+   * @returns state after the change.
+   */
+  @Remote
+  async pause(paused: boolean): Promise<SecurityProxyState> {
+    this.assertOwner('securityProxy/pause')
+    return await this.engine.setPaused(paused)
+  }
+
+  /**
+   * Refuse an owner-only operation from a delegated Remote peer.
+   * @param action - the attempted Remote method.
+   */
+  private assertOwner(action: string): void {
+    if (principalOf(this.ctx.invocation) !== undefined) {
+      throw new RemoteError('security-proxy/owner-required', 'This security proxy operation requires the application owner.', { action })
+    }
+  }
+
+  private transportChanged(): void {
+    try { this.ctx.emit('security-proxy/transport-changed') }
+    catch (error) { this.ctx.logger.warn('Browser proxy notification failed; reopen browser tabs before continuing.', error) }
+  }
+}
diff --git a/packages/guard/security-proxy-local/src/settings.ts b/packages/guard/security-proxy-local/src/settings.ts
new file mode 100644
index 00000000..0c7024ca
--- /dev/null
+++ b/packages/guard/security-proxy-local/src/settings.ts
@@ -0,0 +1,227 @@
+/**
+ * Durable settings for the security-mode egress proxy, and the validation every
+ * write passes before it reaches the file. The file holds no credential: the
+ * upstream password lives in the credential store under
+ * {@link PROXY_PASSWORD_REF} and is resolved per operation.
+ * @module @deepseek-ai/dsh-security-proxy-local/settings
+ */
+
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises'
+import { dirname } from 'node:path'
+import { z } from 'zod'
+import type {
+  SecurityProxyProtocol,
+  SecurityProxySettings,
+  SecurityProxySettingsPatch,
+} from '@deepseek-ai/dsh-security-proxy/types'
+
+/** Version of the settings document; a future incompatible layout bumps it. */
+export const SETTINGS_VERSION = 1
+
+/** Environment-style reference the upstream password is stored under. */
+export const PROXY_PASSWORD_REF = 'DSH_SECURITY_PROXY_PASSWORD'
+
+/** Stored settings lack the credential-presence flag, which is read from the credential store. */
+export type StoredSettings = Omit<SecurityProxySettings, 'hasPassword'>
+
+/** Defaults an absent file supplies: the feature is off and warns about nothing. */
+export const DEFAULT_SETTINGS: StoredSettings = {
+  enabled: false,
+  protocol: 'http',
+  host: '',
+  port: 8080,
+  authEnabled: false,
+  username: '',
+  warnWhenDisabled: false,
+  capturePaused: false,
+  maxFlows: 500,
+  maxBodyBytes: 1_048_576,
+  retentionMinutes: 1_440,
+}
+
+/** Bounds the settings surface and the capture store both enforce. */
+export const SETTINGS_BOUNDS = {
+  maxFlows: { min: 1, max: 5_000 },
+  maxBodyBytes: { min: 1_024, max: 4_194_304 },
+  retentionMinutes: { min: 1, max: 10_080 },
+} as const
+
+const protocol = z.enum(['http', 'https'])
+
+const storedSettingsSchema = z.object({
+  enabled: z.boolean(),
+  protocol,
+  host: z.string(),
+  port: z.number().int().min(1).max(65_535),
+  authEnabled: z.boolean(),
+  username: z.string(),
+  warnWhenDisabled: z.boolean(),
+  capturePaused: z.boolean(),
+  maxFlows: z.number().int().min(SETTINGS_BOUNDS.maxFlows.min).max(SETTINGS_BOUNDS.maxFlows.max),
+  maxBodyBytes: z.number().int().min(SETTINGS_BOUNDS.maxBodyBytes.min).max(SETTINGS_BOUNDS.maxBodyBytes.max),
+  retentionMinutes: z.number().int().min(SETTINGS_BOUNDS.retentionMinutes.min).max(SETTINGS_BOUNDS.retentionMinutes.max),
+})
+
+/** The persisted document's outer envelope, validated on load. */
+const settingsFileSchema = z.object({
+  version: z.literal(SETTINGS_VERSION),
+  settings: storedSettingsSchema,
+})
+
+/** A value the settings surface rejected; the message names the field, never a secret. */
+export class SettingsValidationError extends Error {
+  override readonly name = 'SettingsValidationError'
+}
+
+/**
+ * Validate one host/port pair as a usable upstream address.
+ * @param host - candidate host name or IP literal.
+ * @param port - candidate TCP port.
+ * @throws {SettingsValidationError} when either half is unusable.
+ */
+export function assertUpstream(host: string, port: number): void {
+  if (host.trim() === '') throw new SettingsValidationError('upstream host is required')
+  if (/\s/.test(host)) throw new SettingsValidationError('upstream host must not contain whitespace')
+  if (!Number.isInteger(port) || port < 1 || port > 65_535) {
+    throw new SettingsValidationError('upstream port must be an integer between 1 and 65535')
+  }
+}
+
+/**
+ * Merge one validated patch over the stored settings.
+ * @param current - the settings in force.
+ * @param patch - fields the owner changed; omitted fields keep their value.
+ * @returns the next settings, valid by construction.
+ * @throws {SettingsValidationError} when a supplied field is out of bounds.
+ */
+export function applyPatch(current: StoredSettings, patch: SecurityProxySettingsPatch): StoredSettings {
+  const next: StoredSettings = {
+    ...current,
+    ...patch.enabled === undefined ? {} : { enabled: patch.enabled },
+    ...patch.protocol === undefined ? {} : { protocol: patch.protocol },
+    ...patch.host === undefined ? {} : { host: patch.host.trim() },
+    ...patch.port === undefined ? {} : { port: patch.port },
+    ...patch.authEnabled === undefined ? {} : { authEnabled: patch.authEnabled },
+    ...patch.username === undefined ? {} : { username: patch.username },
+    ...patch.warnWhenDisabled === undefined ? {} : { warnWhenDisabled: patch.warnWhenDisabled },
+    ...patch.capturePaused === undefined ? {} : { capturePaused: patch.capturePaused },
+    ...patch.maxFlows === undefined ? {} : { maxFlows: patch.maxFlows },
+    ...patch.maxBodyBytes === undefined ? {} : { maxBodyBytes: patch.maxBodyBytes },
+    ...patch.retentionMinutes === undefined ? {} : { retentionMinutes: patch.retentionMinutes },
+  }
+  if (!protocol.safeParse(next.protocol).success) {
+    throw new SettingsValidationError('upstream protocol must be http or https')
+  }
+  if (next.authEnabled && next.username.trim() === '') {
+    throw new SettingsValidationError('authentication requires a user name')
+  }
+  assertBounds(next)
+  if (next.enabled) assertUpstream(next.host, next.port)
+  return next
+}
+
+/** Reject a complete settings value whose bounded numbers fall outside {@link SETTINGS_BOUNDS}. */
+function assertBounds(settings: StoredSettings): void {
+  for (const field of ['maxFlows', 'maxBodyBytes', 'retentionMinutes'] as const) {
+    const { min, max } = SETTINGS_BOUNDS[field]
+    const value = settings[field]
+    if (!Number.isInteger(value) || value < min || value > max) {
+      throw new SettingsValidationError(`${field} must be an integer between ${String(min)} and ${String(max)}`)
+    }
+  }
+}
+
+/** The persisted document this store writes. */
+interface SettingsDocument {
+  readonly version: typeof SETTINGS_VERSION
+  readonly settings: StoredSettings
+}
+
+/**
+ * One settings file shared by every Agent this Host runs.
+ *
+ * Writes are serialized and atomic: a temporary sibling is written and renamed
+ * over the target, so a crash leaves either the previous or the next document,
+ * never a partial one. A load failure keeps the defaults in memory and reports
+ * the diagnostic instead of taking the Host down.
+ */
+export class SettingsStore {
+  private current: StoredSettings
+  private writeChain: Promise<void> = Promise.resolve()
+  private loadFailureDetail: string | null = null
+
+  private constructor(
+    private readonly path: string,
+    initial: StoredSettings,
+  ) {
+    this.current = initial
+  }
+
+  /**
+   * Open the settings file, falling back to defaults when it is absent.
+   * @param path - absolute settings file path.
+   * @returns the opened store; a malformed document is reported through {@link failure}.
+   */
+  static async open(path: string): Promise<SettingsStore> {
+    let text: string
+    try {
+      text = await readFile(path, 'utf8')
+    } catch (error: unknown) {
+      if ((error as NodeJS.ErrnoException).code === 'ENOENT') return new SettingsStore(path, { ...DEFAULT_SETTINGS })
+      const store = new SettingsStore(path, { ...DEFAULT_SETTINGS })
+      store.loadFailureDetail = `settings file is unreadable: ${String(error)}`
+      return store
+    }
+    try {
+      const value: unknown = JSON.parse(text)
+      const parsed = settingsFileSchema.parse(value)
+      return new SettingsStore(path, parsed.settings)
+    } catch (error: unknown) {
+      const store = new SettingsStore(path, { ...DEFAULT_SETTINGS })
+      store.loadFailureDetail = `settings file is not a valid security proxy document: ${String(error)}`
+      return store
+    }
+  }
+
+  /** The settings in force. */
+  get value(): StoredSettings {
+    return this.current
+  }
+
+  /** Why the last load failed, or null when the document was readable. */
+  get failure(): string | null {
+    return this.loadFailureDetail
+  }
+
+  /**
+   * Replace the settings and wait for the write to commit.
+   * @param next - validated settings to persist.
+   */
+  async write(next: StoredSettings): Promise<void> {
+    assertBounds(next)
+    const document: SettingsDocument = { version: SETTINGS_VERSION, settings: next }
+    const body = `${JSON.stringify(document, null, 2)}\n`
+    const write = this.writeChain.then(async () => {
+      await mkdir(dirname(this.path), { recursive: true })
+      const temporary = `${this.path}.tmp`
+      await writeFile(temporary, body, { encoding: 'utf8', mode: 0o600 })
+      await rename(temporary, this.path)
+      this.current = next
+      this.loadFailureDetail = null
+    })
+    this.writeChain = write.catch(() => {
+      // A failed write keeps the previous document; the caller receives the rejection
+      // from `write` and the chain stays usable for the next attempt.
+    })
+    await write
+  }
+}
+
+/**
+ * Whether a raw string names one supported upstream transport.
+ * @param value - candidate transport name.
+ * @returns true for http or https.
+ */
+export function isProtocol(value: string): value is SecurityProxyProtocol {
+  return value === 'http' || value === 'https'
+}
diff --git a/packages/guard/security-proxy-local/src/upstream.ts b/packages/guard/security-proxy-local/src/upstream.ts
new file mode 100644
index 00000000..ff48f7d8
--- /dev/null
+++ b/packages/guard/security-proxy-local/src/upstream.ts
@@ -0,0 +1,228 @@
+/**
+ * The configured upstream proxy: its address, its Proxy-Authorization value, the
+ * dispatcher every proxied request uses, and the CONNECT primitive the chain
+ * proxy and the connection check share.
+ *
+ * TLS verification is never relaxed here. A `https:` upstream is reached through
+ * `node:https` with Node's default trust store, and origin TLS stays end-to-end
+ * through the tunnel.
+ * @module @deepseek-ai/dsh-security-proxy-local/upstream
+ */
+
+import { request as httpRequest } from 'node:http'
+import { request as httpsRequest } from 'node:https'
+import type { Socket } from 'node:net'
+import { isIP } from 'node:net'
+import { ProxyAgent } from 'undici'
+import { deadline, timeoutOf } from '@deepseek-ai/dsh-timeout'
+import type { SecurityProxyFailure, SecurityProxyProtocol } from '@deepseek-ai/dsh-security-proxy/types'
+
+/** One resolved upstream proxy, credentials included. Never logged or stored in this form. */
+export interface Upstream {
+  readonly protocol: SecurityProxyProtocol
+  readonly host: string
+  readonly port: number
+  readonly username: string
+  readonly password: string | undefined
+}
+
+/** A classified transport failure the settings surface can render without a transport vocabulary. */
+export class UpstreamFailure extends Error {
+  override readonly name = 'UpstreamFailure'
+
+  /**
+   * @param failure - stable reason the Client localizes.
+   * @param detail - unlocalized diagnostic; carries no credential.
+   */
+  constructor(
+    readonly failure: SecurityProxyFailure,
+    detail: string,
+    options?: ErrorOptions,
+  ) {
+    super(detail, options)
+  }
+}
+
+/** One open tunnel to a target, and its upstream response status. */
+export interface UpstreamTunnel {
+  readonly socket: Socket
+  readonly status: number
+}
+
+/**
+ * The proxy URL without credentials, for diagnostics and the dispatcher URI.
+ * @param upstream - configured upstream.
+ * @returns `protocol://host:port`.
+ */
+export function proxyUrl(upstream: Upstream): string {
+  const host = isIP(upstream.host) === 6 ? `[${upstream.host}]` : upstream.host
+  return `${upstream.protocol}://${host}:${String(upstream.port)}`
+}
+
+/**
+ * Resolve the Proxy-Authorization header value.
+ * @param upstream - configured upstream.
+ * @returns the header value, or undefined when authentication is off.
+ * @throws {UpstreamFailure} when authentication is on but no password is stored.
+ */
+export function proxyAuthorization(upstream: Upstream): string | undefined {
+  if (upstream.password === undefined && upstream.username === '') return undefined
+  if (upstream.password === undefined) {
+    throw new UpstreamFailure('auth', 'the upstream proxy password is not configured')
+  }
+  return `Basic ${Buffer.from(`${upstream.username}:${upstream.password}`).toString('base64')}`
+}
+
+/**
+ * Build the dispatcher for this upstream. One dispatcher serves every request for
+ * one settings value; a settings change closes it and builds the next.
+ * @param upstream - configured upstream.
+ * @returns the dispatcher to hand to `fetch`.
+ */
+export function createDispatcher(upstream: Upstream): ProxyAgent {
+  const token = proxyAuthorization(upstream)
+  // proxy-exempt: this explicitly configured Security proxy has credentials and routing independent of the global proxy.
+  return new ProxyAgent({
+    uri: proxyUrl(upstream),
+    ...token === undefined ? {} : { token },
+  })
+}
+
+/**
+ * The innermost transport error of one failure chain. `fetch` reports a bare
+ * `TypeError('fetch failed')` and keeps the socket's `code` on its cause, so the
+ * classification must read through the chain rather than the outer message.
+ * @param error - the thrown value.
+ * @returns the deepest value carrying a Node error code, or the input.
+ */
+function rootCause(error: unknown): unknown {
+  let current = error
+  for (let depth = 0; depth < 4; depth += 1) {
+    const cause = (current as { cause?: unknown } | undefined)?.cause
+    if (cause === undefined || cause === current) return current
+    current = cause
+  }
+  return current
+}
+
+/**
+ * Map a transport error to a stable failure reason.
+ * @param error - the thrown value, possibly wrapping its own cause.
+ * @returns the reason the settings surface renders.
+ */
+export function classifyFailure(error: unknown): SecurityProxyFailure {
+  if (error instanceof UpstreamFailure) return error.failure
+  const deepest = rootCause(error)
+  const code = (deepest as NodeJS.ErrnoException | undefined)?.code
+    ?? (error as NodeJS.ErrnoException | undefined)?.code
+    ?? ''
+  const name = (deepest as Error | undefined)?.name ?? (error as Error | undefined)?.name ?? ''
+  if (code === 'ERR_PROXY_AUTH' || code === 'ERR_INVALID_PROXY') return 'auth'
+  if (code === 'ETIMEDOUT' || code === 'UND_ERR_CONNECT_TIMEOUT' || name === 'AbortError' || name === 'TimeoutError') return 'timeout'
+  if (code.startsWith('ERR_TLS') || code.startsWith('CERT_') || code.includes('SELF_SIGNED') || code === 'DEPTH_ZERO_SELF_SIGNED_CERT') return 'tls'
+  if (code === 'ECONNREFUSED' || code === 'ENOTFOUND' || code === 'EAI_AGAIN' || code === 'ECONNRESET' || code === 'EHOSTUNREACH' || code === 'ENETUNREACH') return 'unreachable'
+  return 'unknown'
+}
+
+/**
+ * Explain one failure without repeating a secret.
+ * @param error - the thrown value.
+ * @returns an unlocalized diagnostic; carries no credential.
+ */
+export function describeFailure(error: unknown): string {
+  const deepest = rootCause(error)
+  const code = (deepest as NodeJS.ErrnoException | undefined)?.code
+  if (error instanceof Error) {
+    const message = deepest instanceof Error ? deepest.message : error.message
+    return code === undefined ? message : `${code}: ${message}`
+  }
+  return String(error)
+}
+
+/**
+ * Open one CONNECT tunnel through the upstream.
+ *
+ * The request goes to the proxy itself (TLS-verified when the upstream is
+ * `https:`), asks for `host:port`, and resolves only after the proxy answers
+ * `2xx`. A `407` is classified as an authentication failure; any other non-2xx
+ * is a proxy refusal.
+ * @param upstream - configured upstream.
+ * @param host - target host the proxy should reach.
+ * @param port - target port the proxy should reach.
+ * @param timeoutMs - whole-handshake budget.
+ * @param signal - caller cancellation.
+ * @returns the connected socket and the proxy's status.
+ */
+export async function connectThrough(
+  upstream: Upstream,
+  host: string,
+  port: number,
+  timeoutMs: number,
+  signal?: AbortSignal,
+): Promise<UpstreamTunnel> {
+  const authorization = proxyAuthorization(upstream)
+  signal?.throwIfAborted()
+  const authority = `${isIP(host) === 6 ? `[${host}]` : host}:${String(port)}`
+  using bounded = deadline(signal ?? AbortSignal.any([]), timeoutMs, 'SECURITY_PROXY_CONNECT_TIMEOUT')
+  return await new Promise<UpstreamTunnel>((resolve, reject) => {
+    let outcome: UpstreamTunnel | UpstreamFailure | undefined
+    const send = upstream.protocol === 'https' ? httpsRequest : httpRequest
+    const request = send({
+      host: upstream.host,
+      port: upstream.port,
+      method: 'CONNECT',
+      path: authority,
+      headers: {
+        host: authority,
+        ...authorization === undefined ? {} : { 'proxy-authorization': authorization },
+      },
+      agent: false,
+      signal: bounded.signal,
+    })
+    request.once('connect', (response, socket, head) => {
+      if (outcome !== undefined || bounded.signal.aborted) { socket.destroy(); request.destroy(); return }
+      if (response.statusCode !== undefined && response.statusCode >= 200 && response.statusCode < 300) {
+        // The consumer installs its handlers after this promise resumes; retain errors during that interval on the socket.
+        socket.on('error', () => { socket.destroy() })
+        if (head.length > 0) socket.unshift(head)
+        outcome = { socket, status: response.statusCode }
+        resolve(outcome)
+        return
+      }
+      outcome = new UpstreamFailure(response.statusCode === 407 ? 'auth' : 'unreachable',
+        `the upstream proxy refused CONNECT ${authority} with HTTP ${String(response.statusCode)}`)
+      socket.destroy()
+      request.destroy()
+    })
+    request.once('error', (error) => {
+      outcome ??= timeoutOf(bounded.signal, 'SECURITY_PROXY_CONNECT_TIMEOUT') !== undefined
+        ? new UpstreamFailure('timeout', `the upstream proxy did not answer CONNECT within ${timeoutMs} ms`, { cause: error })
+        : error instanceof UpstreamFailure ? error
+          : new UpstreamFailure(classifyFailure(error), describeFailure(error), { cause: error })
+      request.destroy()
+    })
+    request.once('close', () => {
+      if (outcome instanceof UpstreamFailure) reject(outcome)
+      else if (outcome === undefined) reject(new UpstreamFailure('unreachable', 'the upstream closed before CONNECT completed'))
+    })
+    request.end()
+  })
+}
+
+/**
+ * Run one real proxy-path check: a CONNECT tunnel to the configured target,
+ * opened and closed. Nothing about TLS trust is relaxed, and no target body is
+ * requested.
+ * @param upstream - configured upstream.
+ * @param host - check target host.
+ * @param port - check target port.
+ * @param timeoutMs - whole-check budget.
+ * @returns the handshake latency in milliseconds.
+ * @throws {UpstreamFailure} when the check fails.
+ */
+export async function checkUpstream(upstream: Upstream, host: string, port: number, timeoutMs: number): Promise<number> {
+  const started = performance.now()
+  const tunnel = await connectThrough(upstream, host, port, timeoutMs)
+  tunnel.socket.destroy()
+  return Math.round(performance.now() - started)
+}
diff --git a/packages/guard/security-proxy-local/tests/capture.spec.ts b/packages/guard/security-proxy-local/tests/capture.spec.ts
new file mode 100644
index 00000000..91d8b7be
--- /dev/null
+++ b/packages/guard/security-proxy-local/tests/capture.spec.ts
@@ -0,0 +1,212 @@
+import { describe, expect, it } from 'vitest'
+import {
+  CaptureStore,
+  headerEntries,
+  prepareBody,
+  truncateBody,
+  type CapturedExchangeInput,
+} from '../src/capture.ts'
+
+/** One captured exchange with sensible defaults. */
+function exchange(patch: Partial<CapturedExchangeInput> = {}): CapturedExchangeInput {
+  return {
+    at: Date.now(),
+    kind: 'http',
+    origin: 'client',
+    sessionId: 'session-a',
+    tool: 'web_fetch',
+    method: 'GET',
+    target: 'http://target.test/',
+    status: 200,
+    durationMs: 12,
+    requestBytes: 0,
+    responseBytes: 5,
+    outcome: 'complete',
+    note: null,
+    requestHeaders: [['accept', 'text/plain']],
+    responseHeaders: [['content-type', 'text/plain']],
+    requestBody: null,
+    responseBody: 'hello',
+    contentType: 'text/plain',
+    ...patch,
+  }
+}
+
+const limits = (patch: Partial<{ maxFlows: number; maxBodyBytes: number; retentionMs: number }> = {}) => ({
+  maxFlows: 3,
+  maxBodyBytes: 1_024,
+  retentionMs: 60_000,
+  ...patch,
+})
+
+describe('transparency', () => {
+  it('stores credential-bearing headers exactly as observed', () => {
+    expect(headerEntries([
+      ['Authorization', 'Bearer secret'],
+      ['proxy-authorization', 'Basic abc'],
+      ['Cookie', 'a=1'],
+      ['set-cookie', 'b=2'],
+      ['Referer', 'https://user:pass@example.test/?token=secret&display=a%20b'],
+      ['Location', '/callback?keep=1#access_token=secret&expires_in=300'],
+      ['accept', 'text/html'],
+    ])).toEqual([
+      { name: 'Authorization', value: 'Bearer secret' },
+      { name: 'proxy-authorization', value: 'Basic abc' },
+      { name: 'Cookie', value: 'a=1' },
+      { name: 'set-cookie', value: 'b=2' },
+      { name: 'Referer', value: 'https://user:pass@example.test/?token=secret&display=a%20b' },
+      { name: 'Location', value: '/callback?keep=1#access_token=secret&expires_in=300' },
+      { name: 'accept', value: 'text/html' },
+    ])
+  })
+})
+
+describe('body preparation', () => {
+  it('cuts at the byte budget without splitting a character', () => {
+    const text = '安全代理'
+    const cut = truncateBody(text, 7)
+    expect(cut.truncated).toBe(true)
+    expect(cut.text).toBe('安全')
+    expect(Buffer.byteLength(cut.text, 'utf8')).toBeLessThanOrEqual(7)
+  })
+
+  it('keeps a body that fits exactly', () => {
+    expect(truncateBody('abc', 3)).toEqual({ text: 'abc', truncated: false })
+  })
+
+  it('preserves an original replacement character at the UTF-8 capture boundary', () => {
+    expect(truncateBody('\uFFFD尾', 3)).toEqual({ text: '\uFFFD', truncated: true })
+  })
+
+  it('stores a binary media body as the text the transport decoded', () => {
+    expect(prepareBody('raw', 1_024)).toEqual({ body: 'raw', truncated: false })
+  })
+
+  it('reports truncation from the cap', () => {
+    expect(prepareBody('abcdef', 3)).toEqual({ body: 'abc', truncated: true })
+  })
+})
+
+describe('capture store', () => {
+  it('caps retained flows at maxFlows and keeps the newest', () => {
+    const store = new CaptureStore(() => limits({ maxFlows: 2 }))
+    store.append(exchange({ target: 'http://one/' }))
+    store.append(exchange({ target: 'http://two/' }))
+    store.append(exchange({ target: 'http://three/' }))
+    expect(store.list().map(flow => flow.target)).toEqual(['http://three/', 'http://two/'])
+    expect(store.stats(false)).toMatchObject({ retained: 2, total: 3 })
+  })
+
+  it('prunes entries past the retention window', () => {
+    let now = 1_000
+    const store = new CaptureStore(() => limits({ retentionMs: 1_000 }), () => now)
+    store.append(exchange({ at: now }))
+    now = 2_500
+    expect(store.list()).toEqual([])
+  })
+
+  it('filters by session, kind, text, and limit', () => {
+    const store = new CaptureStore(() => limits({ maxFlows: 10 }))
+    store.append(exchange({ sessionId: 'a', target: 'http://alpha/' }))
+    store.append(exchange({ sessionId: 'b', target: 'http://beta/', kind: 'tunnel', method: 'CONNECT', status: null }))
+    expect(store.list({ sessionId: 'a' })).toHaveLength(1)
+    expect(store.list({ kind: 'tunnel' })[0]?.target).toBe('http://beta/')
+    expect(store.list({ text: 'ALPHA' })[0]?.target).toBe('http://alpha/')
+    expect(store.list({ limit: 1 })).toHaveLength(1)
+  })
+
+  it('stores headers verbatim and a detail view that matches the list row', () => {
+    const store = new CaptureStore(() => limits())
+    const stored = store.append(exchange({
