new file mode 100644
index 00000000..6cc45530
--- /dev/null
+++ b/packages/guard/spend-limit/tests/process.spec.ts
@@ -0,0 +1,38 @@
+import { expect, it } from 'vitest'
+import { fork } from 'node:child_process'
+import { once } from 'node:events'
+import { mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { SpendLedger, DEFAULT_PREFERENCES } from '../src/ledger.ts'
+
+it('atomically excludes competing reservations from independent processes', async () => {
+  const directory = await mkdtemp(join(tmpdir(), 'dshu-budget-process-'))
+  const path = join(directory, 'spending.sqlite')
+  const ledger = await SpendLedger.open(path)
+  const peers: { child: ReturnType<typeof fork>; closed: Promise<[number | null, NodeJS.Signals | null]> }[] = []
+  try {
+    ledger.configure({ ...DEFAULT_PREFERENCES, enabledPeriods: ['15m', '1h', '5h', '1d', '7d', '30d'], autoResume: true })
+    const started = [0, 1].map(() => {
+      const child = fork(fileURLToPath(new URL('./fixtures/process-ledger.ts', import.meta.url)), [path], {
+        execArgv: ['--import', 'tsx/esm'], env: { ...process.env, TSX_TSCONFIG_PATH: join(process.cwd(), 'tsconfig.base.json') }, stdio: ['ignore', 'ignore', 'inherit', 'ipc'],
+      })
+      const closed = new Promise<[number | null, NodeJS.Signals | null]>((resolve) => { child.once('exit', (code, signal) => { resolve([code, signal]) }) })
+      peers.push({ child, closed })
+      return once(child, 'message')
+    })
+    expect((await Promise.all(started)).map((reply): unknown => reply[0])).toEqual(['ready', 'ready'])
+    const admitted = peers.map(({ child }) => { const reply = once(child, 'message'); child.send('reserve'); return reply })
+    expect((await Promise.all(admitted)).map((reply): unknown => reply[0]).sort()).toEqual(['reserved', 'waiting'])
+    expect(ledger.snapshot().windows[0]?.reserved).toBe(4)
+    for (const { child } of peers) child.send('finish')
+    expect(await Promise.all(peers.map(peer => peer.closed))).toEqual([[0, null], [0, null]])
+    expect(ledger.snapshot().windows[0]?.reserved).toBe(0)
+  } finally {
+    for (const { child } of peers) if (child.exitCode === null && child.signalCode === null) child.kill()
+    await Promise.all(peers.map(peer => peer.closed))
+    ledger.close()
+    await rm(directory, { recursive: true, force: true })
+  }
+})
diff --git a/packages/guard/spend-limit/tests/recovery.spec.ts b/packages/guard/spend-limit/tests/recovery.spec.ts
new file mode 100644
index 00000000..01e4339d
--- /dev/null
+++ b/packages/guard/spend-limit/tests/recovery.spec.ts
@@ -0,0 +1,89 @@
+import { afterEach, expect, it, vi } from 'vitest'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import { SpendGate } from '../src/gate.ts'
+import { SpendLedger, MICRO_CNY } from '../src/ledger.ts'
+import type { SpendPauseClaim } from '../src/ledger.ts'
+import { SpendRecovery } from '../src/continuation.ts'
+import { DEFAULT_RATES } from '../src/pricing.ts'
+
+const owned: { recovery: SpendRecovery; gate: SpendGate }[] = []
+afterEach(async () => { for (const { recovery, gate } of owned.splice(0)) { await recovery.close(); await gate.close() } })
+
+async function fixture() {
+  const ledger = await SpendLedger.open(':memory:')
+  const gate = new SpendGate(ledger, DEFAULT_RATES, 50, () => true)
+  const report = vi.fn()
+  const recovery = new SpendRecovery(report)
+  owned.push({ recovery, gate })
+  const id = ledger.waitForSession(SessionId('paused'), MICRO_CNY)
+  ledger.blockSession(id)
+  return { ledger, gate, recovery, report, id }
+}
+
+it('leaves records durable without a provider, on unavailable sessions, and on reported failures', async () => {
+  const { ledger, gate, recovery, report, id } = await fixture()
+  await recovery.flush(gate)
+  expect(ledger.snapshot().pausedSessions).toHaveLength(1)
+  const handler = vi.fn(async () => 'unavailable' as const)
+  const remove = recovery.register(handler, () => true)
+  await recovery.flush(gate)
+  expect(handler).toHaveBeenCalledWith({ id, sessionId: 'paused' }, expect.any(AbortSignal))
+  expect(ledger.snapshot().pausedSessions).toHaveLength(1)
+  handler.mockRejectedValueOnce(new Error('restore failed'))
+  await recovery.flush(gate)
+  expect(report).toHaveBeenCalledWith(expect.objectContaining({ message: 'restore failed' }))
+  expect(ledger.snapshot().pausedSessions).toHaveLength(1)
+  await remove()
+  recovery.register(async () => 'missing', () => true)
+  await recovery.flush(gate)
+  expect(ledger.snapshot().pausedSessions).toEqual([])
+})
+
+it('serializes recovery and drains a cancelled provider before releasing the ledger', async () => {
+  const { ledger, gate, recovery } = await fixture()
+  const entered = Promise.withResolvers<undefined>(), released = Promise.withResolvers<undefined>()
+  const handler = vi.fn(async (_claim: SpendPauseClaim, signal: AbortSignal) => {
+    entered.resolve(undefined)
+    await released.promise
+    signal.throwIfAborted()
+    return 'missing' as const
+  })
+  const remove = recovery.register(handler, () => true)
+  const first = recovery.flush(gate)
+  let removing: Promise<void> | undefined
+  try {
+    await vi.waitFor(() => { expect(handler).toHaveBeenCalledOnce() })
+    await entered.promise
+    expect(recovery.flush(gate)).toBe(first)
+    let removed = false
+    removing = remove().then(() => { removed = true })
+    await Promise.resolve()
+    expect(removed).toBe(false)
+    expect(ledger.snapshot().pausedSessions).toHaveLength(1)
+  } finally { released.resolve(undefined); await removing; await first }
+  expect(handler).toHaveBeenCalledOnce()
+  expect(ledger.snapshot().pausedSessions).toHaveLength(1)
+  expect(ledger.claimBlockedSessions()).toHaveLength(1)
+})
+
+it('skips a withdrawn pause while another restoration in the same batch is pending', async () => {
+  const { ledger, gate, recovery } = await fixture()
+  const secondId = ledger.waitForSession(SessionId('other-paused'), MICRO_CNY)
+  ledger.blockSession(secondId)
+  const release = Promise.withResolvers<undefined>()
+  const handler = vi.fn(async (_claim: SpendPauseClaim) => {
+    await release.promise
+    return 'missing' as const
+  })
+  recovery.register(handler, () => true)
+  const running = recovery.flush(gate)
+  try {
+    await vi.waitFor(() => { expect(handler).toHaveBeenCalledOnce() })
+    const first = handler.mock.calls[0]![0].sessionId
+    ledger.clearSession(SessionId(first === 'paused' ? 'other-paused' : 'paused'))
+    release.resolve(undefined)
+    await running
+    expect(handler).toHaveBeenCalledOnce()
+    expect(ledger.snapshot().pausedSessions).toEqual([])
+  } finally { release.resolve(undefined); await running }
+})
diff --git a/packages/guard/spend-limit/tests/session-usage.spec.ts b/packages/guard/spend-limit/tests/session-usage.spec.ts
new file mode 100644
index 00000000..b64b2bbc
--- /dev/null
+++ b/packages/guard/spend-limit/tests/session-usage.spec.ts
@@ -0,0 +1,206 @@
+import { expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import SessionStore, { SessionLogOffset, SessionSeq } from '@deepseek-ai/dsh-session'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import { RetryId } from '@deepseek-ai/dsh-llm-retry'
+import { sessionSpendUsage } from '../src/session-usage.ts'
+import SessionQueryEngine, { sideIdentity } from '@deepseek-ai/dsh-session-query'
+import SessionProjections from '@deepseek-ai/dsh-session-projection'
+import * as spending from '../src/index.ts'
+import { DEFAULT_RATES } from '../src/pricing.ts'
+import LlmRuntime, { createAssistantMessage, createUserMessage, MessageId } from '@deepseek-ai/dsh-llm'
+import { brandString } from '@deepseek-ai/dsh-brand'
+import type { MemoryExtractionId } from '@deepseek-ai/dsh-memory/types'
+
+const header = (seq: number, model = 'deepseek-flash'): SessionEvent<'request/header'> => ({
+  seq: SessionSeq(seq), time: seq * 1000, type: 'request/header',
+  data: { reason: 'initial', header: { config: { provider: 'deepseek-official', model } } },
+})
+const attempt = (seq: number, step = 1, input = 100): SessionEvent<'assistant/attempt'> => ({
+  seq: SessionSeq(seq), time: seq * 1000, type: 'assistant/attempt',
+  data: { turn: 1, step, stream: [{ type: 'chunk', time: 0, chunk: { type: 'usage', usage: { inputTokens: input, outputTokens: 20 } } }] },
+})
+
+it('prices a prediction on its recorded route while another assistant settlement is pending', () => {
+  const requestId = brandString<NonNullable<SessionEvent<'input/prediction'>['data']['requestId']>>('prediction-1')
+  const common = { surface: 'side', revision: 1, draft: 'Page', instruction: 'Complete', context: 'Proof', suggestion: '', requestId } as const
+  const request: SessionEvent<'input/prediction'> = { type: 'input/prediction', time: 2000, seq: SessionSeq(2),
+    data: { ...common, phase: 'request', request: { provider: 'deepseek-official', model: 'deepseek-flash', maxTokens: 128,
+      message: { id: MessageId('prediction-message'), role: 'user', content: [{ type: 'text', text: 'Complete Page' }],
+        source: { kind: 'input-prediction', form: 'notice', summary: 'Composer suggestion' } } } } }
+  const result: SessionEvent<'input/prediction'> = { type: 'input/prediction', time: 3000, seq: SessionSeq(3),
+    data: { ...common, phase: 'result', outcome: 'completed', suggestion: ' margins.', usage: { inputTokens: 12, outputTokens: 4 } } }
+  const otherId = brandString<typeof requestId>('prediction-2')
+  const other = { ...request, seq: SessionSeq(3), data: { ...common, requestId: otherId, phase: 'request' as const } }
+  const failed = { ...result, seq: SessionSeq(4), data: { ...common, requestId: otherId, phase: 'result' as const, outcome: 'cancelled' as const } }
+  expect(sessionSpendUsage([request, other, failed, { ...result, seq: SessionSeq(5) }], DEFAULT_RATES, SessionLogOffset(0)))
+    .toMatchObject({ total: .000056, requests: 2, unpricedRequests: 1 })
+  const events = [header(0, 'unpriced-model'), attempt(1), request, result, attempt(4)]
+  expect(sessionSpendUsage(events, DEFAULT_RATES, SessionLogOffset(0))).toEqual({
+    total: .000056, requests: 2, unpricedRequests: 1,
+    points: [{ time: 3000, total: .000056 }, { time: 4000, total: .000056 }],
+  })
+  expect(sessionSpendUsage(events, DEFAULT_RATES, SessionLogOffset(3))).toMatchObject({ total: 0, requests: 1, unpricedRequests: 1 })
+  expect(sessionSpendUsage([request], DEFAULT_RATES, SessionLogOffset(0))).toMatchObject({ requests: 1, unpricedRequests: 1 })
+  const { surface, phase, revision, draft, instruction, context, suggestion } = request.data
+  const old = { surface, phase, revision, draft, instruction, context, suggestion }
+  expect(sessionSpendUsage([{ ...request, data: old }, result], DEFAULT_RATES, SessionLogOffset(0)))
+    .toMatchObject({ total: 0, requests: 1, unpricedRequests: 1 })
+})
+
+it('replaces a repeated usage settlement and counts a real retry separately', () => {
+  const events: SessionEvent[] = [header(0), attempt(1), attempt(2),
+    { seq: SessionSeq(3), time: 3000, type: 'llm/retry-started', data: { turn: 1, step: 1, retry: 1, retryId: RetryId('retry') } },
+    attempt(4),
+  ]
+  const result = sessionSpendUsage(events, DEFAULT_RATES, SessionLogOffset(0))
+  expect(result).toMatchObject({ total: 0.00072, requests: 2, unpricedRequests: 0 })
+  expect(result.points).toEqual([{ time: 2000, total: 0.00036 }, { time: 4000, total: 0.00072 }])
+})
+
+it('prices the final reply from its recorded usage and leaves a missing route unpriced', () => {
+  const stream = attempt(1).data.stream
+  const message = createAssistantMessage({ source: { provider: 'deepseek-official', model: 'deepseek-flash' },
+    content: [{ type: 'text', text: 'Recorded reply' }] })
+  const reply: SessionEvent<'assistant/message'> = { type: 'assistant/message', surfaceOp: 'append', seq: SessionSeq(1), time: 1000,
+    data: { turn: 1, step: 1, stream, message } }
+  const final = { ...reply, data: { ...reply.data, usage: { inputTokens: 200, outputTokens: 20 } } }
+  expect(sessionSpendUsage([header(0), final], DEFAULT_RATES, SessionLogOffset(0)))
+    .toMatchObject({ total: 0.00056, requests: 1, unpricedRequests: 0 })
+  expect(sessionSpendUsage([header(0), reply], DEFAULT_RATES, SessionLogOffset(0)))
+    .toMatchObject({ total: 0.00036, requests: 1, unpricedRequests: 0 })
+  expect(sessionSpendUsage([reply], DEFAULT_RATES, SessionLogOffset(0)))
+    .toMatchObject({ total: 0, requests: 1, unpricedRequests: 1 })
+})
+
+it('excludes inherited work and reports unknown routes without inventing fees', () => {
+  const events: SessionEvent[] = [header(0), attempt(1),
+    { seq: SessionSeq(2), time: 2000, type: 'session/end-seed', data: { inherited: true } },
+    header(3, 'unpriced-model'), attempt(4, 2), header(5), attempt(6, 3),
+  ]
+  expect(sessionSpendUsage(events, DEFAULT_RATES, SessionLogOffset(2))).toMatchObject({ total: 0.00036, requests: 2, unpricedRequests: 1 })
+})
+
+it('publishes the recorded billing revision in session summaries', async () => {
+  const ctx = new Context()
+  try {
+    await ctx.plugin(SessionStore)
+    await ctx.plugin(SessionProjections)
+    await ctx.plugin(LlmRuntime)
+    const session = ctx.sessions.create()
+    const earlier = session.append('assistant/attempt', attempt(0).data)
+    const plugin = await ctx.plugin(spending, { path: ':memory:', pollMs: 1000, rates: DEFAULT_RATES })
+    const projection = ctx.sessionProjections
+    const read = () => projection.snapshot(session).values.sessionSpendRevision
+    expect(read()).toBe(earlier.seq)
+    const requestId = brandString<MemoryExtractionId>('extract-for-fees')
+    const request = session.append('memory/extraction', {
+      requestId, phase: 'request', turn: 1, throughSeq: 0, scope: { global: false, mode: 'writing' },
+      provider: 'deepseek-official', model: 'deepseek-flash', maxTokens: 100,
+      message: createUserMessage({ source: { kind: 'user' }, content: [{ type: 'text', text: 'Remember the format.' }] }),
+    })
+    expect(read()).toBe(request.seq)
+    const receipt = session.append('memory/extraction', {
+      requestId, phase: 'result', turn: 1, throughSeq: 0, outcome: 'completed', saved: [],
+      usage: { inputTokens: 20, outputTokens: 10 },
+    })
+    session.append('request/header', header(0).data)
+    expect(read()).toBe(receipt.seq)
+    expect(projection.viewCheckpoint(projection.checkpoint(session)).sessionSpendRevision).toBe(receipt.seq)
+    expect(projection.snapshot(session, projection.summaryKeys()).values).toHaveProperty('sessionSpendRevision', receipt.seq)
+    await plugin.dispose()
+    expect(read()).toBeUndefined()
+  } finally { await ctx.fiber.dispose() }
+})
+
+it('charges only the grandchild after two real forks and keeps the inherited route', async () => {
+  const ctx = new Context()
+  try {
+    await ctx.plugin(SessionStore)
+    const root = ctx.sessions.create()
+    root.append('request/header', header(0).data)
+    root.append('assistant/attempt', attempt(1).data)
+    const parent = ctx.sessions.fork(root)
+    parent.append('assistant/attempt', attempt(0, 2).data)
+    const child = ctx.sessions.fork(parent)
+    child.append('assistant/attempt', attempt(0, 3).data)
+    const usage = sessionSpendUsage(child.snapshotEvents(), DEFAULT_RATES, child.inheritedEventCount)
+    expect(usage).toMatchObject({ total: 0.00036, requests: 1, unpricedRequests: 0 })
+    expect(usage.points).toHaveLength(1)
+  } finally { await ctx.fiber.dispose() }
+})
+
+class BillingSessionQuery extends SessionQueryEngine {
+  override searchSessions(): never { throw new Error('Search is not used for billing') }
+  override searchEvents(): never { throw new Error('Search is not used for billing') }
+}
+
+it('counts every native side generation once and preserves the separate cost of a normal fork', async () => {
+  const ctx = new Context()
+  try {
+    await ctx.plugin(SessionStore)
+    await ctx.plugin(SessionProjections)
+    await ctx.plugin(BillingSessionQuery)
+    await ctx.plugin(LlmRuntime)
+    await ctx.plugin(spending, { path: ':memory:', pollMs: 1000, rates: DEFAULT_RATES })
+    const root = ctx.sessions.create()
+    root.append('request/header', header(0).data)
+    root.append('assistant/attempt', attempt(1).data)
+
+    const seed = root.snapshotEvents()
+    const side = ctx.sessions.create(sideIdentity(root.id), {
+      seed, inheritedEventCount: SessionLogOffset(seed.length), meta: { isSeeded: true, parentSession: root.id },
+    })
+    side.append('assistant/attempt', attempt(1).data)
+    const cleared = ctx.sessions.create(sideIdentity(root.id, 1), { meta: { parentSession: root.id } })
+    cleared.append('request/header', header(0).data)
+    cleared.append('assistant/attempt', attempt(1).data)
+    const fork = ctx.sessions.fork(root)
+    fork.append('assistant/attempt', attempt(1).data)
+
+    const total = await ctx.spendLimit.sessionUsage(root.id)
+    expect(total).toMatchObject({ total: .00108, requests: 3, unpricedRequests: 0 })
+    expect(total.points.map(point => point.total)).toEqual([.00036, .00072, .00108])
+    expect(await ctx.spendLimit.sessionUsage(fork.id)).toMatchObject({ total: .00036, requests: 1 })
+  } finally { await ctx.fiber.dispose() }
+})
+
+it('bounds curve payloads while preserving the exact total and end points', () => {
+  const events = [header(0), ...Array.from({ length: 1000 }, (_, index) => attempt(index + 1, index + 1))]
+  const result = sessionSpendUsage(events, DEFAULT_RATES, SessionLogOffset(0))
+  expect(result.total).toBe(0.36)
+  expect(result.points).toHaveLength(240)
+  expect(result.points.at(-1)).toEqual({ time: 1_000_000, total: 0.36 })
+})
+
+it('accounts extraction once using its recorded route without changing the main model route', () => {
+  const requestId = brandString<MemoryExtractionId>('extraction-1')
+  const request: SessionEvent<'memory/extraction'> = {
+    type: 'memory/extraction', seq: SessionSeq(2), time: 2000,
+    data: { requestId, phase: 'request', turn: 1, throughSeq: 1, scope: { global: false, mode: 'standard' },
+      provider: 'deepseek-official', model: 'deepseek-flash', maxTokens: 200,
+      message: createUserMessage({ source: { kind: 'user' }, content: [{ type: 'text', text: 'Extract memory' }] }) },
+  }
+  const receipt: SessionEvent<'memory/extraction'> = {
+    type: 'memory/extraction', seq: SessionSeq(3), time: 3000,
+    data: { requestId, phase: 'result', turn: 1, throughSeq: 1, outcome: 'completed', saved: [],
+      usage: { inputTokens: 100, outputTokens: 20 } },
+  }
+  const events = [header(0), attempt(1), request, receipt, attempt(4, 2)]
+  const result = sessionSpendUsage(events, DEFAULT_RATES, SessionLogOffset(0))
+  expect(result).toMatchObject({ total: 0.00108, requests: 3, unpricedRequests: 0 })
+  expect(result.points).toHaveLength(3)
+  expect(sessionSpendUsage(events.slice(0, 3), DEFAULT_RATES, SessionLogOffset(0)))
+    .toMatchObject({ total: 0.00036, requests: 2, unpricedRequests: 1 })
+  expect(sessionSpendUsage([request, receipt, receipt], DEFAULT_RATES, SessionLogOffset(0)))
+    .toMatchObject({ total: 0.00036, requests: 1, unpricedRequests: 0 })
+  expect(sessionSpendUsage(events, DEFAULT_RATES, SessionLogOffset(3)))
+    .toMatchObject({ total: 0.00036, requests: 1, unpricedRequests: 0 })
+  expect(sessionSpendUsage([request, receipt], [], SessionLogOffset(0)))
+    .toMatchObject({ total: 0, requests: 1, unpricedRequests: 1 })
+  const cancelled: SessionEvent<'memory/extraction'> = { ...receipt, data: {
+    requestId, phase: 'result', turn: 1, throughSeq: 1, outcome: 'cancelled', saved: [],
+  } }
+  expect(sessionSpendUsage([request, cancelled], DEFAULT_RATES, SessionLogOffset(0)))
+    .toMatchObject({ total: 0, requests: 1, unpricedRequests: 1 })
+})
