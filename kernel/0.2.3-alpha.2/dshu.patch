diff --git a/packages/client/ui-settings-account/src/client/spending.ts b/packages/client/ui-settings-account/src/client/spending.ts
new file mode 100644
index 0000000000000000000000000000000000000000..725fe80ffcd6442ad3bf2ea8ec2cb1c89bd80273
--- /dev/null
+++ b/packages/client/ui-settings-account/src/client/spending.ts
@@ -0,0 +1,55 @@
+/** Assemble the shared spending controls over the built-in Host ledger. */
+import type { Context } from '@deepseek-ai/cordis'
+import { type RemoteResult } from '@deepseek-ai/dsh-typert-protocol'
+import type { SpendSnapshot } from '@deepseek-ai/dsh-spend-limit/types'
+import { SpendingController } from './spending-controller.ts'
+import { SpendingSettings, SpendingToast, SpendingBanner } from './SpendingView.tsx'
+import type { SpendingInjected } from './SpendingView.tsx'
+
+import { spendingEn, spendingZh } from './spending-locales.ts'
+import type {} from '@deepseek-ai/dsh-spend-limit/remote'
+import type {} from '@deepseek-ai/dsh-client-ui-conversation/client'
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    /** Budget settings and pause notices. */
+    'settings.spending': keyof typeof spendingEn
+  }
+}
+
+async function unwrap(request: Promise<RemoteResult<SpendSnapshot>>): Promise<SpendSnapshot> {
+  const result = await request
+  if (!result.ok) throw result.error
+  return result.value
+}
+
+/**
+ * Register spending controls and feedback.
+ * @param ctx - Account plugin scope, independent of Settings panels.
+ */
+export function registerSpending(ctx: Context): void {
+  ctx.effect(() => ctx.locale.register('settings.spending', {
+    en: spendingEn, zh: spendingZh, de: spendingEn, es: spendingEn, fr: spendingEn, ja: spendingEn, pt: spendingEn, ru: spendingEn,
+  }), 'spending dictionaries')
+  ctx.inject(['remote.spending'], (scope) => {
+    scope.remoteAccess.whenAccess('spending/get', function* () {
+      const controller = new SpendingController(() => unwrap(scope.remote.spending.get()))
+      yield scope.effect(() => () => controller.dispose(), 'account: spending requests')
+      const inject = (): SpendingInjected => ({ hooks: { spending: controller.state }, refreshSpending: controller.refresh,
+        configureSpendingWindow: value => controller.mutate(() => unwrap(scope.remote.spending.configureWindow(value))),
+        setSpendingAutoResume: value => controller.mutate(() => unwrap(scope.remote.spending.setAutoResume(value))),
+        disableAllSpending: () => controller.mutate(() => unwrap(scope.remote.spending.disableAll())),
+        resetSpending: period => controller.mutate(() => unwrap(scope.remote.spending.reset(period))),
+        resumeSpending: () => controller.mutate(() => unwrap(scope.remote.spending.resume())), dismissSpendingToast: controller.dismiss })
+      yield scope.slots.inject('settings.section', () => scope.slots.register({ name: 'settings.section', id: 'spending', order: 10, label: () => scope.locale.bind('settings.spending')('spending.title'), locale: 'settings.spending', inject }, SpendingSettings))
+      yield scope.slots.inject('shell.overlay', () => scope.slots.register({ name: 'shell.overlay', id: 'spending-feedback', locale: 'settings.spending', inject }, SpendingToast))
+      yield scope.slots.inject('conversation.input.dock', () => scope.slots.register({
+        name: 'conversation.input.dock', id: 'spending-pause', order: -30, locale: 'settings.spending',
+        inject: () => {
+          const settings = scope.get('settingsNavigation')
+          return { ...inject(), ...settings === undefined ? {} : { openBudgetSettings: () => settings.openSection('spending') } }
+        },
+      }, SpendingBanner))
+    })
+  })
+}
