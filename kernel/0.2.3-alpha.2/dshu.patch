+/** Conservative published peak-rate quotes; unknown routes cannot pass an enabled limit. */
+import type { TokenUsage } from '@deepseek-ai/dsh-llm'
+import type { SpendRate } from './types.ts'
+
+/** Official Flash peak prices checked 2026-10-23; deployment configuration can replace them. */
+export const DEFAULT_RATES: SpendRate[] = [{ providers: ['deepseek-official', 'deepseek-account'], models: ['deepseek-flash', 'deepseek-v4-flash', 'deepseek-v4-flash-vision-exp'], input: 2, cachedInput: 0.04, cacheWrite: 2, output: 8, contextTokens: 1_000_000, maxOutputTokens: 256_000, searchRequest: 0.005 }]
+
+/**
+ * Calculate a conservative request reservation using the entire configured context allowance.
+ * @param rate - Matching deployment rate.
+ * @param maxTokens - Exact output ceiling from the request, or the configured provider default.
+ * @param searches - Maximum native search uses.
+ * @returns Integer micro-CNY; rounding always increases the estimate.
+ */
+export function reserveCost(rate: SpendRate, maxTokens: number | undefined, searches = 0): number {
+  return Math.ceil(rate.contextTokens * Math.max(rate.input, rate.cachedInput, rate.cacheWrite)
+    + (maxTokens ?? rate.maxOutputTokens) * rate.output + searches * rate.searchRequest * 1_000_000)
+}
+
+/**
+ * Price disjoint usage counters; reasoning tokens are already included in output tokens.
+ * @param rate - Rate captured before dispatch.
+ * @param usage - Complete final provider counters.
+ * @param searches - Successful native search uses.
+ * @returns Integer micro-CNY.
+ */
+export function usageCost(rate: SpendRate, usage: TokenUsage, searches = 0): number {
+  return Math.ceil(usage.inputTokens * rate.input + (usage.cacheReadTokens ?? 0) * rate.cachedInput
+    + (usage.cacheWriteTokens ?? 0) * rate.cacheWrite + usage.outputTokens * rate.output + searches * rate.searchRequest * 1_000_000)
+}
diff --git a/packages/guard/spend-limit/src/session-usage.ts b/packages/guard/spend-limit/src/session-usage.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0d77a0304d319c51d20df147cdf8979879ae3eae
--- /dev/null
+++ b/packages/guard/spend-limit/src/session-usage.ts
@@ -0,0 +1,49 @@
+/** Session-local estimates from durable usage; independent of whether admission limits are enabled. */
+import { lastAssistantStreamChunk } from '@deepseek-ai/dsh-llm'
+import type { SessionEvent, SessionLogOffset } from '@deepseek-ai/dsh-session'
+import type {} from '@deepseek-ai/dsh-llm-retry/types'
+import { usageCost } from './pricing.ts'
+import type { SessionSpendUsage, SpendRate } from './types.ts'
+
+/** Maximum points returned by the session-cost RPC; totals still cover every request. */
+const MAX_POINTS = 240
+
+/**
+ * Estimate this Session's own model responses and retries at the configured rates.
+ * @param events - Durable events including route headers and optional inherited prefix.
+ * @param rates - Current deployment rates; missing rates remain explicitly unpriced.
+ * @param inheritedEventCount - Session-validated length of the full inherited prefix, including ancestors.
+ * @returns CNY totals, coverage counts and a bounded cumulative curve.
+ */
+export function sessionSpendUsage(
+  events: readonly SessionEvent[], rates: readonly SpendRate[], inheritedEventCount: SessionLogOffset,
+): SessionSpendUsage {
+  let route: { provider: string; model: string } | undefined
+  let total = 0, unknown = 0, requests = 0
+  let last: { turn: number; step: number; cost: number; unknown: number } | undefined
+  let points: SessionSpendUsage['points'] = []
+  for (const event of events) {
+    if (event.type === 'request/header') route = event.data.header.config
+    if (event.seq < inheritedEventCount) continue
+    if (event.type === 'llm/retry-started') { last = undefined; continue }
+    if (event.type !== 'assistant/message' && event.type !== 'assistant/attempt') continue
+    const usage = event.type === 'assistant/message' && event.data.usage !== undefined
+      ? event.data.usage : lastAssistantStreamChunk(event.data.stream, 'usage')?.usage
+    const currentRoute = route
+    const rate = currentRoute === undefined ? undefined
+      : rates.find(value => value.providers.includes(currentRoute.provider) && value.models.includes(currentRoute.model))
+    const cost = rate === undefined || usage === undefined ? 0 : usageCost(rate, usage)
+    const unpriced = rate === undefined || usage === undefined ? 1 : 0
+    const replacing = last !== undefined && last.turn === event.data.turn && last.step === event.data.step
+    if (replacing && last !== undefined) { total -= last.cost; unknown -= last.unknown; points.pop() }
+    else requests++
+    total += cost; unknown += unpriced
+    points.push({ time: event.time, total: total / 1_000_000 })
+    last = { turn: event.data.turn, step: event.data.step, cost, unknown: unpriced }
+  }
+  if (points.length > MAX_POINTS) {
+    const keep = new Set(Array.from({ length: MAX_POINTS }, (_, index) => Math.round(index * (points.length - 1) / (MAX_POINTS - 1))))
+    points = points.filter((_, index) => keep.has(index))
+  }
+  return { total: total / 1_000_000, requests, unpricedRequests: unknown, points }
+}
diff --git a/packages/guard/spend-limit/src/types.ts b/packages/guard/spend-limit/src/types.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c733c79cc2f9d52824e7c125bea7e239f08df3a7
--- /dev/null
+++ b/packages/guard/spend-limit/src/types.ts
@@ -0,0 +1,91 @@
+/** Client-safe preferences and observations for the shared CNY spending ledger. */
+import type { Branded } from '@deepseek-ai/dsh-brand'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+
+declare module '@deepseek-ai/dsh-typert-protocol' {
+  interface RemoteErrorDetailsMap {
+    'spending/owner-required': { readonly action: string }
+  }
+}
+
+/** Identity of one durable reservation; never contains credentials or prompt text. */
+export type SpendReservationId = Branded<'SpendReservationId'>
+/** Stable identity of a paused model request and its eventual continuation. */
+export type SpendPauseId = Branded<'SpendPauseId'>
+/** Rolling periods, in increasing duration. */
+export type SpendPeriod = '15m' | '1h' | '5h' | '1d' | '7d' | '30d'
+/** User-owned preferences shared by processes using the same Uncensored home. */
+export interface SpendPreferences {
+  /** Only these rolling periods participate in request admission. */
+  enabledPeriods: SpendPeriod[]
+  autoResume: boolean
+  limits: Record<SpendPeriod, number>
+}
+/** One window's independent settings update. Omitted fields retain their stored values. */
+export interface SpendWindowUpdate {
+  period: SpendPeriod
+  enabled?: boolean
+  limit?: number
+}
+/** One rolling window, with amounts expressed in CNY. */
+export interface SpendWindow {
+  period: SpendPeriod
+  enabled: boolean
+  limit: number
+  spent: number
+  reserved: number
+  uncertain: number
+  remaining: number
+}
+/** One conversation waiting on a limit or left blocked by a dead process. */
+export interface SpendPausedSession {
+  sessionId: SessionId
+  state: 'waiting' | 'blocked'
+  /** This pause needs an explicit resume even when automatic recovery is enabled. */
+  requiresManualResume?: boolean
+  /** At least one enabled window is smaller than the original reservation, even when empty. */
+  exceedsLimit?: boolean
+  /** Estimated automatic admission time at current usage; null means manual recovery or unresolved reservations. Older Hosts omit it. */
+  resumeAt?: number | null
+}
+/** Durable totals and the local process's queued requests. */
+export interface SpendSnapshot {
+  preferences: SpendPreferences
+  paused: boolean
+  windows: SpendWindow[]
+  pending: number
+  waiting: number
+  /** Conversations that must continue when capacity returns. Waiting rows belong to a live process. */
+  pausedSessions: SpendPausedSession[]
+  nextExpiry: number | null
+  updatedAt: number
+}
+/** CNY prices per million tokens. Reservations use the uncached input rate. */
+export interface SpendRate {
+  /** Provider identifiers sharing this price schedule. */
+  providers: string[]
+  /** Model identifiers matched by this schedule. */
+  models: string[]
+  /** CNY per million uncached input tokens. */
+  input: number
+  /** CNY per million cached input tokens. */
+  cachedInput: number
+  /** CNY per million cache-creation tokens. */
+  cacheWrite: number
+  /** CNY per million output tokens. */
+  output: number
+  /** Context capacity used when reserving the maximum request cost. */
+  contextTokens: number
+  /** Output-token ceiling used for request reservations. */
+  maxOutputTokens: number
+  /** CNY per native search request, independent of token prices. */
+  searchRequest: number
+}
+
+/** Session-local model-response estimates at current configured prices, including retries but excluding inherited work. */
+export interface SessionSpendUsage {
+  total: number
+  requests: number
+  unpricedRequests: number
+  points: { time: number; total: number }[]
+}
