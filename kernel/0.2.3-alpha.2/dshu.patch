diff --git a/packages/bundle/web-app/presets/reverse.patch.yml b/packages/bundle/web-app/presets/reverse.patch.yml
new file mode 100644
index 00000000..bbd85cd7
--- /dev/null
+++ b/packages/bundle/web-app/presets/reverse.patch.yml
@@ -0,0 +1,159 @@
+# Built-in reverse-engineering composition. External analysis backends are configured separately.
+- insert:
+    - id: preset-reverse
+      name: '@deepseek-ai/dsh-agent-preset'
+      config:
+        id: reverse
+        order: 3
+        plugins:
+          - id: rea-tools
+            name: '@deepseek-ai/dsh-rea/agent'
+          - id: persona
+            name: '@deepseek-ai/dsh-persona'
+            config:
+              prefix: |-
+                You are a reverse-engineering analyst working with the user on the artifacts in this workspace. You reconstruct behavior from evidence and testable hypotheses, and you answer the user's actual question instead of touring the binary.
+
+                Establish identity before interpretation: hash, format, architecture, entry point, toolchain, packer. Preserve the original; patch and instrument copies. Every address or offset you cite names its module, its load base, and whether it is a file offset or a runtime address.
+
+                Separate raw bytes, disassembly, decompiler output, observed runtime behavior, and your interpretation. A recovered type, name, or struct is a hypothesis until a call site, a trace, or a test vector corroborates it. Prefer a discriminating experiment over another hour of reading.
+
+                Use the provider the host actually has — Ghidra, IDA, Binary Ninja, radare2/rizin, Hopper, dnSpy/ILSpy, JADX, Frida, x64dbg, gdb/lldb, capa, YARA, angr, z3. If a backend is missing, say which one and continue with what exists.
+
+                This mode ships field manuals as skills:
+                - reverse-triage — identity, packing, strings, first decision
+                - reverse-static — disassembly, decompilation, scripting the analysis
+                - reverse-dynamic — debuggers, tracing, Frida, unpacking, anti-analysis
+                - reverse-protocol — wire protocols, formats, crypto identification
+                - reverse-patch-keygen — patching, re-signing, keygen, symbolic solving
+                - reverse-mobile — APK/IPA, JADX, native libs, pinning bypass
+                - reverse-malware — config, C2, persistence, IOCs, YARA
+                - reverse-casebook — sample ledger, symbol map, hypotheses across sessions
+
+                Keep the sample ledger current (`node ../../shared/scripts/casefile.mjs` and `node ../../shared/scripts/sample.mjs`, resolved from the loaded skill directory) so the next session starts from evidence instead of from scratch.
+
+                Deliver the reconstruction, the working patch, the keygen, the extracted config, or the analysis — with the evidence that supports it and an explicit account of what remains unknown.
+          - id: agent-instructions
+            name: '@deepseek-ai/dsh-agent-instructions'
+            config:
+              maxBytes: 65536
+          - id: time-context
+            name: '@deepseek-ai/dsh-time-context'
+          # Cross-conversation memory for this mode: shared facts, conclusions,
+          # and settings are retrieved into the first request of each turn, and
+          # the model may save what the user explicitly asks to remember.
+          - id: memory-agent
+            name: '@deepseek-ai/dsh-memory/agent'
+            config:
+              mode: reverse
+          - id: tool-bash
+            name: '@deepseek-ai/dsh-tool-bash'
+            disabled: !!js process.platform === 'win32'
+          - id: tool-pwsh
+            name: '@deepseek-ai/dsh-tool-pwsh'
+            disabled: !!js process.platform !== 'win32'
+          - id: tool-fs
+            name: '@deepseek-ai/dsh-tool-fs'
+          - id: tool-fs-search
+            name: '@deepseek-ai/dsh-tool-fs-search'
+            config:
+              sampleOverCapGlobResults: false
+          - id: tool-jobs
+            name: '@deepseek-ai/dsh-tool-jobs'
+          - id: tool-schedule
+            name: '@deepseek-ai/dsh-tool-schedule'
+          - id: skill-filesystem
+            name: '@deepseek-ai/dsh-skill-filesystem'
+          - id: skill-playbooks
+            name: '@deepseek-ai/dsh-skill-playbooks'
+            config:
+              packs:
+                - reverse
+          - id: tool-skill
+            name: '@deepseek-ai/dsh-tool-skill'
+          - id: command-goal
+            name: '@deepseek-ai/dsh-command-goal'
+          - id: tool-goal
+            name: '@deepseek-ai/dsh-tool-goal'
+          - id: planning
+            name: cordis:group
+            group: true
+            isolate:
+              planMode: true
