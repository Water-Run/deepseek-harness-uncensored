+import * as Playbooks from '@deepseek-ai/dsh-skill-playbooks'
+import { expect, it } from 'vitest'
+
+it('honors an empty pack selection and removes the writing catalog when unmounted', async () => {
+  const ctx = new Context()
+  try {
+    await ctx.plugin(Skills)
+    await ctx.plugin(Playbooks, { packs: [] })
+    expect(await ctx.skills.list()).toEqual([])
+    const writing = await ctx.plugin(Playbooks, { packs: ['writing'] })
+    expect(await ctx.skills.list()).toHaveLength(7)
