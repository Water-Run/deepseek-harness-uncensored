+    subnets: [
+      [[0x2001, 0x4, 0x112, 0, 0, 0, 0, 0], 48],
+      [[0x2620, 0x4f, 0x8000, 0, 0, 0, 0, 0], 48],
+    ],
+  },
+  { name: 'deprecatedOrchid', subnets: [[[0x2001, 0x10, 0, 0, 0, 0, 0, 0], 28]] },
+  { name: 'orchid2', subnets: [[[0x2001, 0x20, 0, 0, 0, 0, 0, 0], 28]] },
+  { name: 'droneRemoteIdProtocolEntityTags', subnets: [[[0x2001, 0x30, 0, 0, 0, 0, 0, 0], 28]] },
