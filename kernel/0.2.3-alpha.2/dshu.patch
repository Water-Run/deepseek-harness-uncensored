+    await workspace.attachSession(sessionId)
+    await api.rename({ sessionId, title: 'Morning market' })
+    await api.selectModel({ sessionId, provider: 'quick-question-fixture', model: 'mock' })
+    const main = scaffold.ctx.agents.get(sessionId)!
+    main.followup(createUserMessage({ source: { kind: 'user' }, content: [{ type: 'text', text: 'Draft a market scene at dawn.' }] }))
+    await expect.poll(() => adapter.requests.length).toBe(1)
+    const browser = await chromium.launch()
+    try {
+      const page = await newEnglishPage(browser)
+      await page.goto(scaffold.authenticatedUrl)
+      const group = page.getByRole('treeitem').filter({ has: page.getByText('Writing workspace', { exact: true }) })
