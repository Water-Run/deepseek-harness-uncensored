diff --git a/packages/guard/security-proxy/src/index.ts b/packages/guard/security-proxy/src/index.ts
new file mode 100644
index 00000000..ec55691f
--- /dev/null
+++ b/packages/guard/security-proxy/src/index.ts
@@ -0,0 +1,232 @@
+/**
+ * Service Definition for the security-mode egress proxy seam (`ctx.securityProxy`).
+ *
+ * The seam answers three questions for a tool execution: whether this Agent's
+ * session is a security-mode session the proxy serves, which environment a child
+ * process needs to reach it, and how to retrieve one target through it while
+ * recording the exchange. The providing plugin owns configuration, the upstream
+ * connection, the loopback chain proxy, and the capture store; consumers never
+ * build ordinary transports of their own. Native enforcement retains an egress
+ * lease when it needs its own policy-checked gateway.
+ *
+ * The session's mode is read from its durable log, never from a tool argument: a
+ * consumer passes the executing {@link Agent}, and a call without one is never
+ * covered.
+ * @module @deepseek-ai/dsh-security-proxy
+ */
+
+import { Context, Service } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { WebFetchResult } from '@deepseek-ai/dsh-web'
+import type {
+  SecurityProxyCaptureStats,
+  SecurityProxyCaptureExport,
+  SecurityProxyExportQuery,
+  SecurityProxyFlowDetail,
+  SecurityProxyFlowQuery,
+  SecurityProxyFlowsResult,
+  SecurityProxyResponseCaptureLimit,
+  SecurityProxySettingsPatch,
+  SecurityProxyState,
+  SecurityProxyTestResult,
+  SecurityProxyProtocol,
+} from './types.ts'
+
+export type * from './types.ts'
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    securityProxy: SecurityProxyRuntime
+  }
+}
+
+/**
+ * Why one execution is covered. A consumer that receives a route may rely on
+ * both branches it names: the session is the attribution key, and the tool name
+ * is what the traffic list shows.
+ */
+export interface SecurityProxyRoute {
+  /** Conversation the exchange is attributed to. */
+  readonly sessionId: SessionId
+  /** Preset the session currently runs; `security` is the only covered value. */
+  readonly preset: string
+  /** Tool that is about to reach the network. */
+  readonly tool: string
+}
+
+/** Host-only raw exchange; the proxy owner assigns identity and redacts it before storage. */
+export type SecurityProxyCaptureInput = Omit<SecurityProxyFlowDetail,
+  'id' | 'requestHeaders' | 'responseHeaders' | 'bodyTruncated' | 'bodyLimits'> & {
+    readonly requestHeaders: readonly (readonly [string, string])[]
+    readonly responseHeaders: readonly (readonly [string, string])[]
+    /** Whether an upstream read or relay capture limit already shortened the response body. */
+    readonly bodyTruncated?: boolean
+    /** Which capture limit shortened the response body before storage, when known. */
+    readonly responseCaptureLimit?: SecurityProxyResponseCaptureLimit
+  }
+
+/** Host-only upstream snapshot. Credentials must never enter a Remote result or diagnostic. */
+export interface SecurityProxyUpstream {
+  readonly protocol: SecurityProxyProtocol
+  readonly host: string
+  readonly port: number
+  readonly username: string
+  readonly password: string | undefined
+}
+
+/** Native enforcement's retained use of one conversation's independent proxy and capture store. */
+export interface SecurityProxyEgressLease {
+  readonly upstream: SecurityProxyUpstream
+  /** Cancels when configuration, conversation, caller or provider ownership is withdrawn. */
+  readonly signal: AbortSignal
+  readonly capture: {
+    /** @param input - Observed exchange; conversation and tool attribution are overwritten by the owner.
+     * @returns The redacted stored flow, or undefined while capture is paused. */
+    append(input: SecurityProxyCaptureInput): SecurityProxyFlowDetail | undefined
+  }
+  /** @returns Whether the user currently pauses capture, without changing forwarding. */
+  paused(): boolean
+  /**
+   * Report delegated cleanup after the process range and gateway have closed.
+   * @param failure - Omitted for confirmed closure. An error reports untrusted closure and retains dependencies.
+   */
+  release(failure?: { readonly error: unknown }): void
+}
+
+/**
+ * The egress seam. Implementations are Host-local: they own one configured
+ * upstream, one loopback chain proxy, and one bounded capture store.
+ */
+export abstract class SecurityProxyRuntime extends Service {
+  /**
+   * @param ctx - owning Cordis context; the service registers as `ctx.securityProxy`.
+   */
+  constructor(ctx: Context) {
+    super(ctx, 'securityProxy')
+  }
+
+  /**
+   * Decide whether one tool execution is routed through the security proxy.
+   * A call with no Agent is never covered, and a session whose recorded preset
+   * is not `security` is never covered regardless of what the tool reports.
+   * @param agent - the Agent executing the tool call, when the caller has one.
+   * @param tool - the model-facing tool name, used for traffic attribution.
+   * @returns the route when covered, otherwise `undefined`.
+   */
+  abstract route(agent: Agent | undefined, tool: string): SecurityProxyRoute | undefined
+
+  /**
+   * Environment entries a child process needs to send its traffic through this
+   * proxy. The caller merges them into that one execution's environment; nothing
+   * here mutates the Host process or the operating system.
+   * @param agent - the Agent executing the tool call.
+   * @param tool - the model-facing tool name, used for traffic attribution.
+   * @returns The overlay for one spawn, or `undefined` when not covered. An inspected listener may supply its public certificate as
+   * `DSH_SECURITY_PROXY_CA_PEM` for explicit client trust.
+   */
+  abstract environment(agent: Agent | undefined, tool: string): Promise<Readonly<Record<string, string>> | undefined>
+
+  /**
+   * Retain the configured upstream and capture writer for a native enforcement gateway.
+   * This Host-only operation exposes credentials; it is never a Remote method.
+   * @param agent - Actual executing Agent; omission and uncovered modes acquire nothing.
+   * @param tool - Tool attribution bound to every captured exchange.
+   * @param stop - Stop and join the delegated process range and gateway when ownership is withdrawn.
+   * @param signal - Caller cancellation, retained for the entire lease.
+   * @param admission - Optional startup-only cancellation; omission uses the caller lifetime alone.
+   * @returns A lease for enabled Security mode, otherwise undefined. Covered admission failures reject without fallback.
+   */
+  abstract openEgress(
+    agent: Agent | undefined, tool: string, stop: () => Promise<void>, signal: AbortSignal, admission?: AbortSignal,
+  ): Promise<SecurityProxyEgressLease | undefined>
+
+  /**
+   * Resolve the sidebar browser's loopback proxy from the actual owning Agent.
+   * @param agent - Conversation resolved by the Host's Agent resource loader.
+   * @returns A local proxy URL, or undefined when this conversation is not covered.
+   */
+  abstract browserEnvironment(agent: Agent): Promise<string | undefined>
+
+  /**
+   * Read the public certificate for the sidebar listener issued to this conversation.
+   * @param agent - Conversation resolved by the Host's Agent resource loader.
+   * @param server - Previously issued loopback proxy URL, which must still belong to the conversation.
+   * @returns The listener's public PEM certificate, or null for opaque CONNECT.
+   */
+  abstract browserTrust(agent: Agent, server: string): Promise<string | null>
+
+  /**
+   * Retrieve one HTTP(S) target through the configured upstream, recording the
+   * exchange at the controlled Client layer. TLS verification stays at the
+   * Node defaults for both the proxy hop and the origin.
+   * @param agent - the Agent executing the tool call.
+   * @param url - the absolute HTTP(S) target.
+   * @param signal - caller cancellation.
+   * @returns the decoded response, bounded by the provider's normal limits.
+   * @throws {@link import('@deepseek-ai/dsh-web').WebError} when not covered or retrieval fails.
+   */
+  abstract fetchTarget(agent: Agent | undefined, url: string, signal: AbortSignal): Promise<WebFetchResult>
+
+  /**
+   * Read the settings and status the surface renders.
+   * @returns current state.
+   */
+  abstract get(): Promise<SecurityProxyState>
+
+  /**
+   * Merge one settings change; the provider persists it before resolving.
+   * @param patch - owner-edited fields.
+   * @returns state after the write.
+   */
+  abstract configure(patch: SecurityProxySettingsPatch): Promise<SecurityProxyState>
+
+  /**
+   * Store or remove the upstream password in the credential provider.
+   * @param password - the new secret, or null to remove the record.
+   * @returns state after the write.
+   */
+  abstract setPassword(password: string | null): Promise<SecurityProxyState>
+
+  /**
+   * Run one real proxy-path check and publish its result.
+   * @returns the check outcome and the state after it.
+   */
+  abstract test(): Promise<SecurityProxyTestResult>
+
+  /**
+   * List retained flows, newest first.
+   * @param query - optional session, kind, text, and limit filters.
+   * @returns matching rows and the capture counters.
+   */
+  abstract list(query: SecurityProxyFlowQuery): Promise<SecurityProxyFlowsResult>
+
+  /**
+   * Read one flow's stored detail.
+   * @param id - flow identity.
+   * @returns the detail, or null when pruned or unknown.
+   */
+  abstract detail(id: string): Promise<SecurityProxyFlowDetail | null>
+
+  /**
+   * Export all retained records matching the filters as one redacted JSON snapshot.
+   * @param query - Session, kind and text filters; list pagination does not apply.
+   * @returns Complete snapshot; exceeding the deployment byte budget rejects without a partial export.
+   */
+  abstract exportCapture(query: SecurityProxyExportQuery): Promise<SecurityProxyCaptureExport>
+
+  /**
+   * Drop every retained flow.
+   * @returns the capture counters after clearing.
+   */
+  abstract clear(): Promise<SecurityProxyCaptureStats>
+
+  /**
+   * Pause or resume capture without changing routing.
+   * @param paused - whether new flows are refused.
+   * @returns state after the change.
+   */
+  abstract pause(paused: boolean): Promise<SecurityProxyState>
+}
+
+export default SecurityProxyRuntime
diff --git a/packages/guard/security-proxy/src/types.ts b/packages/guard/security-proxy/src/types.ts
new file mode 100644
index 00000000..edac1563
--- /dev/null
+++ b/packages/guard/security-proxy/src/types.ts
@@ -0,0 +1,243 @@
+/**
+ * Client-safe payloads for the security-mode egress proxy seam. These values
+ * cross the Host/Client Remote boundary, so they are plain JSON and never carry
+ * proxy credentials: the password is addressed by an existing credential
+ * reference and reported only as {@link SecurityProxySettings.hasPassword}.
+ * @module @deepseek-ai/dsh-security-proxy/types
+ */
+
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+
+/** Lifecycle of the configured upstream, as the settings surface reports it. */
+export type SecurityProxyStatus = 'off' | 'connecting' | 'ready' | 'failed'
+
+/** Why the last connection check failed; the Client owns the localized copy. */
+export type SecurityProxyFailure =
+  | 'invalid-config'
+  | 'unreachable'
+  | 'timeout'
+  | 'auth'
+  | 'tls'
+  | 'unknown'
+
+/** Upstream proxy transport this deployment can configure. */
+export type SecurityProxyProtocol = 'http' | 'https'
+
+/** What a captured flow actually is. */
+export type SecurityProxyFlowKind = 'http' | 'tunnel'
+
+/** Which side produced the flow: the controlled Client, or the loopback chain proxy. */
+export type SecurityProxyFlowOrigin = 'client' | 'proxy'
+
+/** How completely one tool's traffic is covered by this proxy. */
+export type SecurityProxyCoverageCode = 'captured' | 'proxied' | 'partial' | 'uncovered'
+
+/** Settings the owner edits, with the credential reduced to presence. */
+export interface SecurityProxySettings {
+  /** The feature switch. Off means no security traffic is routed and no listener runs. */
+  enabled: boolean
+  /** Transport used to reach the upstream proxy. */
+  protocol: SecurityProxyProtocol
+  /** Upstream proxy host name or IP literal. */
+  host: string
+  /** Upstream proxy TCP port. */
+  port: number
+  /** Whether the upstream requires Proxy-Authorization. */
+  authEnabled: boolean
+  /** Non-secret user name sent with Proxy-Authorization. */
+  username: string
+  /** Whether a password record exists in the credential store. Never the value. */
+  hasPassword: boolean
+  /** Ask once per security session when the proxy is off. Defaults to false. */
+  warnWhenDisabled: boolean
+  /** Stop appending new flows while keeping the retained ones. */
+  capturePaused: boolean
+  /** Retained flow count cap. */
+  maxFlows: number
+  /** Per-body capture cap in bytes; larger bodies are cut and flagged. */
+  maxBodyBytes: number
+  /** Age after which a retained flow is dropped. */
+  retentionMinutes: number
+}
+
+/** One tool's real coverage, so the surface never claims more than it delivers. */
+export interface SecurityProxyCoverage {
+  /** Stable tool family id; the Client localizes it. */
+  readonly id: 'web_fetch' | 'shell' | 'browser' | 'mcp' | 'delegates' | 'model_api'
+  /** How far this proxy reaches that family. */
+  readonly code: SecurityProxyCoverageCode
+}
+
+/** Bytes and counts the capture store currently holds. */
+export interface SecurityProxyCaptureStats {
+  /** New flows stop being appended while paused; retained ones remain readable. */
+  readonly paused: boolean
+  /** Flows created since the Host started, including pruned ones. */
+  readonly total: number
+  /** Flows currently retained and listable. */
+  readonly retained: number
+  /** Captured request plus response bytes currently retained. */
+  readonly bytes: number
+}
+
+/** Complete state the settings surface renders. */
+export interface SecurityProxyState {
+  readonly settings: SecurityProxySettings
+  readonly status: SecurityProxyStatus
+  /** Machine reason for the last failure; null while not failed. */
+  readonly failure: SecurityProxyFailure | null
+  /** Unlocalized transport diagnostic for the detail line; carries no credential. */
+  readonly detail: string | null
+  /** Epoch milliseconds of the last completed connection check. */
+  readonly checkedAt: number | null
+  /** Handshake latency of the last successful check. */
+  readonly latencyMs: number | null
+  readonly capture: SecurityProxyCaptureStats
+  /** Conversation/tool listeners currently open for child processes. */
+  readonly listeners: number
+  readonly coverage: readonly SecurityProxyCoverage[]
+}
+
+/** One configured field group; every field is optional and merged over the stored value. */
+export interface SecurityProxySettingsPatch {
+  readonly enabled?: boolean
+  readonly protocol?: SecurityProxyProtocol
+  readonly host?: string
+  readonly port?: number
+  readonly authEnabled?: boolean
+  readonly username?: string
+  readonly warnWhenDisabled?: boolean
+  readonly capturePaused?: boolean
+  readonly maxFlows?: number
+  readonly maxBodyBytes?: number
+  readonly retentionMinutes?: number
+}
+
+/** Result of one real proxy-path check. */
+export interface SecurityProxyTestResult {
+  readonly ok: boolean
+  readonly durationMs: number
+  readonly failure: SecurityProxyFailure | null
+  readonly detail: string | null
+  readonly state: SecurityProxyState
+}
+
+/** One header as captured. */
+export interface SecurityProxyHeader {
+  readonly name: string
+  readonly value: string
+}
+
+/** List row for one captured exchange. */
+export interface SecurityProxyFlowSummary {
+  /** Stable identity within this Host lifetime. */
+  readonly id: string
+  /** Epoch milliseconds when the exchange started. */
+  readonly at: number
+  readonly kind: SecurityProxyFlowKind
+  readonly origin: SecurityProxyFlowOrigin
+  /** Owning conversation, or null when the exchange cannot be attributed. */
+  readonly sessionId: string | null
+  /** Tool that produced the exchange, such as `web_fetch` or `pwsh`. */
+  readonly tool: string
+  readonly method: string
+  /** Absolute URL for `http` flows; `host:port` for tunnels. */
+  readonly target: string
+  /** HTTP status received from upstream, including responses that fail after headers. Null when unavailable or for tunnels. */
+  readonly status: number | null
+  readonly durationMs: number | null
+  readonly requestBytes: number
+  readonly responseBytes: number
+  readonly outcome: 'complete' | 'error' | 'pending'
+  /** Stable note code for the surface, such as `tunnel-metadata-only`. */
+  readonly note: string | null
+}
+
+/** Response capture stage at which content was cut before storage. */
+export type SecurityProxyResponseCaptureLimit = 'read' | 'relay'
+
+/** Size limits applied to the bodies retained for an exchange. */
+export interface SecurityProxyBodyLimits {
+  /** Storage shortened or omitted the request body. */
+  readonly requestStorage?: boolean
+  /** Storage shortened or omitted the response body. */
+  readonly responseStorage?: boolean
+  /** The controlled reader or proxy capture had already shortened the response. */
+  readonly responseCapture?: SecurityProxyResponseCaptureLimit
+}
+
+/** Detail view of one captured exchange. */
+export interface SecurityProxyFlowDetail extends SecurityProxyFlowSummary {
+  readonly requestHeaders: readonly SecurityProxyHeader[]
+  readonly responseHeaders: readonly SecurityProxyHeader[]
+  /** Decoded request body, or null when absent. */
+  readonly requestBody: string | null
+  /** Decoded response body, or null when absent or not captured. */
+  readonly responseBody: string | null
+  /** Whether a byte limit shortened or omitted a captured body. */
+  readonly bodyTruncated: boolean
+  /** Known cap stages, omitted if nothing was capped or the stage is unavailable. */
+  readonly bodyLimits?: SecurityProxyBodyLimits
+  /** Media type as reported by the response, when known. */
+  readonly contentType: string | null
+}
+
+/** Filters accepted by the flow list. */
+export interface SecurityProxyFlowQuery {
+  readonly sessionId?: string
+  readonly kind?: SecurityProxyFlowKind
+  /** Case-insensitive substring over method, target, and tool. */
+  readonly text?: string
+  /** Row cap; the Host applies its own ceiling. */
+  readonly limit?: number
+}
+
+/** Filters for exporting every matching retained record, without the list row cap. */
+export type SecurityProxyExportQuery = Pick<SecurityProxyFlowQuery, 'sessionId' | 'kind' | 'text'>
+
+/** Versioned JSON download containing the stored capture values. */
+export interface SecurityProxyCaptureExport {
+  readonly format: 'dshu-security-proxy-capture'
+  readonly version: 1
+  /** Snapshot time in epoch milliseconds. */
+  readonly exportedAt: number
+  /** Whether session, kind or text filters limited the records; filter text is not included. */
+  readonly filtered: boolean
+  readonly capture: SecurityProxyCaptureStats
+  readonly flows: readonly SecurityProxyFlowDetail[]
+}
+
+/** Counters returned after a mutation of the capture store. */
+export interface SecurityProxyFlowsResult {
+  readonly flows: readonly SecurityProxyFlowSummary[]
+  readonly capture: SecurityProxyCaptureStats
+}
+
+declare module '@deepseek-ai/dsh-typert-protocol' {
+  interface RemoteErrorDetailsMap {
+    /** The complete export exceeds the deployment's UTF-8 JSON byte budget. */
+    'security-proxy/export-too-large': { readonly maxBytes: number }
+    /** The caller is not the application owner. */
+    'security-proxy/owner-required': { readonly action: string }
+    /** The issued browser endpoint has been withdrawn or belongs to another conversation. */
+    'security-proxy/browser-route-changed': Record<string, never>
+  }
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Events {
+    /**
+     * The independent browser proxy configuration has changed; open guests must reconnect.
+     * @mode emit
+     */
+    'security-proxy/transport-changed'(): void
+    /**
+     * One security-mode tool call ran while the independent proxy was off, at
+     * most once per session. The Client renders the reminder; it changes no
+     * proxy state.
+     * @mode emit
+     * @param sessionId - the conversation whose call triggered the reminder.
+     */
+    'security-proxy/warning'(sessionId: SessionId): void
+  }
+}
