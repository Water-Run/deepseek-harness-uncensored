+  { name: 'benchmarking', subnets: [[[0x2001, 0x2, 0, 0, 0, 0, 0, 0], 48]] },
+  { name: 'amt', subnets: [[[0x2001, 0x3, 0, 0, 0, 0, 0, 0], 32]] },
+  {
