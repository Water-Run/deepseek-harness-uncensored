+/** Writing material admission and reconstruction from the conversation log. */
+import type { Context } from '@deepseek-ai/cordis'
+import { z } from 'zod'
+import type { Agent, PreStepDecision } from '@deepseek-ai/dsh-agent'
+import type { FileSystem } from '@deepseek-ai/dsh-fs'
+import { createUserMessage, type ContextFormed } from '@deepseek-ai/dsh-llm'
+import type { ProjectionHandle } from '@deepseek-ai/dsh-session-projection'
+import type {} from '@deepseek-ai/dsh-agent-preset-registry'
+import type {} from '@deepseek-ai/dsh-sandbox-policy'
+import { readSelectedMaterials } from './story.ts'
+
+declare module '@deepseek-ai/dsh-llm' {
+  interface MessageSourceMap {
+    /** Durable context this service injected on the user's behalf. */
+    'mode-dossiers': { readonly kind: 'mode-dossiers' } & ContextFormed
+  }
+}
+
+/** Agent preset whose requests receive the selected writing materials. */
+const WRITING_PRESET = 'writing'
+
+/**
+ * Render the writing materials one request should receive.
+ *
+ * Only a Writing-mode request carries materials, and only the documents the
+ * registry marks as selected are read: a file under `story/` that the user did
+ * not select never reaches the model through this path.
+ * @param fs - composed filesystem.
+ * @param rootPath - the session's workspace directory.
+ * @param preset - the preset composed for the agent.
+ * @param budget - inclusive byte budget; 0 disables the context.
+ * @param signal - request cancellation.
+ * @returns the context text, or an empty string when nothing applies.
+ */
+export async function writingMaterialsText(
+  fs: FileSystem,
+  rootPath: string,
+  preset: string | undefined,
+  budget: number,
+  signal: AbortSignal,
+): Promise<string> {
+  if (preset !== WRITING_PRESET || budget <= 0) return ''
+  return readSelectedMaterials(fs, rootPath, budget, signal)
+}
+
+/**
+ * Add the selected writing materials before one request.
+ * @param ctx - Host context.
+ * @param agent - agent whose step is being prepared.
+ * @param signal - step cancellation.
+ * @param contextBytes - complete writing-material byte budget.
+ * @param admitted - whether this conversation has ever admitted writing materials.
+ * @param next - the remaining pre-step chain.
+ * @returns the decision, with the materials appended when this is a Writing step with a selection.
+ */
+async function extendRequest(
+  ctx: Context,
+  agent: Agent,
+  signal: AbortSignal,
+  contextBytes: number,
+  admitted: ProjectionHandle<boolean>,
+  next: () => Promise<PreStepDecision>,
+): Promise<PreStepDecision> {
+  const decision = await next()
+  if (decision.kind === 'reject' || signal.aborted || contextBytes === 0) return decision
+  if (ctx.get('agentPresets')?.composedPreset(agent.ctx) !== WRITING_PRESET) return decision
+  const rootPath = agent.session.header.cwd ?? ctx.get('sandboxPolicy')?.workspaceRoot
+  if (rootPath === undefined) return decision
+  let text: string
+  try {
+    text = await writingMaterialsText(ctx.fs, rootPath, WRITING_PRESET, contextBytes, signal)
+  } catch (error: unknown) {
+    // Selected materials are optional context: a broken store must not fail the turn it would have joined.
+    ctx.logger.warn('mode-dossiers: writing materials could not be read: %o', error)
+    return decision
+  }
+  if (signal.aborted) return decision
+  const previous = agent.session.deriveMessages().findLast(message => message.role === 'user' && message.source.kind === 'mode-dossiers')
+  if (!text && !admitted.stateOf(agent.session)) return decision
+  const current = text || 'No writing materials are currently selected. Disregard earlier writing-material instructions.'
+  const block = previous?.content[0]
+  if (block?.type === 'text' && block.text === current) return decision
+  return {
+    ...decision,
+    messages: [...decision.messages, createUserMessage({
+      content: [{ type: 'text', text: current }],
+      source: { kind: 'mode-dossiers', form: 'instructions' },
+    })],
+  }
+}
+
+/**
+ * Register the writing history projection and install the request hook once its history is ready.
+ * @param ctx - owning plugin scope with session projections and filesystem.
+ * @param contextBytes - maximum serialized material bytes for a writing step.
+ */
+export async function installWritingContext(ctx: Context, contextBytes: number): Promise<void> {
+  if (contextBytes === 0) return
+  const admitted = await ctx.sessionProjections.register({
+    key: 'writingMaterialsAdmitted',
+    stateVersion: 1,
+    stateSchema: z.boolean(),
+    init: () => false,
+    apply: (seen, event) => seen || (event.type === 'user/message' && event.data.source.kind === 'mode-dossiers'),
+  })
+  ctx.on('agent/pre-step', async ({ agent, signal }, next) => extendRequest(ctx, agent, signal, contextBytes, admitted, next))
+}
diff --git a/packages/api/mode-dossiers/tests/harness.ts b/packages/api/mode-dossiers/tests/harness.ts
new file mode 100644
index 0000000000000000000000000000000000000000..03567a5a35aab846733b60e54f7ebf78ef9048d8
--- /dev/null
+++ b/packages/api/mode-dossiers/tests/harness.ts
@@ -0,0 +1,79 @@
+/**
+ * Shared fixture: a real local filesystem over a temp workspace plus the
+ * minimal Host services the dossier service reads. The real backend, not a
+ * fake `ctx.fs`, because the version guard under test is the backend's own and
+ * a stub would pass a conflict test that the real write path would fail.
+ */
+
+import { mkdir, mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Context } from '@deepseek-ai/cordis'
+import { LocalFileSystem } from '@deepseek-ai/dsh-fs-local'
+import { brandString } from '@deepseek-ai/dsh-brand'
+import type { WorkspaceId } from '@deepseek-ai/dsh-workspace/types'
+import SessionStore from '@deepseek-ai/dsh-session'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import TypertRegistry from '@deepseek-ai/dsh-typert-registry'
+import { ModeDossiers } from '../src/index.ts'
+
+/** Workspace identity the fixture registers. */
+export const WORKSPACE_ID = 'w-test'
+
+/** Cancellation token every direct service call receives. */
+export const signal = (): AbortSignal => new AbortController().signal
+
+/** One temp workspace and the service serving it. */
+export interface Harness {
+  readonly workspace: string
+  readonly ctx: Context
+  readonly service: ModeDossiers
+  dispose(): Promise<void>
+}
+
+/**
+ * Create the workspace and a context with the local backend rooted at it.
+ * @param prefix - temp directory prefix naming the suite.
+ * @returns the harness; dispose it in `afterEach`.
+ */
+export async function openHarness(prefix: string): Promise<Harness> {
+  const root = await mkdtemp(join(tmpdir(), prefix))
+  const workspace = join(root, 'workspace')
+  await mkdir(workspace, { recursive: true })
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(TypertRegistry)
+  await ctx.plugin(LocalFileSystem, { cwd: workspace })
+  ctx.provide('workspaceRegistry', {
+    get: (id: string) => (id === WORKSPACE_ID
+      ? { id: brandString<WorkspaceId>(WORKSPACE_ID), title: 'Fixture workspace', path: workspace }
+      : undefined),
+  } as never)
+  await ctx.plugin(ModeDossiers, { contextBytes: 4096 })
+  const service = ctx.modeDossiers
+  return {
+    workspace,
+    ctx,
+    service,
+    dispose: async () => {
+      await ctx.fiber.dispose()
+      await rm(root, { recursive: true, force: true })
+    },
+  }
+}
+
+/**
+ * Await an operation expected to fail with a Remote error.
+ * @param operation - the call under test.
+ * @returns the Remote failure's code.
+ */
+export async function failureCodeOf(operation: Promise<unknown>): Promise<string> {
+  try {
+    await operation
+  } catch (error: unknown) {
+    if (typeof error === 'object' && error !== null && 'code' in error && typeof error.code === 'string') return error.code
+    throw error
+  }
+  throw new Error('expected the operation to fail')
+}
diff --git a/packages/api/mode-dossiers/tests/writing.spec.ts b/packages/api/mode-dossiers/tests/writing.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..91c410a5870d3b1032cb7c4fcdb10401ced8c6ab
--- /dev/null
+++ b/packages/api/mode-dossiers/tests/writing.spec.ts
@@ -0,0 +1,203 @@
+/** Writing material admission and storage over a local workspace. */
+
+import { mkdir, readFile, stat, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { agentEvents, type Agent } from '@deepseek-ai/dsh-agent'
+import { createUserMessage, type UserMessage } from '@deepseek-ai/dsh-llm'
+import { Session, type SessionEvent, type SessionId } from '@deepseek-ai/dsh-session'
+import { brandString } from '@deepseek-ai/dsh-brand'
+import { writingMaterialsText } from '../src/index.ts'
+import { failureCodeOf, openHarness, signal, WORKSPACE_ID, type Harness } from './harness.ts'
+
+it('round-trips ordinary v4 prompts and writer notices through the upstream Session reader', () => {
+  const id = brandString<SessionId>('writing-v4')
+  const log = Session.create(id)
+  const content = [{ type: 'text', text: 'Draft.' }] as const
+  for (const source of [
+    { kind: 'user' }, { kind: 'mode-dossiers', form: 'instructions' }, { kind: 'spend-limit', form: 'notice', summary: 'Spending capacity recovered.' },
+  ] as const) {
+    log.append('user/message', createUserMessage({ content, source }), { surfaceOp: 'append' })
+  }
+  const seed: SessionEvent[] = JSON.parse(JSON.stringify(log.snapshotEvents()))
+  const previous = Session.create(id, seed.slice(0, 1), log.header)
+  expect(previous.deriveMessages()).toEqual([log.deriveMessages()[0]])
+  const restored = Session.create(id, seed, log.header)
+  expect(restored.deriveMessages()).toEqual(log.deriveMessages())
+})
+
+let harness: Harness | undefined
+
+afterEach(async () => {
+  await harness?.dispose()
+  harness = undefined
+})
+
+/** One opened harness. */
+async function open(prefix: string): Promise<Harness> {
+  harness = await openHarness(prefix)
+  return harness
+}
+
+describe('writing materials', () => {
+  it('budgets the complete context and preserves Chinese and emoji at the byte limit', async () => {
+    const { service, workspace, ctx } = await open('dsh-story-')
+    await service.createStory({ workspaceId: WORKSPACE_ID, section: 'style', name: 'voice',
+      title: 'Voice', markdown: '月光🌙'.repeat(4000) }, signal())
+    for (const budget of [320, 321, 322, 323]) {
+      const text = await writingMaterialsText(ctx.fs, workspace, 'writing', budget, signal())
+      expect(Buffer.byteLength(text)).toBeLessThanOrEqual(budget)
+      expect(text).toContain('月光🌙')
+      expect(text).not.toContain('\uFFFD')
+      expect(text).toMatch(/\[truncated\]$/u)
+    }
+    const path = join(workspace, 'story/materials.json')
+    const registry = JSON.parse(await readFile(path, 'utf8'))
+    await writeFile(path, JSON.stringify({ ...registry, selected: ['notes.md'] }))
+    await expect(writingMaterialsText(ctx.fs, workspace, 'writing', 4096, signal())).rejects.toThrow('unregistered')
+  })
+
+  it('reissues selected material after compaction and records clearing and reselecting it', async () => {
+    const { service, workspace, ctx } = await open('dsh-story-')
+    ctx.provide('agentPresets', { composedPreset: () => 'writing' } as never)
+    const session = ctx.sessions.create(undefined, { meta: { cwd: workspace } })
+    const agent = { ctx, session, id: session.id } as Agent
+    const events: SessionEvent[] = []
+    ctx.on('session/event', (_session, event) => { events.push(event) })
+    const step = async (current = agent) => {
+      const decision = await agentEvents(current.ctx, current).waterfall('agent/pre-step', {
+        turn: 1, step: 1, messages: [], signal: signal(), modelSelection: { provider: 'fixture', model: 'writing' },
+      }, () => Promise.resolve({ kind: 'enter' as const, messages: [] as UserMessage[] }))
+      if (decision.kind === 'reject') throw new Error('Writing step rejected')
+      return decision.messages
+    }
+    const card = await service.createStory({ workspaceId: WORKSPACE_ID, section: 'style', name: 'voice',
+      title: 'Voice', markdown: 'VOICE' }, signal())
+    await service.createStory({ workspaceId: WORKSPACE_ID, section: 'bible', name: 'canon',
+      title: 'Canon', markdown: 'CANON' }, signal())
+    const [first] = await step()
+    expect(first?.content[0]).toMatchObject({ text: expect.stringContaining('VOICE') })
+    expect(first?.content[0]).toMatchObject({ text: expect.stringContaining('CANON') })
+    const admitted = session.append('user/message', first!, { surfaceOp: 'append' })
+    expect(await step()).toEqual([])
+    session.append('user/message', createUserMessage({ content: [{ type: 'text', text: 'Summary' }], source: { kind: 'user' } }), {
+      surfaceOp: { op: 'replace', startSeq: admitted.seq, endSeq: admitted.seq }, sourceEventSeqs: [admitted.seq],
+    })
+    const [reissued] = await step()
+    expect(reissued?.content).toEqual(first?.content)
+    const repeated = session.append('user/message', reissued!, { surfaceOp: 'append' })
+    session.append('user/message', createUserMessage({ content: [{ type: 'text', text: 'Synopsis retaining old canon' }],
+      source: { kind: 'user' } }), {
+      surfaceOp: { op: 'replace', startSeq: repeated.seq, endSeq: repeated.seq }, sourceEventSeqs: [repeated.seq],
+    })
+    await service.selectStory({ workspaceId: WORKSPACE_ID, selected: [] }, signal())
+    const reopened = await openHarness('dsh-story-reopen-')
+    try {
+      reopened.ctx.provide('agentPresets', { composedPreset: () => 'writing' } as never)
+      const replay = reopened.ctx.sessions.create(session.id, { meta: { cwd: workspace }, seed: structuredClone(events) })
+      const [withdrawal] = await step({ ctx: reopened.ctx, session: replay, id: replay.id } as Agent)
+      expect(withdrawal?.content[0]).toMatchObject({ text: expect.stringContaining('Disregard earlier writing-material instructions') })
+    } finally {
+      await reopened.dispose()
+    }
+    const [cleared] = await step()
+    expect(cleared?.content).toMatchInlineSnapshot(`
+      [
+        {
+          "text": "No writing materials are currently selected. Disregard earlier writing-material instructions.",
+          "type": "text",
+        },
+      ]
+    `)
+    session.append('user/message', cleared!, { surfaceOp: 'append' })
+    expect(await step()).toEqual([])
+    await service.selectStory({ workspaceId: WORKSPACE_ID, selected: [card.path] }, signal())
+    const [restored] = await step()
+    expect(restored?.content[0]).toMatchObject({ text: expect.stringContaining('VOICE') })
+    expect(restored?.content[0]).not.toMatchObject({ text: expect.stringContaining('CANON') })
+  })
+  it('creates, selects, adopts, and removes records without deleting documents', async () => {
+    const { service, workspace } = await open('dsh-dossiers-')
+    const created = await service.createStory({
+      workspaceId: WORKSPACE_ID, section: 'bible', name: 'characters', title: 'Characters',
+      markdown: '# Characters\n\nMara, 34, cartographer.\n',
+    }, signal())
+    expect(created.path).toBe('story/bible/characters.md')
+    expect(await readFile(join(workspace, 'story', 'bible', 'characters.md'), 'utf8')).toContain('Mara')
+
+    await mkdir(join(workspace, 'story', 'style'), { recursive: true })
+    await writeFile(join(workspace, 'story', 'style', 'noir.md'), '# Noir\n\nShort sentences.\n')
+
+    let inventory = await service.inventory({ workspaceId: WORKSPACE_ID }, signal())
+    expect(inventory.writing.entries.map(entry => entry.path)).toEqual(['story/bible/characters.md'])
+    expect(inventory.writing.selected).toEqual(['story/bible/characters.md'])
+    expect(inventory.writing.unregistered.map(entry => entry.path)).toEqual(['story/style/noir.md'])
+
+    inventory = await service.adoptStory({ workspaceId: WORKSPACE_ID, path: 'story/style/noir.md' }, signal())
+    expect(inventory.writing.entries.map(entry => entry.path)).toEqual([
+      'story/bible/characters.md', 'story/style/noir.md',
+    ])
+    expect(inventory.writing.unregistered).toEqual([])
+
+    await service.selectStory({
+      workspaceId: WORKSPACE_ID, selected: ['story/style/noir.md'],
+    }, signal())
+    inventory = await service.inventory({ workspaceId: WORKSPACE_ID }, signal())
+    expect(inventory.writing.selected).toEqual(['story/style/noir.md'])
+
+    await service.removeStory({ workspaceId: WORKSPACE_ID, path: 'story/bible/characters.md' }, signal())
+    inventory = await service.inventory({ workspaceId: WORKSPACE_ID }, signal())
+    expect(inventory.writing.entries.map(entry => entry.path)).toEqual(['story/style/noir.md'])
+    // The document itself is still the user's.
+    expect(await stat(join(workspace, 'story', 'bible', 'characters.md'))).toBeDefined()
+  })
+
+  it('refuses to select a path that was never registered', async () => {
+    const { service, workspace } = await open('dsh-dossiers-')
+    await mkdir(join(workspace, 'story', 'bible'), { recursive: true })
+    await writeFile(join(workspace, 'story', 'bible', 'premise.md'), '# Premise\n')
+    expect(await failureCodeOf(service.selectStory({
+      workspaceId: WORKSPACE_ID, selected: ['story/bible/premise.md'],
+    }, signal()))).toBe('mode-dossier/workspace-missing')
+  })
+
+  it('refuses paths outside the managed directories', async () => {
+    const { service } = await open('dsh-dossiers-')
+    expect(await failureCodeOf(service.readStory({ workspaceId: WORKSPACE_ID, path: '../secret.md' }, signal())))
+      .toBe('mode-dossier/unreadable')
+    expect(await failureCodeOf(service.readStory({ workspaceId: WORKSPACE_ID, path: 'story/bible/a.txt' }, signal())))
+      .toBe('mode-dossier/unreadable')
+  })
+
+  it('refuses a write whose document changed since it was opened', async () => {
+    const { service, workspace } = await open('dsh-dossiers-')
+    const created = await service.createStory({
+      workspaceId: WORKSPACE_ID, section: 'style', name: 'voice', title: 'Voice', markdown: 'one',
+    }, signal())
+    await writeFile(join(workspace, 'story', 'style', 'voice.md'), 'two, longer text')
+    expect(await failureCodeOf(service.writeStory({
+      workspaceId: WORKSPACE_ID, path: created.path, expectedVersion: created.version, markdown: 'mine',
+    }, signal()))).toBe('mode-dossier/conflict')
+  })
+
+  it('injects only the selected materials into a writing request', async () => {
+    const { service, workspace, ctx } = await open('dsh-dossiers-')
+    await service.createStory({
+      workspaceId: WORKSPACE_ID, section: 'style', name: 'voice', title: 'Voice', markdown: 'VOICE-ONLY',
+    }, signal())
+    await service.createStory({
+      workspaceId: WORKSPACE_ID, section: 'bible', name: 'canon', title: 'Canon', markdown: 'CANON-TEXT',
+    }, signal())
+    const listing = await service.inventory({ workspaceId: WORKSPACE_ID }, signal())
+    expect(listing.writing.selected).toHaveLength(2)
+    await service.selectStory({ workspaceId: WORKSPACE_ID, selected: ['story/style/voice.md'] }, signal())
+
+    const text = await writingMaterialsText(ctx.fs, workspace, 'writing', 4096, signal())
+    expect(text).toContain('VOICE-ONLY')
+    expect(text).not.toContain('CANON-TEXT')
+    expect(text).not.toContain('story/bible/canon.md')
+
+    expect(await writingMaterialsText(ctx.fs, workspace, 'standard', 4096, signal())).toBe('')
+    expect(await writingMaterialsText(ctx.fs, workspace, 'writing', 0, signal())).toBe('')
+  })
+})
