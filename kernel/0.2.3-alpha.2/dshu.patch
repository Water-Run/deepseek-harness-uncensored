+}
+
+/** Bind the child Session to the tab belonging to this parent.
+ * @param props - Parent Session, resource subscription, locale and nested conversation slot.
+ * @returns The current discussion or its opening state.
+ */
+export function SidePanel({ sessionId, useSessions, useTabInfo, useResource, SessionProvider, renderSlot, t, markRead, clear }:
+  PropsRuntime<'sidebar.right.pane.tab'> & PropsLocale<'command'> & PropsRenderSlots<'sidebar.aside.conversation'> & { clear: (child: SessionId) => void; markRead: (child: SessionId, seq: number) => void }) {
+  const { tab } = useTabInfo()
+  const resource = useResource<'aside'>(asideParent(tab.contentId) === undefined ? asideAddress(sessionId) : tab.contentId)
+  const child = resource.value?.sessionId
+  const events = resource.value?.binding.eventSource
+  const seq = useSessions(list => sideMetadata(list, child)?.result?.seq)
+  useEffect(() => {
+    if (!tab.visible || resource.status !== 'live' || !events || child === undefined || seq === undefined) return
+    let acknowledged = false
+    const acknowledge = () => {
+      if (acknowledged || document.visibilityState !== 'visible') return acknowledged
+      const received = events.getSnapshot().entries.some(({ event }) => event.seq === seq && event.type === 'turn/end')
+      if (received) { acknowledged = true; markRead(child, seq) }
+      return received
+    }
+    if (acknowledge()) return
+    const release = events.subscribe(acknowledge)
+    document.addEventListener('visibilitychange', acknowledge)
+    return () => { release(); document.removeEventListener('visibilitychange', acknowledge) }
+  }, [child, events, seq, tab.visible, resource.status, markRead])
+  return <section className={css.sidebar} aria-label={t('aside.side')} data-aside="side">
+    <div className={css.context}><span>{t('aside.inherited')}</span>
+      <button type="button" className={css.clear} disabled={!resource.value || resource.status !== 'live'}
+        onClick={() => { if (resource.value) clear(resource.value.sessionId) }}>{t('aside.clearHistory')}</button>
+    </div>
+    {resource.status === 'failed'
+      ? <div role="alert" className={css.state}>{t('aside.failed')}</div>
+      : !resource.value
+        ? <div role="status" aria-label={t('aside.loading')} className={css.state}><IconLoadingOutlineRegular size={20} /></div>
+        : <SessionProvider key={resource.value.sessionId} session={resource.value}>{renderSlot('sidebar.aside.conversation', {})}</SessionProvider>}
+  </section>
+}
+
+type StatusProps = PropsRuntime<'sidebar.right.pane.tab.title'> & PropsLocale<'command'>
+  & InjectFace<{ hooks: { asideRead: ReturnType<AsideReads['for']> } }>
+
+function useSideStatus({ sessionId, useSessions, useAsideRead }: Pick<StatusProps, 'sessionId' | 'useSessions' | 'useAsideRead'>) {
+  const child = useSessions(list => newestSide(list, sessionId))
+  const side = useSessions(list => sideMetadata(list, child))
+  const listed = useSessions(list => child !== undefined && list.byId[child]?.running)
+  const read = useAsideRead(value => value)
+  if (!side?.asked) return undefined
+  if (listed) return 'running'
+  if (side.result?.interrupted) return 'interrupted'
+  if (!side.result) return undefined
+  return read && read.child === child && read.seq >= side.result.seq ? 'read' : 'unread'
+}
+
+function StatusIcon({ state, label }: { state: ReturnType<typeof useSideStatus>; label?: string | undefined }) {
+  return <span className={css.statusIcon} role={label ? 'img' : undefined} aria-label={label}><AsideIcon />
+    {state && <span aria-hidden="true" className={css.light} data-aside-status={state} />}
+  </span>
+}
+
+/** Render the title and current result status of the persistent side tab.
+ * @param props - Current parent, read position and locale.
+ * @returns Localized tab title and status.
+ */
+export function SideTitle(props: StatusProps) {
+  const state = useSideStatus(props)
+  return <><StatusIcon state={state} label={state && props.t(`aside.status.${state}`)} />{props.t('aside.side')}</>
+}
+
+/** Open the persistent discussion from the main conversation header.
+ * @param props - Current parent, read position, launch action and locale.
+ * @returns The header shortcut with the latest side result status.
+ */
+export function SideLauncher(props: PropsRuntime<'conversation.session.header.utilities'> & PropsLocale<'command'>
+  & InjectFace<{ hooks: { asideRead: ReturnType<AsideReads['for']> }; open: () => void }>) {
+  const state = useSideStatus(props)
+  const description = state && props.t(`aside.status.${state}`)
+  return <Tooltip label={description ?? props.t('aside.side')} side="bottom" portal>
+    <button type="button" className={css.launcher} aria-label={props.t('aside.side')} aria-description={description} onClick={props.open}>
+      <StatusIcon state={state} />
+    </button>
+  </Tooltip>
+}
diff --git a/packages/client/ui-commands/src/client/asides/address.ts b/packages/client/ui-commands/src/client/asides/address.ts
new file mode 100644
index 00000000..df880029
--- /dev/null
+++ b/packages/client/ui-commands/src/client/asides/address.ts
@@ -0,0 +1,25 @@
+/** Address helpers shared by the side-question provider and tab body. */
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+
+/** Resource namespace reserved for native side conversations. */
+export const ASIDE_PREFIX = 'dsh-resource://aside/session/'
+
+/**
+ * Address a main conversation's persistent side question.
+ * @param parent - Main conversation.
+ * @returns Stable resource URI for its side question.
+ */
+export function asideAddress(parent: SessionId): string { return `${ASIDE_PREFIX}${encodeURIComponent(parent)}` }
+
+/**
+ * Read the main conversation identity from an aside URI.
+ * @param address - Resource URI.
+ * @returns Valid source identity, or undefined.
+ */
+export function asideParent(address: string): SessionId | undefined {
+  if (!address.startsWith(ASIDE_PREFIX)) return undefined
+  try {
+    const id = decodeURIComponent(address.slice(ASIDE_PREFIX.length))
+    return id.length > 0 && id.length <= 256 && !/[/?#\u0000-\u001f]/u.test(id) ? id as SessionId : undefined
+  } catch (_invalidEncoding) { return undefined }
+}
diff --git a/packages/client/ui-commands/src/client/asides/clear-settings.ts b/packages/client/ui-commands/src/client/asides/clear-settings.ts
new file mode 100644
index 00000000..9b602db5
--- /dev/null
+++ b/packages/client/ui-commands/src/client/asides/clear-settings.ts
@@ -0,0 +1,59 @@
+/** Live, opt-in side context cleanup preference owned by the Host. */
+import type { JsonValue } from '@deepseek-ai/dsh-util-values'
+import type { SettingsRemoteFace } from './reasoning-settings.ts'
+
+/** Current value and read/write availability for the settings row. */
+export interface AsideClearSnapshot {
+  readonly value: boolean
+  readonly writable: boolean
+  readonly status: 'loading' | 'ready' | 'saving' | 'unavailable' | 'error'
+}
+
+function record(value: JsonValue): Record<string, JsonValue> | undefined {
+  return typeof value === 'object' && value !== null && !Array.isArray(value) ? value : undefined
+}
+
+/** Revision-fenced settings writes; unknown deployments cannot enable the switch locally. */
+export class AsideClearController {
+  private namespace: string | undefined
+  private revision: number | undefined
+  private value = false
+
+  /** @param settings - Host settings Remote. */
+  constructor(private readonly settings: SettingsRemoteFace) {}
+
+  /**
+   * Read the Host's current preference.
+   * @returns Authoritative value or a disabled unavailable state.
+   */
+  async load(): Promise<AsideClearSnapshot> {
+    const result = await this.settings.describe()
+    if (!result.ok) return { status: 'unavailable', value: false, writable: false }
+    const view = result.value.namespaces.find(entry => typeof record(entry.value)?.sideClearOnClose === 'boolean')
+    if (view === undefined) return { status: 'unavailable', value: false, writable: false }
+    this.namespace = view.ns
+    this.revision = view.revision
+    this.value = record(view.value)?.sideClearOnClose === true
+    return { status: 'ready', value: this.value, writable: result.value.writable }
+  }
+
+  /**
+   * Save a preference with the last observed revision.
+   * @param value - Requested preference.
+   * @returns Accepted value or a visible failure retaining the previous value.
+   */
+  async save(value: boolean): Promise<AsideClearSnapshot> {
+    if (this.namespace === undefined) return { status: 'unavailable', value: this.value, writable: false }
+    const accepted = this.value
+    let result = await this.settings.update(this.namespace, { sideClearOnClose: value }, this.revision)
+    if (!result.ok && result.error.code === 'settings/conflict') {
+      const current = await this.load()
+      if (current.status !== 'ready' || !current.writable || current.value === value) return current
+      if (current.value === accepted) result = await this.settings.update(this.namespace, { sideClearOnClose: value }, this.revision)
+    }
+    if (!result.ok) return { status: 'error', value: this.value, writable: true }
+    this.revision = result.value.revision
+    this.value = record(result.value.value)?.sideClearOnClose === true
+    return { status: 'ready', value: this.value, writable: true }
+  }
+}
diff --git a/packages/client/ui-commands/src/client/asides/controller.ts b/packages/client/ui-commands/src/client/asides/controller.ts
new file mode 100644
index 00000000..0c3e305f
--- /dev/null
+++ b/packages/client/ui-commands/src/client/asides/controller.ts
@@ -0,0 +1,109 @@
+/** Submission and reference ownership for one-shot inline questions. */
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import type { SessionReference } from '@deepseek-ai/dsh-api-session-controller/client'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+
+/** One result block; rejected admission retains any opened transcript for inspection. */
+export type InlineAside = { readonly status: 'opening' } | { readonly status: 'failed' }
+  | { readonly status: 'ready'; readonly reference: SessionReference; readonly submitFailed: boolean }
+
+interface Opening {
+  readonly question: string
+  reference?: SessionReference
+  pending: boolean
+  hidden: boolean
+  task: Promise<boolean>
+}
+
+/** Owns each question through admission, even when its result block is hidden meanwhile. */
+export class InlineAsideController {
+  /** Result blocks indexed by their main conversation. */
+  readonly state = createSnapshotStore<ReadonlyMap<SessionId, InlineAside>>(new Map())
+  private readonly entries = new Map<SessionId, Opening>()
+  private readonly operations = new Set<Promise<boolean>>()
+  private closed = false
+
+  /**
+   * @param create - Create and retain a fresh child whose initial history is ready.
+   * @param submit - Submit one question; reject when admission cannot be confirmed.
+   */
+  constructor(
+    private readonly create: (parent: SessionId) => Promise<SessionReference>,
+    private readonly submit: (reference: SessionReference, question: string) => Promise<void>,
+  ) {}
+
+  /**
+   * Submit one independent question; simultaneous identical submissions share admission.
+   * @param parent - Conversation owning the result block.
+   * @param text - Nonempty question after the command token.
+   * @returns Confirmed admission; false keeps the originating draft intact.
+   */
+  ask(parent: SessionId, text: string): Promise<boolean> {
+    const question = text.trim()
+    if (this.closed || !question) return Promise.resolve(false)
+    const previous = this.entries.get(parent)
+    if (previous?.pending) return previous.question === question ? previous.task : Promise.resolve(false)
+    this.hide(parent)
+    const entry: Opening = { question, pending: true, hidden: false, task: Promise.resolve(false) }
+    this.entries.set(parent, entry)
+    this.publish(parent, { status: 'opening' })
+    const operation = this.run(parent, entry).finally(() => {
+      entry.pending = false
+      this.operations.delete(operation)
+      if (entry.hidden || this.closed) this.release(entry)
+    })
+    entry.task = operation
+    this.operations.add(operation)
+    return operation
+  }
+
+  private async run(parent: SessionId, entry: Opening): Promise<boolean> {
+    try {
+      entry.reference = await this.create(parent)
+      if (entry.hidden || this.closed) return false
+      const reference = entry.reference
+      this.publish(parent, { status: 'ready', reference, submitFailed: false })
+      await this.submit(reference, entry.question)
+      return true
+    } catch (_admissionFailed) {
+      if (!entry.hidden && !this.closed) {
+        this.publish(parent, entry.reference === undefined ? { status: 'failed' }
+          : { status: 'ready', reference: entry.reference, submitFailed: true })
+      }
+      return false
+    }
+  }
+
+  /**
+   * Hide the result block; an in-flight submission retains its reference until settlement.
+   * @param parent - Owning conversation.
+   */
+  hide(parent: SessionId): void {
+    const entry = this.entries.get(parent)
+    this.entries.delete(parent)
+    this.publish(parent, undefined)
+    if (entry === undefined) return
+    entry.hidden = true
+    if (!entry.pending) this.release(entry)
+  }
+
+  private release(entry: Opening): void {
+    const reference = entry.reference
+    delete entry.reference
+    reference?.release()
+  }
+
+  private publish(parent: SessionId, value: InlineAside | undefined): void {
+    const next = new Map(this.state.getSnapshot())
+    if (value === undefined) next.delete(parent)
+    else next.set(parent, value)
+    this.state.set(next)
+  }
+
+  /** Stop admission, drain pending submissions, then release every owned child reference. */
+  async dispose(): Promise<void> {
+    this.closed = true
+    for (const parent of this.entries.keys()) this.hide(parent)
+    await Promise.allSettled([...this.operations])
+  }
+}
