+  topicHint: '同一类型、同一范围、同一主题的记录必须一致，检索时采用最新一条。',
+  shareGlobal: '共享到所有工作区与模式',
+  shareGlobalHint: '关闭时，记录只保留在下方选择的工作区和模式中。',
+  workspace: '工作区',
+  mode: '模式',
+  noWorkspace: '不限工作区',
+  noMode: '不限模式',
+  scopeRequired: '请选择工作区或模式，或把记录设为全局共享。',
+  loadFailed: '无法读取已保存的记忆。',
+  saveFailed: '记录未保存，你的内容已保留。',
+  conflict: '这条记录已在另一个窗口被修改。',
+  conflictHint: '你的内容已保留。请重新载入记录后再保存。',
+  invalid: '这条记录无法按当前内容保存。',
