+```ts persistence-catalog
+/** A released DSHU composer's background request or result. Both stay outside the message surface. */
+'input/prediction': {
+  readonly surface: 'main' | 'side' | 'btw'
+  readonly phase: 'request' | 'result'
+  readonly revision: number
+  readonly draft: string
+  readonly instruction: string
+  readonly context: string
+  readonly suggestion: string
+  readonly requestId?: Branded<'PredictionRequestId'>
+  readonly request?: {
+    readonly provider: string
+    readonly model: string
+    readonly reasoningEffort?: ReasoningEffortId
+    readonly maxTokens: number
+    readonly message: {
+      readonly id: MessageId
+      readonly role: 'user'
+      readonly content: readonly TextBlock[]
+      readonly source: { readonly kind: 'input-prediction'; readonly form: 'notice'; readonly summary: string }
+    }
+  }
+  readonly outcome?: 'completed' | 'cancelled' | 'failed'
+  readonly usage?: TokenUsage
+}
+```
