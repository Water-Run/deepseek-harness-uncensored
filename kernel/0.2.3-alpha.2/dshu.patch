+  { name: 'unspecified', subnets: [[[0, 0, 0, 0], 8]] },
+  { name: 'broadcast', subnets: [[[255, 255, 255, 255], 32]] },
+  { name: 'multicast', subnets: [[[224, 0, 0, 0], 4]] },
+  { name: 'linkLocal', subnets: [[[169, 254, 0, 0], 16]] },
+  { name: 'loopback', subnets: [[[127, 0, 0, 0], 8]] },
+  { name: 'carrierGradeNat', subnets: [[[100, 64, 0, 0], 10]] },
+  {
