+  const dir = join(assetRoot, 'writing', 'writing-voice')
+  const file = join(dir, 'SKILL.md')
+  const metadata = '---\ndescription: Narrative voice\n---\n'
+  const ctx = new Context()
+  try {
+    await mkdir(dir, { recursive: true })
+    await writeFile(file, metadata + 'Original text.')
+    await ctx.plugin(Skills)
+    await ctx.plugin(Playbooks, { packs: ['writing'], assetRoot })
+    await writeFile(file, metadata + 'Revised text.')
