+import { asideAddress, asideParent } from './address.ts'
+import { AsideIcon } from './AsideIcon.tsx'
+import { newestSide, sideMetadata, type AsideReads } from './read-status.ts'
+import css from './SidePanel.module.css'
+
+function ChatView({ renderSlot }: ConversationViewsProps) {
+  return <>{renderSlot('conversation.session', { view: 'chat' })}</>
+}
+
+/** Render the child's transcript and composer inside its own Session provider.
+ * @param props - Factories scoped to the side Session.
+ * @returns The active conversation, including a composer before the first turn.
+ */
+export function SideConversation({ renderFactorySlot, t }: PropsRuntime<'sidebar.aside.conversation'> & PropsRenderFactories & PropsLocale<'command'>) {
