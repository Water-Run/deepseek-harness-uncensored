+/** Public GitHub repository shared by production packaging and upload staging. */
+export const DSHU_RELEASE_REPOSITORY: string
+
+/** Immutable update settings sealed into the installed application. */
+export interface PackagedUpdateFeed {
+  readonly channel: 'stable' | 'nightly'
+  readonly publicUrl: string
+  readonly environment: 'production' | 'test'
+  readonly github: boolean
+}
+
+/**
+ * Resolve the public GitHub feed for production installers or the configured test feed.
+ * @param env - Packaging settings.
+ * @param platform - Installer platform.
+ * @param arch - Installer architecture.
+ * @returns Update settings for this target when it has an update feed.
+ */
+export function resolvePackagedUpdate(env: NodeJS.ProcessEnv, platform: NodeJS.Platform, arch: string): PackagedUpdateFeed | undefined
