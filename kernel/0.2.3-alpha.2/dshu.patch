@@ -0,0 +1,77 @@
+/**
+ * Product identity displayed by the verified kernel candidate in Web and Desktop.
+ * @module
+ */
+import { FishLogo, IconCloseOutlineRegular, Modal } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { AccountMenuProps } from './AccountMenu.tsx'
+import { GitHubIcon } from './GitHubIcon.tsx'
+import { releaseComponents } from './release-components.ts'
+import css from './AboutDialog.module.css'
+
+const repository = 'https://github.com/Water-Run/deepseek-harness-uncensored'
+const upstream = 'https://github.com/deepseek-ai/deepseek-harness'
+
+function utc(value: string | undefined, missing: string): string {
+  if (!value) return missing
+  const timestamp = Date.parse(value)
+  if (!Number.isFinite(timestamp)) return missing
+  return new Date(timestamp).toISOString().slice(0, 16).replace('T', ' ') + ' UTC'
+}
+
+/** @param props - Visibility, dismissal and translated labels. @returns The candidate's version and source information. */
+export function AboutDialog({ t, close, open }: { t: AccountMenuProps['t']; close: () => void; open: boolean }) {
+  const version = process.env.DSH_CLIENT_VERSION
+  const productVersion = process.env.DSH_CLIENT_FORK_VERSION
+  const tree = process.env.DSH_CLIENT_CANDIDATE_TREE
+  const missing = t('aboutUnknown')
+  const revision = process.env.DSH_CLIENT_UPSTREAM_COMMIT ?? process.env.DSH_CLIENT_COMMIT_HASH
+  const baseUrl = revision ? upstream + '/commit/' + revision : upstream
+  return <Modal open={open} onClose={close} headless title={t('about')} className={css.dialog ?? ''}>
+    <button type="button" className={css.close} aria-label={t('close')} onClick={close}><IconCloseOutlineRegular size={16} /></button>
+    <div className={css.content}>
+      <section className={css.identity} aria-label={t('aboutIdentity')}>
+        <div className={css.brandRow}><div className={css.logo}><FishLogo size={56} /></div><span className={css.edition}>DSHU</span></div>
+        <h2 className={css.product}>DeepSeek Harness Uncensored</h2>
+        <p className={css.slogan}>{t('aboutSlogan')}</p>
+        <div className={css.author}><span>{t('aboutAuthor')}</span><a href="https://github.com/Water-Run" target="_blank" rel="noreferrer">WaterRun</a></div>
+        <dl className={css.build}>
+          <div className={css.versionRow}><dt>{t('aboutProductVersion')}</dt><dd className={css.version}>{productVersion ?? missing}</dd></div>
+          <div><dt>{t('aboutBuildTime')}</dt><dd>{utc(process.env.DSH_CLIENT_BUILD_TIME, missing)}</dd></div>
+        </dl>
+        <a className={css.github} href={repository} target="_blank" rel="noreferrer"><GitHubIcon />{t('aboutRepo')}</a>
+        <div className={css.update}><span>{t('aboutCandidate')}</span><a href={repository + '/releases/latest'} target="_blank" rel="noreferrer">{t('aboutReleases')}</a></div>
+      </section>
+      <div className={css.details}>
+        <section className={css.foundationGroup}>
+          <h3>{t('aboutFoundation')}</h3>
+          <p className={css.foundation}><a href={baseUrl} target="_blank" rel="noreferrer">{t('aboutBasedOn', { version: version ?? '' })}</a></p>
+          <div className={css.licenses}>
+            <a href={repository + '/blob/main/LICENSE'} target="_blank" rel="noreferrer">{t('aboutForkLicense')} · GPL-3.0-or-later</a>
+            <a href={upstream + '/blob/' + (revision ?? 'master') + '/LICENSE'} target="_blank" rel="noreferrer">{t('aboutUpstreamLicense')} · MIT</a>
+          </div>
+        </section>
+        <section className={css.sourceGroup}><h3>{t('aboutSource')}</h3>
+          <dl className={css.metadata}>
+            <div><dt>{t('aboutCommit')}</dt><dd><a href={baseUrl} title={revision} target="_blank" rel="noreferrer">{revision?.slice(0, 12) ?? missing}</a></dd></div>
+            <div><dt>{t('aboutDate')}</dt><dd>{utc(process.env.DSH_CLIENT_UPSTREAM_DATE, missing)}</dd></div>
+            <div><dt>{t('aboutTree')}</dt><dd><code title={tree}>{tree?.slice(0, 12) ?? t('aboutWorking')}</code></dd></div>
+          </dl>
+        </section>
+        <section className={css.sourceGroup}><h3>{t('aboutComponents')}</h3><p className={css.componentNote}>{t('aboutNotBundled')}</p>
+          <div className={css.dependencies}>{releaseComponents.map(component => <div className={css.group} key={component.name}>
+            <a className={css.dependencyHeading} href={component.repository} target="_blank" rel="noreferrer">{component.name} {component.version}</a>
+            <div className={css.licenseName}>{component.license}</div>
+            <a className={css.revision} href={component.repository + '/commit/' + component.commit} title={component.commit}
+              target="_blank" rel="noreferrer">{component.commit.slice(0, 12)}</a>
+            <time dateTime={component.time}>{utc(component.time, missing)}</time>
+          </div>)}</div>
+        </section>
+        <section className={css.sourceGroup}><h3>{t('aboutCandidateSource')}</h3><div className={css.licenses}>
+          {version && <a href={repository + '/blob/main/kernel/' + version + '/source.json'} target="_blank" rel="noreferrer">{t('aboutManifest')}</a>}
+          <a href={repository + '/blob/main/docs/user/guide/dshu.md'} target="_blank" rel="noreferrer">{t('aboutGuide')}</a>
+          <a href={upstream + '/blob/' + (revision ?? 'master') + '/THIRD_PARTY_NOTICES.md'} target="_blank" rel="noreferrer">{t('aboutThirdParty')}</a>
+        </div></section>
+      </div>
+    </div>
+  </Modal>
+}
