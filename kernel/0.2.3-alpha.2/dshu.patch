+/** Scoped instructions and recorded parent context for native side conversations and quick questions. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import type {} from '@deepseek-ai/dsh-permission-presets'
+import type {} from '@deepseek-ai/dsh-system-prompt'
+import { completedConversationEvents, mainProgressContext } from './aside-main-context.ts'
+import { quickQuestionContext } from './aside-question-context.ts'
+
+/** Restore the aside's own prompt on both creation and cold resume.
+ * @param ctx - Unpublished child Agent scope.
+ * @param agent - Child whose Session records each model request.
+ * @param parent - Owning main conversation.
+ * @param kind - Persistent discussion or one-shot question.
+ * @param readParent - Owning Host's Session query service.
+ * @param contextBytes - Maximum bytes of parent context in each request.
+ */
+export function configureAsidePrompt(ctx: Context, agent: Agent, parent: SessionId, kind: 'side' | 'btw',
+  readParent: Context['sessionQuery'], contextBytes: number): void {
+  if (kind === 'btw') {
+    const presets = ctx.get('permissionPresets')
+    if (presets === undefined) throw new Error('A quick question requires the read-only permission preset.')
+    presets.set(agent.session, 'read-only')
+  }
+  ctx.effect(() => ctx.systemPrompt.section({ name: 'conversation:aside',
+    order: ctx.systemPrompt.getSectionOrder('DEPLOYMENT_PERSONA_SUFFIX'), interpolate: false,
+    text: kind === 'side'
+      ? 'Answer the question asked in this independent side conversation. Use completed main-conversation messages as background. Side messages belong to this discussion.'
+      : 'Answer the quick question in the user’s language using the supplied main-conversation progress as background. Give at most three short sentences or five short progress bullets. Do not call tools, continue the main task, or ask a follow-up. If the snapshot does not contain the answer, say so in one sentence.',
+  }), 'conversation: aside instructions')
+  ctx.on('system-prompt/assemble', async (_assembly, context, next) => {
+    const result = await next()
+    context.signal?.throwIfAborted()
+    using source = await readParent.observeSession(parent, { projectionMode: 'none', ...(context.signal === undefined ? {} : { signal: context.signal }) })
+    context.signal?.throwIfAborted()
+    const text = kind === 'btw' ? quickQuestionContext(parent, source.events, contextBytes)
+      : mainProgressContext(parent, completedConversationEvents(source.events), contextBytes)
+    if (text) result.contexts.push({ name: 'conversation:main-progress', text, interpolate: false })
+    return result
+  })
+}
