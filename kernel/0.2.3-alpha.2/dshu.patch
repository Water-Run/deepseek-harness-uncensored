+/** Agent-scoped reading of the current independent side discussion. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { SessionQueryError } from '@deepseek-ai/dsh-session-query'
+import { defineTool, ToolContextUnavailableError } from '@deepseek-ai/dsh-tools'
+import { currentSide } from './aside-identity.ts'
+import { completedConversationEvents, mainProgressContext } from './aside-main-context.ts'
+
+/**
+ * Expose completed side messages to their owning conversation on explicit tool calls.
+ * @param ctx - Owner's Agent scope, released with the Agent.
+ * @param owner - Only Agent allowed to read this discussion.
+ * @param maxBytes - Maximum UTF-8 bytes returned from completed discussion history.
+ */
+export function configureSideReader(ctx: Context, owner: Agent, maxBytes: number): void {
+  ctx.tools.register(defineTool({
+    name: 'read_side_context',
+    description: 'Read completed messages from the independent side conversation linked to this main conversation.',
+    parameters: {},
+    output: { schema: { type: 'string' }, render: (_args, text) => [{ type: 'text', text }] },
+    isConcurrencySafe: () => true,
+    presentCall: () => ({ card: 'generic', kind: 'read', title: 'Read side conversation', rawInput: '' }),
+    execute: async (_args, { agent, signal }) => {
+      if (agent !== owner) throw new ToolContextUnavailableError('Reading side context requires its owning conversation.')
+      signal.throwIfAborted()
+      const side = await currentSide(ctx, owner.id)
+      signal.throwIfAborted()
+      if (!side) return 'No side conversation has been opened.'
+      try {
+        using source = await ctx.sessionQuery.observeSession(side.id, { projectionMode: 'none', signal })
+        if (source.header.parentSession !== owner.id) throw new ToolContextUnavailableError('The side conversation belongs to another parent.')
+        const current = await currentSide(ctx, owner.id)
+        signal.throwIfAborted()
+        if (current?.id !== side.id) return 'The side conversation changed during this read. Read again for the current discussion.'
+        const completed = completedConversationEvents(source.events.slice(source.inheritedEventCount))
+        return mainProgressContext(side.id, completed, maxBytes, 'side') || 'The side conversation has no completed messages yet.'
+      } catch (error) {
+        if (error instanceof SessionQueryError && error.code === 'SESSION_QUERY_SESSION_NOT_FOUND') return 'The side conversation is no longer available.'
+        throw error
+      }
+    },
+  }), { when: ({ agent }) => agent === owner })
+}
diff --git a/packages/api/session-controller/src/aside-sessions.ts b/packages/api/session-controller/src/aside-sessions.ts
new file mode 100644
index 00000000..7b404483
--- /dev/null
+++ b/packages/api/session-controller/src/aside-sessions.ts
@@ -0,0 +1,237 @@
+/** Publication and lifetime of native side conversations and one-shot questions. */
+import { randomUUID } from 'node:crypto'
+import type { Context } from '@deepseek-ai/cordis'
+import type { AgentHandle, ModelSelection } from '@deepseek-ai/dsh-agent'
+import { brandString } from '@deepseek-ai/dsh-brand'
+import { errorChain, ReasoningEffortId } from '@deepseek-ai/dsh-llm'
+import type { Session, SessionId } from '@deepseek-ai/dsh-session'
+import type { SessionObservation } from '@deepseek-ai/dsh-session-query'
+import { RemoteError } from '@deepseek-ai/dsh-typert-protocol'
+import type { ApiSessionAgentController } from './agent.ts'
+import { currentSide, nativeAsideKind, sideIdentity } from './aside-identity.ts'
+import { inheritedModel, inheritSidePermissions } from './aside-settings.ts'
+import type { SessionAsideRequest, SessionAsideResetRequest, SessionForkValue } from './types.ts'
+
+/** Owns independent aside Agents and drains admissions when the Host stops. */
+export class AsideSessions {
+  private readonly releasingSaved = new Map<SessionId, { session: Session; done: Promise<void> }>()
+  private readonly pinned = new Set<SessionId>()
+  private readonly handles = new Map<SessionId, AgentHandle>()
+  private readonly pending = new Set<Promise<SessionForkValue>>()
+  private readonly retiring = new Set<Promise<void>>()
+  private readonly sideOperations = new Map<SessionId, Promise<SessionForkValue>>()
+  private closed = false
+
+  /** @param ctx - Host Session services.
+   * @param agents - Shared preset composition and recorded model selection.
+   * @param maxTokens - Output limit for one question.
+   * @param effort - Live requested reasoning level.
+   * @param clearOnClose - Whether closing a side tab starts a new context.
+   */
+  constructor(private readonly ctx: Context, private readonly agents: ApiSessionAgentController,
+    private readonly maxTokens: number, private readonly effort: () => string, private readonly clearOnClose: () => boolean) {
+    ctx.on('agent/disposed', ({ agent }) => {
+      if (this.handles.get(agent.id)?.agent === agent) this.handles.delete(agent.id)
+    })
+    ctx.on('agent/status', ({ agent, status }) => {
+      const handle = this.handles.get(agent.id)
+      if (status !== 'idle' || this.closed || handle?.agent !== agent) return
+      const task = this.releaseWhenDurable(handle).catch((error: unknown) => {
+        if (!this.closed) this.ctx.logger.warn(`Could not release aside "${agent.id}": ${errorChain(error)}`)
+      })
+      this.retiring.add(task)
+      void task.then(() => { this.retiring.delete(task) })
+    })
+    ctx.on('workspace/session-stop', ({ sessionId }) => {
+      for (const { agent } of this.handles.values()) {
+        if (agent.session.header.parentSession === sessionId && agent.status === 'running') agent.cancel({ kind: 'user' })
+      }
+    })
+  }
+
+  /** Retain a live child until its answer reaches persistence.
+   * @param handle - Child owned by this Host.
+   */
+  retain(handle: AgentHandle): void {
+    this.handles.set(handle.agent.id, handle)
+  }
+
+  /** Whether this disposal releases only the writer of a successfully flushed aside.
+   * @param session - Exact Session being detached from this Host.
+   * @returns Whether its saved conversation remains available for follow-ups.
+   */
+  isReleasingSaved(session: Session): boolean {
+    return this.releasingSaved.get(session.id)?.session === session
+  }
+
+  private async releaseSaved(handle: AgentHandle): Promise<void> {
+    const { session } = handle.agent
+    const active = this.releasingSaved.get(session.id)
+    if (active?.session === session) return active.done
+    const done = Promise.resolve().then(() => handle.dispose())
+    this.releasingSaved.set(session.id, { session, done })
+    try { await done }
+    finally { this.releasingSaved.delete(session.id) }
+  }
+
+  private async releaseWhenDurable(handle: AgentHandle): Promise<void> {
+    const { agent } = handle
+    await agent.whenIdle()
+    if (this.closed || this.handles.get(agent.id) !== handle || !this.ctx.get('sessionPersistence')) return
+    if (await this.ctx.sessions.flush(agent.session) && agent.status === 'idle' && this.handles.get(agent.id) === handle && !this.pinned.has(agent.id)) {
+      await this.releaseSaved(handle)
+    }
+  }
+
+  /** Open the current side conversation or create a fresh quick question, without submitting a turn.
+   * @param request - Owning main Session and the requested kind of discussion.
+   * @returns Identity of the published child.
+   */
+  async open(request: SessionAsideRequest): Promise<SessionForkValue> {
+    const { sessionId: parent, kind } = request
+    return this.schedule(kind === 'side' ? parent : undefined, () => {
+      this.authorizeParent(parent)
+      return this.openChild(parent, kind)
+    })
+  }
+
+  private async schedule(parent: SessionId | undefined, run: () => Promise<SessionForkValue>): Promise<SessionForkValue> {
+    if (this.closed) throw new RemoteError('gateway/internal', 'Session service is closing', {})
+    const previous = parent === undefined ? undefined : this.sideOperations.get(parent)
+    const operation = previous === undefined ? run() : previous.then(run, run)
+    if (parent !== undefined) this.sideOperations.set(parent, operation)
+    this.pending.add(operation)
+    try {
+      return await operation
+    } finally {
+      this.pending.delete(operation)
+      if (parent !== undefined && this.sideOperations.get(parent) === operation) this.sideOperations.delete(parent)
+    }
+  }
+
+  private authorize(id: SessionId): void {
+    if (!this.ctx.remoteAccess.allows({ kind: 'session', id })) {
+      throw new RemoteError('remote-access/denied', 'Aside access denied.', { action: 'session/aside', reason: 'no-allow' })
+    }
+  }
+
+  private authorizeParent(parent: SessionId): void {
+    this.authorize(parent)
+    if (this.ctx.workspaceRegistry.archivedSessionIds.includes(parent)) {
+      throw new RemoteError('session/fork-unavailable', 'Restore the main conversation before opening an aside.', { sessionId: parent })
+    }
+  }
+
+  /** Publish one fresh side generation while holding the previous generation's writer.
+   * @param request - Exact side identity and the action that requested a clear.
+   * @returns The current side, including when a stale client retries an earlier reset.
+   */
+  async reset(request: SessionAsideResetRequest): Promise<SessionForkValue> {
+    const old = request.sessionId
+    this.authorize(old)
+    using observed = await this.ctx.sessionQuery.observeSession(old)
+    const parent = observed.header.parentSession
+    if (parent === undefined || nativeAsideKind(old, parent) !== 'side') {
+      throw new RemoteError('gateway/bad-request', 'Context clearing requires a native side conversation.', {})
+    }
+    return await this.schedule(parent, async () => {
+      this.authorizeParent(parent)
+      this.authorize(old)
+      const current = await currentSide(this.ctx, parent)
+      if (!current) throw new RemoteError('session/not-found', 'Side conversation is unavailable.', { sessionId: old })
+      this.authorize(current.id)
+      if (current.id !== old || (request.cause === 'close' && !this.clearOnClose())) return { sessionId: current.id }
+      if (!Number.isSafeInteger(current.generation + 1)) throw new RemoteError('gateway/internal', 'Side context generation is exhausted.', {})
+      const child = sideIdentity(parent, current.generation + 1)
+      this.authorize(child)
+      this.pinned.add(old)
+      try {
+        await this.releasingSaved.get(old)?.done
+        const resolved = await this.agents.resolveAgent(old)
+        if ('error' in resolved) {
+          const latest = await currentSide(this.ctx, parent)
+          if (latest !== undefined && latest.id !== old) {
+            this.authorize(latest.id)
+            return { sessionId: latest.id }
+          }
+          throw resolved.error
+        }
+        const handle = this.handles.get(old)
+        if (handle?.agent !== resolved.agent) throw new RemoteError('session/writer-held', 'Another owner holds this side conversation.', { sessionId: old })
+        const result = await this.agents.replaceSideWriter(handle.agent, async () => {
+          handle.agent.cancel({ kind: 'user' })
+          await this.ctx.parallel('workspace/session-stop', { sessionId: old })
+          await this.ctx.get('subagents')?.drainDescendants([handle.agent])
+          await handle.agent.whenIdle()
+          await this.ctx.sessions.flush(handle.agent.session)
+          using settings = await this.ctx.sessionQuery.observeSession(old, { projectionMode: 'all' })
+          return await this.publish(parent, 'side', child, settings)
+        })
+        this.ctx.emit('api-session/side-reset', parent)
+        return result
+      } finally {
+        this.pinned.delete(old)
+        const owned = this.handles.get(old)
+        if (owned !== undefined && owned.agent.status === 'idle') await this.releaseWhenDurable(owned)
+      }
+    })
+  }
+
+  private async openChild(parent: SessionId, kind: SessionAsideRequest['kind']): Promise<SessionForkValue> {
+    const live = this.ctx.sessions.get(parent)
+    if (live !== undefined) await this.ctx.sessions.flush(live)
+    using source = await this.ctx.sessionQuery.observeSession(parent, { projectionMode: 'all' })
+    const current = kind === 'side' ? await currentSide(this.ctx, source.header.id) : undefined
+    const child = current?.id ?? (kind === 'side' ? sideIdentity(parent) : brandString<SessionId>(`session-btw-${randomUUID()}`))
+    this.authorize(child)
+    if (current !== undefined) return { sessionId: current.id }
+    return await this.publish(parent, kind, child, source)
+  }
+
+  private async publish(parent: SessionId, kind: SessionAsideRequest['kind'], child: SessionId, source: SessionObservation): Promise<SessionForkValue> {
+    const composition = await this.agents.composeAgent(this.agents.presetForObservation(source))
+    const inherited = inheritedModel(this.ctx, source)
+    const selection = kind === 'btw' ? await this.selectEffort(inherited) : inherited
+    const handle = await this.ctx.agents.create({ sessionId: child,
+      meta: { parentSession: parent, ...(source.header.cwd === undefined ? {} : { cwd: source.header.cwd }),
+        ...(composition.agentPreset === undefined ? {} : { agentPreset: composition.agentPreset }) },
+      agentOptions: kind === 'btw' ? { ...selection, maxTokens: this.maxTokens } : selection,
+      setup: async (ctx, agent) => {
+        const commit = await composition.setup(ctx, agent)
+        if (kind === 'side') inheritSidePermissions(ctx, agent, source)
+        agent.model.select(selection)
+        return commit
+      },
+    })
+    try {
+      this.retain(handle)
+      if (await this.ctx.sessions.flush(handle.agent.session) && this.ctx.get('sessionPersistence')) {
+        await this.releaseSaved(handle)
+      }
+      return { sessionId: child }
+    } catch (error) {
+      await handle.dispose()
+      throw error
+    }
+  }
+
+  private async selectEffort(inherited: ModelSelection): Promise<ModelSelection> {
+    try {
+      const model = await this.ctx.llm.resolveModelInfo(inherited.provider, inherited.model)
+      const effort = this.effort()
+      return model.reasoning?.efforts.some(entry => entry.id === effort)
+        ? { ...inherited, reasoningEffort: ReasoningEffortId(effort) } : inherited
+    } catch (error) {
+      this.ctx.logger.warn(`Quick-question model lookup failed: ${errorChain(error)}`)
+      return inherited
+    }
+  }
+
+  /** Finish admitted publications before releasing child Agents. */
+  async close(): Promise<void> {
+    this.closed = true
+    await Promise.allSettled([...this.pending])
+    await Promise.all([...this.handles.values()].map(handle => handle.dispose()))
+    await Promise.allSettled([...this.retiring])
+  }
+}
