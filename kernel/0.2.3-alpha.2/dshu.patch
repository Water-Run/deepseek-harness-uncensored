diff --git a/apps/web/tests/balance-cleanup.e2e.ts b/apps/web/tests/balance-cleanup.e2e.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c8faeeebbcc220c6ab85524b815fe0200d140f3f
--- /dev/null
+++ b/apps/web/tests/balance-cleanup.e2e.ts
@@ -0,0 +1,85 @@
+/** Stored-sample cleanup and automatic retention in the balance sampling settings. */
+import { mkdir } from 'node:fs/promises'
+import { fileURLToPath } from 'node:url'
+import { join } from 'node:path'
+import { chromium } from 'playwright'
+import { expect, it, onTestFinished, vi } from 'vitest'
+import type {} from '@deepseek-ai/dsh-balance'
+import type { BalanceCleanupRequest } from '@deepseek-ai/dsh-balance/types'
+import { launchWebScaffold } from './scaffold.ts'
+import { openSettings, ZH_BROWSER_LOCALE } from './support.ts'
+
+it('cleans stored samples by age, by count, or completely, and keeps automatic retention', async () => {
+  const scaffold = await launchWebScaffold({ developerTools: false,
+    extraOverlayPath: fileURLToPath(new URL('./pin-browse-picker.overlay.yml', import.meta.url)) })
+  onTestFinished(() => scaffold.close())
+  await scaffold.ctx.settings.mutate('ui-settings-account', [
+    { op: 'set', path: ['step'], value: 'done' }, { op: 'set', path: ['completion'], value: 'completed' },
+  ])
+  const snapshot = {
+    status: 'ready' as const, source: 'api' as const, account: 'api-key' as const, sampleCount: 4,
+    samples: [[0, 128.5], [1, 128.4], [181, 128.4], [182, 128.3]].map(([minute, amount]) => ({
+      time: Date.UTC(2026, 10, 11, 0, minute ?? 0),
+      wallets: [{ currency: 'CNY' as const, toppedUp: (amount ?? 0).toFixed(2), granted: '0' }] })),
+  }
+  const get = vi.spyOn(scaffold.ctx.uncensoredBalance, 'get').mockResolvedValue(snapshot)
+  const requests: BalanceCleanupRequest[] = []
+  const clear = vi.spyOn(scaffold.ctx.uncensoredBalance, 'clear').mockImplementation(async (_client, request) => {
+    requests.push(request)
+    return { ...snapshot, status: 'empty', sampleCount: 0, samples: [] }
+  })
+  onTestFinished(() => { get.mockRestore(); clear.mockRestore() })
+  const browser = await chromium.launch()
+  onTestFinished(() => browser.close())
+  const page = await browser.newPage({ viewport: { width: 1280, height: 900 }, locale: ZH_BROWSER_LOCALE,
+    timezoneId: 'Asia/Shanghai', reducedMotion: 'reduce' })
+  await page.goto(scaffold.authenticatedUrl, { waitUntil: 'load' })
+  await openSettings(page, 'zh')
+  const dialog = page.getByRole('dialog', { name: '设置', exact: true })
+  await dialog.getByRole('navigation').getByRole('button', { name: '额度', exact: true }).click()
+  await dialog.getByRole('slider', { name: '总余额采样曲线' }).waitFor()
+  await dialog.getByText('采样设置', { exact: true }).click()
+
+  const cleanupButton = dialog.getByRole('button').filter({ hasText: /^(清理|确认清理)$/u })
+  const manual = dialog.getByRole('group', { name: '清理存储的采样' })
+  const automatic = dialog.getByRole('group', { name: '自动清理' })
+  const keepDays = manual.getByRole('spinbutton', { name: '保留天数' })
+  expect(await automatic.getByRole('spinbutton', { name: '保留天数' }).inputValue()).toBe('30')
+  await expect.poll(() => cleanupButton.isEnabled()).toBe(true)
+
+  const screenshots = fileURLToPath(new URL('../../../.artifacts/screenshots/balance-cleanup', import.meta.url))
+  await mkdir(screenshots, { recursive: true })
+  for (const preference of ['light', 'dark'] as const) {
+    await scaffold.ctx.settings.update('ui-theme', { preference })
+    await dialog.getByText('自动清理', { exact: true }).scrollIntoViewIfNeeded()
+    await dialog.locator('details[open]').screenshot({ path: join(screenshots, `${preference}.png`) })
+  }
+
+  await keepDays.fill('7')
+
+  await cleanupButton.scrollIntoViewIfNeeded()
+  await cleanupButton.click({ force: true })
+  await expect.poll(() => requests).toEqual([{ mode: 'age', days: 7 }])
+
+  await dialog.getByRole('button', { name: '清理存储的采样' }).click()
+  await page.getByRole('menuitem', { name: '按条数', exact: true }).click()
+  const keepCount = manual.getByRole('spinbutton', { name: '保留条数' })
+  await keepCount.fill('500')
+  await cleanupButton.scrollIntoViewIfNeeded()
+  await cleanupButton.click({ force: true })
+  await expect.poll(() => requests.at(-1)).toEqual({ mode: 'count', keep: 500 })
+
+  await dialog.getByRole('button', { name: '清理存储的采样' }).click()
+  await page.getByRole('menuitem', { name: '全部', exact: true }).click()
+  await cleanupButton.scrollIntoViewIfNeeded()
+  await cleanupButton.click({ force: true })
+  await expect.poll(() => cleanupButton.textContent()).toContain('确认清理')
+  expect(requests.at(-1)).toEqual({ mode: 'count', keep: 500 })
+  await cleanupButton.scrollIntoViewIfNeeded()
+  await cleanupButton.click({ force: true })
+  await expect.poll(() => requests.at(-1)).toEqual({ mode: 'all' })
+
+  await dialog.getByRole('button', { name: '自动清理' }).click()
+  await page.getByRole('menuitem', { name: '按条数', exact: true }).click()
+  await expect.poll(() => automatic.getByRole('spinbutton', { name: '保留条数' }).count()).toBe(1)
+})
diff --git a/apps/web/tests/balance-history-layout.e2e.ts b/apps/web/tests/balance-history-layout.e2e.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b17cb72899e36b40c7d7a3d7fd7140233504354b
--- /dev/null
+++ b/apps/web/tests/balance-history-layout.e2e.ts
@@ -0,0 +1,171 @@
+/** Balance sample bubbles stay inside their plot while its layout changes. */
+import { mkdir } from 'node:fs/promises'
+import { fileURLToPath } from 'node:url'
+import { join } from 'node:path'
+import { chromium, webkit } from 'playwright'
+import { describe, expect, it, onTestFinished, vi } from 'vitest'
+import type {} from '@deepseek-ai/dsh-balance'
+import { BalanceEngine } from '../../../packages/credentials/balance/src/engine.ts'
+import { launchWebScaffold } from './scaffold.ts'
+import { openSettings, ZH_BROWSER_LOCALE } from './support.ts'
+
+it('keeps sub-cent observations and a small rise visible in a dense history in both palettes', async () => {
+  const scaffold = await launchWebScaffold({ developerTools: false,
+    extraOverlayPath: fileURLToPath(new URL('./pin-browse-picker.overlay.yml', import.meta.url)) })
+  onTestFinished(() => scaffold.close())
+  await scaffold.ctx.settings.mutate('ui-settings-account', [
+    { op: 'set', path: ['step'], value: 'done' }, { op: 'set', path: ['completion'], value: 'completed' },
+  ])
+  const amounts = Array.from({ length: 500 }, (_, index) =>
+    ((63_889_919 - index * 20 + (index === 4 ? 40 : 0)) / 1_000_000).toFixed(6))
+  const time = (index: number): number => Date.UTC(2026, 10, 17, 1, index)
+  const samples = amounts.map((toppedUp, index) => ({ time: time(index),
+    wallets: [{ currency: 'CNY' as const, toppedUp, granted: '0' }] }))
+  const engine = new BalanceEngine({
+    identify: async () => ({ key: 'balance-fixture', account: 'api-key', query: async () => null, current: async () => true }),
+    read: () => samples, write: async () => {}, limit: samples.length, displayLimit: 240, timeoutMs: 1000, now: Date.now,
+    retention: () => ({ mode: 'off', count: 2000, days: 30 }),
+  })
+  onTestFinished(() => engine.close())
+  const balance = vi.spyOn(scaffold.ctx.uncensoredBalance, 'get').mockImplementation((client, view) => engine.read(client, 'local', view))
+  onTestFinished(() => { balance.mockRestore() })
+  const browser = await chromium.launch()
+  onTestFinished(() => browser.close())
+  const page = await browser.newPage({ viewport: { width: 1000, height: 800 }, locale: ZH_BROWSER_LOCALE,
+    timezoneId: 'Asia/Shanghai', reducedMotion: 'reduce' })
+  await page.goto(scaffold.authenticatedUrl, { waitUntil: 'load' })
+  await openSettings(page, 'zh')
+  const dialog = page.getByRole('dialog', { name: '设置', exact: true })
+  await dialog.getByRole('navigation').getByRole('button', { name: '额度', exact: true }).click()
+  const plot = dialog.getByRole('slider', { name: '总余额采样曲线' })
+  await expect.poll(() => plot.getAttribute('aria-valuemax')).toBe('499')
+  const rise = await plot.locator('path[class*="increase"]').getAttribute('d')
+  const jump = /^M([\d.]+),[\d.]+ V[\d.]+$/u.exec(rise ?? '')
+  expect(jump).not.toBeNull()
+  expect(Number(jump?.[1])).toBeCloseTo(52 + 4 / (amounts.length - 1) * 252)
+  const screenshots = fileURLToPath(new URL('../../../.artifacts/screenshots/balance-precision', import.meta.url))
+  await mkdir(screenshots, { recursive: true })
+  for (const preference of ['light', 'dark'] as const) {
+    await scaffold.ctx.settings.update('ui-theme', { preference })
+    const rect = await plot.boundingBox()
+    if (rect === null) throw new Error('Balance plot is missing')
+    for (const index of [0, 4, amounts.length - 1]) {
+      const ratio = (6 + index / (amounts.length - 1) * 252) / 264
+      await page.mouse.move(rect.x + rect.width * ratio, rect.y + rect.height / 2)
+      await expect.poll(() => plot.getByRole('status').innerText()).toContain(`¥${amounts[index]}`)
+      expect(await plot.getByRole('status').locator('time').getAttribute('datetime')).toBe(new Date(time(index)).toISOString())
+    }
+    expect(await plot.getAttribute('aria-valuemax')).toBe('499')
+    expect(await dialog.getByText('-¥0.00998', { exact: true }).count()).toBe(1)
+    expect(await dialog.evaluate(node => node.scrollWidth <= node.clientWidth)).toBe(true)
+    await dialog.screenshot({ path: join(screenshots, `${preference}.png`) })
+  }
+  const start = dialog.getByRole('slider', { name: '区间起点' })
+  const end = dialog.getByRole('slider', { name: '区间终点' })
+  const selectedRange = start.locator('..').locator('span')
+  expect(await selectedRange.evaluate(node => getComputedStyle(node).backgroundColor)).not.toBe('rgba(0, 0, 0, 0)')
+  await start.focus()
+  await start.press('ArrowRight')
+  await end.focus()
+  await end.press('ArrowLeft')
+  await expect.poll(() => plot.getAttribute('aria-valuemax')).toBe('497')
+  await plot.focus()
+  await plot.press('Home')
+  expect(await plot.getByRole('status').locator('time').getAttribute('datetime')).toBe(new Date(time(1)).toISOString())
+  await plot.press('End')
+  expect(await plot.getByRole('status').locator('time').getAttribute('datetime')).toBe(new Date(time(498)).toISOString())
+  const sidebar = dialog.getByRole('switch', { name: '侧栏显示余额' })
+  await sidebar.click()
+  await expect.poll(() => sidebar.getAttribute('aria-checked')).toBe('false')
+  expect(await plot.isVisible()).toBe(true)
+  await sidebar.click()
+  const track = await start.boundingBox()
+  if (!track) throw new Error('The history range control is missing')
+  const y = track.y + track.height / 2
+  await page.mouse.move(track.x + 9, y)
+  await page.mouse.down()
+  await page.mouse.move(track.x + track.width * .25, y, { steps: 6 })
+  await page.mouse.up()
+  await expect.poll(() => start.inputValue().then(Number)).toBeGreaterThan(100)
+  await page.mouse.move(track.x + track.width - 9, y)
+  await page.mouse.down()
+  await page.mouse.move(track.x + track.width * .75, y, { steps: 6 })
+  await page.mouse.up()
