+}
+
+.input,
+.textarea,
+.textareaWide {
+  box-sizing: border-box;
+  width: 100%;
+  min-width: 0;
+  padding: 6px 8px;
+  border: 0.5px solid var(--dsw-alias-border-l3);
+  border-radius: var(--dsw-radius-sm);
+  background: var(--dsw-alias-bg-layer-1);
+  color: var(--dsw-alias-label-primary);
+  font: inherit;
+  font-size: 13px;
+  line-height: 1.5;
+}
+
+.textarea {
+  resize: vertical;
+  min-height: 64px;
+}
+
+.textareaWide {
+  resize: vertical;
+  min-height: 160px;
+  font-family: var(--dsw-font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
+  font-size: 12.5px;
+}
+
+.input:focus-visible,
+.textarea:focus-visible,
+.textareaWide:focus-visible {
+  outline: var(--dsw-focus-ring-width) solid var(--dsw-focus-ring-color, var(--dsw-alias-state-business-primary));
+  outline-offset: 1px;
+}
+
+.inlineForm {
+  display: flex;
+  align-items: flex-end;
+  flex-wrap: wrap;
+  gap: 8px;
+  min-width: 0;
+}
+
+.inlineForm > *:first-child {
+  flex: 1 1 260px;
+}
+
+.facts {
+  display: grid;
+  grid-template-columns: minmax(72px, max-content) minmax(0, 1fr);
+  gap: 4px 12px;
+  margin: 0;
+  font-size: 12.5px;
+  min-width: 0;
+}
+
+.facts dt {
+  color: var(--dsw-alias-label-secondary);
+}
+
+.facts dd {
+  margin: 0;
+  min-width: 0;
+  color: var(--dsw-alias-label-primary);
+  overflow-wrap: anywhere;
+}
+
+.strings {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  max-height: 220px;
+  overflow: auto;
+}
+
+.mono {
+  font-family: var(--dsw-font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
+  font-size: 11.5px;
+  line-height: 1.5;
+  overflow-wrap: anywhere;
+}
+
+.problem,
+.error,
+.conflict {
+  margin: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 6px;
+  padding: 8px 10px;
+  border-radius: var(--dsw-radius-sm);
+  font-size: 12px;
+  line-height: 1.55;
+  overflow-wrap: anywhere;
+}
+
+.problem,
+.error {
+  border: 0.5px solid var(--dsw-alias-state-error-primary);
+  color: var(--dsw-alias-state-error-primary);
+}
+
+.conflict {
+  border: 0.5px solid var(--dsw-alias-state-warning-primary, var(--dsw-alias-border-l3));
+  background: var(--dsw-alias-interactive-bg-hover);
+  color: var(--dsw-alias-label-primary);
+}
+
+.problemDetail,
+.failureBody {
+  margin: 0;
+  font-size: 11.5px;
+  color: var(--dsw-alias-label-tertiary);
+}
+
+.failureHead {
+  margin: 0;
+  font-weight: 500;
+}
+
+.dialog {
+  width: min(640px, 100%);
+}
+
+.reportDialog {
+  width: min(820px, 100%);
+}
+
+.report {
+  --dsh-scrollbar-thumb: var(--dsw-alias-scrollbar-bg-l2);
+  --dsh-scrollbar-thumb-hover: var(--dsw-alias-scrollbar-hover-l2);
+  margin: 0;
+  padding: 12px;
+  max-height: min(60vh, 560px);
+  overflow: auto;
+  border: 0.5px solid var(--dsw-alias-border-l4);
+  border-radius: var(--dsw-radius-lg);
+  background: var(--dsw-alias-bg-layer-2);
+  color: var(--dsw-alias-label-secondary);
+  font-family: var(--dsw-font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
+  font-size: 12px;
+  line-height: 1.5;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+}
+
+/* Narrow windows: the row stacks its actions under the title instead of
+   clipping, and the inline form's control keeps its own line. */
+@media (max-width: 480px) {
+  .row {
+    align-items: stretch;
+  }
+
+  .rowActions {
+    margin-left: 0;
+    justify-content: flex-start;
+  }
+
+  .facts {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
diff --git a/packages/client/ui-mode-materials/src/client/ModeMaterials.tsx b/packages/client/ui-mode-materials/src/client/ModeMaterials.tsx
