index 0000000000000000000000000000000000000000..8a0825450fc6db5f0846a5c0efdb1d7224a00f04
--- /dev/null
+++ b/packages/subprocess/subprocess-local/tests/fixtures/terminal-output-exit.ts
@@ -0,0 +1,25 @@
+/** Windows terminal hosts must exit naturally once the output of each child has drained. */
+import assert from 'node:assert/strict'
+import { text } from 'node:stream/consumers'
+import { Context } from '@deepseek-ai/cordis'
+import LocalSubprocessRuntime from '@deepseek-ai/dsh-subprocess-local'
+
+const ctx = new Context()
+await ctx.plugin(LocalSubprocessRuntime)
+try {
+  for (const scenario of [
+    { script: 'console.log("one reply")', code: 0, lines: ['one reply'] },
+    { script: 'process.exitCode = 7', code: 7, lines: [] },
+    { script: 'for (let i=0;i<256;i++) console.log("line-"+i+"-end")', code: 0,
+      lines: Array.from({ length: 256 }, (_, i) => 'line-' + i + '-end') },
+  ]) {
+    const handle = await ctx.subprocess.spawnTerminal({ argv: [process.execPath, '-e', scenario.script],
+      cwd: process.cwd(), rows: 24, cols: 80, terminalType: 'dumb', graceMs: 1000 })
+    const [outcome, output] = await Promise.all([handle.done, text(handle.output)])
+    assert.equal(outcome.exitCode, scenario.code)
+    const lines = output.match(/one reply|line-\d+-end/gu) ?? []
+    assert.deepEqual(lines, scenario.lines)
+    await handle.terminate()
+  }
+} finally { await ctx.fiber.dispose() }
+console.log('Released terminal handles')
