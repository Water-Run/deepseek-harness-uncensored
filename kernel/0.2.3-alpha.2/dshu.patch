index 0000000000000000000000000000000000000000..ab5bfb432d0ad21f63a9b8cfe0ffb531f0bd6612
--- /dev/null
+++ b/packages/guard/spend-limit/src/index.ts
@@ -0,0 +1,221 @@
+/** Built-in spending admission for model streams and DeepSeek native search. */
+import type { Context } from '@deepseek-ai/cordis'
+import schema from '@deepseek-ai/schemastery'
+import { principalOf, Remote, RemoteError, TypertRemoteService } from '@deepseek-ai/dsh-typert-protocol'
+import type {} from '@deepseek-ai/dsh-llm'
+import type {} from '@deepseek-ai/dsh-web-search-deepseek'
+import type {} from '@deepseek-ai/dsh-session-query'
+import { z } from 'zod'
+import { SpendRecovery, type SpendContinuationHandler } from './continuation.ts'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import { SpendLedger } from './ledger.ts'
+import { SpendGate } from './gate.ts'
+import { DEFAULT_RATES } from './pricing.ts'
+import type { SessionSpendUsage, SpendPeriod, SpendPreferences, SpendRate, SpendSnapshot, SpendWindowUpdate } from './types.ts'
+export type * from './types.ts'
+
+/** Deployment-owned ledger path and conservative rates. User limits live in the ledger. */
+export interface Config {
+  /** SQLite ledger path, independent of individual conversations. */
+  path: string
+  /** Interval in milliseconds for rechecking waiting requests and durable pauses. */
+  pollMs: number
+  /** Provider/model rates used for reservations and settlement estimates. */
+  rates: SpendRate[]
+}
+/** All deployment-varying rates are configurable without changing source. */
+export const Config = schema.object({
+  path: schema.string().required(), pollMs: schema.number().step(1).min(50).max(60000).default(1000), rates: schema.array(schema.object({
+    providers: schema.array(schema.string()).required(), models: schema.array(schema.string()).required(),
+    input: schema.number().min(0).max(10000).required(), cachedInput: schema.number().min(0).max(10000).required(),
+    cacheWrite: schema.number().min(0).max(10000).required(), output: schema.number().min(0).max(10000).required(),
+    contextTokens: schema.number().step(1).min(1).max(100000000).required(),
+    maxOutputTokens: schema.number().step(1).min(1).max(100000000).required(), searchRequest: schema.number().min(0).max(10000).required(),
+  })).default(DEFAULT_RATES) })
+export const name = 'spend-limit'
+export const inject = ['llm']
+declare module '@deepseek-ai/cordis' { interface Context { spendLimit: SpendLimitRemote } }
+interface SpendRuntime { ready: Promise<SpendGate>; recovery: SpendRecovery }
+const count = z.number().int().nonnegative()
+const usageSchema = z.object({ input_tokens: count, output_tokens: count,
+  cache_read_input_tokens: count.optional(), cache_creation_input_tokens: count.optional() })
+
+/** Authenticated settings and observations; no request content or credentials are stored. */
+export class SpendLimitRemote extends TypertRemoteService {
+  /** @param ctx - Service owner. @param runtime - Owned ledger and recovery worker. */
+  constructor(ctx: Context, private readonly runtime: SpendRuntime) { super(ctx, 'spendLimit', { namespace: 'spending' }) }
+  private assertOwner(action: string): void {
+    if (principalOf(this.ctx.invocation) !== undefined) throw new RemoteError('spending/owner-required',
+      'Only the application owner can access spending limits.', { action })
+  }
+  /**
+   * Register the lifecycle owner that captures and restores ordinary conversations.
+   * @param handler - Normal conversation restoration path.
+   * @param capture - Tests ownership of a live Session before creating a durable pause.
+   * @returns Cancelling, draining registration disposer.
+   */
+  registerContinuation(handler: SpendContinuationHandler, capture: (id: SessionId) => boolean): () => Promise<void> {
+    return this.runtime.recovery.register(handler, capture)
+  }
+  /**
+   * Discard a conversation's saved continuation, including one awaiting restoration.
+   * @param sessionId - Conversation whose pending continuation has been withdrawn.
+   */
+  async forgetSession(sessionId: SessionId): Promise<void> { (await this.runtime.ready).ledger.clearSession(sessionId) }
+  /**
+   * Read the durable ledger; initialization failures remain visible to every caller.
+   * @returns Shared limits, rolling totals and local waiters.
+   */
+  @Remote
+  async get(): Promise<SpendSnapshot> {
+    this.assertOwner('spending/get')
+    const gate = await this.runtime.ready
+    return gate.ledger.snapshot(gate.waiting)
+  }
+  /**
+   * Read estimates from recorded model usage, including when spending limits are off.
+   * @param sessionId - Conversation to inspect; only the application owner may read it.
+   * @returns CNY estimate and bounded cumulative history, with missing usage or rates counted explicitly.
+   */
+  @Remote
+  async sessionUsage(sessionId: SessionId): Promise<SessionSpendUsage> {
+    this.assertOwner('spending/sessionUsage')
+    const query = this.ctx.get('sessionQuery')
+    if (query === undefined) throw new RemoteError('gateway/internal', 'Session history is unavailable.', {})
+    using source = await query.observeSession(sessionId)
+    return (await this.runtime.ready).sessionUsage(source.events, source.inheritedEventCount)
+  }
+  /**
+   * Save user preferences across local processes.
+   * @param preferences - Complete user limits.
+   * @returns Committed settings and totals.
+   */
+  @Remote
+  async configure(preferences: SpendPreferences): Promise<SpendSnapshot> {
+    this.assertOwner('spending/configure')
+    const gate = await this.runtime.ready
+    gate.ledger.configure(preferences)
+    await this.runtime.recovery.flush(gate)
+    return this.get()
+  }
+  /**
+   * Save one window without overwriting concurrent changes to another window.
+   * @param update - Window and the settings to change.
+   * @returns Committed preferences and totals.
+   */
+  @Remote
+  async configureWindow(update: SpendWindowUpdate): Promise<SpendSnapshot> {
+    this.assertOwner('spending/configure-window')
+    const gate = await this.runtime.ready
+    gate.ledger.configureWindow(update)
+    await this.runtime.recovery.flush(gate)
+    return this.get()
+  }
+  /**
+   * Save the automatic continuation preference independently of window settings.
+   * @param enabled - Whether paused conversations should continue when capacity returns.
+   * @returns Committed preferences and totals.
+   */
+  @Remote
+  async setAutoResume(enabled: boolean): Promise<SpendSnapshot> {
+    this.assertOwner('spending/auto-resume')
+    const gate = await this.runtime.ready
+    gate.ledger.setAutoResume(enabled)
+    await this.runtime.recovery.flush(gate)
+    return this.get()
+  }
+  /**
+   * Disable all windows while preserving their amounts and accounting records.
+   * @returns Committed preferences and totals after eligible conversations resume.
+   */
+  @Remote
+  async disableAll(): Promise<SpendSnapshot> {
+    this.assertOwner('spending/disable-all')
+    const gate = await this.runtime.ready
+    gate.ledger.disableAll()
+    await this.runtime.recovery.flush(gate)
+    return this.get()
+  }
+  /**
+   * Clear manual pause.
+   * @returns Updated state; remaining limits still apply.
+   */
+  @Remote
+  async resume(): Promise<SpendSnapshot> {
+    this.assertOwner('spending/resume')
+    const gate = await this.runtime.ready
+    gate.ledger.resume()
+    await this.runtime.recovery.flush(gate)
+    return this.get()
+  }
+  /**
+   * Clear completed statistics.
+   * @param period - One rolling window; omission resets all completed statistics.
+   * @returns Remaining active reservations and settings.
+   */
+  @Remote
+  async reset(period?: SpendPeriod): Promise<SpendSnapshot> {
+    this.assertOwner('spending/reset')
+    const gate = await this.runtime.ready
+    gate.ledger.reset(period)
+    await this.runtime.recovery.flush(gate)
+    return this.get()
+  }
+}
+
+/**
+ * Install admission before provider dispatch and retain the ledger through request teardown.
+ * @param ctx - Root application scope.
+ * @param config - Validated deployment settings.
+ */
+export async function apply(ctx: Context, config: Config): Promise<void> {
+  let closing = false
+  const ready = SpendLedger.open(config.path)
+    .then(ledger => new SpendGate(ledger, config.rates, config.pollMs, id => recovery.canCapture(id)))
+  void ready.catch((error: unknown) => { ctx.logger.error('spend-limit: ledger unavailable; paid requests remain blocked'); ctx.logger.error(error) })
+  const recovery = new SpendRecovery((error) => {
+    ctx.logger.error('spend-limit: paused conversation remains pending; recovery failed')
+    ctx.logger.error(error)
+  })
+  let stopPolling: (() => void) | undefined
+  void ready.then((gate) => {
+    if (closing) return
+    const timer = setInterval(() => { void recovery.flush(gate) }, config.pollMs)
+    stopPolling = () => { clearInterval(timer) }
+  }, () => { /* Initialization failure is reported above and blocks paid requests. */ })
+  const service = ctx.plugin(SpendLimitRemote, { ready, recovery })
+  const stopStream = ctx.on('llm/stream', async function* (request, next) {
+    const gate = await ready
+    if (closing) throw new Error('spend-limit: service is closing')
+    yield* gate.stream(request, next)
+  })
+  const stopSearch = ctx.on('web/deepseek-search-request', async (request, signal, next) => {
+    const gate = await ready
+    if (closing) throw new Error('spend-limit: service is closing')
+    return gate.call({ provider: 'deepseek-official', model: request.body.model, maxTokens: request.body.max_tokens, searches: request.body.tools[0].max_uses }, async () => {
+      const value = await next()
+      const parsed = usageSchema.safeParse(value.usage)
+      const counters = parsed.success ? parsed.data : undefined
+      return { value, ...counters === undefined ? {} : { usage: { inputTokens: counters.input_tokens, outputTokens: counters.output_tokens,
+        cacheReadTokens: counters.cache_read_input_tokens ?? 0, cacheWriteTokens: counters.cache_creation_input_tokens ?? 0 } },
+      searches: value.content?.filter(block => block.type === 'web_search_tool_result').length ?? request.body.tools[0].max_uses }
+    }, signal)
+  })
+  ctx.effect(() => async () => {
+    closing = true
+    stopPolling?.()
+    stopStream(); stopSearch()
+    await recovery.close()
+    // Failed initialization has already been reported; there is no owned handle to close.
+    const gate = await ready.catch(() => undefined)
+    await gate?.close()
+    await service.dispose()
+  }, 'spend-limit: admission and ledger')
+  try { await service.await() }
+  catch (error) {
+    closing = true; stopPolling?.(); stopStream(); stopSearch()
+    await recovery.close()
+    await (await ready.catch(() => undefined))?.close()
+    throw error
+  }
+}
diff --git a/packages/guard/spend-limit/src/ledger.ts b/packages/guard/spend-limit/src/ledger.ts
new file mode 100644
index 0000000000000000000000000000000000000000..07a98ff85a7112c65567c09b7e7f1d7f8b7708de
--- /dev/null
+++ b/packages/guard/spend-limit/src/ledger.ts
@@ -0,0 +1,439 @@
+/** Transactional reservations shared by local processes, with conservative crash recovery. */
+import { randomUUID } from 'node:crypto'
+import { mkdir, open } from 'node:fs/promises'
+import { dirname, resolve } from 'node:path'
+import { DatabaseSync } from 'node:sqlite'
+import { z } from 'zod'
+import { brandString } from '@deepseek-ai/dsh-brand'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import type { SpendPauseId, SpendPausedSession, SpendPeriod, SpendPreferences, SpendReservationId, SpendSnapshot, SpendWindowUpdate } from './types.ts'
+
+/** Integer micro-CNY keeps parallel reservation arithmetic exact. */
+export const MICRO_CNY = 1_000_000
+/** Durable ledger schema; newer files are rejected instead of reset. */
+export const SCHEMA_VERSION = 3
+/** Fixed rolling periods exposed by the product. */
+export const SPEND_PERIODS: Readonly<Record<SpendPeriod, number>> = { '15m': 900_000, '1h': 3_600_000, '5h': 18_000_000, '1d': 86_400_000, '7d': 604_800_000, '30d': 2_592_000_000 }
+/** Defaults apply only when the independent ledger is first created. */
+export const DEFAULT_PREFERENCES: SpendPreferences = { enabledPeriods: [], autoResume: false, limits: { '15m': 5, '1h': 15, '5h': 50, '1d': 100, '7d': 500, '30d': 2000 } }
+const amount = z.number().min(0.000001).max(1_000_000)
+const periodSchema = z.enum(['15m', '1h', '5h', '1d', '7d', '30d'])
+const periodNames = Object.keys(SPEND_PERIODS) as SpendPeriod[]
+const limitsSchema = z.object({ '15m': amount, '1h': amount, '5h': amount, '1d': amount, '7d': amount, '30d': amount })
+/** Validation for both remote writes and persisted preferences. */
+export const preferencesSchema = z.object({
+  enabledPeriods: z.array(periodSchema).max(6).refine(periods => new Set(periods).size === periods.length, 'Duplicate spending period'),
+  autoResume: z.boolean(), limits: limitsSchema,
+})
+const settingsSchema = z.object({ preferences: preferencesSchema, paused: z.boolean() })
+const legacySettingsSchema = z.object({
+  preferences: z.object({ enabled: z.boolean(), autoResume: z.boolean(), limits: limitsSchema }), paused: z.boolean(),
+})
+const exclusionSchema = z.object({ period: periodSchema, charge_id: z.string() })
+const entrySchema = z.object({ id: z.string(), owner: z.string(), pid: z.number().int(), time: z.number().int(), reserved: z.number().int().nonnegative(), cost: z.number().int().nonnegative().nullable(), state: z.enum(['pending', 'settled', 'uncertain']) })
+const pauseSchema = z.object({ session_id: z.string().min(1), state: z.enum(['waiting', 'blocked']), pid: z.number().int(), updated_at: z.number().int(),
+  ticket: z.string().min(1), owner: z.string(), required: z.number().int().nonnegative(),
+  manual_only: z.union([z.literal(0), z.literal(1)]),
+  claim_owner: z.string().nullable(), claim_pid: z.number().int().nullable() })
+type Pause = z.infer<typeof pauseSchema>
+/** One recoverable pause claimed exclusively by this ledger handle. */
+export interface SpendPauseClaim {
+  readonly id: SpendPauseId
+  readonly sessionId: SessionId
+}
+type Entry = z.infer<typeof entrySchema>
+type Settings = z.infer<typeof settingsSchema>
+/** Admission result; a waiting result has no network or reservation side effects. */
+export type SpendAdmission = { kind: 'disabled' } | { kind: 'reserved'; id: SpendReservationId } | { kind: 'waiting'; reason: 'paused' | 'limit' } | { kind: 'too-large' }
+
+function exceedsEnabledLimit(required: number, preferences: SpendPreferences): boolean {
+  return preferences.enabledPeriods.some(period => required > Math.round(preferences.limits[period] * MICRO_CNY))
+}
+
+function alive(pid: number): boolean {
+  try { process.kill(pid, 0); return true }
+  catch (error) { if ((error as NodeJS.ErrnoException).code === 'ESRCH') return false; return true }
+}
+
+/**
+ * Synchronous SQL transactions exclude other processes during admission and settlement.
+ * Pending requests never age out. A dead owner becomes an uncertain charge at recovery time.
+ */
+export class SpendLedger {
+  private readonly owner = randomUUID()
+  private closed = false
+  private constructor(
+    private readonly db: DatabaseSync, private readonly now: () => number, private readonly isAlive: (pid: number) => boolean,
+  ) {}
+
+  /**
+   * Open an independent ledger; malformed or unsupported data fails without resetting totals.
+   * @param path - Local SQLite filename, or :memory: for isolated tests.
+   * @param now - Wall clock used for rolling windows.
+   * @param isAlive - Local process liveness check; permission failures count as alive.
+   * @returns An owned handle; callers must drain requests before closing it.
+   */
+  static async open(path: string, now = Date.now, isAlive = alive): Promise<SpendLedger> {
+    const file = path === ':memory:' ? path : resolve(path)
+    if (file !== ':memory:') {
+      await mkdir(dirname(file), { recursive: true, mode: 0o700 })
+      try { const handle = await open(file, 'wx', 0o600); await handle.close() }
+      catch (error) { if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error }
+    }
+    const db = new DatabaseSync(file)
+    try {
+      db.exec('PRAGMA busy_timeout = 5000; PRAGMA journal_mode = WAL; PRAGMA synchronous = FULL; PRAGMA foreign_keys = ON')
+      const version = z.object({ user_version: z.number() }).parse(db.prepare('PRAGMA user_version').get()).user_version
+      if (!Number.isInteger(version) || version < 0 || version > SCHEMA_VERSION) throw new Error(`spend-limit: unsupported ledger version ${version}`)
+      const ledger = new SpendLedger(db, now, isAlive)
+      ledger.transaction(() => {
+        db.exec('CREATE TABLE IF NOT EXISTS preferences (id INTEGER PRIMARY KEY CHECK(id = 1), value TEXT NOT NULL) STRICT')
+        db.exec("CREATE TABLE IF NOT EXISTS charges (id TEXT PRIMARY KEY, owner TEXT NOT NULL, pid INTEGER NOT NULL, time INTEGER NOT NULL, reserved INTEGER NOT NULL CHECK(reserved >= 0), cost INTEGER, state TEXT NOT NULL CHECK(state IN ('pending', 'settled', 'uncertain'))) STRICT")
+        db.exec('CREATE INDEX IF NOT EXISTS charges_time ON charges(time)')
+        db.exec("CREATE TABLE IF NOT EXISTS session_pauses (session_id TEXT PRIMARY KEY, state TEXT NOT NULL CHECK(state IN ('waiting', 'blocked')), pid INTEGER NOT NULL, updated_at INTEGER NOT NULL) STRICT")
+        if (version < 2) {
+          db.exec("ALTER TABLE session_pauses ADD COLUMN ticket TEXT NOT NULL DEFAULT ''; ALTER TABLE session_pauses ADD COLUMN owner TEXT NOT NULL DEFAULT ''; ALTER TABLE session_pauses ADD COLUMN required INTEGER NOT NULL DEFAULT 0; ALTER TABLE session_pauses ADD COLUMN manual_only INTEGER NOT NULL DEFAULT 1; ALTER TABLE session_pauses ADD COLUMN claim_owner TEXT; ALTER TABLE session_pauses ADD COLUMN claim_pid INTEGER")
+          const legacy = z.array(pauseSchema.pick({ session_id: true, state: true, pid: true, updated_at: true }))
+            .parse(db.prepare('SELECT session_id, state, pid, updated_at FROM session_pauses').all())
+          for (const row of legacy) db.prepare("UPDATE session_pauses SET ticket = ?, state = 'blocked' WHERE session_id = ?").run(randomUUID(), row.session_id)
+        }
+        if (version < 3) {
+          const row = z.object({ value: z.string() }).optional().parse(db.prepare('SELECT value FROM preferences WHERE id = 1').get())
+          if (row !== undefined) {
+            const old = legacySettingsSchema.parse(JSON.parse(row.value))
+            ledger.writeSettings({ preferences: {
+              enabledPeriods: old.preferences.enabled ? [...periodNames] : [],
+              autoResume: old.preferences.autoResume, limits: old.preferences.limits,
+            }, paused: old.paused })
+          }
+        }
+        db.exec("CREATE TABLE IF NOT EXISTS window_exclusions (period TEXT NOT NULL CHECK(period IN ('15m','1h','5h','1d','7d','30d')), charge_id TEXT NOT NULL REFERENCES charges(id) ON DELETE CASCADE, PRIMARY KEY(period, charge_id)) STRICT")
+        db.prepare('INSERT OR IGNORE INTO preferences VALUES (1, ?)').run(JSON.stringify({ preferences: DEFAULT_PREFERENCES, paused: false }))
+        ledger.settings()
+        ledger.pauseRows()
+        db.exec(`PRAGMA user_version = ${SCHEMA_VERSION}`)
+      })
+      return ledger
+    } catch (error) { db.close(); throw error }
+  }
+
+  private transaction<T>(operation: () => T): T {
+    if (this.closed) throw new Error('spend-limit: ledger is closed')
+    this.db.exec('BEGIN IMMEDIATE')
+    try { const result = operation(); this.db.exec('COMMIT'); return result }
+    catch (error) { this.db.exec('ROLLBACK'); throw error }
+  }
+
+  private settings(): Settings {
+    const row = z.object({ value: z.string() }).parse(this.db.prepare('SELECT value FROM preferences WHERE id = 1').get())
+    return settingsSchema.parse(JSON.parse(row.value))
+  }
+
+  private writeSettings(value: Settings): void {
+    this.db.prepare('UPDATE preferences SET value = ? WHERE id = 1').run(JSON.stringify(value))
+  }
+
+  private entries(time: number): Entry[] {
+    this.db.prepare("DELETE FROM charges WHERE state != 'pending' AND time <= ?").run(time - SPEND_PERIODS['30d'])
+    const entries = z.array(entrySchema).parse(this.db.prepare('SELECT * FROM charges').all())
+    for (const entry of entries) {
+      if (entry.state !== 'pending' || entry.owner === this.owner || this.isAlive(entry.pid)) continue
+      this.db.prepare("UPDATE charges SET state = 'uncertain', cost = reserved, time = ? WHERE id = ?").run(time, entry.id)
+      entry.state = 'uncertain'; entry.cost = entry.reserved; entry.time = time
+    }
+    return entries
+  }
+
+  private pauseRows(): Pause[] {
+    return z.array(pauseSchema).parse(this.db.prepare('SELECT * FROM session_pauses').all())
+  }
+
+  private pauses(time: number, settings: Settings, entries: Entry[],
+    exclusions: ReadonlyMap<SpendPeriod, Set<string>>): SpendPausedSession[] {
+    const rows = this.pauseRows()
+    return rows.map((row) => {
+      let state = row.state
+      if (state === 'waiting' && row.owner !== this.owner && !this.isAlive(row.pid)) {
+        this.db.prepare("UPDATE session_pauses SET state = 'blocked', updated_at = ? WHERE session_id = ?").run(time, row.session_id)
+        state = 'blocked'
+      }
+      return { sessionId: brandString<SessionId>(row.session_id), state,
+        ...(row.manual_only !== 0 ? { requiresManualResume: true } : {}),
+        ...(exceedsEnabledLimit(row.required, settings.preferences) ? { exceedsLimit: true } : {}),
+        resumeAt: this.resumeAt(row, time, settings, entries, exclusions) }
+    }).sort((left, right) => left.sessionId < right.sessionId ? -1 : left.sessionId > right.sessionId ? 1 : 0)
+  }
+
+  private resumeAt(row: Pause, time: number, settings: Settings, entries: Entry[],
+    exclusions: ReadonlyMap<SpendPeriod, Set<string>>): number | null {
+    if (settings.paused || row.manual_only !== 0 || !settings.preferences.autoResume) return null
+    const reserved = entries.filter(entry => entry.state === 'pending').reduce((sum, entry) => sum + entry.reserved, 0)
+    let readyAt = time
+    for (const period of settings.preferences.enabledPeriods) {
+      const capacity = Math.round(settings.preferences.limits[period] * MICRO_CNY) - reserved - row.required
+      if (capacity < 0) return null
+      const duration = SPEND_PERIODS[period]
+      const charges = entries.filter(entry => entry.state !== 'pending' && entry.time + duration > time
+        && exclusions.get(period)?.has(entry.id) !== true).sort((a, b) => a.time - b.time)
+      let spent = charges.reduce((sum, entry) => sum + (entry.cost ?? entry.reserved), 0)
+      for (const entry of charges) {
+        if (spent <= capacity) break
+        spent -= entry.cost ?? entry.reserved
+        readyAt = Math.max(readyAt, entry.time + duration)
+      }
+    }
+    return readyAt
+  }
+
+  private snapshotAt(time: number, settings: Settings, entries: Entry[], waiting: number): SpendSnapshot {
+    let nextExpiry: number | null = null
+    const exclusions = new Map<SpendPeriod, Set<string>>()
+    for (const row of z.array(exclusionSchema).parse(this.db.prepare('SELECT period, charge_id FROM window_exclusions').all())) {
+      const ids = exclusions.get(row.period) ?? new Set<string>()
+      ids.add(row.charge_id)
+      exclusions.set(row.period, ids)
+    }
+    const windows = (Object.entries(SPEND_PERIODS) as [SpendPeriod, number][]).map(([period, duration]) => {
+      const enabled = settings.preferences.enabledPeriods.includes(period)
+      let spent = 0, reserved = 0, uncertain = 0
+      for (const entry of entries) {
+        if (entry.state === 'pending') { reserved += entry.reserved; continue }
+        if (exclusions.get(period)?.has(entry.id) === true) continue
+        if (entry.time <= time - duration) continue
+        const cost = entry.cost ?? entry.reserved
+        spent += cost
+        if (entry.state === 'uncertain') uncertain += cost
+        if (enabled) nextExpiry = Math.min(nextExpiry ?? Infinity, entry.time + duration)
+      }
+      const limit = settings.preferences.limits[period]
+      return { period, enabled, limit, spent: spent / MICRO_CNY, reserved: reserved / MICRO_CNY, uncertain: uncertain / MICRO_CNY,
+        remaining: Math.max(0, Math.round(limit * MICRO_CNY) - spent - reserved) / MICRO_CNY }
+    })
+    return { preferences: settings.preferences, paused: settings.paused, windows, pending: entries.filter(entry => entry.state === 'pending').length, waiting, pausedSessions: this.pauses(time, settings, entries, exclusions), nextExpiry, updatedAt: time }
+  }
+
+  /**
+   * Read current rolling totals and recover dead owners.
+   * @param waiting - Locally queued requests.
+   * @returns Totals read in one transaction.
+   */
+  snapshot(waiting = 0): SpendSnapshot {
+    return this.transaction(() => { const time = this.now(); return this.snapshotAt(time, this.settings(), this.entries(time), waiting) })
+  }
+
+  /**
+   * Reserve before dispatch. No-auto-resume exhaustion latches until resume, reset, or disable.
+   * @param microCny - Conservative maximum request estimate, in integer micro-CNY.
+   * @returns The committed reservation or a reason not to dispatch.
+   */
+  reserve(microCny: number): SpendAdmission {
+    if (!Number.isSafeInteger(microCny) || microCny < 0) throw new Error('spend-limit: invalid reservation amount')
+    return this.transaction(() => {
+      const settings = this.settings()
+      if (settings.preferences.enabledPeriods.length === 0) return { kind: 'disabled' }
+      const time = this.now(), snapshot = this.snapshotAt(time, settings, this.entries(time), 0)
+      const active = snapshot.windows.filter(window => window.enabled)
+      if (exceedsEnabledLimit(microCny, settings.preferences)) return { kind: 'too-large' }
+      if (settings.paused) return { kind: 'waiting', reason: 'paused' }
+      if (active.some(window => microCny > Math.round(window.remaining * MICRO_CNY))) {
+        const exhausted = active.some(window =>
+          Math.round(window.spent * MICRO_CNY) + microCny > Math.round(window.limit * MICRO_CNY))
+        if (!settings.preferences.autoResume && exhausted) this.writeSettings({ ...settings, paused: true })
+        return { kind: 'waiting', reason: 'limit' }
+      }
+      const id = randomUUID() as SpendReservationId
+      this.db.prepare("INSERT INTO charges VALUES (?, ?, ?, ?, ?, NULL, 'pending')").run(id, this.owner, process.pid, time, microCny)
+      return { kind: 'reserved', id }
+    })
+  }
+
+  /**
+   * Settle once. Missing complete usage retains the reservation; observed overruns pause admission.
+   * @param id - Reservation issued by this handle.
+   * @param microCny - Complete reported cost estimate; null denotes unknown final usage.
+   */
+  settle(id: SpendReservationId, microCny: number | null): void {
+    if (microCny !== null && (!Number.isSafeInteger(microCny) || microCny < 0)) throw new Error('spend-limit: invalid settlement amount')
+    this.transaction(() => {
+      const entry = entrySchema.parse(this.db.prepare('SELECT * FROM charges WHERE id = ? AND owner = ?').get(id, this.owner))
+      if (entry.state !== 'pending') throw new Error('spend-limit: reservation already settled')
+      this.db.prepare('UPDATE charges SET cost = ?, state = ?, time = ? WHERE id = ?').run(microCny ?? entry.reserved, microCny === null ? 'uncertain' : 'settled', this.now(), id)
+      const settings = this.settings()
+      if (microCny !== null && microCny > entry.reserved && settings.preferences.enabledPeriods.length > 0) {
+        this.writeSettings({ ...settings, paused: true })
+      }
+    })
+  }
+
+  /**
+   * Commit user limits without discarding any charges.
+   * @param value - Complete validated preferences.
+   * @returns Preferences after durable commit.
+   */
+  configure(value: SpendPreferences): SpendSnapshot {
+    return this.changePreferences(() => value)
+  }
+
+  /**
+   * Update one window against the latest stored preferences.
+   * @param update - Window and the fields to change.
+   * @returns Current committed settings and totals.
+   */
+  configureWindow(update: SpendWindowUpdate): SpendSnapshot {
+    return this.changePreferences(current => ({ ...current,
+      enabledPeriods: update.enabled === undefined ? current.enabledPeriods : update.enabled
+        ? periodNames.filter(period => period === update.period || current.enabledPeriods.includes(period))
+        : current.enabledPeriods.filter(period => period !== update.period),
+      limits: update.limit === undefined ? current.limits : { ...current.limits, [update.period]: update.limit },
+    }))
+  }
+
+  /**
+   * Save the automatic continuation policy without replacing window preferences.
+   * @param enabled - Whether exhausted windows resume automatically.
+   * @returns Committed settings and totals.
+   */
+  setAutoResume(enabled: boolean): SpendSnapshot { return this.changePreferences(current => ({ ...current, autoResume: enabled })) }
+
+  /**
+   * Disable every window while retaining their limits and statistics.
+   * @returns Committed settings and totals.
+   */
+  disableAll(): SpendSnapshot { return this.changePreferences(current => ({ ...current, enabledPeriods: [] })) }
+
+  private changePreferences(change: (current: SpendPreferences) => SpendPreferences): SpendSnapshot {
+    this.transaction(() => {
+      const current = this.settings()
+      const preferences = preferencesSchema.parse(change(current.preferences))
+      const removed = current.preferences.enabledPeriods.some(period => !preferences.enabledPeriods.includes(period))
+      const paused = preferences.enabledPeriods.length > 0 && !preferences.autoResume && !removed && current.paused
+      this.writeSettings({ preferences, paused })
+    })
+    return this.snapshot()
+  }
+
+  /**
+   * Persist a real conversation request only after spending admission makes it wait.
+   * @param sessionId - Conversation whose current request is waiting.
+   * @param required - Original reservation requirement in micro-CNY.
+   * @returns Stable pause identity used for exclusive recovery and replay deduplication.
+   */
+  waitForSession(sessionId: SessionId, required: number): SpendPauseId {
+    if (!Number.isSafeInteger(required) || required < 0) throw new Error('spend-limit: invalid pause reservation')
+    return this.transaction(() => {
+      const existing = this.pauseRows().find(row => row.session_id === sessionId)
+      if (existing?.state === 'waiting' && this.isAlive(existing.pid)) throw new Error('spend-limit: conversation already has an admission waiter')
+      const id = brandString<SpendPauseId>(randomUUID())
+      this.db.prepare(`INSERT INTO session_pauses (session_id, state, pid, updated_at, ticket, owner, required, manual_only, claim_owner, claim_pid)
+        VALUES (?, 'waiting', ?, ?, ?, ?, ?, 0, NULL, NULL)
+        ON CONFLICT(session_id) DO UPDATE SET state = excluded.state, pid = excluded.pid, updated_at = excluded.updated_at,
+        ticket = excluded.ticket, owner = excluded.owner, required = excluded.required, manual_only = 0, claim_owner = NULL, claim_pid = NULL`)
+        .run(sessionId, process.pid, this.now(), id, this.owner, required)
+      return id
+    })
+  }
+
+  /**
+   * Retain an owned admission waiter for recovery after shutdown.
+   * @param id - Owned waiter interrupted by application shutdown.
+   */
+  blockSession(id: SpendPauseId): void {
+    this.transaction(() => { this.db.prepare("UPDATE session_pauses SET state = 'blocked', updated_at = ? WHERE ticket = ? AND owner = ?").run(this.now(), id, this.owner) })
+  }
+
+  /**
+   * Drop a conversation pause after admission, cancellation, or deletion.
+   * @param sessionId - Conversation that no longer needs continuation.
+   * @param id - When present, clear only this exact waiting request.
+   */
+  clearSession(sessionId: SessionId, id?: SpendPauseId): void {
+    this.transaction(() => {
+      if (id === undefined) this.db.prepare('DELETE FROM session_pauses WHERE session_id = ?').run(sessionId)
+      else this.db.prepare('DELETE FROM session_pauses WHERE session_id = ? AND ticket = ?').run(sessionId, id)
+    })
+  }
+
+  /**
+   * Claim blocked conversations whose original reservation fits the remaining windows.
+   * Records remain durable until acknowledged; another process may reclaim only a dead claim owner.
+   * @returns Exclusive claims; callers must complete or release each one.
+   */
+  claimBlockedSessions(): SpendPauseClaim[] {
+    return this.transaction(() => {
+      const settings = this.settings()
+      const enabled = settings.preferences.enabledPeriods.length > 0
+      if (enabled && settings.paused) return []
+      const time = this.now()
+      const snapshot = this.snapshotAt(time, settings, this.entries(time), 0)
+      const claims: SpendPauseClaim[] = []
+      const pauses = this.pauseRows()
+      const active = snapshot.windows.filter(window => window.enabled)
+      if (enabled && !settings.preferences.autoResume && pauses.some(row => row.state === 'blocked' && row.manual_only === 0
+        && !exceedsEnabledLimit(row.required, settings.preferences)
+        && active.some(window => Math.round(window.spent * MICRO_CNY) + row.required > Math.round(window.limit * MICRO_CNY)))) {
+        this.writeSettings({ ...settings, paused: true })
+        return []
+      }
+      for (const row of pauses) {
+        if (row.state !== 'blocked' || row.manual_only === 1 || row.claim_owner === this.owner
+          || (row.claim_pid !== null && this.isAlive(row.claim_pid))) continue
+        if (enabled && active.some(window => Math.round(window.remaining * MICRO_CNY) < row.required)) continue
+        this.db.prepare('UPDATE session_pauses SET claim_owner = ?, claim_pid = ? WHERE ticket = ?').run(this.owner, process.pid, row.ticket)
+        claims.push({ id: brandString<SpendPauseId>(row.ticket), sessionId: brandString<SessionId>(row.session_id) })
+      }
+      return claims
+    })
+  }
+
+  /**
+   * Read whether this handle still owns an unreplaced recovery claim.
+   * @param id - Recovery claim captured before an asynchronous restoration.
+   * @returns False after withdrawal, replacement, or release of the claim.
+   */
+  ownsClaim(id: SpendPauseId): boolean {
+    return this.db.prepare('SELECT 1 FROM session_pauses WHERE ticket = ? AND claim_owner = ?').get(id, this.owner) !== undefined
+  }
+
+  /**
+   * Remove an acknowledged claim only while this handle still owns it.
+   * @param id - Claim whose continuation was accepted or whose session was deleted.
+   */
+  completeClaim(id: SpendPauseId): void {
+    this.transaction(() => { this.db.prepare('DELETE FROM session_pauses WHERE ticket = ? AND claim_owner = ?').run(id, this.owner) })
+  }
+
+  /**
+   * Release an owned claim without discarding the pause or a newer replacement.
+   * @param id - Claim that could not continue and must remain available for retry.
+   */
+  releaseClaim(id: SpendPauseId): void {
+    this.transaction(() => { this.db.prepare('UPDATE session_pauses SET claim_owner = NULL, claim_pid = NULL WHERE ticket = ? AND claim_owner = ?').run(id, this.owner) })
+  }
+
+  /** Clear the manual pause without bypassing any remaining window limit. */
+  resume(): void { this.transaction(() => { this.writeSettings({ ...this.settings(), paused: false }); this.db.exec('UPDATE session_pauses SET manual_only = 0') }) }
+
+  /**
+   * Reset completed statistics while preserving every active request reservation.
+   * @param period - One window to reset; omission resets every window.
+   */
+  reset(period?: SpendPeriod): void {
+    this.transaction(() => {
+      this.entries(this.now())
+      if (period === undefined) this.db.exec("DELETE FROM charges WHERE state != 'pending'")
+      else this.db.prepare("INSERT OR IGNORE INTO window_exclusions SELECT ?, id FROM charges WHERE state != 'pending'").run(period)
+      this.writeSettings({ ...this.settings(), paused: false })
+    })
+  }
+
+  /** Retain unsettled owned requests as uncertain charges, then release the database. */
+  close(): void {
+    if (this.closed) return
+    try { this.transaction(() => {
+      this.db.prepare("UPDATE charges SET state = 'uncertain', cost = reserved, time = ? WHERE owner = ? AND state = 'pending'").run(this.now(), this.owner)
+      this.db.prepare("UPDATE session_pauses SET state = 'blocked' WHERE owner = ? AND state = 'waiting'").run(this.owner)
+      this.db.prepare('UPDATE session_pauses SET claim_owner = NULL, claim_pid = NULL WHERE claim_owner = ?').run(this.owner)
+    }) }
+    finally { this.closed = true; this.db.close() }
+  }
+}
