+import { mkdir, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { create } from 'tar'
+import { expect, it } from 'vitest'
+import { verifyLinuxDebianArchive } from '../scripts/verify-linux-debian-archive.ts'
+import { verifyLinuxPortableArchive } from '../scripts/verify-linux-portable-archive.ts'
+
+const files = {
+  'deepseek-harness-uncensored': 'owned executable',
+  'resources/app.asar': 'packaged application',
+  'resources/runtime/primary-runtime/dependencies/node/bin/node': 'Host interpreter',
+  'resources/runtime/cli/bin/dsh-uncensored': 'owned launcher',
+}
+
+async function withArchive(
+  launchMode: number, consume: (archive: string, application: string) => Promise<void>, directory = 'portable application',
+): Promise<void> {
+  const root = await mkdtemp(join(tmpdir(), 'dshu-portable-archive-'))
+  const application = join(root, directory)
+  const archive = join(root, 'portable.tar.gz')
+  try {
+    for (const [path, bytes] of Object.entries(files)) {
+      const destination = join(application, path)
+      await mkdir(dirname(destination), { recursive: true })
+      await writeFile(destination, bytes)
+    }
+    await create({ cwd: root, file: archive, gzip: true, onWriteEntry(entry) {
+      if (entry.stat?.isFile()) {
+        entry.stat.mode = (entry.stat.mode & ~0o777) | (entry.path.endsWith('/bin/dsh-uncensored') ? launchMode : 0o755)
+      }
+    } }, [directory])
+    await consume(archive, application)
+  } finally { await rm(root, { recursive: true, force: true }) }
+}
+
+it('compares the archived bytes with the assembled application, including same-size changes', async () => {
+  await withArchive(0o755, async (archive, application) => {
+    await expect(verifyLinuxPortableArchive(archive, application)).resolves.toBeUndefined()
+    await writeFile(join(application, 'resources/app.asar'), files['resources/app.asar'].toUpperCase())
+    await expect(verifyLinuxPortableArchive(archive, application)).rejects.toThrow('assembled file differs for resources/app.asar')
+  })
+})
+
+it('rejects a portable CLI launcher that loses its executable mode', async () => {
+  await withArchive(0o644, async (archive, application) => {
+    await expect(verifyLinuxPortableArchive(archive, application)).rejects.toThrow('executable permission missing for resources/runtime/cli')
+  })
+})
+
+function debianMember(name: string, content: Buffer): Buffer {
+  const header = name.padEnd(16) + '0'.padEnd(12) + '0'.padEnd(6) + '0'.padEnd(6)
+    + '100644'.padEnd(8) + String(content.length).padEnd(10) + '\x60\n'
+  return Buffer.concat([Buffer.from(header), content, content.length % 2 === 0 ? Buffer.alloc(0) : Buffer.from('\n')])
+}
+
+it('selects the Debian data member after an odd-sized member and rejects a truncated payload', async () => {
+  await withArchive(0o755, async (archive, application) => {
+    const deb = join(dirname(archive), 'package.deb')
+    const bytes = Buffer.concat([Buffer.from('!<arch>\n'), debianMember('debian-binary', Buffer.from('2.0\n')),
+      debianMember('control.tar.gz', Buffer.from('x')), debianMember('data.tar.gz/', await readFile(archive))])
+    await writeFile(deb, bytes)
+    await expect(verifyLinuxDebianArchive(deb, application)).resolves.toBeUndefined()
+    await writeFile(deb, bytes.subarray(0, -5))
+    await expect(verifyLinuxDebianArchive(deb, application)).rejects.toThrow('member exceeds the package size')
+  }, 'opt/DeepSeek Harness Uncensored')
+})
diff --git a/apps/desktop/tests/linux-rpm-archive.spec.ts b/apps/desktop/tests/linux-rpm-archive.spec.ts
new file mode 100644
index 00000000..06b1e058
--- /dev/null
+++ b/apps/desktop/tests/linux-rpm-archive.spec.ts
@@ -0,0 +1,107 @@
+/** RPM payload reading used by Linux packaging verification. */
+import { createHash } from 'node:crypto'
+import { Readable } from 'node:stream'
+import { describe, expect, it } from 'vitest'
+import { readLinuxRpmPayloadFiles } from '../scripts/verify-linux-rpm-archive.ts'
+
+const APPLICATION_PREFIX = 'opt/DeepSeek Harness Uncensored/'
+const TRAILER = 'TRAILER!!!'
+
+interface FixtureEntry {
+  readonly name: string
+  readonly mode: number
+  readonly data: string
+}
+
+function pad4(value: number): number {
+  return (4 - (value % 4)) % 4
+}
+
+/** Assemble a newc cpio payload the way fpm writes the RPM body. */
+function newcPayload(entries: readonly FixtureEntry[]): Buffer {
+  const parts: Buffer[] = []
+  for (const entry of [...entries, { name: TRAILER, mode: 0, data: '' }]) {
+    const body = Buffer.from(entry.data, 'utf8')
+    const name = Buffer.from(`${entry.name}\0`, 'utf8')
+    const header = Buffer.from([
+      '070701',
+      '00000000',
+      entry.mode.toString(16).padStart(8, '0'),
+      '00000000',
+      '00000000',
+      '00000001',
+      '00000000',
+      body.length.toString(16).padStart(8, '0'),
+      '00000000',
+      '00000000',
+      '00000000',
+      '00000000',
+      name.length.toString(16).padStart(8, '0'),
+      '00000000',
+    ].join(''), 'latin1')
+    parts.push(header, name, Buffer.alloc(pad4(header.length + name.length)), body, Buffer.alloc(pad4(body.length)))
+  }
+  return Buffer.concat(parts)
+}
+
+function fingerprint(data: string): string {
+  return createHash('sha256').update(Buffer.from(data, 'utf8')).digest('hex')
+}
+
+const applicationEntries: readonly FixtureEntry[] = [
+  { name: `./${APPLICATION_PREFIX}deepseek-harness-uncensored`, mode: 0o100755, data: 'executable' },
+  { name: `./${APPLICATION_PREFIX}resources/app.asar`, mode: 0o100644, data: 'asar payload' },
+  { name: `./${APPLICATION_PREFIX}resources/runtime/cli/bin/dsh-uncensored`, mode: 0o100755, data: 'cli launcher' },
+  { name: `./${APPLICATION_PREFIX}resources/runtime/primary-runtime/dependencies/node/bin/node`, mode: 0o100755, data: 'Host Node' },
+]
+
+async function read(entries: readonly FixtureEntry[]) {
+  return readLinuxRpmPayloadFiles(Readable.from([newcPayload(entries)]))
+}
+
+describe('Linux RPM payload', () => {
+  it('indexes the executable, ASAR and CLI launcher by their application-relative paths', async () => {
+    const files = await read(applicationEntries)
+    expect(files.map(file => file.path)).toEqual([
+      'deepseek-harness-uncensored', 'resources/app.asar', 'resources/runtime/cli/bin/dsh-uncensored',
+      'resources/runtime/primary-runtime/dependencies/node/bin/node',
+    ])
+    expect(files[0]).toMatchObject({ bytes: 10, sha256: fingerprint('executable'), executable: true })
+    expect(files[1]).toMatchObject({ bytes: 12, sha256: fingerprint('asar payload'), executable: false })
+    expect(files[2]).toMatchObject({ bytes: 12, sha256: fingerprint('cli launcher'), executable: true })
+  })
+
+  it('reads entries split across stream chunks', async () => {
+    const payload = newcPayload(applicationEntries)
+    const chunks = Array.from({ length: payload.length }, (_unused, index) => payload.subarray(index, index + 1))
+    const files = await readLinuxRpmPayloadFiles(Readable.from(chunks))
+    expect(files).toHaveLength(applicationEntries.length)
+    expect(files[1]?.sha256).toBe(fingerprint('asar payload'))
+  })
+
+  it('streams a large entry instead of buffering the whole payload', async () => {
+    const big = 'x'.repeat(512 * 1024)
+    const entries = applicationEntries.map(entry => entry.name.endsWith('/resources/app.asar') ? { ...entry, data: big } : entry)
+    const payload = newcPayload(entries)
+    const chunks: Buffer[] = []
+    for (let offset = 0; offset < payload.length; offset += 4096) chunks.push(payload.subarray(offset, offset + 4096))
+    const files = await readLinuxRpmPayloadFiles(Readable.from(chunks))
+    expect(files[1]).toMatchObject({ bytes: big.length, sha256: fingerprint(big) })
+  })
+
+  it('rejects a payload missing a required application file', async () => {
+    await expect(read(applicationEntries.slice(0, 2))).rejects.toThrow(/required application files are missing/u)
+  })
+
+  it('rejects an executable without permission bits', async () => {
+    const entries = [...applicationEntries]
+    entries[0] = { ...entries[0]!, mode: 0o100644 }
+    await expect(read(entries)).rejects.toThrow(/executable permission missing for deepseek-harness-uncensored/u)
+  })
+
+  it('rejects a payload without a cpio trailer', async () => {
+    const truncated = newcPayload(applicationEntries)
+    await expect(readLinuxRpmPayloadFiles(Readable.from([truncated.subarray(0, truncated.length - 120)])))
+      .rejects.toThrow(/payload ends inside|no cpio trailer/u)
+  })
+})
