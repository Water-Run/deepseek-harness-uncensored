@@ -0,0 +1,281 @@
+/** Run the three persistent side-discussion entry points against the Web profile. */
+import { readFile } from 'node:fs/promises'
+import { fileURLToPath } from 'node:url'
+import { chromium } from 'playwright'
+import { expect, it, vi } from 'vitest'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import { MockAdapter, textResponse, toolCallResponse } from '../../../packages/core/agent-loop/tests/mock-adapter.ts'
+import product from '../../cli/package.json' with { type: 'json' }
+import { launchWebScaffold } from './scaffold.ts'
+import { newEnglishPage, openSettings, startWithSessionPanelHidden } from './support.ts'
+
+class SideAdapter extends MockAdapter {
+  override listModels(provider: string) {
+    return Promise.resolve([{ provider, id: 'mock', name: 'Writing fixture', contextWindow: 128000, inputModalities: ['text', 'image'] as const }])
+  }
+}
+
+it.each(['standard', 'writing'])('opens, continues, clears and explicitly reads a side discussion in the %s preset', async (agentPreset) => {
+  const scaffold = await launchWebScaffold({ extraOverlayPath: [
+    fileURLToPath(new URL('./pin-browse-picker.overlay.yml', import.meta.url)),
+    fileURLToPath(new URL('./side-spending.overlay.yml', import.meta.url)),
+  ] })
+  try {
+    const adapter = new SideAdapter([textResponse('The market opens at dawn.'), 'hang',
+      textResponse('The cover is red.'), textResponse('Keep the red cover.'), textResponse('Discuss the spine next.'),
+      textResponse('The cover stock is cotton.'), toolCallResponse('read-cover', 'read_side_context', {}), textResponse('Use cotton stock.')])
+    scaffold.ctx.llm.registerAdapter(['side-fixture'], adapter)
+    const ctx = scaffold.ctx
+    const api = ctx.sessionController
+    const { sessionId } = await api.create({ cwd: scaffold.workspaceCwd, agentPreset })
+    const workspace = await ctx.workspaceRegistry.create(scaffold.workspaceCwd)
+    await workspace.setTitle('Writing workspace')
+    await workspace.attachSession(sessionId)
+    await api.rename({ sessionId, title: 'Market notebook' })
+    await api.selectModel({ sessionId, provider: 'side-fixture', model: 'mock' })
+    const main = ctx.agents.get(sessionId)!
+    const prompt = (text: string) => createUserMessage({ source: { kind: 'user' }, content: [{ type: 'text', text }] })
+    main.followup(prompt('Draft the opening.'))
+    await main.whenIdle()
+    main.followup(prompt('UNFINISHED CHAPTER'))
+    await expect.poll(() => adapter.requests.length).toBe(2)
+    const childIds = new Set<SessionId>()
+    ctx.on('session/event', (session, event) => {
+      if (session.header.parentSession === sessionId && event.type === 'user/message' && event.data.source.kind === 'user') childIds.add(session.id)
+    })
+    const png = await readFile(new URL('../../../snapshots/session/read-image/workspace/red.png', import.meta.url))
+    const browser = await chromium.launch()
+    try {
+      const page = await newEnglishPage(browser)
+      page.setDefaultTimeout(12_000)
+      // Count requests from conversation turns independently of timed composer predictions.
+      await page.addInitScript(() => { localStorage.setItem('dsh.uncensored.prediction', '0') })
+      await page.goto(scaffold.authenticatedUrl)
+      const group = page.getByRole('treeitem').filter({ has: page.getByText('Writing workspace', { exact: true }) })
+      await group.waitFor()
+      if (await group.getAttribute('aria-expanded') === 'false') await group.press('ArrowRight')
+      await page.getByRole('treeitem').filter({ hasText: 'Market notebook' }).click()
+      const cost = page.getByRole('button', { name: /^Conversation cost:/u })
+      await page.getByRole('button', { name: 'Conversation cost: ￥0.02', exact: true }).waitFor()
+      const header = page.getByRole('button', { name: 'Side question', exact: true }).first()
+      const panel = page.locator('[data-aside="side"]:visible')
+      const composer = '[data-composer-input][contenteditable="true"]'
+      const closeTab = page.getByRole('tab').filter({ hasText: 'Side question' }).locator('[data-dockkit-tab-close]')
+      await header.focus()
+      await header.press('Enter')
+      await panel.locator(composer).waitFor()
+      expect(adapter.requests).toHaveLength(2)
+      await closeTab.click()
+      await panel.waitFor({ state: 'hidden' })
+      const mainInput = page.locator(composer + ':visible').first()
+      await mainInput.fill('/side Which color is on the notebook cover?')
+      await page.locator('[data-composer-card] input[type=file]').first().setInputFiles({ name: 'cover.png', mimeType: 'image/png', buffer: png })
+      await page.locator('button[aria-busy="false"]', { has: page.getByRole('img', { name: 'cover.png' }) }).waitFor()
+      await mainInput.press('Enter')
+      await panel.getByText('The cover is red.', { exact: true }).waitFor()
+      expect(await panel.getByRole('button', { name: /^(Conversation cost|Spending limits):/u }).count()).toBe(0)
+      await page.getByRole('button', { name: 'Conversation cost: ￥0.04', exact: true }).waitFor()
+      expect(await cost.count()).toBe(1)
+      const sent = adapter.requests[2]?.messages
+      expect(JSON.stringify(sent)).toContain('The market opens at dawn.')
+      expect(JSON.stringify(sent)).not.toContain('UNFINISHED CHAPTER')
+      const image = sent?.flatMap(message => message.content).find(block => block.type === 'image')
+      if (image?.type !== 'image') throw new Error('The side request did not contain the attached image')
+      expect(image.attachment.name).toBe('cover.png')
+      expect(Buffer.from((await ctx.attachments.readImage(image.attachment)).data)).toEqual(png)
+      await closeTab.click()
+      await panel.waitFor({ state: 'hidden' })
+      const guide = page.locator('[data-sidebar-right-guide-entry="aside"]:visible')
+      const expand = page.getByRole('button', { name: 'Open right sidebar', exact: true })
+      if (await expand.isVisible()) await expand.click()
+      if (!await guide.isVisible()) await page.getByRole('button', { name: 'New tab', exact: true }).first().click()
+      await guide.click()
+      await panel.getByText('The cover is red.', { exact: true }).waitFor()
+      await expect.poll(() => panel.locator(composer).getAttribute('aria-label')).toBe('Side question: ask here')
+      expect(await page.getByRole('treeitem').filter({ hasText: 'Ungrouped' }).count()).toBe(0)
+      await page.setViewportSize({ width: 390, height: 844 })
+      if (!await panel.isVisible()) await header.click()
+      await panel.locator(composer).fill('Should we keep it?')
+      await panel.locator(composer).press('Enter')
+      await panel.getByText('Keep the red cover.', { exact: true }).waitFor()
+      await expect.poll(() => [...childIds].every(id => ctx.agents.get(id) === undefined)).toBe(true)
+      await panel.locator(composer).waitFor()
+      expect(await panel.evaluate(el => el.scrollWidth <= el.clientWidth)).toBe(true)
