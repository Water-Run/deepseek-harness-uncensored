diff --git a/packages/credentials/balance/src/engine.ts b/packages/credentials/balance/src/engine.ts
new file mode 100644
index 00000000..771c230b
--- /dev/null
+++ b/packages/credentials/balance/src/engine.ts
@@ -0,0 +1,247 @@
+/** Serial, account-scoped sampling; no credential or raw response enters the stored history. */
+import { createHash, createHmac, randomBytes } from 'node:crypto'
+import { z } from 'zod'
+import type { AccountClientMetadata } from '@deepseek-ai/dsh-deepseek-account/types'
+import type { BalanceAutoCleanup, BalanceHistoryTag, BalanceSidebarRange, BalanceCleanupRequest, BalanceCleanupSnapshot, BalanceSample, BalanceSnapshot, BalanceWallet } from './types.ts'
+
+/** One credential generation resolved on the Host. */
+export interface BalanceIdentity {
+  readonly key: string
+  readonly account: 'account' | 'api-key'
+  readonly query: (signal: AbortSignal) => Promise<readonly BalanceWallet[] | null>
+  readonly current: () => Promise<boolean>
+}
+
+/** Runtime retention policy read from the live sampling preferences. */
+export interface BalanceRetention {
+  readonly mode: BalanceAutoCleanup
+  readonly count: number
+  readonly days: number
+}
+
+/** IO owned by one installed balance provider. */
+export interface BalanceEngineOptions {
+  readonly identify: (client: AccountClientMetadata, refreshIdentity: boolean) => Promise<BalanceIdentity | null>
+  readonly read: (key: string) => readonly BalanceSample[] | undefined
+  readonly write: (key: string, samples: readonly BalanceSample[]) => Promise<void>
+  readonly limit: number
+  readonly timeoutMs: number
+  readonly displayLimit: number
+  readonly retention: () => BalanceRetention
+  readonly now: () => number
+}
+
+/** Milliseconds in one retained day. */
+const DAY_MS = 86_400_000
+
+/**
+ * Apply the automatic retention policy to samples about to be written.
+ * An age window always keeps the newest sample, so history never empties itself
+ * merely because sampling paused for longer than the window.
+ * @param samples - Samples that would otherwise be stored, oldest first.
+ * @param retention - Live policy from the sampling preferences.
+ * @param now - Sampling instant used as the age cutoff.
+ * @returns The samples to store.
+ */
+export function retainSamples(samples: readonly BalanceSample[], retention: BalanceRetention, now: number): readonly BalanceSample[] {
+  if (retention.mode === 'count') return samples.slice(-Math.max(2, Math.floor(retention.count)))
+  if (retention.mode === 'age') {
+    const cutoff = now - Math.max(1, Math.floor(retention.days)) * DAY_MS
+    const kept = samples.filter(sample => sample.time >= cutoff)
+    return kept.length > 0 ? kept : samples.slice(-1)
+  }
+  return samples
+}
+
+/**
+ * Apply one manual cleanup request.
+ * @param samples - Stored samples, oldest first.
+ * @param request - Requested cleanup mode and its bound.
+ * @param now - Cleanup instant used as the age cutoff.
+ * @returns The samples to keep.
+ */
+export function cleanSamples(samples: readonly BalanceSample[], request: BalanceCleanupRequest, now: number): readonly BalanceSample[] {
+  switch (request.mode) {
+    case 'all': return []
+    case 'count': return samples.slice(-Math.max(1, Math.floor(request.keep)))
+    case 'age': {
+      const cutoff = now - Math.max(1, Math.floor(request.days)) * DAY_MS
+      const kept = samples.filter(sample => sample.time >= cutoff)
+      return kept.length > 0 ? kept : samples.slice(-1)
+    }
+    default: {
+      const unreachable: never = request
+      return unreachable
+    }
+  }
+}
+
+/** Accepted API decimal strings, bounded before numeric chart conversion. */
+export const balanceAmount = z.string().max(64).regex(/^-?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?$/u)
+  .refine(value => Number.isFinite(Number(value)))
+
+/** Schema used at both API and durable history reads. */
+export const balanceSample = z.object({
+  time: z.number().int().nonnegative(),
+  wallets: z.array(z.object({ currency: z.enum(['CNY', 'USD']), toppedUp: balanceAmount, granted: balanceAmount }).strict()).max(2),
+}).strict()
+
+/**
+ * Keep account and API-key identities out of local history filenames.
+ * @param value - Host-only account/issuer or API-key identity.
+ * @returns Opaque local storage key.
+ */
+export function balanceStorageKey(value: string): string { return createHash('sha256').update(value).digest('hex') }
+
+function atIndex<T>(items: readonly T[], index: number): T {
+  const item = items[index]
+  if (item === undefined) throw new RangeError(`Balance history index ${index} is out of range`)
+  return item
+}
+
+function increased(previous: BalanceSample, current: BalanceSample): boolean {
+  return current.wallets.some((wallet) => {
+    const prior = previous.wallets.find(entry => entry.currency === wallet.currency)
+    return prior !== undefined && Number(wallet.toppedUp) + Number(wallet.granted) > Number(prior.toppedUp) + Number(prior.granted)
+  })
+}
+
+function displaySamples(samples: readonly BalanceSample[], limit: number): readonly BalanceSample[] {
+  if (samples.length <= limit) return samples
+  const last = samples.length - 1
+  const selected = new Set([0, last])
+  for (let index = last; index > 0 && selected.size < limit; index -= 1) {
+    const needed = Number(!selected.has(index - 1)) + Number(!selected.has(index))
+    if (needed > limit - selected.size || !increased(atIndex(samples, index - 1), atIndex(samples, index))) continue
+    selected.add(index - 1)
+    selected.add(index)
+  }
+  const remaining = limit - selected.size
+  if (remaining > 0) {
+    const available = samples.map((_sample, index) => index).filter(index => !selected.has(index))
+    for (let index = 1; index <= remaining; index += 1) {
+      const offset = Math.round(index * (available.length + 1) / (remaining + 1)) - 1
+      selected.add(atIndex(available, offset))
+    }
+  }
+  return samples.filter((_sample, index) => selected.has(index))
+}
+
+function snapshotSamples(samples: readonly BalanceSample[], limit: number, view?: 'history' | BalanceSidebarRange) {
+  if (view === 'history') return samples
+  const latest = samples.at(-1)
+  if (view === undefined || latest === undefined) return displaySamples(samples, limit)
+  const cutoff = latest.time - Number(view) * DAY_MS
+  return displaySamples(samples.filter(sample => sample.time >= cutoff), limit)
+}
+
+/** Owns sampling, credential-change checks, and write settlement before disposal. */
+export class BalanceEngine {
+  private readonly lifetime = new AbortController()
+  private readonly tagSecret = randomBytes(32)
+  private tail: Promise<void> = Promise.resolve()
+  /** @param options - Provider-owned IO and validated limits. */
+  constructor(private readonly options: BalanceEngineOptions) {}
+
+  private historyTag(identity: BalanceIdentity): BalanceHistoryTag {
+    return createHmac('sha256', this.tagSecret).update(identity.key).digest('hex') as BalanceHistoryTag
+  }
+
+  /**
+   * Read cached history or append one successful API sample.
+   * @param client - Request identity used by the account provider.
+   * @param source - Local history only, or a fresh API observation.
+   * @param view - Full history or the time window to downsample.
+   * @returns Credential-free state; failures never fabricate a zero balance.
+   */
+  read(client: AccountClientMetadata, source: 'local' | 'api', view?: 'history' | BalanceSidebarRange): Promise<BalanceSnapshot> {
+    const operation = this.tail.then(() => this.query(client, source)).then(result => ({
+      ...result,
+      sampleCount: result.samples.length,
+      samples: snapshotSamples(result.samples, this.options.displayLimit, view),
+    }))
+    this.tail = operation.then(() => undefined, () => undefined)
+    return operation
+  }
+
+  private async query(client: AccountClientMetadata, source: 'local' | 'api'): Promise<Omit<BalanceSnapshot, 'sampleCount'>> {
+    let samples: readonly BalanceSample[] = []
+    let identity: BalanceIdentity | null = null
+    let failure: 'request' | 'storage' = 'request'
+    try {
+      this.lifetime.signal.throwIfAborted()
+      identity = await this.options.identify(client, source === 'api')
+      if (identity === null) return { status: 'signed-out', source, account: null, samples }
+      failure = 'storage'
+      samples = this.options.read(identity.key) ?? []
+      if (source === 'local') return this.snapshot(identity, source, samples.length === 0 ? 'empty' : 'ready', samples)
+      failure = 'request'
+      const wallets = await identity.query(AbortSignal.any([this.lifetime.signal, AbortSignal.timeout(this.options.timeoutMs)]))
+      this.lifetime.signal.throwIfAborted()
+      if (wallets === null || !await identity.current()) return { status: 'unavailable', source, account: null, samples: [], error: 'changed' }
+      const now = this.options.now()
+      const sample = balanceSample.parse({ time: now, wallets })
+      const next = retainSamples([...samples, sample].slice(-this.options.limit), this.options.retention(), now)
+      failure = 'storage'
+      this.lifetime.signal.throwIfAborted()
+      await this.options.write(identity.key, next)
+      return this.snapshot(identity, source, 'ready', next)
+    } catch (_error) {
+      return identity === null ? { status: 'unavailable', source, account: null, samples: [], error: failure }
+        : this.snapshot(identity, source, 'unavailable', samples, failure)
+    }
+  }
+
+  private async snapshot(identity: BalanceIdentity, source: BalanceSnapshot['source'], status: BalanceSnapshot['status'],
+    samples: readonly BalanceSample[], error?: BalanceSnapshot['error']): Promise<Omit<BalanceSnapshot, 'sampleCount'>> {
+    if (!await identity.current().catch(() => false)) {
+      return { status: 'unavailable', source, account: null, samples: [], error: 'changed' }
+    }
+    return { status, source, account: identity.account, historyTag: this.historyTag(identity), samples,
+      ...(error === undefined ? {} : { error }) }
+  }
+
+  /** Stop admission and await every query and durable write before storage closes. @returns Quiescent completion. */
+  async close(): Promise<void> { this.lifetime.abort(); await this.tail }
+
+  /**
+   * Remove stored samples under the current identity.
+   * @param client - Request identity used by the account provider.
+   * @param request - Cleanup mode and its bound.
+   * @param view - Full history or the time window to downsample.
+   * @param expectedHistory - History shown when the user requested cleanup, when supplied by the client.
+   * @returns The remaining history and its account tag.
+   */
+  clear(client: AccountClientMetadata, request: BalanceCleanupRequest, view?: 'history' | BalanceSidebarRange, expectedHistory?: BalanceHistoryTag): Promise<BalanceCleanupSnapshot> {
+    // Older clients omit the tag. Capture their target before waiting for pending writes.
+    const target = this.lifetime.signal.aborted ? undefined : this.options.identify(client, false).catch(() => undefined)
+    const operation = this.tail.then(async () => this.remove(await target, request, expectedHistory)).then(result => ({
+      ...result,
+      sampleCount: result.samples.length,
+      samples: snapshotSamples(result.samples, this.options.displayLimit, view),
+    }))
+    this.tail = operation.then(() => undefined, () => undefined)
+    return operation
+  }
+
+  private async remove(identity: BalanceIdentity | null | undefined, request: BalanceCleanupRequest,
+    expectedHistory?: BalanceHistoryTag): Promise<Omit<BalanceCleanupSnapshot, 'sampleCount'>> {
+    if (identity === undefined) return { status: 'unavailable', source: 'local', account: null, samples: [], error: 'storage' }
+    if (identity === null) return expectedHistory === undefined
+      ? { status: 'signed-out', source: 'local', account: null, samples: [] }
+      : { status: 'unavailable', source: 'local', account: null, samples: [], error: 'changed' }
+    try {
+      this.lifetime.signal.throwIfAborted()
+      if ((expectedHistory !== undefined && expectedHistory !== this.historyTag(identity)) || !await identity.current()) {
+        return { status: 'unavailable', source: 'local', account: null, samples: [], error: 'changed' }
+      }
+      const samples = this.options.read(identity.key) ?? []
+      const next = cleanSamples(samples, request, this.options.now())
+      this.lifetime.signal.throwIfAborted()
+      await this.options.write(identity.key, next)
+      return { ...await this.snapshot(identity, 'local', next.length === 0 ? 'empty' : 'ready', next), cleanupApplied: true }
+    } catch (_error) {
+      return { status: 'unavailable', source: 'local', account: null, samples: [], error: 'storage' }
+    }
+  }
+}
diff --git a/packages/credentials/balance/src/index.ts b/packages/credentials/balance/src/index.ts
new file mode 100644
index 00000000..e29afb14
--- /dev/null
+++ b/packages/credentials/balance/src/index.ts
@@ -0,0 +1,180 @@
+/** Built-in balance history backed by the application's independent storage domain. */
+import type { Context, Volatile } from '@deepseek-ai/cordis'
+import { isVolatile } from '@deepseek-ai/cosmokit'
+import schema from '@deepseek-ai/schemastery'
+import { z } from 'zod'
+import { defineDomain, domainTable } from '@deepseek-ai/dsh-storage-domain'
+import { credentialRef } from '@deepseek-ai/dsh-credentials'
+import { Remote, TypertRemoteService } from '@deepseek-ai/dsh-typert-protocol'
+import type {} from '@deepseek-ai/dsh-deepseek-account'
+import type {} from '@deepseek-ai/dsh-settings'
+import type { AccountClientMetadata } from '@deepseek-ai/dsh-deepseek-account/types'
+import { BalanceEngine, balanceAmount, balanceSample, balanceStorageKey } from './engine.ts'
+import type { BalanceIdentity } from './engine.ts'
+import type { BalanceAutoCleanup, BalanceHistoryTag, BalanceSidebarRange, BalanceSample, BalanceCleanupRequest, BalanceCleanupSnapshot, BalanceSnapshot } from './types.ts'
+export type * from './types.ts'
+
+/** Deployment and live user preferences for balance queries. */
+export interface Config {
+  /** Whether authenticated queries and local sampling are enabled. */
+  enabled: Volatile<boolean>
+  /** Display the current balance in the sidebar independently of sampling. */
+  showInSidebar: Volatile<boolean>
+  /** Time window for the sidebar curve. */
+  sidebarDays: Volatile<BalanceSidebarRange>
+  /** Interval in seconds used by the shared client polling owner. */
+  refreshSeconds: Volatile<number>
+  /** Read saved observations or fetch the current balance from the provider. */
+  source: Volatile<'local' | 'api'>
+  /** Credential-store reference for API-key balance requests. */
+  apiKeyRef: string
+  /** HTTPS API origin without credentials, a path, query or fragment. */
+  baseURL: string
+  /** Deadline in milliseconds for one provider request. */
+  timeoutMs: number
+  /** Maximum retained samples per account in local storage. */
+  historyLimit: number
+  /** Maximum observations included in a compact balance snapshot. */
+  displayLimit: number
+  /** Automatic cleanup applied while sampling: off, by count, or by age. */
+  autoCleanup: Volatile<BalanceAutoCleanup>
+  /** Samples kept, newest first, when `autoCleanup` is `count`. */
+  retainCount: Volatile<number>
+  /** Days of history kept when `autoCleanup` is `age`. */
+  retainDays: Volatile<number>
+}
+// Thirty days at the shortest supported automatic interval, including both endpoints.
+const HISTORY_CAPACITY = 30 * 24 * 3600 / 3 + 1
+
+/** Validated sampling preferences and bounded provider requests. */
+export const Config = schema.object({
+  enabled: schema.boolean().default(true).volatile(),
+  showInSidebar: schema.boolean().default(true).volatile(),
+  sidebarDays: schema.union(['1', '7', '30'] as const).default('7').volatile(),
+  refreshSeconds: schema.number().step(1).min(3).max(3600).default(15).volatile(),
+  source: schema.union(['local', 'api'] as const).default('api').volatile(),
+  apiKeyRef: schema.string().default('DEEPSEEK_API_KEY'),
+  baseURL: schema.string().default('https://api.deepseek.com'),
+  timeoutMs: schema.number().step(1).min(1000).max(60000).default(10000),
+  historyLimit: schema.number().step(1).min(2).max(HISTORY_CAPACITY).default(HISTORY_CAPACITY),
+  displayLimit: schema.number().step(1).min(2).max(1000).default(240),
+  autoCleanup: schema.union(['off', 'count', 'age'] as const).default('age').volatile(),
+  retainCount: schema.number().step(1).min(2).max(40320).default(2000).volatile(),
+  retainDays: schema.number().step(1).min(1).max(3650).default(30).volatile(),
+})
+export const name = 'balance'
+export const inject = ['storage', 'storageDomain', 'deepseekAccount', 'credentials', 'settings']
+
+const domainSpec = defineDomain({ name: 'uncensored_balance', version: 1, layout: 'per-record',
+  tables: { samples: domainTable<string, readonly BalanceSample[]>(z.array(balanceSample).max(HISTORY_CAPACITY)) } })
+const responseSchema = z.object({ balance_infos: z.array(z.object({
+  currency: z.enum(['CNY', 'USD']), topped_up_balance: balanceAmount, granted_balance: balanceAmount,
+})).max(2) })
+const cleanupSchema = z.discriminatedUnion('mode', [
+  z.object({ mode: z.literal('all') }).strict(),
+  z.object({ mode: z.literal('count'), keep: z.number().int().min(1).max(40320) }).strict(),
+  z.object({ mode: z.literal('age'), days: z.number().int().min(1).max(3650) }).strict(),
+])
+
+declare module '@deepseek-ai/cordis' { interface Context { uncensoredBalance: BalanceRemote } }
+
+/** Authenticated application access to local history and fresh balance queries. */
+export class BalanceRemote extends TypertRemoteService {
+  /** @param ctx - Service owner. @param options - Provider-owned engine and live preferences. */
+  constructor(ctx: Context, private readonly options: { engine: BalanceEngine; config: Config }) {
+    super(ctx, 'uncensoredBalance', { namespace: 'balance' })
+  }
+  /**
+   * Read balance observations under the current account and sampling preferences.
+   * @param client - Platform request metadata.
+   * @param view - Full retained history for settings or a compact sidebar time window.
+   * @returns Sanitized current state and local sampling history.
+   */
+  @Remote
+  get(client: AccountClientMetadata, view?: 'history' | BalanceSidebarRange): Promise<BalanceSnapshot> {
+    const configured = this.options.config
+    const source = isVolatile(configured.source) ? configured.source.get() : configured.source
+    const enabled = isVolatile(configured.enabled) ? configured.enabled.get() : configured.enabled
+    return enabled ? this.options.engine.read(client, source, view)
+      : Promise.resolve({ status: 'disabled', source, account: null, samples: [], sampleCount: 0 })
+  }
+
+  /**
+   * Remove stored samples for the current account.
+   * @param client - Platform request metadata.
+   * @param request - Cleanup mode and its bound.
+   * @param view - History detail requested by the active client view.
+   * @param expectedHistory - Opaque tag of the account history the user reviewed.
+   * @returns The remaining history.
+   */
+  @Remote
+  clear(client: AccountClientMetadata, request: BalanceCleanupRequest, view?: 'history' | BalanceSidebarRange, expectedHistory?: BalanceHistoryTag): Promise<BalanceCleanupSnapshot> {
+    return this.options.engine.clear(client, cleanupSchema.parse(request), view, expectedHistory)
+  }
+}
+
+/**
+ * Mount the shared balance provider and close it before its storage domain.
+ * @param ctx - Host capabilities supplied by the shipped application.
+ * @param config - Validated deployment and sampling preferences.
+ */
+export async function apply(ctx: Context, config: Config): Promise<void> {
+  const origin = new URL(config.baseURL)
+  if (origin.protocol !== 'https:' || origin.username || origin.password || origin.pathname !== '/' || origin.search || origin.hash) {
+    throw new Error('balance: baseURL must be an HTTPS origin without credentials, path, query, or fragment')
+  }
+  const ref = credentialRef(config.apiKeyRef)
+  ctx.settings.configure({ auto: false }, ctx.fiber)
+  const domain = await ctx.storage.domain.open(domainSpec)
+  const table = domain.table('samples')
+  const identify = async (client: AccountClientMetadata, refreshIdentity: boolean): Promise<BalanceIdentity | null> => {
+    let platform = await ctx.deepseekAccount.getPlatformSession()
+    if (platform !== null) {
+      if (platform.userId === null && refreshIdentity) {
+        await ctx.deepseekAccount.getProfile(client)
+        platform = await ctx.deepseekAccount.getPlatformSession()
+      }
+      if (platform === null || platform.userId === null) return null
+      const selected = platform
+      return { key: balanceStorageKey(`account:${platform.origin}:${platform.userId}`), account: 'account',
+        current: async () => (await ctx.deepseekAccount.getPlatformSession())?.token === selected.token,
+        query: async () => {
+          const result = await ctx.deepseekAccount.getBalance(client)
+          if (result?.status !== 'ready') throw new Error('balance: account query unavailable')
+          const currencies = [...new Set([...result.value, ...result.bonusWallets].map(wallet => wallet.currency))]
+          return currencies.map(currency => ({ currency,
+            toppedUp: result.value.find(wallet => wallet.currency === currency)?.balance ?? '0',
+            granted: result.bonusWallets.find(wallet => wallet.currency === currency)?.balance ?? '0',
+          }))
+        },
+      }
+    }
+    const key = (await ctx.credentials.resolve(ref))?.value
+    if (!key) return null
+    return { key: balanceStorageKey(`api:${origin.origin}:${key}`), account: 'api-key',
+      current: async () => (await ctx.credentials.resolve(ref))?.value === key && await ctx.deepseekAccount.getPlatformSession() === null,
+      query: async (signal) => {
+        const response = await fetch(new URL('/user/balance', origin), { signal, redirect: 'error', headers: { authorization: `Bearer ${key}` } })
+        if (!response.ok) throw new Error('balance: API query unavailable')
+        const payload: unknown = await response.json()
+        return responseSchema.parse(payload).balance_infos.map(wallet => ({ currency: wallet.currency,
+          toppedUp: wallet.topped_up_balance, granted: wallet.granted_balance }))
+      },
+    }
+  }
+  const engine = new BalanceEngine({ identify, read: key => table.get(key), write: (key, samples) => table.put(key, samples),
+    limit: config.historyLimit, displayLimit: config.displayLimit, timeoutMs: config.timeoutMs, now: Date.now,
+    retention: () => ({
+      mode: isVolatile(config.autoCleanup) ? config.autoCleanup.get() : config.autoCleanup,
+      count: isVolatile(config.retainCount) ? config.retainCount.get() : config.retainCount,
+      days: isVolatile(config.retainDays) ? config.retainDays.get() : config.retainDays,
+    }) })
+  const service = ctx.plugin(BalanceRemote, { engine, config })
+  ctx.effect(() => async () => {
+    await engine.close()
+    try { await service.dispose() }
+    finally { await domain.close() }
+  }, 'balance: queries and history')
+  try { await service.await() }
+  catch (error) { await engine.close(); await domain.close(); throw error }
+}
