+    windows: [
+      { period: '15m', enabled: false, limit: 5, spent: 5, reserved: 0, remaining: 0, uncertain: 0 },
+      { period: '5h', enabled: true, limit: 50, spent: 49, reserved: 0, remaining: 1, uncertain: 0 },
