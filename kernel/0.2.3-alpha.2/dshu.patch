+ * IPv4/IPv6 parsing and special-range classification for the pinned HTTP transport.
+ *
+ * `network.ts` must answer two questions before any socket opens: whether an address is globally
+ * routable unicast, and whether an IPv6 address carries an IPv4 destination through a translation
+ * prefix that NAT64 would deliver elsewhere. Both answers decide which addresses are admitted to the
+ * pinned connector, so the tables below are policy, not utility: their ranges follow ipaddr.js 2.5.0,
+ * the classification this provider's address policy is written against.
+ * @module @deepseek-ai/dsh-web-fetch-http/ip
+ */
+
+import { isIP } from 'node:net'
+
+/**
+ * Range name of one address. `unicast` is the only publicly routable answer; every other name marks
+ * a special range that anonymous fetch refuses or that a proxy connection must not bind.
+ */
+export type AddressRange =
+  | 'unicast'
+  | 'unspecified'
+  | 'broadcast'
+  | 'multicast'
+  | 'linkLocal'
+  | 'loopback'
+  | 'carrierGradeNat'
+  | 'private'
+  | 'reserved'
+  | 'as112'
+  | 'amt'
+  | 'uniqueLocal'
+  | 'ipv4Mapped'
+  | 'deprecatedSiteLocal'
+  | 'discard'
+  | 'rfc6145'
+  | 'rfc6052'
+  | '6to4'
+  | 'teredo'
+  | 'benchmarking'
+  | 'as112v6'
+  | 'deprecatedOrchid'
+  | 'orchid2'
+  | 'droneRemoteIdProtocolEntityTags'
+  | 'segmentRouting'
+
+/** A parsed IPv4 address as its four octets in network order. */
+export interface Ipv4Address {
+  readonly kind: 'ipv4'
+  /** Four octets, most significant first. */
+  readonly octets: readonly number[]
+}
+
+/** A parsed IPv6 address as its eight 16-bit groups, most significant first. */
+export interface Ipv6Address {
+  readonly kind: 'ipv6'
+  /** Eight groups; a zone identifier is not part of the address and is dropped. */
+  readonly parts: readonly number[]
+}
+
+/** One parsed address of either family. */
+export type IpAddress = Ipv4Address | Ipv6Address
+
+/** A `[network prefix, prefix length]` pair in the family's own subdivision (octets or groups). */
