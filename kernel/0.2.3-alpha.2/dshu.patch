diff --git a/apps/web/tests/writing-spending-settings.e2e.ts b/apps/web/tests/writing-spending-settings.e2e.ts
new file mode 100644
index 0000000000000000000000000000000000000000..39232c1ec1842713c612da20295ca814eb22e6df
--- /dev/null
+++ b/apps/web/tests/writing-spending-settings.e2e.ts
@@ -0,0 +1,54 @@
+/** Owner settings send Writing and spending edits through the shipped browser and Host. */
+import { fileURLToPath } from 'node:url'
+import { mkdir } from 'node:fs/promises'
+import { join } from 'node:path'
+import { chromium } from 'playwright'
+import { expect, it } from 'vitest'
+import { launchWebScaffold } from './scaffold.ts'
+import { connectFreshWorkspace, newEnglishPage, openSettings } from './support.ts'
+
+it('edits a voice card and two rolling windows in Settings', async () => {
+  const scaffold = await launchWebScaffold({ extraOverlayPath: fileURLToPath(new URL('./pin-browse-picker.overlay.yml', import.meta.url)) })
+  try {
+    const browser = await chromium.launch()
+    try {
+      const page = await newEnglishPage(browser)
+      page.setDefaultTimeout(10_000)
+      await page.goto(scaffold.authenticatedUrl)
+      await connectFreshWorkspace(page, scaffold.workspaceCwd)
+      await openSettings(page, 'en')
+      await page.getByText('Writing materials', { exact: true }).first().click()
+      await page.getByRole('button', { name: 'New material' }).click()
+      const dialog = page.getByRole('dialog').last()
+      await dialog.getByLabel('File name without .md').fill('voice')
+      await dialog.getByLabel('Title', { exact: true }).fill('Harbor voice')
+      await dialog.getByLabel('Content (Markdown)').fill('Use short sentences.')
+      await dialog.getByRole('button', { name: 'Save', exact: true }).click()
+      await page.getByText('Harbor voice', { exact: true }).first().waitFor()
+      const selected = page.getByRole('checkbox', { name: 'Use for writing' })
+      expect(await selected.isChecked()).toBe(true)
+      await selected.click()
+      await expect.poll(() => selected.isChecked()).toBe(false)
+      await page.getByText('Spending limits', { exact: true }).first().click()
+      const periods = ['5 hours', '7 days']
+      for (const period of periods) await page.getByRole('switch', { name: 'Enable limit for ' + period, exact: true }).click()
+      await expect.poll(async () => (await scaffold.ctx.spendLimit.get()).preferences.enabledPeriods.toSorted()).toEqual(['5h', '7d'])
+      await page.getByText('¥0.00 / ¥50.00', { exact: true }).waitFor()
+      await page.getByText('¥0.00 / ¥500.00', { exact: true }).waitFor()
+      const output = fileURLToPath(new URL('../../../.artifacts/screenshots/writing-spending', import.meta.url))
+      await mkdir(output, { recursive: true })
+      for (const [width, preference] of [[1280, 'light'], [390, 'dark']] as const) {
+        await page.setViewportSize({ width, height: 840 })
+        await scaffold.ctx.settings.update('ui-theme', { preference })
+        await expect.poll(() => page.locator('body').getAttribute('data-ds-dark-theme').then(value => value !== null)).toBe(preference === 'dark')
+        const toggle = page.getByRole('switch', { name: 'Enable limit for 5 hours' })
+        await toggle.scrollIntoViewIfNeeded()
+        const box = await toggle.boundingBox()
+        expect(box).not.toBeNull()
+        expect(box!.x).toBeGreaterThanOrEqual(0)
+        expect(box!.x + box!.width).toBeLessThanOrEqual(width)
+        await page.screenshot({ path: join(output, preference + '.png') })
+      }
+    } finally { await browser.close() }
+  } finally { await scaffold.close() }
+}, 120_000)
diff --git a/apps/web/tests/writing-spending.e2e.ts b/apps/web/tests/writing-spending.e2e.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fba0c46014b3821790bc6629d92b3b45bf807164
--- /dev/null
+++ b/apps/web/tests/writing-spending.e2e.ts
@@ -0,0 +1,104 @@
+/** Writing materials and concurrent rolling limits through the shipped Web Host. */
+import { fileURLToPath } from 'node:url'
+import { expect, it } from 'vitest'
+import { brandString } from '@deepseek-ai/dsh-brand'
+import { LlmAdapter, type GenerateOptions, type StreamChunk } from '@deepseek-ai/dsh-llm'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import type { SessionRequestId } from '@deepseek-ai/dsh-api-session-controller/types'
+import { launchWebScaffold } from './scaffold.ts'
+
+class WritingAdapter extends LlmAdapter {
+  readonly requests: GenerateOptions[] = []
+  override async listModels(provider: string) { return [{ provider, id: 'writer', name: 'Writer' }] }
+  override async *stream(request: GenerateOptions): AsyncIterable<StreamChunk> {
+    this.requests.push(request)
+    yield { type: 'block-start', index: 0, blockType: 'text' }
+    yield { type: 'text-delta', index: 0, text: 'Draft.' }
+    yield { type: 'block-end', index: 0, block: { type: 'text', text: 'Draft.' } }
+    yield { type: 'usage', usage: { inputTokens: this.requests.length === 1 ? 1_000_000 : 100, outputTokens: 8 } }
+    yield { type: 'finish', reason: { kind: 'stop' } }
+  }
+}
+
+it('admits selected style and canon only after both windows recover and logs each withdrawal', async () => {
+  const scaffold = await launchWebScaffold({
+    extraOverlayPath: fileURLToPath(new URL('./fixtures/writing-spending/rate.overlay.yml', import.meta.url)),
+  })
+  const { ctx } = scaffold
+  try {
+    const signal = AbortSignal.timeout(60_000)
+    const adapter = new WritingAdapter()
+    ctx.effect(() => ctx.llm.registerAdapter(['writing-smoke'], adapter), 'test writing adapter')
+    await ctx.agentDefaultModel.saveSelection({ provider: 'writing-smoke', model: 'writer' })
+    const workspace = await ctx.workspaceRegistry.create(scaffold.workspaceCwd)
+    const scope = { workspaceId: workspace.id }
+    await ctx.modeDossiers.createStory({ ...scope, section: 'style', title: 'Voice', name: 'voice', markdown: 'VOICE-ALPHA' }, signal)
+    await ctx.modeDossiers.createStory({ ...scope, section: 'bible', title: 'Canon', name: 'canon', markdown: 'CANON-ALPHA' }, signal)
+    const initial = (await ctx.spendLimit.get()).preferences
+    await ctx.spendLimit.configure({ ...initial, enabledPeriods: ['5h', '7d'], autoResume: true,
+      limits: { ...initial.limits, '5h': 100, '7d': 100 } })
+    const send = (sessionId: SessionId, requestId: string) => ctx.sessionController.prompt({
+      sessionId, mode: 'queue', requestId: brandString<SessionRequestId>(requestId), content: [{ type: 'text', text: 'Continue the draft.' }],
+    }, signal)
+    const standard = await ctx.sessionController.create({ ...scope, agentPreset: 'standard' })
+    await ctx.sessionController.selectModel({ sessionId: standard.sessionId, provider: 'writing-smoke', model: 'writer' })
+    const [charged] = await Promise.all([scaffold.whenTurnSettled(), send(standard.sessionId, 'standard')])
+    expect(charged).toBe(standard.sessionId)
+    using chargeLog = await ctx.sessionQuery.observeSession(standard.sessionId)
+    const finished = chargeLog.events.findLast(event => event.type === 'turn/end')
+    const attempts = chargeLog.events.filter(event => event.type === 'turn/end' || event.type === 'assistant/attempt')
+    expect(finished?.data.reason, JSON.stringify([chargeLog.events.findLast(event => event.type === 'request/header')?.data.header.config, ...attempts])).toMatchObject({ kind: 'completed' })
+    expect(adapter.requests).toHaveLength(1)
+    expect(JSON.stringify(adapter.requests[0]!.messages)).not.toContain('VOICE-ALPHA')
+    expect(JSON.stringify(adapter.requests[0]!.messages)).not.toContain('CANON-ALPHA')
+    const { sessionId } = await ctx.sessionController.create({ ...scope, agentPreset: 'writing' })
+    await ctx.sessionController.selectModel({ sessionId, provider: 'writing-smoke', model: 'writer' })
+    for (const period of ['5h', '7d'] as const) await ctx.spendLimit.configureWindow({ period, limit: 2, enabled: true })
+    await send(sessionId, 'first')
+    await expect.poll(async () => (await ctx.spendLimit.get()).pausedSessions.map(row => row.sessionId), { timeout: 15_000 }).toContain(sessionId)
+    await ctx.spendLimit.reset('5h')
+    expect((await ctx.spendLimit.get()).pausedSessions.map(row => row.sessionId)).toContain(sessionId)
+    expect(adapter.requests).toHaveLength(1)
+    const [first] = await Promise.all([scaffold.whenTurnSettled(), ctx.spendLimit.reset('7d')])
+    expect(first).toBe(sessionId)
+    expect(adapter.requests).toHaveLength(2)
+    const materials = (request: GenerateOptions) => request.messages.filter(msg => msg.role === 'user' && msg.source?.kind === 'mode-dossiers')
+    expect(JSON.stringify(materials(adapter.requests[1]!))).toContain('VOICE-ALPHA')
+    expect(JSON.stringify(materials(adapter.requests[1]!))).toContain('CANON-ALPHA')
+    await expect.poll(async () => (await ctx.spendLimit.get()).pausedSessions, { timeout: 15_000 }).toEqual([])
+    await ctx.modeDossiers.selectStory({ ...scope, selected: [] }, signal)
+    const [second] = await Promise.all([scaffold.whenTurnSettled(), send(sessionId, 'second')])
+    expect(second).toBe(sessionId)
+    expect(adapter.requests).toHaveLength(3)
+    const withdrawal = materials(adapter.requests[2]!).at(-1)
+    expect(withdrawal?.content[0]).toMatchObject({ text: expect.stringContaining('Disregard earlier writing-material instructions') })
+    using observed = await ctx.sessionQuery.observeSession(sessionId)
+    const logged = observed.events.filter(event => event.type === 'user/message' && event.data.source.kind === 'mode-dossiers')
+    expect(logged.map(event => event.data)).toEqual(materials(adapter.requests[2]!))
+    expect((await ctx.spendLimit.sessionUsage(sessionId)).requests).toBe(2)
+
+    const coldId = brandString<SessionId>('writing-disposed-while-waiting')
+    const handle = await ctx.agents.create({
+      sessionId: coldId, agentOptions: ctx.agentDefaultModel.currentSelection(),
+      meta: { cwd: scaffold.workspaceCwd, agentPreset: 'writing' },
+      setup: async agentCtx => { await ctx.agentPresets.mount(agentCtx, 'writing') },
+    })
+    await workspace.attachSession(coldId)
+    const ceiling = 1 + (adapter.requests[2]!.maxTokens ?? 500_000) / 1_000_000
+    await ctx.spendLimit.configureWindow({ period: '5h', limit: ceiling })
+    await send(coldId, 'wait-for-budget')
+    await expect.poll(async () => (await ctx.spendLimit.get()).pausedSessions.find(row => row.sessionId === coldId)?.state, { timeout: 15_000 }).toBe('waiting')
+    await handle.dispose()
+    expect(ctx.agents.get(coldId)).toBeUndefined()
+    expect((await ctx.spendLimit.get()).pausedSessions.find(row => row.sessionId === coldId)?.state).toBe('blocked')
+    const [resumed] = await Promise.all([scaffold.whenTurnSettled(), ctx.spendLimit.reset('5h')])
+    expect(resumed).toBe(coldId)
+    expect(adapter.requests).toHaveLength(4)
+    await expect.poll(async () => (await ctx.spendLimit.get()).pausedSessions, { timeout: 15_000 }).toEqual([])
+    using restored = await ctx.sessionQuery.observeSession(coldId)
+    const notices = restored.events.filter(event => event.type === 'user/message' && event.data.source.kind === 'spend-limit')
+    expect(notices).toHaveLength(1)
+    await ctx.spendLimit.resume()
+    expect(adapter.requests).toHaveLength(4)
+  } finally { await scaffold.close() }
+}, 120_000)
