+/** Reverse-preset consumer: discover REA tools on demand within one Agent. @module */
+import type { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { createScope, type Scope } from '@deepseek-ai/dsh-scope'
+import { defineTool } from '@deepseek-ai/dsh-tools'
+import { createMcpToolDefinition, publicToolName } from '@deepseek-ai/dsh-mcp-client'
+import type {} from '@deepseek-ai/dsh-sandbox-policy'
+import type {} from '@deepseek-ai/dsh-working-directory'
+import { registerHeaderIdentification } from './header-identification.ts'
+import type {} from './index.ts'
+
+/** Cordis diagnostics name. */
+export const name = 'rea-agent'
+/** Services that own tool routing, process configuration, and execution policy. */
+export const inject = ['rea', 'tools', 'agents', 'sandboxPolicy', 'workingDirectory']
+
+type OwnedConnection = Awaited<ReturnType<Context['rea']['connect']>>
+interface Owner {
+  scope: Scope
+  abort: AbortController
+  ready: Promise<OwnedConnection>
+  selected: Set<string>
+  close: () => Promise<void>
+}
+
+/**
+ * Mount lazy discovery and Agent-owned external tool definitions.
+ * @param ctx - Reverse preset context; no other preset mounts this consumer.
+ */
+export function apply(ctx: Context): void {
+  registerHeaderIdentification(ctx)
+  const owners = new Map<Agent, Owner>()
+  const cleanups = new Map<Agent, () => Promise<void>>()
+  let stopped = false
+  const authorize = (agent: Agent | undefined): Agent => {
+    if (stopped || agent === undefined || ctx.agents.get(agent.id) !== agent) throw new Error('REA requires a live reverse conversation')
+    if (!ctx.rea.options.enabled) throw new Error('REA is disabled. Configure it in Reverse settings.')
+    if (ctx.sandboxPolicy.resolve({ session: agent.session }).mode !== 'danger-full-access') {
+      throw new Error('REA external engines require full access; the current conversation policy does not allow this process.')
+    }
+    return agent
+  }
+  const ownerFor = (agent: Agent): Owner => {
+    const existing = owners.get(agent)
+    if (existing !== undefined) return existing
+    const abort = new AbortController()
+    const scope = createScope(ctx, agent)
+    const selected = new Set<string>()
+    const ready = ctx.workingDirectory.ensure(agent, abort.signal).then(cwd => ctx.rea.connect(cwd, abort.signal))
+    let closing: Promise<void> | undefined
+    const close = (): Promise<void> => closing ??= (async () => {
+      abort.abort(new Error('REA Agent disposed'))
+      const opened = await Promise.allSettled([ready])
+      if (opened[0].status === 'fulfilled') await opened[0].value.dispose()
+      await scope.dispose()
+      owners.delete(agent)
+    })()
+    const owner = { abort, scope, selected, ready, close }
+    owners.set(agent, owner)
+    if (!cleanups.has(agent)) {
+      cleanups.set(agent, agent.ctx.effect(() => async () => {
+        await owners.get(agent)?.close()
+        cleanups.delete(agent)
+      }, 'rea.agent.connection'))
+    }
+    // An abandoned startup still has an observer and remains owned until close.
+    void ready.catch(() => {})
+    return owner
+  }
+  ctx.effect(() => async () => {
+    stopped = true
+    const settled = await Promise.allSettled([...owners.values()].map(owner => owner.close()))
+    const errors: unknown[] = []
+    for (const result of settled) if (result.status === 'rejected') errors.push(result.reason)
+    if (errors.length > 0) throw new AggregateError(errors, 'REA Agent cleanup failed')
+    await Promise.all([...cleanups.values()].map(dispose => dispose()))
+  }, 'rea.agent.connections')
+
+  ctx.effect(() => ctx.tools.register(defineTool({
+    name: 'rea_tools',
+    description: 'Find REA analysis tools by keyword, then enable exact tool names with names. Enabled tools become directly callable in this conversation. All available tools can be discovered in pages; optional engines must be installed on the host. reset closes this conversation’s REA process and discards its active analysis target. Record verified findings in the reverse case ledger.',
+    parameters: {
+      query: { type: 'string', description: 'Search tool names and descriptions; omit for all tools.' },
+      offset: { type: 'integer', description: 'Zero-based page offset.' },
+      names: { type: 'array', items: { type: 'string' }, description: 'Exact upstream tool names to enable.' },
+      reset: { type: 'boolean', description: 'Explicitly discard the active REA process before connecting again.' },
+    },
+    output: { schema: { type: 'json' }, render: (_args, value) => [{ type: 'text', text: JSON.stringify(value) }] },
+    async execute(args, exec) {
+      const agent = authorize(exec.agent)
+      if (args.reset) await owners.get(agent)?.close()
+      const owner = ownerFor(agent)
+      let cancellation: Promise<void> | undefined
+      const cancel = (): void => { cancellation = owner.close(); void cancellation.catch(() => {}) }
+      exec.signal.addEventListener('abort', cancel, { once: true })
+      let opened: OwnedConnection
+      try { opened = await owner.ready }
+      finally {
+        exec.signal.removeEventListener('abort', cancel)
+        if (cancellation !== undefined) await cancellation
+      }
+      const { connection } = opened
+      exec.signal.throwIfAborted()
+      authorize(agent)
+      const catalog = connection.tools()
+      const names = args.names ?? []
+      const chosen = names.map((rawName) => {
+        const tool = catalog.find(entry => entry.name === rawName)
+        if (tool === undefined) throw new Error(`Unknown REA tool: ${rawName}`)
+        return tool
+      })
+      for (const tool of chosen) {
+        if (owner.selected.has(tool.name)) continue
+        owner.scope.ctx.effect(() => owner.scope.ctx.tools.register(createMcpToolDefinition(owner.scope.ctx, {
+          name: publicToolName('rea', tool.name), rawName: tool.name, description: tool.description ?? tool.name,
+          inputSchema: tool.inputSchema, outputSchema: tool.outputSchema,
+          taskRequired: tool.execution?.taskSupport === 'required',
+          call: async (arguments_, call) => {
+            if (authorize(call.agent) !== agent) throw new Error('This REA tool belongs to another conversation')
+            return connection.call(tool, arguments_, call.signal)
+          },
+        }), { when: () => ctx.rea.options.enabled }), `rea.tool.${tool.name}`)
+        owner.selected.add(tool.name)
+      }
+      const query = (args.query ?? '').trim().toLocaleLowerCase('en-US')
+      const matched = catalog.filter(tool => `${tool.name}\n${tool.description ?? ''}`.toLocaleLowerCase('en-US').includes(query))
+      const offset = args.offset ?? 0
+      if (offset < 0) throw new Error('REA catalog offset must be nonnegative')
+      const page = matched.slice(offset, offset + ctx.rea.options.catalogPageSize)
+      return { server: connection.describe().version, total: matched.length,
+        nextOffset: offset + page.length < matched.length ? offset + page.length : null,
+        tools: page.map(tool => ({ name: tool.name, description: tool.description ?? '' })),
+        enabled: chosen.map(tool => publicToolName('rea', tool.name)) }
+    },
+    presentCall: args => ({ card: 'generic', title: 'REA tools', kind: 'other', rawInput: args }),
+  })), 'rea.discovery')
+}
diff --git a/packages/mcp/rea/src/connection.ts b/packages/mcp/rea/src/connection.ts
new file mode 100644
index 00000000..327a4dc6
--- /dev/null
+++ b/packages/mcp/rea/src/connection.ts
@@ -0,0 +1,129 @@
+/** One isolated REA process, with serialized calls and quiescent shutdown. @module */
+import { Client, type Tool } from '@modelcontextprotocol/client'
+import { StdioClientTransport } from '@modelcontextprotocol/client/stdio'
+import { AjvJsonSchemaValidator } from '@modelcontextprotocol/client/validators/ajv'
+import type { JsonSchemaType, JsonSchemaValidator } from '@modelcontextprotocol/client'
+import { scrubbedParentEnv } from '@deepseek-ai/dsh-subprocess'
+import type { ReaOptions, ReaProbe, ReaExecutionLease } from './types.ts'
+
+/** Owns the MCP process and its analysis state for one live Agent or temporary probe. */
+export class ReaConnection {
+  private readonly client = new Client({ name: 'dshu-rea', version: '0.1.0' }, { versionNegotiation: { mode: 'legacy' } })
+  private readonly lifetime = new AbortController()
+  private readonly transport: StdioClientTransport
+  private readonly nativeClosed = Promise.withResolvers<void>()
+  private readonly revoke: (() => void) | undefined
+  private tail: Promise<unknown> = Promise.resolve()
+  private closing: Promise<void> | undefined
+  private catalog: readonly Tool[] = []
+  private readonly validator = new AjvJsonSchemaValidator()
+  private readonly argumentsValidators = new Map<string, JsonSchemaValidator<Record<string, unknown>>>()
+  /** Resolves after the MCP handshake and complete tool catalog are available. */
+  readonly ready: Promise<void>
+
+  /**
+   * @param options - Validated launch preferences.
+   * @param cwd - Working directory assigned by the owning workspace service.
+   * @param execution - Optional executor lease, checked before any process starts.
+   * @param reportCloseError - Owner's visible sink for asynchronous revocation failures.
+   */
+  constructor(private readonly options: ReaOptions, cwd: string, private readonly execution: ReaExecutionLease | undefined,
+    reportCloseError: (error: unknown) => void) {
+    execution?.signal.throwIfAborted(); execution?.check()
+    const env = { ...scrubbedParentEnv(), REA_MCP_INPUT_SCHEMA_PROFILE: 'compact' }
+    const overrides: Record<string, string> = {
+      GHIDRA_INSTALL_DIR: options.ghidraPath, JAVA_HOME: options.javaHome,
+      REA_IDA_MCP_CONFIG: options.idaConfig,
+      REA_ANALYSIS_PROVIDER: options.provider === 'auto' ? '' : options.provider,
+    }
+    this.transport = new StdioClientTransport({ command: options.nodePath, args: [options.cliPath, 'mcp'], cwd,
+      env: { ...env, ...Object.fromEntries(Object.entries(overrides).filter(([, value]) => value !== '')) }, stderr: 'pipe' })
+    // Drain diagnostics without retaining engine output or leaking it to the model.
+    this.transport.stderr?.on('data', () => {})
+    this.transport.onclose = () => { this.nativeClosed.resolve() }
+    this.client.onclose = () => { this.lifetime.abort(new Error('REA connection closed; reset the connection and reopen the sample.')) }
+    this.ready = this.initialize()
+    if (execution !== undefined) {
+      this.revoke = () => { void this.close().catch(reportCloseError) }
+      execution.signal.addEventListener('abort', this.revoke, { once: true })
+    }
+  }
+
+  private async initialize(): Promise<void> {
+    try {
+      await this.client.connect(this.transport, { signal: this.lifetime.signal, timeout: this.options.startupTimeoutMs })
+      this.catalog = (await this.client.listTools(undefined, {
+        signal: this.lifetime.signal, timeout: this.options.startupTimeoutMs,
+      })).tools
+      if (new Set(this.catalog.map(tool => tool.name)).size !== this.catalog.length) throw new Error('REA returned duplicate tool names')
+      this.lifetime.signal.throwIfAborted()
+    } catch (error) {
+      await this.client.close()
+      throw error
+    }
+  }
+
+  /**
+   * Read the discovered catalog after initialization.
+   * @returns Upstream tools, including their original input and output schemas.
+   */
+  tools(): readonly Tool[] { this.lifetime.signal.throwIfAborted(); return this.catalog }
+
+  /**
+   * Describe the successful handshake, without claiming optional engines were exercised.
+   * @returns Server identity, tool names, and configured engine locations.
+   */
+  describe(): ReaProbe {
+    const version = this.client.getServerVersion()
+    return { name: version?.name ?? 'REA', version: version?.version ?? '', toolCount: this.catalog.length,
+      tools: this.catalog.map(tool => tool.name), engines: [
+        { name: 'Ghidra', path: this.options.ghidraPath },
+        { name: 'Java', path: this.options.javaHome },
+        { name: 'IDA MCP', path: this.options.idaConfig },
+      ].map(engine => ({ ...engine, state: engine.path === '' ? 'discover' : 'configured' })) }
+  }
+
+  /**
+   * Serialize one upstream call; failures never trigger automatic replay.
+   * @param tool - Tool from this connection's catalog.
+   * @param args - Arguments validated by the shared MCP tool definition.
+   * @param signal - Calling turn's cancellation.
+   * @returns Raw MCP result for canonical validation and durable presentation.
+   */
+  call(tool: Tool, args: Record<string, unknown>, signal: AbortSignal): Promise<unknown> {
+    const combined = AbortSignal.any([signal, this.lifetime.signal])
+    const task = this.tail.then(async () => {
+      combined.throwIfAborted()
+      await this.ready
+      this.execution?.signal.throwIfAborted(); this.execution?.check()
+      let validate = this.argumentsValidators.get(tool.name)
+      if (validate === undefined) {
+        validate = this.validator.getValidator<Record<string, unknown>>(tool.inputSchema as JsonSchemaType)
+        this.argumentsValidators.set(tool.name, validate)
+      }
+      const parsed = validate(args)
+      if (!parsed.valid) throw new Error(`Invalid arguments for ${tool.name}: ${parsed.errorMessage}`)
+      return this.client.callTool({ name: tool.name, arguments: args },
+        { signal: combined, timeout: this.options.toolTimeoutMs, toolDefinition: tool })
+    })
+    this.tail = task.catch(() => {})
+    return task
+  }
+
+  /**
+   * Interrupt startup and calls, close the transport, then drain owned promises.
+   * @returns Shared completion; transport-close failures remain visible.
+   */
+  close(): Promise<void> {
+    return this.closing ??= (async () => {
+      this.lifetime.abort(new Error('REA connection disposed'))
+      if (this.revoke !== undefined) this.execution?.signal.removeEventListener('abort', this.revoke)
+      try { await this.client.close() }
+      finally {
+        await this.nativeClosed.promise
+        await Promise.allSettled([this.ready, this.tail])
+        this.execution?.release()
+      }
+    })()
+  }
+}
