diff --git a/apps/web/tests/input-prediction.e2e.ts b/apps/web/tests/input-prediction.e2e.ts
new file mode 100644
index 00000000..da582f1b
--- /dev/null
+++ b/apps/web/tests/input-prediction.e2e.ts
@@ -0,0 +1,64 @@
+/** The shipped Web composer reads a suggestion over the Session RPC and keeps Tab local. */
+import { fileURLToPath } from 'node:url'
+import { chromium, type Browser } from 'playwright'
+import { afterEach, expect, it } from 'vitest'
+import { launchWebScaffold, webSnapshotMode, type WebScaffold } from './scaffold.ts'
+import { connectFreshWorkspace, newEnglishPage, openSettings } from './support.ts'
+
+let scaffold: WebScaffold | undefined
+let browser: Browser | undefined
+
+afterEach(async () => {
+  try { await browser?.close() } finally { await scaffold?.close() }
+})
+
+it.skipIf(webSnapshotMode() === 'record')('ignores and accepts suggestions without sending and retains an opt-out on reload', async () => {
+  scaffold = await launchWebScaffold({
+    replayFixture: fileURLToPath(new URL('../../../snapshots/web/live-interactions/session.v4.jsonl', import.meta.url)),
+    replayOverride: fileURLToPath(new URL('./expected/input-prediction/replay.override.json', import.meta.url)),
+    compareReplaySession: false,
+  })
+  const records: string[] = []
+  scaffold.ctx.on('session/event', (_session, event) => {
+    if (event.type === 'input/prediction') records.push(event.data.phase)
+    if (event.type === 'user/message' && event.data.source.kind === 'user' && event.surfaceOp === 'append') records.push('sent')
+  })
+  browser = await chromium.launch()
+  const page = await newEnglishPage(browser)
+  await page.goto(scaffold.authenticatedUrl)
+  await connectFreshWorkspace(page, scaffold.workspaceCwd)
+  const input = page.locator('[data-composer-input]').first()
+  const settled = scaffold.whenTurnSettled()
+  await input.fill('Start?')
+  await input.press('Enter')
+  await settled
+  await input.fill('Maybe')
+  await input.press('End')
+  await page.waitForSelector('[data-composer-input][data-composer-prediction][data-prediction-eligible]')
+  expect(await input.textContent()).toBe('Maybe')
+  await input.fill('Please')
+  await input.press('End')
+  await page.waitForSelector('[data-composer-input][data-composer-prediction][data-prediction-eligible]')
+  expect(await input.evaluate(element => getComputedStyle(element.querySelector('p:last-child')!, '::after').content)).toBe('" continue?"')
+  expect(await input.textContent()).toBe('Please')
+  await input.press('Tab')
+  await expect.poll(() => input.textContent()).toBe('Please continue?')
+  expect(records).toEqual(['sent', 'request', 'result', 'request', 'result'])
+
+  await openSettings(page, 'en')
+  const dialog = page.getByRole('dialog', { name: 'Settings', exact: true })
+  await dialog.getByRole('navigation').getByRole('button', { name: 'General', exact: true }).click()
+  const setting = dialog.getByRole('switch', { name: 'Input prediction', exact: true })
+  expect(await setting.getAttribute('aria-checked')).toBe('true')
+  await setting.click()
+  await page.reload()
+  await openSettings(page, 'en')
+  await dialog.getByRole('navigation').getByRole('button', { name: 'General', exact: true }).click()
+  expect(await setting.getAttribute('aria-checked')).toBe('false')
+  await page.keyboard.press('Escape')
+  await input.fill('Another draft')
+  // Leave the actual debounce interval open to observe any unwanted Host request.
+  await expect.poll(() => input.textContent()).toBe('Another draft')
+  await new Promise(resolve => setTimeout(resolve, 1200))
+  expect(records).toEqual(['sent', 'request', 'result', 'request', 'result'])
+}, 90_000)
diff --git a/apps/web/tests/mcp-schema-recovery.e2e.ts b/apps/web/tests/mcp-schema-recovery.e2e.ts
new file mode 100644
index 00000000..4d19b2c6
--- /dev/null
+++ b/apps/web/tests/mcp-schema-recovery.e2e.ts
@@ -0,0 +1,61 @@
+/** Reopen a failed conversation and read the recovery instructions for its recorded tool declarations without submitting a turn. */
+import { readFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { chromium } from 'playwright'
+import { expect, it, onTestFailed } from 'vitest'
+import { assertFixtureInventory, launchWebScaffold, seedSession } from './scaffold.ts'
+import { newEnglishPage, saveFailureShot } from './support.ts'
+
+const directory = fileURLToPath(new URL('../../../snapshots/web/mcp-schema-recovery/', import.meta.url))
+
+it('opens the recorded MCP recovery instructions on desktop and a narrow screen', async () => {
+  const scaffold = await launchWebScaffold({ extraOverlayPath: fileURLToPath(new URL('./pin-browse-picker.overlay.yml', import.meta.url)) })
+  try {
+    const recording = await readFile(join(directory, 'session.v4.jsonl'), 'utf8')
+    const cases = [
+      { id: 'mcp-schema-recovery', tool: 'mcp__notes__lookup_archive', expectedFile: 'recovery.expected.txt' },
+      { id: 'mcp-schema-declared', tool: 'mcp__notes__lookup', expectedFile: 'declared.expected.txt' },
+    ]
+    for (const { id, tool } of cases) {
+      const tools = [{ name: tool, description: 'Look up a note.', parameters: { type: 'object', properties: {} } }]
+      await seedSession(scaffold, recording.replace('"{{tools}}"', JSON.stringify(tools)), id)
+    }
+    const browser = await chromium.launch()
+    try {
+      const page = await newEnglishPage(browser)
+      onTestFailed(() => saveFailureShot(page, 'mcp-schema-recovery'))
+      await page.goto(scaffold.authenticatedUrl, { waitUntil: 'load' })
+      await page.locator('[role="treeitem"]').first().click()
+      for (const { id, expectedFile } of cases) {
+        await page.setViewportSize({ width: 1280, height: 780 })
+        await page.locator(`[data-row-key="session:${id}"]`).click()
+        await page.getByText("Invalid schema for function 'mcp__notes__lookup': invalid pattern", { exact: true }).waitFor()
+        const summary = page.getByText('How to recover this conversation', { exact: true })
+        await summary.waitFor()
+        const details = page.locator('details').filter({ has: summary })
+        const expected = (await readFile(join(directory, expectedFile), 'utf8')).trimEnd().split(/\r?\n/u)
+        for (const width of [1280, 390]) {
+          await page.setViewportSize({ width, height: 780 })
+          await summary.click({ trial: true, position: { x: 6, y: 6 } })
+          await summary.focus()
+          await summary.press('Enter')
+          await expect.poll(() => details.getAttribute('open')).not.toBeNull()
+          expect((await details.innerText()).split(/\n+/u)).toEqual(expected)
+          const box = await details.boundingBox()
+          expect(box).not.toBeNull()
+          expect(box!.x).toBeGreaterThanOrEqual(0)
+          expect(box!.x + box!.width).toBeLessThanOrEqual(width + 1)
+          await page.screenshot({ animations: 'disabled', path: join(process.cwd(), '.artifacts', `${id}-${width}.png`) })
+          await summary.press('Space')
+          await expect.poll(() => details.getAttribute('open')).toBeNull()
+        }
+      }
+      await assertFixtureInventory(directory, ['session.v4.jsonl', ...cases.map(item => item.expectedFile)])
+    } finally {
+      await browser.close()
+    }
+  } finally {
+    await scaffold.close()
+  }
+}, 120_000)
diff --git a/apps/web/tests/memory-preference.e2e.ts b/apps/web/tests/memory-preference.e2e.ts
new file mode 100644
index 00000000..7368ad0f
--- /dev/null
+++ b/apps/web/tests/memory-preference.e2e.ts
@@ -0,0 +1,44 @@
+/** The memory opt-in takes effect on the Host and survives a reopened settings page. */
+import { fileURLToPath } from 'node:url'
+import { mkdir } from 'node:fs/promises'
+import { join } from 'node:path'
+import { chromium } from 'playwright'
+import { expect, it, onTestFinished } from 'vitest'
+import type {} from '@deepseek-ai/dsh-memory'
+import { launchWebScaffold } from './scaffold.ts'
+import { openSettings, ZH_BROWSER_LOCALE } from './support.ts'
+
+it('enables conversation memory independently of extraction and keeps saved records after disabling it', async () => {
+  const scaffold = await launchWebScaffold({
+    extraOverlayPath: fileURLToPath(new URL('./pin-browse-picker.overlay.yml', import.meta.url)),
+  })
+  onTestFinished(() => scaffold.close())
+  const browser = await chromium.launch()
+  onTestFinished(() => browser.close())
+  const page = await browser.newPage({ locale: ZH_BROWSER_LOCALE })
+  await page.goto(scaffold.authenticatedUrl, { waitUntil: 'load' })
+  await openSettings(page, 'zh')
+  const master = page.getByRole('switch', { name: '跨对话记忆', exact: true })
+  await master.waitFor()
+  expect(await master.getAttribute('aria-checked')).toBe('false')
+  await master.click()
+  await expect.poll(() => scaffold.ctx.memory.enabled).toBe(true)
+  const extract = page.getByRole('switch', { name: '自动提炼记忆' })
+  await extract.waitFor()
+  expect(await extract.getAttribute('aria-checked')).toBe('false')
+  await scaffold.ctx.memory.create({ type: 'preference', content: '使用简体中文', scope: { global: true }, source: { kind: 'user', confirmed: true } })
+  await page.reload({ waitUntil: 'load' })
+  await openSettings(page, 'zh')
+  await master.waitFor()
+  expect(await master.getAttribute('aria-checked')).toBe('true')
+  await master.click()
+  await expect.poll(() => scaffold.ctx.memory.enabled).toBe(false)
+  await extract.waitFor({ state: 'hidden' })
+  expect(scaffold.ctx.memory.records()).toHaveLength(1)
+  const shots = fileURLToPath(new URL('../../../.artifacts/screenshots/memory', import.meta.url))
+  await mkdir(shots, { recursive: true })
+  await page.getByRole('button', { name: '管理记忆', exact: true }).click()
+  const manager = page.getByRole('dialog', { name: '跨对话记忆', exact: true })
+  await manager.getByText('使用简体中文', { exact: true }).first().waitFor()
+  await manager.screenshot({ animations: 'disabled', path: join(shots, 'manager.png') })
+})
diff --git a/apps/web/tests/persistent-side.e2e.ts b/apps/web/tests/persistent-side.e2e.ts
