+      const panel = page.locator('[data-aside="btw"]')
+      await input.fill('/btw Which part is being written?')
+      await input.press('Enter')
+      await panel.getByText('The opening is being drafted.', { exact: true }).waitFor()
+      expect(await panel.locator('[data-composer-input]').count()).toBe(0)
+      expect(JSON.stringify(adapter.requests[1]?.messages)).toContain('Draft a market scene at dawn.')
+      expect(JSON.stringify(adapter.requests[1]?.messages)).toContain('Status: running')
+      expect(adapter.requests[1]?.maxTokens).toBe(512)
+      expect(adapter.requests[1]?.reasoningEffort).toBeUndefined()
