@@ -0,0 +1,83 @@
+/** Workspace scope bar: which workspace the panels manage and how to change it. */
+
+import { useEffect, useState, type ReactNode } from 'react'
+import { Button, Menu } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { WorkspaceView } from '@deepseek-ai/dsh-api-workspace-controller/client'
+import type { MaterialsFailure, MaterialsState, MaterialScope } from './contract.ts'
+import type { Translate } from './ui.tsx'
+import css from './ModeMaterials.module.css'
+
+/** Props of the scope bar shared by every mode panel. */
+export interface ScopeBarProps {
+  readonly state: MaterialsState
+  readonly items: readonly WorkspaceView[]
+  readonly scope: MaterialScope | undefined
+  readonly t: Translate
+  readonly load: (workspaceId: string | undefined) => Promise<void>
+  readonly pickDirectory: () => Promise<string | null>
+  readonly createWorkspace: (path: string) => Promise<string>
+}
+
+/** Render the managed workspace, its path, and the failure of a selection attempt. */
+export function ScopeBar({ state, items, scope, t, load, pickDirectory, createWorkspace }: ScopeBarProps): ReactNode {
+  const [open, setOpen] = useState(false)
+  const [failure, setFailure] = useState<MaterialsFailure | undefined>(undefined)
+  const [choosing, setChoosing] = useState(false)
+  const current = state.workspaceId === undefined
+    ? undefined
+    : items.find(item => item.workspaceId === state.workspaceId)
+  // A first visit lands on the first registered workspace instead of an empty panel.
+  useEffect(() => {
+    if (state.workspaceId !== undefined || items.length === 0) return
+    const first = items[0]
+    if (first !== undefined) void load(first.workspaceId)
+  }, [state.workspaceId, items, load])
+  const choose = async (): Promise<void> => {
+    setChoosing(true)
+    setFailure(undefined)
+    try {
+      const path = await pickDirectory()
+      if (path === null) return
+      await load(await createWorkspace(path))
+    } catch (error: unknown) {
+      setFailure({ code: 'scope/pick-failed', message: error instanceof Error ? error.message : String(error) })
+    } finally {
+      setChoosing(false)
+    }
+  }
+  return <div className={css.scope}>
+    <div className={css.scopeRow}>
+      <span className={css.scopeLabel}>{t('scope.label')}</span>
+      {items.length === 0
+        ? <span className={css.scopeNone}>{t('scope.none')}</span>
+        : <Menu open={open} onClose={() => { setOpen(false) }} align="start" portal
+          selectedId={state.workspaceId}
+          items={items.map(item => ({ id: item.workspaceId, label: item.title }))}
+          onSelect={(id) => { setOpen(false); void load(id) }}
+          anchor={<button type="button" className={css.scopeButton} aria-haspopup="menu" aria-expanded={open}
+            onClick={() => { setOpen(value => !value) }}>
+            {current?.title ?? t('scope.none')}
+            <span aria-hidden="true" className={css.scopeCaret}>▾</span>
+          </button>} />}
+      <span className={css.scopeSpacer} />
+      <Button variant="outline" size="sm" disabled={choosing} onClick={() => { void choose() }}>
+        {t('scope.choose')}
+      </Button>
+      <Button variant="ghost" size="sm" disabled={scope === undefined || state.phase === 'loading'}
+        onClick={() => { void load(state.workspaceId) }}>
+        {t('reload')}
+      </Button>
+    </div>
+    {state.inventory?.workspace?.path === undefined ? null : <p className={css.scopePath} title={state.inventory.workspace.path}>
+      {state.inventory.workspace.path}
+    </p>}
+    {state.workspaceId === undefined
+      ? <p className={css.hint}>{t('scope.noneHint')}</p>
+      : <p className={css.hint}>{t('scope.range')}</p>}
+    {failure === undefined
+      ? null
+      : <p className={css.error} role="alert">
+        {failure.code === 'scope/pick-failed' ? t('scope.pickFailed', { reason: failure.message }) : failure.message}
+      </p>}
+  </div>
+}
diff --git a/packages/client/ui-mode-materials/src/client/ui.tsx b/packages/client/ui-mode-materials/src/client/ui.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..49da366bde614e1235634c25f7979f1917f11b6d
--- /dev/null
+++ b/packages/client/ui-mode-materials/src/client/ui.tsx
@@ -0,0 +1,70 @@
+/** Small presentational pieces shared by the three mode-materials panels. */
+
+import type { ReactNode } from 'react'
+import { Button, Modal } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { MaterialsFailure } from './contract.ts'
+import type { ModeMaterialsKey } from './locales.ts'
+import type { DossierProblem } from '@deepseek-ai/dsh-api-mode-dossiers/types'
+import css from './ModeMaterials.module.css'
+
+/** Localized-text function these panels receive through the locale seat. */
+export type Translate = (key: ModeMaterialsKey, vars?: Record<string, string | number>) => string
+
+/** One labelled control in a panel or dialog. */
+export function Field({ label, hint, children }: {
+  readonly label: string
+  readonly hint?: string | undefined
+  readonly children: ReactNode
+}): ReactNode {
+  return <label className={css.field}>
+    <span className={css.fieldLabel}>{label}</span>
+    {children}
+    {hint === undefined ? null : <span className={css.fieldHint}>{hint}</span>}
+  </label>
+}
+
+/** A reported storage condition, localized by its code. */
+export function ProblemNote({ problem, t }: { readonly problem: DossierProblem; readonly t: Translate }): ReactNode {
+  return <p className={css.problem} role="alert">
+    {t(`problem.${problem.code}`)}
+    <span className={css.problemDetail}>{problem.detail}</span>
+  </p>
+}
+
+/** A failed operation, with the conflict case called out as its own state. */
+export function FailureNote({ failure, t, onRetry }: {
+  readonly failure: MaterialsFailure
+  readonly t: Translate
+  readonly onRetry?: (() => void) | undefined
+}): ReactNode {
+  const conflict = failure.code === 'mode-dossier/conflict'
+  return <div className={conflict ? css.conflict : css.error} role="alert">
+    <p className={css.failureHead}>{conflict ? t('conflict') : t('unknownError', { reason: failure.message })}</p>
+    {conflict ? <p className={css.failureBody}>{t('conflictHint')}</p> : null}
+    {onRetry === undefined ? null : <Button variant="outline" size="sm" onClick={onRetry}>{t('reload')}</Button>}
+  </div>
+}
+
+/** One modal frame with a Cancel/Confirm footer. */
+export function FormModal({ open, title, children, confirmLabel, cancelLabel, busy, confirmDisabled, onConfirm, onClose }: {
+  readonly open: boolean
+  readonly title: string
+  readonly children: ReactNode
+  readonly confirmLabel: string
+  readonly cancelLabel: string
+  readonly busy: boolean
+  readonly confirmDisabled: boolean
+  readonly onConfirm: () => void
+  readonly onClose: () => void
+}): ReactNode {
+  return <Modal open={open} onClose={busy ? () => {} : onClose} closeLabel={cancelLabel} title={title}
+    className={css.dialog as string}
+    footer={<>
+      <Button variant="outline" onClick={onClose} disabled={busy}>{cancelLabel}</Button>
+      <Button variant="primary" onClick={onConfirm} disabled={busy || confirmDisabled}>
+        {confirmLabel}
+      </Button>
+    </>}>
+    {children}
+  </Modal>
+}
